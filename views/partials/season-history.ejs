<%
  const statusOf = (result) => String(result?.status || '').trim().toUpperCase();
  const numberOf = (value) => Number.isFinite(Number(value)) ? Number(value) : 0;
  const hasResult = (result) => Boolean(result && (result.position || result.status || result.fastestLap || numberOf(result.points)));
  const podiumClass = (result) => {
    const position = Number(result?.position);
    return position >= 1 && position <= 3 ? `season-race-position-${position}` : '';
  };
  const resultLabel = (result, mode, race) => {
    if (mode === 'reserve' && result?.outsideStint) return { text: '–', kind: 'inactive' };
    if (mode === 'regular' && result?.outsideStint) return { text: 'DNS', kind: 'dns' };
    if (!race?.isCompleted) return { text: '–', kind: 'future' };
    const status = statusOf(result);
    if (status === 'DNF' || status === 'DSQ') return { text: status, kind: status.toLowerCase() };
    if (status === 'DNS' || !hasResult(result)) return { text: 'DNS', kind: 'dns' };
    return { text: String(numberOf(result.points)), kind: 'points' };
  };
  const activeSeason = typeof selectedSeason === 'undefined' ? null : selectedSeason;
  const game = activeSeason?.f1Game;
  const gameLabel = game?.name || activeSeason?.gameName || '';
%>

<% if (history.seasons.length && selectedHistory) { %>
  <header class="season-sheet-hero" style="--season-accent:<%= activeSeason?.accentColor || league.accentColor || '#6ef2f2' %>">
    <div class="season-sheet-brand">
      <% if (league.logoPath) { %><img src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } else { %><span>KRL</span><% } %>
    </div>
    <div>
      <span>MEISTERSCHAFTSVERLAUF</span>
      <h3><%= selectedHistory.name %></h3>
      <small><%= league.name %> · Punkte je Rennwochenende</small>
    </div>
    <div class="season-sheet-game">
      <% if (game?.logoPath) { %><img src="<%= game.logoPath %>" alt="<%= game.name %>"><% } else if (gameLabel) { %><strong><%= gameLabel %></strong><% } %>
    </div>
  </header>

  <% if (history.warning && isAdmin) { %><div class="history-notice" role="status"><%= history.warning %></div><% } %>

  <div class="season-history-switch" role="tablist" aria-label="Wertung auswählen">
    <button type="button" class="season-history-tab is-active" data-history-tab="regular" role="tab" aria-selected="true">
      <span>STAMM</span><strong>Fahrer-WM</strong><small><%= selectedHistory.drivers.length %> Fahrer</small>
    </button>
    <button type="button" class="season-history-tab" data-history-tab="reserve" role="tab" aria-selected="false">
      <span>ERSATZ</span><strong>Ersatzfahrer</strong><small><%= (selectedHistory.reserveDrivers || []).length %> Fahrer</small>
    </button>
  </div>

  <% const renderSheet = (drivers, mode) => { %>
    <div class="season-sheet-wrap" data-season-rounds="<%= selectedHistory.races.length %>">
      <table class="season-sheet-table">
        <colgroup>
          <col class="col-position"><col class="col-driver"><col class="col-team">
          <% selectedHistory.races.forEach(() => { %><col class="col-race"><% }) %>
          <col class="col-stat"><col class="col-stat"><col class="col-stat"><col class="col-rate"><col class="col-rate">
        </colgroup>
        <thead><tr>
          <th class="sheet-sticky sheet-position">#</th><th class="sheet-sticky sheet-driver">FAHRER</th><th class="sheet-sticky sheet-team">TEAM</th>
          <% selectedHistory.races.forEach((race) => { %>
            <th class="sheet-race-head <%= race.isCompleted ? 'is-completed' : 'is-upcoming' %> <%= race.hasSprint ? 'has-sprint' : '' %>" title="Runde <%= race.round %> · <%= race.title %>">
              <span class="sheet-flag"><% if (race.countryFlagPath) { %><img src="<%= race.countryFlagPath %>" alt="<%= race.countryName || '' %>"><% } else { %><b><%= race.code %></b><% } %></span>
              <strong>R<%= race.round %></strong><% if (race.hasSprint) { %><small>SPR</small><% } %>
            </th>
          <% }) %>
          <th class="sheet-stat-head">Σ</th><th class="sheet-stat-head">Δ</th><th class="sheet-stat-head">Ø</th>
          <th class="sheet-stat-head sheet-rate-head" title="Startquote">START</th><th class="sheet-stat-head sheet-rate-head" title="Ausfallquote">DNF</th>
        </tr></thead>
        <tbody>
          <% drivers.forEach((driver) => { %>
            <tr class="<%= driver.isFormerDriver ? 'is-former-driver' : '' %> <%= mode === 'reserve' ? 'is-reserve-driver' : '' %>">
              <td class="sheet-sticky sheet-position"><strong><%= driver.position %></strong></td>
              <td class="sheet-sticky sheet-driver">
                <strong title="<%= driver.name %>"><%= driver.name %></strong>
                <% if (driver.isFormerDriver) { %><small>Ehemalig<%= driver.regularToRound ? ` · bis R${driver.regularToRound}` : '' %></small><% } %>
                <% if (!driver.isFormerDriver && driver.regularFromRound > 1) { %><small>ab R<%= driver.regularFromRound %></small><% } %>
                <% if (mode === 'reserve' && driver.promotedToRegular) { %><small>ab R<%= driver.promotedFromRound %> Stammfahrer</small><% } %>
              </td>
              <td class="sheet-sticky sheet-team">
                <% if (driver.teamLogoPath) { %><img src="<%= driver.teamLogoPath %>" alt="<%= driver.team || 'Team' %>" title="<%= driver.team || '' %>"><% } else { %><span title="<%= driver.team || '' %>"><%= (driver.team || '–').slice(0, 3).toUpperCase() %></span><% } %>
              </td>
              <% driver.results.forEach((weekend, index) => {
                const race = selectedHistory.races[index];
                const main = weekend.main || (!Object.prototype.hasOwnProperty.call(weekend, 'main') ? weekend : null);
                const sprint = weekend.sprint;
                const mainView = resultLabel(main, mode, race);
                const sprintView = resultLabel(sprint, mode, race);
              %>
                <td class="sheet-result <%= race?.hasSprint ? 'has-sprint' : '' %>">
                  <% if (race?.hasSprint) { %>
                    <span class="sheet-result-part is-sprint <%= `is-${sprintView.kind}` %> <%= podiumClass(sprint) %>"><i>S</i><b><%= sprintView.text %></b></span>
                    <span class="sheet-result-part is-main <%= `is-${mainView.kind}` %> <%= podiumClass(main) %>"><i>GP</i><b><%= mainView.text %></b></span>
                  <% } else { %><span class="sheet-result-single <%= `is-${mainView.kind}` %> <%= podiumClass(main) %>"><%= mainView.text %></span><% } %>
                </td>
              <% }) %>
              <td class="sheet-total"><strong><%= numberOf(driver.total) %></strong></td>
              <td class="sheet-stat"><%= driver.position === 1 ? '—' : `+${Math.abs(numberOf(driver.gap))}` %></td>
              <td class="sheet-stat"><%= numberOf(driver.average).toFixed(1).replace('.', ',') %></td>
              <td class="sheet-stat sheet-rate"><%= numberOf(driver.startRate).toFixed(0) %>%</td>
              <td class="sheet-stat sheet-rate"><%= numberOf(driver.failureRate).toFixed(0) %>%</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% }; %>

  <section class="season-history-panel" data-history-panel="regular" role="tabpanel"><% renderSheet(selectedHistory.drivers, 'regular'); %></section>
  <section class="season-history-panel" data-history-panel="reserve" role="tabpanel" hidden>
    <% if ((selectedHistory.reserveDrivers || []).length) { renderSheet(selectedHistory.reserveDrivers, 'reserve'); } else { %><div class="empty-state">In dieser Saison wurde bisher kein Ersatzfahrer eingesetzt.</div><% } %>
  </section>
<% } else { %><div class="empty-state">Noch keine Ergebnisse eingetragen.</div><% } %>
