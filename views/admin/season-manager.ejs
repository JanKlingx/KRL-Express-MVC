<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">SCHRITT 1</span><h1>SAISONS VERWALTEN</h1><p class="admin-intro">Zuerst Liga wählen, danach Saison sichtbar schalten, ändern oder vollständig löschen.</p></div><a class="button" href="/admin/season-setup">Saison-Assistent starten</a></div>
  <form class="race-selector" method="get"><label>Liga<select name="league" onchange="this.form.submit()"><% leagues.forEach((item) => { %><option value="<%= item.id %>" <%= league?.id === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label></form>
  <% if (!seasons.length) { %><div class="empty-state">Für diese Liga gibt es noch keine Saison. Starte den Saison-Assistenten.</div><% } %>
  <div class="setup-calendar-list"><% seasons.forEach((season) => { %><article><div class="season-manager-card-head"><span><%= season.status === 'active' ? 'AKTUELL' : 'HISTORISCH' %></span><strong><%= season.name %></strong><a href="/admin/season-setup?league=<%= league.id %>&season=<%= season.id %>">Fahrer, Teams, Line-Up und Kalender vollständig bearbeiten →</a></div><form method="post" action="/admin/season-manager/<%= season.id %>" class="setup-form setup-calendar-form"><label>Saisonname<input name="name" value="<%= season.name %>" required></label><label>Spiel<input name="gameName" value="<%= season.gameName || '' %>" placeholder="z. B. F1 25"></label><label>Status<select name="status"><option value="active" <%= season.status === 'active' ? 'selected' : '' %>>Aktuelle Saison</option><option value="historical" <%= season.status === 'historical' ? 'selected' : '' %>>Historisch</option></select></label><label>Punktesystem *<select name="PointsSchemeId" required><option value="">Bitte auswählen …</option><% schemes.forEach((scheme) => { %><option value="<%= scheme.id %>" <%= season.PointsSchemeId === scheme.id ? 'selected' : '' %>><%= scheme.name %></option><% }) %></select></label><label>Farbe *<input type="color" name="accentColor" value="<%= season.accentColor || '#6ef2f2' %>" required></label><label class="checkbox-control"><input type="checkbox" name="isPublished" <%= season.isPublished ? 'checked' : '' %>><span>Im Frontend anzeigen</span></label><button class="button button-small">Änderungen prüfen & speichern</button></form><form method="post" action="/admin/season-manager/<%= season.id %>?_method=DELETE" data-confirm="Diese Saison inklusive Kalender, Line-Up und Ergebnisse endgültig löschen?"><button class="button button-ghost button-small">Saison vollständig löschen</button></form></article><% }) %></div>
</div></section>
<%- include('../partials/footer') %>
