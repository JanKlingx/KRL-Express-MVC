<%- include('partials/header', { title }) %>
<section class="league-hero lmu-hero"><div class="container"><span class="eyebrow">LE MANS ULTIMATE · <%= league.currentSeason %></span><h1>LE MANS<br><span>ULTIMATE</span></h1><p><%= league.description %></p><div class="facts"><span>Renntag <strong><%= league.raceDay %></strong></span><span>Start <strong><%= league.raceTime %></strong></span><span>Format <strong>3 Fahrer pro Team</strong></span></div></div></section>
<section class="section container"><div class="section-heading"><span>TEAMWORK AUF DER LANGSTRECKE</span><h2>COCKPITS</h2></div><div class="cockpit-grid"><% cockpits.forEach(cockpit => { %><article class="cockpit-card"><div class="car-number">#<%= cockpit.carNumber || '00' %></div><span><%= cockpit.vehicleClass || 'Hypercar' %></span><h3><%= cockpit.teamName %></h3><p><%= cockpit.car || 'Le Mans Prototype' %></p><ul><li><%= cockpit.driver1 || 'Freier Platz' %></li><li><%= cockpit.driver2 || 'Freier Platz' %></li><li><%= cockpit.driver3 || 'Freier Platz' %></li><% if (cockpit.reserveDriver) { %><li>Ersatz: <%= cockpit.reserveDriver %></li><% } %></ul></article><% }) %></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><span>AKTUELLE WERTUNG</span><h2>LMU WM-STÄNDE</h2></div><%- include('partials/carousel', { items: standingImages, label: 'LMU-WM-Stände' }) %></div></section>
<%- include('partials/footer') %>
