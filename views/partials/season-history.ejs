<% if (history.seasons.length && selectedHistory) { %>
  <div class="season-history-toolbar">
    <form method="get" action="/f1/<%= league.slug %>#season-history" class="season-picker">
      <label for="season">Saison auswählen</label>
      <select id="season" name="season">
        <% history.seasons.forEach((season) => { %>
          <option value="<%= season.name %>" <%= season.name === selectedHistory.name ? 'selected' : '' %>><%= season.name %></option>
        <% }) %>
      </select>
      <button class="button button-small" type="submit">Anzeigen</button>
    </form>
    <% if (history.sourceLabel) { %><span class="history-source">Quelle: <%= history.sourceLabel %></span><% } %>
  </div>

  <% if (history.warning && isAdmin) { %><div class="history-notice" role="status"><%= history.warning %></div><% } %>

  <div class="season-chart-card">
    <div class="season-chart-heading">
      <div><span>PUNKTEENTWICKLUNG</span><h3><%= selectedHistory.name %></h3></div>
      <p>Die acht bestplatzierten Fahrer im Verlauf der Saison.</p>
    </div>
    <div class="season-chart-scroll">
      <div class="season-chart" data-season-chart aria-label="Punkteverlauf <%= selectedHistory.name %>"></div>
    </div>
    <div class="season-chart-legend" data-season-legend></div>
    <% const chartPayload = JSON.stringify({ races: selectedHistory.races, drivers: selectedHistory.drivers.slice(0, 8) }).replace(/</g, '\\u003c'); %>
    <script type="application/json" data-season-chart-data><%- chartPayload %></script>
  </div>

  <div class="table-wrap season-history-table">
    <table>
      <thead>
        <tr><th>Pos.</th><th>Fahrer</th>
          <% selectedHistory.races.forEach((race) => { %><th title="Runde <%= race.round %>"><%= race.code %><small><%= race.round %></small></th><% }) %>
          <th>Gesamt</th>
        </tr>
      </thead>
      <tbody>
        <% selectedHistory.drivers.forEach((driver) => { %>
          <tr><td><strong><%= driver.position %></strong></td><td><%= driver.name %></td>
            <% driver.results.forEach((result) => { %><td class="<%= result.fastestLap ? 'has-fastest-lap' : '' %>"><%= result.value || '–' %></td><% }) %>
            <td><strong><%= driver.total %></strong></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } else { %>
  <div class="empty-state">Für diese Liga ist noch kein Saisonverlauf hinterlegt.</div>
<% } %>
