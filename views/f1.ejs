<%- include('partials/header', { title }) %>
<div class="league-page" style="--accent:<%= league.accentColor %>">
  <section class="league-hero">
    <div class="container">
      <span class="eyebrow">FORMEL 1 · <%= league.currentSeason %></span>
      <h1><%= league.name %></h1>
      <p><%= league.description %></p>
      <div class="facts"><span>Renntag <strong><%= league.raceDay %></strong></span><span>Start <strong><%= league.raceTime %></strong></span><span>Saison <strong><%= league.currentSeason %></strong></span></div>
    </div>
  </section>
  <% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/teams?league=<%= league.id %>">✎ Teamaufstellungen bearbeiten</a><a href="/admin/drivers">✎ Fahrer-Stammdaten bearbeiten</a><a href="/admin/race-editor?league=<%= league.id %>">✎ Saisonverlauf bearbeiten</a><a href="/admin/f1Calendar">✎ Rennkalender bearbeiten</a></div><% } %>

  <section class="section container">
    <div class="section-heading"><span>STARTAUFSTELLUNG</span><h2>TEAMS & FAHRER</h2></div>
    <div class="cockpit-grid"><% teams.forEach((team) => { const teamDrivers = [team.driverOne, team.driverTwo]; %><article class="cockpit-card"><% if (team.logoPath) { %><img class="cockpit-logo" src="<%= team.logoPath %>" alt="Logo <%= team.name %>"><% } %><span><%= team.car || 'Formel 1' %></span><h3><%= team.name %></h3><ul><% teamDrivers.forEach((driver, index) => { %><li><strong>Fahrer <%= index === 0 ? 'A' : 'B' %>:</strong> <%= driver?.name || 'Noch nicht besetzt' %><% if (driver) { %> · #<%= driver.number || '–' %> · <%= driver.platform %><% } %></li><% }) %></ul></article><% }) %></div>
    <% if (!teams.length) { %><div class="empty-state">Noch keine Teams für diese Liga angelegt.</div><% } %>
  </section>

  <section class="section container"><div class="section-heading"><span>ALLE TERMINE</span><h2>RENNKALENDER</h2></div><div class="calendar-grid"><% calendar.forEach((race) => { %><article class="calendar-card"><time datetime="<%= race.startsAt.toISOString() %>"><%= new Intl.DateTimeFormat('de-DE', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', timeZone:'Europe/Berlin' }).format(race.startsAt) %></time><h3><%= race.title %></h3><p><%= race.circuit || league.name %></p></article><% }) %><% if (!calendar.length) { %><div class="empty-state">Noch keine Renntermine veröffentlicht.</div><% } %></div></section>

  <section class="section section-dark">
    <div class="container standings-grid">
      <div><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>FAHRER-WM</h2><a class="download-link" href="/f1/<%= league.slug %>/download/fahrer-wm.csv" download>Fahrer-WM herunterladen (.csv) ↓</a></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Fahrer</th><th>Team</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% driverStandings.forEach(row => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.driver.name %></td><td><%= row.driver.team ? row.driver.team.name : '–' %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div></div>
      <div><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>TEAM-WM</h2><a class="download-link" href="/f1/<%= league.slug %>/download/team-wm.csv" download>Team-WM herunterladen (.csv) ↓</a></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Team</th><th>Punkte</th><th>Siege</th><th>Gap</th></tr></thead><tbody><% teamStandings.forEach(row => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.team.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td><td><%= row.gap || '–' %></td></tr><% }) %></tbody></table></div></div>
    </div>
  </section>

  <section class="section container gp-results-section">
    <div class="section-heading"><span>AUTOMATISCH AUS DEM SAISONVERLAUF</span><h2>GP-ERGEBNISSE</h2><a class="download-link" href="/f1/<%= league.slug %>/download/gp-results.csv" download>Alle GP-Results herunterladen (.csv) ↓</a></div>
    <%- include('partials/gp-results', { items: gpResults, label: 'Grand-Prix-Ergebnisse' }) %>
  </section>

  <section class="section section-dark season-history-section" id="season-history">
    <div class="container">
      <div class="section-heading"><span>VOM AUFTAKT BIS ZUM FINALE</span><h2>SAISONVERLAUF</h2></div>
      <%- include('partials/season-history', { history, selectedHistory, league }) %>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
