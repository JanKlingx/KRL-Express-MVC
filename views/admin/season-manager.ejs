<%- include('../partials/header', { title }) %>


<section class="admin-shell">

  <div class="container">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="admin-heading">

      <div>

        <a
          class="back-link"
          href="/admin"
        >
          ← Dashboard
        </a>


        <span class="form-kicker">
          SCHRITT 1
        </span>


        <h1>
          SAISONS VERWALTEN
        </h1>


        <p class="admin-intro">
          Liga auswählen und bestehende Saisonattribute verwalten.
          Fahrer, Teams, Line-up und Kalender bleiben im Saison-Assistenten.
        </p>

      </div>


      <a
        class="button"
        href="/admin/season-setup"
      >
        Saison-Assistent starten
      </a>

    </div>


    <!-- ================================================= -->
    <!-- LIGA -->
    <!-- ================================================= -->

    <form
      class="race-selector"
      method="get"
    >

      <label>

        Liga

        <select
          name="league"
          onchange="this.form.submit()"
        >

          <% leagues.forEach((item) => { %>

            <option
              value="<%= item.id %>"
              <%= league?.id === item.id
                ? 'selected'
                : ''
              %>
            >
              <%= item.name %>
            </option>

          <% }) %>

        </select>

      </label>

    </form>


    <!-- ================================================= -->
    <!-- KEINE SAISON -->
    <!-- ================================================= -->

    <% if (!seasons.length) { %>

      <div class="empty-state">

        Für diese Liga gibt es noch keine Saison.
        Starte den Saison-Assistenten.

      </div>

    <% } %>


    <!-- ================================================= -->
    <!-- SAISONS -->
    <!-- ================================================= -->

    <div class="setup-calendar-list">

      <% seasons.forEach((season) => { %>

        <article>


          <!-- ============================================= -->
          <!-- INFO -->
          <!-- ============================================= -->

          <div class="season-manager-card-head">

            <span>

              <%= season.status === 'active'
                ? 'AKTUELL'
                : 'HISTORISCH'
              %>

            </span>


            <strong>
              <%= season.name %>
            </strong>


            <% if (season.f1Game) { %>

              <small>
                <%= season.f1Game.name %>
              </small>

            <% } else if (season.gameName) { %>

              <small>
                Legacy-Spiel:
                <%= season.gameName %>
              </small>

            <% } %>


            <a
              href="/admin/season-setup?league=<%= league.id %>&season=<%= season.id %>"
            >
              Fahrer, Teams, Line-up und Kalender vollständig bearbeiten →
            </a>

          </div>


          <!-- ============================================= -->
          <!-- BEARBEITEN -->
          <!-- ============================================= -->

          <form
            method="post"
            action="/admin/season-manager/<%= season.id %>"
            class="setup-form setup-calendar-form"
          >


            <!-- SAISONNAME -->

            <label>

              Saisonname

              <input
                name="name"
                value="<%= season.name %>"
                required
              >

            </label>


            <!-- ========================================= -->
            <!-- F1-SPIEL -->
            <!-- ========================================= -->

            <label>

              F1-Spiel

              <select
                name="F1GameId"
              >

                <option value="">
                  Kein F1-Spiel ausgewählt
                </option>


                <% f1Games.forEach((game) => { %>

                  <option
                    value="<%= game.id %>"
                    <%= Number(season.F1GameId) === Number(game.id)
                      ? 'selected'
                      : ''
                    %>
                  >

                    <%= game.name %>

                    <%= game.isActive
                      ? ''
                      : ' · deaktiviert'
                    %>

                  </option>

                <% }) %>

              </select>


              <small>

                Das ausgewählte Spiel und dessen Logo
                werden im öffentlichen Saisonverlauf angezeigt.

                <% if (!season.F1GameId && season.gameName) { %>

                  <br>

                  Aktueller Legacy-Wert:
                  <strong>
                    <%= season.gameName %>
                  </strong>

                <% } %>

              </small>

            </label>


            <!-- STATUS -->

            <label>

              Status

              <select
                name="status"
              >

                <option
                  value="active"
                  <%= season.status === 'active'
                    ? 'selected'
                    : ''
                  %>
                >
                  Aktuelle Saison
                </option>


                <option
                  value="historical"
                  <%= season.status === 'historical'
                    ? 'selected'
                    : ''
                  %>
                >
                  Historisch
                </option>

              </select>

            </label>


            <!-- PUNKTESYSTEM -->

            <label>

              Punktesystem *

              <select
                name="PointsSchemeId"
                required
              >

                <option value="">
                  Bitte auswählen …
                </option>


                <% schemes.forEach((scheme) => { %>

                  <option
                    value="<%= scheme.id %>"
                    <%= Number(season.PointsSchemeId) === Number(scheme.id)
                      ? 'selected'
                      : ''
                    %>
                  >
                    <%= scheme.name %>
                  </option>

                <% }) %>

              </select>

            </label>


            <!-- FARBE -->

            <label>

              Farbe *

              <input
                type="color"
                name="accentColor"
                value="<%= season.accentColor || '#6ef2f2' %>"
                required
              >

            </label>


            <!-- ========================================= -->
            <!-- ÖFFENTLICH SICHTBAR -->
            <!-- ========================================= -->

            <label
              class="checkbox-control setup-option-card"
            >

              <input
                type="checkbox"
                name="isPublished"
                <%= season.isPublished
                  ? 'checked'
                  : ''
                %>
              >


              <span>

                <strong>
                  Saison öffentlich anzeigen
                </strong>


                <small>

                  Aktiv: Die Saison ist auf der öffentlichen
                  F1-Seite sichtbar und kann ausgewählt werden.

                  Deaktiviert: Die Saison und alle zugehörigen
                  Daten bleiben vollständig gespeichert,
                  werden öffentlich aber nicht angezeigt.

                </small>

              </span>

            </label>


            <!-- ========================================= -->
            <!-- ERSATZFAHRER TEAM-WM -->
            <!-- ========================================= -->

            <label
              class="checkbox-control setup-option-card"
            >

              <input
                type="checkbox"
                name="reservePointsForConstructors"
                <%= season.reservePointsForConstructors !== false
                  ? 'checked'
                  : ''
                %>
              >


              <span>

                <strong>
                  Ersatzfahrer-Punkte in Team-WM berücksichtigen
                </strong>


                <small>

                  Aktiv: Ersatzfahrer sammeln Punkte für das
                  eingesetzte Team.

                  Deaktiviert: Fahrer-Punkte bleiben bestehen,
                  zählen aber nicht zur Team-WM.

                </small>

              </span>

            </label>


            <!-- SPEICHERN -->

            <button
              class="button button-small"
            >
              Änderungen prüfen & speichern
            </button>

          </form>


          <!-- ============================================= -->
          <!-- LÖSCHEN -->
          <!-- ============================================= -->

          <form
            method="post"
            action="/admin/season-manager/<%= season.id %>?_method=DELETE"
            data-confirm="Diese Saison inklusive Kalender, Line-Up und Ergebnisse endgültig löschen?"
          >

            <button
              class="button button-ghost button-small"
            >
              Saison vollständig löschen
            </button>

          </form>


        </article>

      <% }) %>

    </div>

  </div>

</section>


<%- include('../partials/footer') %>