<%- include('partials/header', { title }) %>
<div class="league-page" style="--accent:<%= league.accentColor %>">
  <section class="league-hero">
    <div class="container">
      <% if (league.logoPath) { %><img class="league-hero-logo" src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } %>
      <span class="eyebrow">FORMEL 1 · <%= league.currentSeason %></span>
      <h1><%= league.name %></h1>
      <p><%= league.description %></p>
      <div class="facts"><span>Renntag <strong><%= league.raceDay %></strong></span><span>Start <strong><%= league.raceTime %></strong></span><span>Saison <strong><%= league.currentSeason %></strong></span></div>
    </div>
  </section>
  <section class="season-switcher container"><form method="get"><label for="season-select">Saison auswählen</label><select id="season-select" name="season"><%- include('partials/season-options', { seasons, selectedSeason }) %></select><noscript><button class="button button-small" type="submit">Saison laden</button></noscript></form></section>
  <% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/team-rosters/f1?league=<%= league.id %>">✎ Teamaufstellungen</a><a href="/admin/f1-race-lineup?league=<%= league.id %>">✎ Ersatzfahrer</a><a href="/admin/current-season-progress?league=<%= league.id %>">✎ Aktueller Saisonverlauf</a><a href="/admin/season-calendar?league=<%= league.id %>&season=<%= selectedSeason?.id || '' %>">✎ Rennkalender</a></div><% } %>

  <% if (selectedSeason?.status === 'active') { %><section class="section container">
    <div class="section-heading"><span>STARTAUFSTELLUNG</span><h2>TEAMS & FAHRER</h2></div>
    <div class="f1-team-grid"><% teams.forEach((team) => { %><article class="f1-team-card" style="--team-color:<%= team.accentColor || '#6ef2f2' %>" aria-label="<%= team.name %>"><div class="f1-team-watermark" aria-hidden="true"><% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt=""><% } else { %><strong><%= team.name %></strong><% } %></div><ul aria-label="Fahrer von <%= team.name %>"><% team.drivers.forEach((driver) => { %><li><strong><%= driver.name %></strong></li><% }) %></ul></article><% }) %></div>
    <% if (!teams.length) { %><div class="empty-state">Noch keine Teams für diese Liga angelegt.</div><% } %>
  </section><% } %>

  <section class="section container"><div class="section-heading"><span>ALLE TERMINE</span><h2>RENNKALENDER</h2></div><%- include('partials/race-calendar', { calendar, league, emptyMessage: 'Noch keine Renntermine veröffentlicht.' }) %></section>

  <section class="section section-dark">
    <div class="container standings-grid">
      <div id="f1-driver-wm"><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>FAHRER-WM</h2><div class="export-actions"><a class="download-link" href="/f1/<%= league.slug %>/download/fahrer-wm.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#f1-driver-wm" data-png-title="<%= league.name %> · Fahrer-WM" data-png-subtitle="<%= selectedSeason?.name || league.currentSeason %>" data-png-filename="<%= league.slug %>-fahrer-wm" data-png-logo="<%= league.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= league.accentColor %>">PNG ↓</button></div></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Fahrer</th><th>Team</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% driverStandings.forEach(row => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.driver.name %></td><td><%= row.driver.team ? row.driver.team.name : '–' %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div></div>
      <div id="f1-team-wm"><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>TEAM-WM</h2><div class="export-actions"><a class="download-link" href="/f1/<%= league.slug %>/download/team-wm.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#f1-team-wm" data-png-title="<%= league.name %> · Team-WM" data-png-subtitle="<%= selectedSeason?.name || league.currentSeason %>" data-png-filename="<%= league.slug %>-team-wm" data-png-logo="<%= league.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= league.accentColor %>">PNG ↓</button></div></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Team</th><th>Punkte</th><th>Siege</th><th>Gap</th></tr></thead><tbody><% teamStandings.forEach(row => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.team.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td><td><%= row.gap || '–' %></td></tr><% }) %></tbody></table></div></div>
    </div>
  </section>

  <section class="section container gp-results-section" id="f1-gp-results">
    <div class="section-heading"><span>AUTOMATISCH AUS DEM SAISONVERLAUF</span><h2>GP-ERGEBNISSE</h2><div class="export-actions"><a class="download-link" href="/f1/<%= league.slug %>/download/gp-results.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#f1-gp-results" data-png-title="<%= league.name %> · GP-Results" data-png-subtitle="<%= selectedSeason?.name || league.currentSeason %>" data-png-filename="<%= league.slug %>-gp-results" data-png-logo="<%= league.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= league.accentColor %>">PNG ↓</button></div></div>
    <%- include('partials/gp-results', { items: gpResults, label: 'Grand-Prix-Ergebnisse' }) %>
  </section>

  <section class="section section-dark season-history-section" id="season-history">
    <div class="container">
      <div class="section-heading"><span>VOM AUFTAKT BIS ZUM FINALE</span><h2>SAISONVERLAUF</h2></div>
      <%- include('partials/season-history', { history, selectedHistory, league }) %>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
