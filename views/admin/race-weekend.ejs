<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container"><div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">OPERATIVER PROZESS</span><h1>RENNWOCHENENDE</h1><p class="admin-intro">Ein klarer Ablauf: Aufstellung, Anwesenheit und danach Ergebnisse. Die ausgewählte Saison liefert Fahrer, Teams und Punkte.</p></div></div>
<form class="race-selector" method="get"><label>Liga<select name="league" onchange="this.form.submit()"><% leagues.forEach((item) => { %><option value="<%= item.id %>" <%= league?.id === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Saison<select name="season" onchange="this.form.submit()"><% seasons.forEach((item) => { %><option value="<%= item.id %>" <%= season?.id === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Rennen<select name="event" onchange="this.form.submit()"><% events.forEach((item) => { %><option value="<%= item.id %>" <%= event?.id === item.id ? 'selected' : '' %>><%= item.title %></option><% }) %></select></label></form>
<div class="setup-choice-grid"><a class="setup-choice" href="<%= lineupHref %>" style="--setup-accent:#6ef2f2"><span>SCHRITT 1</span><strong>Aufstellung</strong><small>Stammfahrer, Ersatzfahrer und Unsicherheitsstatus.</small></a><a class="setup-choice" href="/admin/penalty-ledger?league=<%= league?.id || '' %>" style="--setup-accent:#e91e63"><span>SCHRITT 2</span><strong>Anwesenheit & Strafen</strong><small>Unabgemeldet und verspätete Abmeldung direkt dokumentieren.</small></a><a class="setup-choice" href="<%= resultsHref %>" style="--setup-accent:#a7ff28"><span>SCHRITT 3</span><strong>Ergebnisse</strong><small>Plätze eingeben; Punkte und Standings werden automatisch berechnet.</small></a></div>
</div></section><%- include('../partials/footer') %>
