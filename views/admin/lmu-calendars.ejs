<%- include('../partials/header',{title}) %><section class="admin-shell"><div class="container"><%- include('../partials/lmu-admin-heading',{title}) %>
<p>Ein Kalender als Vorlage für mehrere Saisons. Änderungen an der Vorlage verändern bereits erstellte Saisons nicht. Deren Termine lassen sich auf der Ligaseite bearbeiten.</p>
<form method="get" class="lmu-picker"><label>Kalender<select name="calendar"><option value="">Neuen Kalender anlegen</option><% calendars.forEach(c=>{ %><option value="<%= c.id %>" <%= selected?.id===c.id?'selected':'' %>><%= c.name %></option><% }); %></select></label><button class="button">Öffnen</button></form>
<% const form=draft||selected||{}; const rounds=draft?Object.values(draft.rounds||{}):(selected?.rounds||[{}]); %>
<form action="/admin/lmu-calendars<%= selected?'/'+selected.id:'' %>" method="post" class="resource-form" data-lmu-calendar>
<label>Kalendername<input name="name" value="<%= form.name||'' %>" required maxlength="255"></label><label><input type="checkbox" name="isActive" <%= !selected||form.isActive?'checked':'' %>> Für neue Saisons auswählbar</label>
<div data-lmu-rounds><% rounds.forEach((row,index)=>{ %><div class="lmu-calendar-round" data-lmu-round><strong data-round-label>Termin <%= index+1 %></strong><label>Titel<input name="rounds[r<%= index %>][title]" data-field="title" value="<%= row.title||'' %>" required maxlength="255"></label><label>Strecke<input name="rounds[r<%= index %>][circuit]" data-field="circuit" value="<%= row.circuit||'' %>" required maxlength="255"></label><label>Datum / Uhrzeit (Berlin)<input type="datetime-local" name="rounds[r<%= index %>][startsAt]" data-field="startsAt" value="<%= draft?row.startsAt||'':localDateTime(row.startsAt) %>" required></label><label><input type="checkbox" name="rounds[r<%= index %>][isTestDay]" data-field="isTestDay" <%= row.isTestDay?'checked':'' %>> Testtag (ohne Wertung)</label><div><button type="button" data-round-up aria-label="Termin nach oben">↑</button><button type="button" data-round-down aria-label="Termin nach unten">↓</button><button type="button" data-round-remove>Entfernen</button></div></div><% }); %></div>
<button type="button" class="button button-ghost" data-round-add>+ Termin hinzufügen</button><button class="button">Kalender speichern</button></form>
<% if(selected){ %><form method="post" action="/admin/lmu-calendars/<%= selected.id %>/delete" data-confirm="Kalendervorlage löschen?"><button class="button button-ghost">Vorlage löschen</button></form><% } %>
</div></section><script src="/js/lmu-admin.js" defer></script><%- include('../partials/footer') %>
