<%- include('../partials/header',{title}) %><section class="admin-shell"><div class="container"><%- include('../partials/lmu-admin-heading',{title}) %><%- include('../partials/lmu-season-picker') %>
<% if(league){const today=new Date().toISOString().slice(0,10),limit=setting?.pointsLimit||12; %><form method="post" action="/admin/lmu-penalty-ledger/settings" class="lmu-picker"><input type="hidden" name="LeagueId" value="<%= league.id %>"><label>Strafpunktelimit<input type="number" min="1" step="1" name="pointsLimit" value="<%= limit %>" required></label><button class="button">Limit speichern</button></form><p>Strafpunkte gelten ein Jahr. Fahrer am Limit werden hervorgehoben; eine Rennsperre wird einer konkreten Runde zugeordnet und dort automatisch im Rennwochenende berücksichtigt.</p>
<div class="table-wrap"><table><thead><tr><th>Fahrer</th><th>Aktive Strafpunkte</th><th>Status</th></tr></thead><tbody><% drivers.forEach(driver=>{const total=entries.filter(e=>e.DriverId===driver.id&&!e.isRaceBan&&e.awardedOn<=today&&(!e.expiresOn||e.expiresOn>=today)).reduce((n,e)=>n+Number(e.points),0); %><tr class="<%= total>=limit?'lmu-penalty-limit':'' %>"><td><%= driver.lmuDisplayName||driver.name %></td><td><%= total %> / <%= limit %></td><td><%= total>=limit?'Limit erreicht · Rennsperre zuordnen':'–' %></td></tr><% }); %></tbody></table></div>
<% if(season){ %><form class="resource-form" method="post" action="/admin/lmu-penalty-ledger"><h2>Strafe eintragen</h2><input type="hidden" name="SeasonId" value="<%= season.id %>"><label>Fahrer<select name="DriverId" required><% drivers.forEach(driver=>{ %><option value="<%= driver.id %>"><%= driver.lmuDisplayName||driver.name %></option><% }); %></select></label><label>Runde<select name="roundNumber" required><% rounds.forEach(r=>{ %><option value="<%= r.sortOrder %>">R<%= r.sortOrder %> · <%= r.title %></option><% }); %></select></label><label>Datum<input type="date" name="awardedOn" value="<%= today %>" required></label><label>Strafpunkte<input type="number" name="points" min="0" step="1" value="0"></label><label><input type="checkbox" name="isRaceBan"> Rennsperre für die gewählte Runde (statt Strafpunkten)</label><label>Begründung<input name="reason" maxlength="255"></label><button class="button">Strafe speichern</button></form><% } %>
<div class="table-wrap"><table><thead><tr><th>Fahrer</th><th>Saison / Runde</th><th>Strafe</th><th>Grund</th><th>Datum / Ablauf</th><th></th></tr></thead><tbody><% entries.forEach(entry=>{ %><tr><td><%= entry.driver?.name||'Fahrer #'+entry.DriverId %></td><td><%= entry.season?.name||'' %> · R<%= entry.roundNumber %></td><td><%= entry.isRaceBan?'Rennsperre':entry.points+' SP' %></td><td><%= entry.reason %></td><td><%= entry.awardedOn %> / <%= entry.expiresOn %></td><td><form method="post" action="/admin/lmu-penalty-ledger/<%= entry.id %>/delete" data-confirm="Diese Strafe löschen?"><button>Entfernen</button></form></td></tr><% }); %></tbody></table></div><% } %>
</div></section><%- include('../partials/footer') %>
