<% const safeStandingsHistory = typeof standingsHistory === 'undefined' ? [] : standingsHistory; const findPublicTeam = name => teams.find(t => String(t.name).trim().toLowerCase() === String(name).trim().toLowerCase()) || null; %>
  <section
    class="section section-dark standings-history-section"
    id="f1-standings-history"
  >

    <div class="container">

      <div class="section-heading">

        <span>
          AUTOMATISCH BERECHNET
        </span>

        <h2>
          WM-STÄNDE
        </h2>

        <div class="export-actions">



        </div>

      </div>


      <% if (safeStandingsHistory.length) { %>

        <div
          class="standings-history-carousel standings-history-carousel-wide"
          data-standings-history
        >

          <div class="standings-history-track">


            <% safeStandingsHistory.forEach((snapshot, snapshotIndex) => {

              const raceDisplay =
                (gpResults || []).find(
                  (race) =>
                    race.raceType === 'main' &&
                    Number(race.sortOrder) ===
                    Number(snapshot.round)
                ) || null;


              const displayTitle =
                raceDisplay?.displayTitle ||
                snapshot.title ||
                `Runde ${snapshot.round}`;


              const displayCircuit =
                raceDisplay?.circuit ||
                snapshot.circuit ||
                '';


              const displayDate =
                raceDisplay?.raceDate ||
                snapshot.raceDate ||
                '';


              const displayFlag =
                raceDisplay?.countryFlagPath ||
                raceDisplay?.trackLogoPath ||
                null;


              const displayCountry =
                raceDisplay?.countryName ||
                String(displayTitle)
                  .replace(
                    /gro(?:ss|ß)er preis (?:von|der)\s*/i,
                    ''
                  )
                  .trim();


              const driverSplit =
                Math.ceil(
                  snapshot.driverStandings.length / 2
                );

              const driverLeft =
                snapshot.driverStandings.slice(
                  0,
                  driverSplit
                );

              const driverRight =
                snapshot.driverStandings.slice(
                  driverSplit
                );


              const teamSplit =
                Math.ceil(
                  snapshot.teamStandings.length / 2
                );

              const teamLeft =
                snapshot.teamStandings.slice(
                  0,
                  teamSplit
                );

              const teamRight =
                snapshot.teamStandings.slice(
                  teamSplit
                );

            %>


              <article
                class="standings-history-slide standings-history-slide-wide <%= snapshotIndex === safeStandingsHistory.length - 1 ? 'is-active' : '' %>"
                data-slide-label="WM nach R<%= snapshot.round %> · <%= displayTitle %>"
                data-standings-slide
                data-slide-index="<%= snapshotIndex %>"
                aria-hidden="<%= snapshotIndex === safeStandingsHistory.length - 1 ? 'false' : 'true' %>"
              >


                <!-- ===================================== -->
                <!-- HEADER -->
                <!-- ===================================== -->

                <header class="standing-gp-header standing-gp-header-wide">

                  <div class="standing-gp-league">

                    <% if (league.logoPath) { %>

                      <img
                        src="<%= league.logoPath %>"
                        alt="<%= league.name %>"
                      >

                    <% } else { %>

                      <strong>
                        KRL
                      </strong>

                    <% } %>

                  </div>


                  <div class="standing-gp-title">

                    <span>
                      WM-STAND NACH RUNDE <%= snapshot.round %>
                    </span>

                    <h3>
                      <%= displayTitle %>
                    </h3>

                    <small>

                      <%= displayCircuit %>

                      <% if (displayDate) { %>
                        · <%= displayDate %>
                      <% } %>

                      · <%= selectedSeason?.name || league.currentSeason %>

                    </small>

                  </div>


                  <div class="standing-gp-flag">

                    <% if (displayFlag) { %>

                      <img
                        src="<%= displayFlag %>"
                        alt="<%= displayCountry || displayTitle %>"
                        title="<%= displayCountry || displayTitle %>"
                      >

                    <% } else { %>

                      <span>
                        <%= String(displayCountry || '')
                          .slice(0, 3)
                          .toUpperCase() || 'GP'
                        %>
                      </span>

                    <% } %>

                  </div>

                </header>


                <% if (snapshot.hasSprint) { %>

                  <div class="standing-weekend-note">
                    Sprint + Hauptrennen in diesem WM-Stand berücksichtigt
                  </div>

                <% } %>


                <!-- ===================================== -->
                <!-- FAHRER + TEAM -->
                <!-- ===================================== -->

                <div class="standing-wide-grid">


                  <!-- =================================== -->
                  <!-- FAHRER-WM -->
                  <!-- =================================== -->

                  <section class="standing-wide-card">

                    <header class="standing-wide-heading">

                      <div>

                        <span>
                          FAHRER
                        </span>

                        <h4>
                          FAHRER-WM
                        </h4>

                      </div>

                      <strong>
                        NACH R<%= snapshot.round %>
                      </strong>

                    </header>


                    <div class="standing-wide-columns">


                      <!-- FAHRER LINKS -->

                      <div class="standing-wide-column">

                        <% driverLeft.forEach((row) => {

                          const standingTeam =
                            findPublicTeam(
                              row.team
                            );


                          const standingLogo =
                            standingTeam?.logoPath ||
                            row.teamLogoPath ||
                            null;


                          const standingColor =
                            standingTeam?.standingsColor || standingTeam?.accentColor ||
                            league.accentColor ||
                            '#6ef2f2';

                        %>


                          <div
                            class="standing-wide-row"
                            style="--standing-team-color:<%= standingColor %>"
                          >

                            <div class="standing-wide-position">
                              <%= row.position %>
                            </div>


                            <div class="standing-wide-team">

                              <% if (standingLogo) { %>

                                <img
                                  src="<%= standingLogo %>"
                                  alt="<%= row.team || 'Team' %>"
                                  title="<%= row.team || '' %>"
                                >

                              <% } else { %>

                                <span>
                                  <%= row.team || '–' %>
                                </span>

                              <% } %>

                            </div>


                            <div class="standing-wide-name"><a class="standing-profile-link" href="/krl-statistik?driver=<%= row.id %>"><%= row.name %></a></div>


                            <div class="standing-wide-points">
                              <%= row.points %>
                            </div>

                          </div>

                        <% }) %>

                      </div>


                      <!-- FAHRER RECHTS -->

                      <div class="standing-wide-column">

                        <% driverRight.forEach((row) => {

                          const standingTeam =
                            findPublicTeam(
                              row.team
                            );


                          const standingLogo =
                            standingTeam?.logoPath ||
                            row.teamLogoPath ||
                            null;


                          const standingColor =
                            standingTeam?.standingsColor || standingTeam?.accentColor ||
                            league.accentColor ||
                            '#6ef2f2';

                        %>


                          <div
                            class="standing-wide-row"
                            style="--standing-team-color:<%= standingColor %>"
                          >

                            <div class="standing-wide-position">
                              <%= row.position %>
                            </div>


                            <div class="standing-wide-team">

                              <% if (standingLogo) { %>

                                <img
                                  src="<%= standingLogo %>"
                                  alt="<%= row.team || 'Team' %>"
                                  title="<%= row.team || '' %>"
                                >

                              <% } else { %>

                                <span>
                                  <%= row.team || '–' %>
                                </span>

                              <% } %>

                            </div>


                            <div class="standing-wide-name"><a class="standing-profile-link" href="/krl-statistik?driver=<%= row.id %>"><%= row.name %></a></div>


                            <div class="standing-wide-points">
                              <%= row.points %>
                            </div>

                          </div>

                        <% }) %>

                      </div>

                    </div>

                  </section>


                  <!-- =================================== -->
                  <!-- TEAM-WM -->
                  <!-- =================================== -->

                  <section class="standing-wide-card">

                    <header class="standing-wide-heading">

                      <div>

                        <span>
                          TEAMS
                        </span>

                        <h4>
                          TEAM-WM
                        </h4>

                      </div>

                      <strong>
                        NACH R<%= snapshot.round %>
                      </strong>

                    </header>


                    <div class="standing-wide-columns">


                      <!-- TEAM LINKS -->

                      <div class="standing-wide-column">

                        <% teamLeft.forEach((row) => {

                          const standingTeam =
                            findPublicTeam(
                              row.name
                            );


                          const standingColor =
                            standingTeam?.standingsColor || standingTeam?.accentColor ||
                            league.accentColor ||
                            '#6ef2f2';

                        %>


                          <div
                            class="standing-wide-row standing-wide-team-row"
                            style="--standing-team-color:<%= standingColor %>"
                          >

                            <div class="standing-wide-position">
                              <%= row.position %>
                            </div>


                            <div class="standing-wide-team">

                              <% if (standingTeam?.logoPath) { %>

                                <img
                                  src="<%= standingTeam.logoPath %>"
                                  alt="<%= row.name %>"
                                  title="<%= row.name %>"
                                >

                              <% } else { %>

                                <span>
                                  <%= row.name %>
                                </span>

                              <% } %>

                            </div>


                            <div class="standing-wide-name"><a class="standing-profile-link" href="<%= league.type === 'lmu' ? '/lmu?league=' : '/krl-statistik/team?league=' %><%= encodeURIComponent(league.slug) %>&amp;season=<%= selectedSeason?.id || "" %>&amp;team=<%= encodeURIComponent(row.name) %>"><%= row.name %></a></div>


                            <div class="standing-wide-points">
                              <%= row.points %>
                            </div>

                          </div>

                        <% }) %>

                      </div>


                      <!-- TEAM RECHTS -->

                      <div class="standing-wide-column">

                        <% teamRight.forEach((row) => {

                          const standingTeam =
                            findPublicTeam(
                              row.name
                            );


                          const standingColor =
                            standingTeam?.standingsColor || standingTeam?.accentColor ||
                            league.accentColor ||
                            '#6ef2f2';

                        %>


                          <div
                            class="standing-wide-row standing-wide-team-row"
                            style="--standing-team-color:<%= standingColor %>"
                          >

                            <div class="standing-wide-position">
                              <%= row.position %>
                            </div>


                            <div class="standing-wide-team">

                              <% if (standingTeam?.logoPath) { %>

                                <img
                                  src="<%= standingTeam.logoPath %>"
                                  alt="<%= row.name %>"
                                  title="<%= row.name %>"
                                >

                              <% } else { %>

                                <span>
                                  <%= row.name %>
                                </span>

                              <% } %>

                            </div>


                            <div class="standing-wide-name"><a class="standing-profile-link" href="<%= league.type === 'lmu' ? '/lmu?league=' : '/krl-statistik/team?league=' %><%= encodeURIComponent(league.slug) %>&amp;season=<%= selectedSeason?.id || "" %>&amp;team=<%= encodeURIComponent(row.name) %>"><%= row.name %></a></div>


                            <div class="standing-wide-points">
                              <%= row.points %>
                            </div>

                          </div>

                        <% }) %>

                      </div>

                    </div>

                  </section>

                </div>

              </article>

            <% }) %>

          </div>


          <!-- =========================================== -->
          <!-- CAROUSEL -->
          <!-- =========================================== -->

          <% if (safeStandingsHistory.length > 1) { %>

            <button
              class="standings-history-control prev"
              type="button"
              data-standings-prev
              aria-label="Vorheriger WM-Stand"
            >
              ‹
            </button>


            <button
              class="standings-history-control next"
              type="button"
              data-standings-next
              aria-label="Nächster WM-Stand"
            >
              ›
            </button>


            <div class="standings-history-dots">

              <% safeStandingsHistory.forEach((snapshot, index) => { %>

                <button
                  type="button"
                  class="<%= index === safeStandingsHistory.length - 1 ? 'is-active' : '' %>"
                  data-standings-dot="<%= index %>"
                  aria-label="WM-Stand nach Runde <%= snapshot.round %>"
                  title="Runde <%= snapshot.round %>"
                ></button>

              <% }) %>

            </div>

          <% } %>

        </div>


      <% } else { %>

        <div class="empty-state">

          Sobald das erste Hauptrennen ein Ergebnis besitzt,
          erscheint hier der WM-Stand nach diesem Grand Prix.

        </div>

      <% } %>

    </div>

  </section>


