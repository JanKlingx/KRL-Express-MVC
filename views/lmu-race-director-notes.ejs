<%- include('partials/header', { title }) %>
<section class="league-hero notes-hero"><div class="container"><span class="eyebrow">OFFIZIELLE DOKUMENTE</span><h1>RACE-DIRECTOR <span>NOTES</span></h1><p>Die aktuelle Rennleiter-Information als Vorschau und alle früheren Ausgaben zum Download.</p></div></section>
<section class="section container"><% if (!documents.length) { %><div class="empty-state">Noch keine Race-Director Notes veröffentlicht.</div><% } else { const latest = documents[0]; %><article class="latest-document"><header><div><span>NEUESTE AUSGABE</span><h2><%= latest.title %></h2><small><%= new Intl.DateTimeFormat('de-DE').format(new Date(`${latest.publishedAt}T12:00:00Z`)) %></small></div><a class="button" href="<%= latest.documentPath %>" download>PDF herunterladen</a></header><iframe src="<%= latest.documentPath %>#toolbar=0" title="Vorschau: <%= latest.title %>"></iframe></article><div class="document-archive"><h2>ÄLTERE DOKUMENTE</h2><% documents.slice(1).forEach((document) => { %><a href="<%= document.documentPath %>" download><span><strong><%= document.title %></strong><small><%= new Intl.DateTimeFormat('de-DE').format(new Date(`${document.publishedAt}T12:00:00Z`)) %></small></span><b>PDF ↓</b></a><% }) %></div><% } %></section>
<%- include('partials/footer') %>
