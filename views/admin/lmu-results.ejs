<%- include('../partials/header',{title}) %>
<section class="admin-shell"><div class="container"><div class="admin-heading"><div><a class="back-link" href="/admin/race-weekend/lmu?season=<%= details.season.id %>&amp;event=<%= details.race.id %>">← Rennwochenende</a><span class="form-kicker">LMU · ERGEBNISPFLEGE</span><h1>ERGEBNIS EINTRAGEN</h1><p class="admin-intro">R<%= details.race.sortOrder %> · <%= details.race.title %></p></div></div>
<% if(!details.entries.length||details.entries.some(e=>!e.attendanceStatus)){ %><p class="empty-state">Bitte zuerst Aufstellung und Anwesenheit bestätigen.</p><% }else{ %>
<form class="race-sheet-form" method="post" action="/admin/lmu-weekends/<%= details.race.id %>/results" data-lmu-results>
<input type="hidden" name="version" value="<%= details.version %>"><div class="race-sheet-heading"><div><span>HAUPTRENNEN</span><h2>PLATZIERUNGEN UND AUSZEICHNUNGEN</h2><p>Punkte werden aus dem Saison-Punktesystem berechnet. Pole Position, schnellste Runde und Driver of the Day jeweils bei einem Fahrer markieren.</p></div><button class="button">ERGEBNIS SPEICHERN</button></div>
<div class="lineup-team-grid"><% details.teams.forEach(team=>{ const entries=details.entries.filter(e=>e.SeasonTeamId===team.id); if(!entries.length)return; %><article class="lineup-team-card" style="--team-color:<%= team.accentColor %>"><header><% if(team.logoPath){ %><img src="<%= team.logoPath %>" alt=""><% } %><div><h3><%= team.name %></h3></div></header><div class="lineup-regular-list">
<% entries.forEach(entry=>{const result=details.results.find(r=>r.DriverId===entry.DriverId); const participates=entry.includeInResults&&!details.penalty.banned.has(entry.DriverId); %><div class="result-driver-row" data-lmu-result-row><div class="result-driver-head"><div class="lineup-driver-name"><strong><%= displayName(entry.driver) %></strong><small><%= entry.roleType==='reserve'?'Ersatzfahrer':'Stammfahrer' %></small></div></div><% if(!participates){ %><p><%= entry.status==='rennsperre'||details.penalty.banned.has(entry.DriverId)?'S · Rennsperre':'DNS · Nicht gestartet' %></p><% }else{ %><div class="result-driver-controls">
<label class="result-field"><span>Platz</span><input type="number" min="1" step="1" required name="results[d<%= entry.DriverId %>][position]" value="<%= result?.position||'' %>" data-result-position></label>
<label class="result-field"><span>Status</span><select name="results[d<%= entry.DriverId %>][status]" data-result-status><% [['','Im Ziel'],['DNF','DNF'],['DSQ','DSQ']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (result?.status||'')===value?'selected':'' %>><%= label %></option><% }); %></select></label>
<% [['fastestLap','Schnellste Runde'],['polePosition','Pole Position'],['driverOfTheDay','Driver of the Day']].forEach(([key,label])=>{ %><label class="result-checkbox result-fastest"><input type="checkbox" name="results[d<%= entry.DriverId %>][<%= key %>]" data-award="<%= key %>" <%= result?.[key]?'checked':'' %>><span><%= label %></span></label><% }); %>
<label class="result-field"><span>Punkte inkl. Boni</span><output data-result-points><%= result?Number(result.points):'–' %></output></label></div><% } %></div><% }); %>
</div></article><% }); %></div><button class="button">ERGEBNIS SPEICHERN</button>
<script type="application/json" data-lmu-points><%- JSON.stringify({allocations:details.scheme?.allocations||[],fastestLapEnabled:details.scheme?.fastestLapEnabled,fastestLapPoints:details.scheme?.fastestLapPoints,polePositionEnabled:details.scheme?.polePositionEnabled,polePositionPoints:details.scheme?.polePositionPoints}).replace(/</g,'\\u003c') %></script>
</form><% } %></div></section><script src="/js/lmu-results.js" defer></script><%- include('../partials/footer') %>
