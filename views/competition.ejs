<%- include('partials/header', { title }) %>
<section class="league-hero competition-hero"><div class="container"><span class="eyebrow">DAS COMMUNITY-EVENT · <%= selectedSeason?.name || '' %></span><h1>WETTKAMPF<br><span>DER LIGEN</span></h1><p><%= pageLeague.description %></p><div class="facts"><span>Ligen <strong><%= leagues.length %></strong></span><span>Fahrer <strong>2 pro Liga</strong></span><span>Rennen <strong><%= races.length %></strong></span><span>Start <strong><%= pageLeague.raceTime %></strong></span></div></div></section>
<section class="season-switcher container"><form method="get"><label for="season-select">Saison auswählen</label><select id="season-select" name="season"><% seasons.forEach((season) => { %><option value="<%= season.id %>" <%= selectedSeason?.id === season.id ? 'selected' : '' %>><%= season.name %><%= season.status === 'active' ? ' · Aktiv' : ' · Historisch' %></option><% }) %></select><noscript><button class="button button-small" type="submit">Saison laden</button></noscript></form></section>
<% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/participatingLeagues">✎ WDL-Ligen</a><a href="/admin/wdlSeasonCalendar">✎ Rennkalender</a><a href="/admin/wdlResultEntries">✎ Saisonverlauf</a><a href="/admin/seasons">✎ Saisons</a></div><% } %>

<section class="section container"><div class="section-heading"><span>DIE HERAUSFORDERER</span><h2>TEILNEHMENDE LIGEN</h2></div><div class="league-grid"><% leagues.forEach((league) => { %><article class="league-card red"><% if (league.logoPath) { %><img class="league-logo" src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } %><div class="league-badge"><%= league.abbreviation || 'LIGA' %></div><h3><%= league.name %></h3><p><%= league.f1Team ? `F1-Team: ${league.f1Team.name}` : (league.constructorName || 'F1-Team offen') %></p><% if (league.websiteUrl) { %><a href="<%= league.websiteUrl %>" target="_blank" rel="noopener">Liga besuchen →</a><% } %></article><% }) %></div></section>

<section class="section section-dark"><div class="container"><div class="section-heading"><span>SAISONTERMINE</span><h2>WDL-RENNKALENDER</h2></div><div class="calendar-grid"><% calendar.forEach((race) => { %><article class="calendar-card"><time datetime="<%= race.startsAt.toISOString() %>"><%= new Intl.DateTimeFormat('de-DE', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', timeZone:'Europe/Berlin' }).format(race.startsAt) %></time><h3><%= race.title %></h3><p><%= race.circuit %></p></article><% }) %><% if (!calendar.length) { %><div class="empty-state">Für diese Saison wurde noch kein Kalender veröffentlicht.</div><% } %></div></div></section>

<section class="section container"><div class="section-heading"><span>AUTOMATISCH BERECHNET</span><h2>LIGA-STANDINGS</h2><div><a class="download-link" href="/wettkampf-der-ligen/download/standings.csv?season=<%= selectedSeason?.id || '' %>" download>Standings (.csv) ↓</a> <button class="button button-small" type="button" data-wdl-export>PNG-Export</button></div></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Liga</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% standings.forEach((row) => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.league.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div><div class="wdl-chart" aria-label="Punktediagramm"><% const maxPoints = Math.max(1, ...standings.map((row) => row.points)); standings.forEach((row) => { %><div class="wdl-chart-row"><span><%= row.league.abbreviation || row.league.name %></span><div><i style="width:<%= Math.max(2, row.points / maxPoints * 100) %>%"></i></div><strong><%= row.points %></strong></div><% }) %></div></section>

<section class="section section-dark"><div class="container"><div class="section-heading"><span>ALLE EINZELERGEBNISSE</span><h2>WDL-RESULTS</h2><a class="download-link" href="/wettkampf-der-ligen/download/results.csv?season=<%= selectedSeason?.id || '' %>" download>Results (.csv) ↓</a></div><% races.forEach((race) => { %><article class="wdl-result"><h3>R<%= race.sortOrder %> · <%= race.title %></h3><div class="table-wrap"><table><thead><tr><th>Liga</th><th>Fahrer 1</th><th>Platz</th><th>Fahrer 2</th><th>Platz</th><th>Punkte</th></tr></thead><tbody><% race.wdlEntries.forEach((entry) => { %><tr><td><%= entry.participatingLeague?.name || '–' %></td><td><%= entry.driverOne?.name || '–' %></td><td><%= entry.positionOne || '–' %></td><td><%= entry.driverTwo?.name || '–' %></td><td><%= entry.positionTwo || '–' %></td><td><strong><%= Number(entry.totalPoints) %></strong></td></tr><% }) %></tbody></table></div></article><% }) %><% if (!races.length) { %><div class="empty-state">Noch keine WDL-Ergebnisse für diese Saison.</div><% } %></div></section>

<script type="application/json" id="wdl-export-data"><%- JSON.stringify({ season: selectedSeason?.name || '', logo: pageLeague.logoPath || '/images/krl-placeholder.svg', standings: standings.map((row) => ({ position: row.position, name: row.league.name, points: row.points })) }).replace(/</g, '\\u003c') %></script>
<%- include('partials/footer') %>
