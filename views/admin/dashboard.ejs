<%- include('../partials/header', { title }) %>
<section class="admin-shell">
  <div class="container">
    <div class="admin-heading">
      <div>
        <span class="eyebrow"><%= dashboardEyebrow %></span>
        <h1><%= dashboardTitle %></h1>
        <p class="admin-intro"><%= dashboardDescription %></p>
      </div>
      <form method="post" action="<%= adminBasePath %>/logout"><button class="button button-ghost" type="submit">Abmelden</button></form>
    </div>

    <section class="admin-group"><div class="admin-group-heading"><h2>Schnelle Renneingabe</h2><span>Google-Sheets-ähnlich</span></div><div class="admin-grid"><a class="admin-card admin-card-featured" href="/admin/race-editor"><span>Teamaufstellung automatisch übernehmen</span><h3>Tabellarischer Saisonverlauf</h3><p>Liga und Kalenderrennen auswählen und das komplette Ergebnis in einer Tabelle erfassen.</p><small>Tabelle öffnen →</small></a></div></section>

    <% groups.forEach((group) => { %>
      <section class="admin-group" aria-labelledby="group-<%= group.name.replace(/\W+/g, '-').toLowerCase() %>">
        <div class="admin-group-heading">
          <h2 id="group-<%= group.name.replace(/\W+/g, '-').toLowerCase() %>"><%= group.name %></h2>
          <span><%= group.modules.length %> Bereiche</span>
        </div>
        <div class="admin-grid">
          <% group.modules.forEach(([key, config]) => { %>
            <a class="admin-card" href="<%= adminBasePath %>/<%= key %>">
              <span><%= counts[key] %> Einträge</span>
              <h3><%= config.title %></h3>
              <p><%= config.description %></p>
              <small>Öffnen und bearbeiten →</small>
            </a>
          <% }) %>
        </div>
      </section>
    <% }) %>
  </div>
</section>
<%- include('../partials/footer') %>
