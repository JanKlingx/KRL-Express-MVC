<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">LMU · aktuelle Saison</span><h1>LMU-FAHREREINTEILUNG</h1><p class="admin-intro">LMU-Stammfahrer aus den Team-Cockpits und LMU-Ersatzfahrer für das ausgewählte Rennen einteilen. Der gepflegte LMU-Anzeigename wird überall in dieser Transaktion verwendet.</p></div><div class="lineup-heading-actions"><a class="button button-ghost" href="/admin/drivers?rank=lmu-regular">LMU-Fahrer pflegen</a><a class="button button-ghost" href="/admin/team-rosters/lmu">LMU-Teams</a></div></div>

  <% if (league) { %><form class="lineup-selector" method="get" action="/admin/lmu-race-lineup"><label>LMU-Liga<input value="<%= league.name %>" readonly></label><label>Aktuelles Rennen<select name="race"><% races.forEach((race) => { %><option value="<%= race.id %>" <%= selectedRace?.id === race.id ? 'selected' : '' %>>R<%= race.sortOrder %> · <%= race.title %><%= race.raceDate ? ` · ${new Intl.DateTimeFormat('de-DE').format(new Date(`${race.raceDate}T12:00:00Z`))}` : '' %></option><% }) %></select></label><noscript><button class="button button-small" type="submit">Öffnen</button></noscript></form><% } %>

  <% if (!activeSeason) { %><div class="empty-state">Für LMU ist keine aktuelle Saison angelegt.</div>
  <% } else if (!selectedRace) { %><div class="empty-state">In <%= activeSeason.name %> ist noch kein Rennen vorhanden. Lege zuerst den saisonbezogenen Rennkalender an.</div>
  <% } else { %>
    <div class="lineup-race-heading"><div><span><%= activeSeason.name %> · R<%= selectedRace.sortOrder %></span><h2><%= selectedRace.title %></h2><p><%= selectedRace.circuit || '' %></p></div><span class="lineup-plan-state"><%= hasSavedPlan ? 'Einteilung gespeichert' : 'Noch nicht gespeichert' %></span></div>
    <form method="post" action="/admin/lmu-race-lineup/<%= selectedRace.id %>" class="lineup-board">
      <section class="lineup-section reserve-section"><div class="lineup-section-heading"><div><span>RANG: LMU ERSATZFAHRER</span><h2>ERSATZFAHRER</h2></div><p>Für dieses Rennen verfügbar</p></div><div class="status-legend"><% reserveStatuses.forEach((status) => { %><span class="status-<%= status.value %>"><%= status.label %></span><% }) %></div>
        <% if (!reserveRows.length) { %><div class="empty-state">Noch keine LMU-Ersatzfahrer angelegt.</div><% } else { %><div class="reserve-driver-grid"><% reserveRows.forEach((row) => { %><article class="reserve-driver-card"><div><strong>#<%= row.driver.id %> · <%= displayName(row.driver) %></strong><small><%= row.driver.lmuCar ? `${row.driver.lmuCar.manufacturer} ${row.driver.lmuCar.name} · ` : '' %><%= row.driver.platform %></small></div><label>Status<select name="reserve[<%= row.driver.id %>][status]" class="lineup-status status-<%= row.status %>" data-lineup-status><% reserveStatuses.forEach((status) => { %><option value="<%= status.value %>" <%= row.status === status.value ? 'selected' : '' %>><%= status.label %></option><% }) %></select></label><p><span>Einteilung</span><strong><%= row.assignedTo ? `${row.assignedTo.team.name} · für ${displayName(row.assignedTo.driver)}` : 'Noch nicht zugeteilt' %></strong></p></article><% }) %></div><% } %>
      </section>

      <section class="lineup-section regular-section"><div class="lineup-section-heading"><div><span>FAHREREINTEILUNG FÜR DAS RENNEN</span><h2>LMU-STAMMFAHRER JE TEAM</h2></div><p>Ersatz direkt einem Cockpitplatz zuordnen</p></div><div class="status-legend"><% regularStatuses.forEach((status) => { %><span class="status-<%= status.value %>"><%= status.label %></span><% }) %></div>
        <div class="lineup-team-grid"><% teamCards.forEach((card) => { %><article class="lineup-team-card"><header><% if (card.team.logoPath) { %><img src="<%= card.team.logoPath %>" alt="Logo <%= card.team.name %>"><% } else { %><div class="roster-logo-fallback"><%= card.team.name.slice(0, 2).toUpperCase() %></div><% } %><div><span><%= card.team.lmuCar ? `${card.team.lmuCar.manufacturer} ${card.team.lmuCar.name}` : 'LMU-Team' %></span><h3><%= card.team.name %></h3></div></header><div class="lineup-regular-list"><% card.rows.forEach((row) => { %><div class="lineup-regular-row"><div class="lineup-driver-name"><strong>#<%= row.driver.id %> · <%= displayName(row.driver) %></strong><small><%= row.driver.lmuCar ? `${row.driver.lmuCar.manufacturer} ${row.driver.lmuCar.name} · ` : '' %><%= row.driver.platform %></small></div><label>Status<select name="regular[<%= row.driver.id %>][status]" class="lineup-status status-<%= row.status %>" data-lineup-status><% regularStatuses.forEach((status) => { %><option value="<%= status.value %>" <%= row.status === status.value ? 'selected' : '' %>><%= status.label %></option><% }) %></select></label><label>Ersatzfahrer<select name="regular[<%= row.driver.id %>][ReplacementDriverId]"><option value="">Kein Ersatz</option><% reserves.forEach((reserve) => { %><option value="<%= reserve.id %>" <%= row.replacementDriverId === reserve.id ? 'selected' : '' %>><%= displayName(reserve) %></option><% }) %></select></label></div><% }) %></div></article><% }) %></div>
      </section>
      <div class="lineup-save-bar"><div><strong>Auswirkung:</strong> Die gespeicherte Einteilung gilt nur für dieses LMU-Rennen der aktuellen Saison.</div><button class="button" type="submit">LMU-Fahrereinteilung speichern</button></div>
    </form>
    <div class="workflow-hint"><strong>Nächster Schritt:</strong> <a href="/admin/season-progress/lmu?season=<%= activeSeason.id %>&race=<%= selectedRace.id %>">LMU-Saisonverlauf öffnen →</a></div>
  <% } %>
</div></section>
<%- include('../partials/footer') %>
