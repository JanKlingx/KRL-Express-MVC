<%- include('../partials/header', { title }) %>

<%
  const raceControlResultCount =
    typeof resultCount === 'undefined'
      ? 0
      : resultCount;

  const raceControlTeamCards =
    typeof teamCards === 'undefined'
      ? []
      : teamCards;

  const raceControlReserveRows =
    typeof reserveRows === 'undefined'
      ? []
      : reserveRows;

  const raceControlRegularStatuses =
    typeof regularStatuses === 'undefined'
      ? []
      : regularStatuses;

  const raceControlReserveStatuses =
    typeof reserveStatuses === 'undefined'
      ? []
      : reserveStatuses;

  const raceControlSelectedRace =
    typeof selectedRace === 'undefined'
      ? race
      : selectedRace;

  const raceControlExcludedRows =
    typeof excludedAttendanceRows === 'undefined'
      ? []
      : excludedAttendanceRows;


  /*
   * Status, die in Schritt 2 wirklich neu gesetzt
   * werden dürfen.
   *
   * Kein ABGEMELDET:
   * kommt bereits aus Schritt 1.
   *
   * Kein UNSICHER:
   * nur Fahrer, die bereits unsicher sind,
   * erhalten den Sonderworkflow.
   */

  const raceControlAttendanceStatuses =
    (attendanceStatuses || []).filter(
      (status) =>
        [
          'anwesend',
          'zu_spaet_vorbesprechung',
          'unabgemeldet',
          'zu_spaet_abgemeldet'
        ].includes(status.value)
    );
%>


<section class="admin-shell">

  <div class="container">


    <div class="admin-heading">

      <div>

        <a
          class="back-link"
          href="/admin"
        >
          ← Dashboard
        </a>


        <span class="form-kicker">
          FORMEL 1 · OPERATIVER PROZESS
        </span>


        <h1>
          RENNWOCHE
        </h1>


        <p class="admin-intro">
          Liga und Rennen wählen, anschließend Aufstellung,
          Anwesenheit und Ergebnis in dieser Reihenfolge abschließen.
        </p>

      </div>

    </div>


    <form
      class="race-selector"
      method="get"
    >

      <label>

        Liga

        <select name="league">

          <% leagues.forEach((item) => { %>

            <option
              value="<%= item.id %>"
              <%= league?.id === item.id ? 'selected' : '' %>
            >
              <%= item.name %>
            </option>

          <% }) %>

        </select>

      </label>


      <label>

        Aktuelle Saison

        <select name="season">

          <% seasons.forEach((item) => { %>

            <option
              value="<%= item.id %>"
              <%= season?.id === item.id ? 'selected' : '' %>
            >
              <%= item.name %>
            </option>

          <% }) %>

        </select>

      </label>


      <label>

        Rennen

        <select name="event">

          <% events.forEach((item) => { %>

            <option
              value="<%= item.id %>"
              <%= event?.id === item.id ? 'selected' : '' %>
            >
              R<%= item.sortOrder %> · <%= item.title %>
            </option>

          <% }) %>

        </select>

      </label>


      <noscript>

        <button class="button">
          Öffnen
        </button>

      </noscript>

    </form>


    <% if (!race) { %>

      <div class="empty-state">
        Für diese Auswahl ist noch kein Rennkalender vorhanden.
      </div>

    <% } else { %>


      <div class="weekend-stepper">

        <a
          href="#aufstellung"
          class="<%= entries.length ? 'complete' : 'active' %>"
        >

          <span>1</span>

          <strong>
            Aufstellung
          </strong>

          <small>
            <%= entries.length ? 'gespeichert' : 'offen' %>
          </small>

        </a>


        <a
          href="#anwesenheit"
          class="<%= entries.length ? 'active' : '' %>"
        >

          <span>2</span>

          <strong>
            Anwesenheit
          </strong>

          <small>
            <%= attendanceRows.some((row) => row.entry.attendanceStatus)
              ? 'bearbeitet'
              : 'offen'
            %>
          </small>

        </a>


        <a
          href="#ergebnisse"
          class="<%= raceControlResultCount ? 'complete' : '' %>"
        >

          <span>3</span>

          <strong>
            Ergebnisse
          </strong>

          <small>
            <%= raceControlResultCount
              ? 'gespeichert'
              : 'Plätze & Punkte'
            %>
          </small>

        </a>

      </div>


      <!-- ================================================= -->
      <!-- SCHRITT 1 -->
      <!-- ================================================= -->

      <section
        class="weekend-step"
        id="aufstellung"
      >

        <div class="weekend-step-number">
          01
        </div>


        <div>

          <span>
            FAHREREINTEILUNG
          </span>


          <h2>
            AUFSTELLUNG
          </h2>


          <p>
            Stammfahrerstatus setzen, Ersatz per Drag & Drop
            zuweisen und Rennsperren kontrollieren.
          </p>


          <%- include('partials/f1-lineup-board', {
            selectedRace: raceControlSelectedRace,
            teamCards: raceControlTeamCards,
            reserveRows: raceControlReserveRows,
            regularStatuses: raceControlRegularStatuses,
            reserveStatuses: raceControlReserveStatuses
          }) %>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- SCHRITT 2 -->
      <!-- ================================================= -->

      <section
        class="weekend-step"
        id="anwesenheit"
      >

        <div class="weekend-step-number">
          02
        </div>


        <div>

          <span>
            VOR DEM START
          </span>


          <h2>
            ANWESENHEITSKONTROLLE
          </h2>


          <% if (!entries.length) { %>

            <div class="empty-state">
              Bitte zuerst Schritt 1 speichern.
            </div>

          <% } else if (!attendanceRows.length) { %>

            <div class="empty-state">
              Aus der Aufstellung wurden keine Fahrer für die
              Anwesenheitskontrolle übernommen.
            </div>

          <% } else { %>


            <%
              const attendanceByTeam =
                new Map();


              attendanceRows.forEach(({
                entry,
                displayTeam,
                plannedReplacement
              }) => {

                const teamId =
                  displayTeam?.id ||
                  entry.TeamId ||
                  "unknown";


                if (!attendanceByTeam.has(teamId)) {

                  attendanceByTeam.set(
                    teamId,
                    {
                      team:
                        displayTeam,

                      rows:
                        []
                    }
                  );

                }


                attendanceByTeam
                  .get(teamId)
                  .rows
                  .push({
                    entry,
                    plannedReplacement
                  });

              });
            %>


            <form
              method="post"
              action="/admin/race-weekend/f1/<%= race.id %>/attendance"
              class="attendance-board"
            >


              <!-- ========================================= -->
              <!-- DETAILDATEN -->
              <!-- ========================================= -->

              <div class="lineup-team-grid">


                <% attendanceByTeam.forEach(({ team, rows }) => { %>

                  <article
                    class="lineup-team-card"
                    style="--team-color:<%= team?.accentColor || '#6ef2f2' %>"
                  >


                    <header>

                      <% if (team?.logoPath) { %>

                        <img
                          src="<%= team.logoPath %>"
                          alt="Logo <%= team.name %>"
                        >

                      <% } else { %>

                        <div class="roster-logo-fallback">

                          <%= (team?.name || "TEAM")
                            .slice(0, 2)
                            .toUpperCase()
                          %>

                        </div>

                      <% } %>


                      <div>

                        <span>
                          TEAM
                        </span>

                        <h3>
                          <%= team?.name || "Saisonteam" %>
                        </h3>

                      </div>

                    </header>


                    <div class="lineup-regular-list">


                      <% rows.forEach(({ entry: row, plannedReplacement }) => { %>

                        <%
                          const isUncertain =
                            row.status === "unsicher";


                          const hasPlannedReplacement =
                            Boolean(
                              plannedReplacement?.driver
                            );


                          const regularAlreadyConfirmed =
                            row.includeInResults === true &&
                            [
                              "anwesend",
                              "zu_spaet_vorbesprechung"
                            ].includes(
                              row.attendanceStatus
                            );


                          const replacementAlreadyConfirmed =
                            plannedReplacement?.includeInResults === true &&
                            [
                              "anwesend",
                              "zu_spaet_vorbesprechung"
                            ].includes(
                              plannedReplacement?.attendanceStatus
                            );


                          const uncertainDecision =
                            !isUncertain
                              ? null
                              : replacementAlreadyConfirmed &&
                                !regularAlreadyConfirmed
                                  ? "replacement"
                                  : regularAlreadyConfirmed
                                    ? "regular"
                                    : "unresolved";


                          const regularActive =
                            !isUncertain ||
                            uncertainDecision === "regular";


                          const replacementActive =
                            isUncertain &&
                            uncertainDecision === "replacement";


                          const regularAttendance =
                            raceControlAttendanceStatuses.some(
                              (status) =>
                                status.value === row.attendanceStatus
                            )
                              ? row.attendanceStatus
                              : "anwesend";


                          const replacementAttendance =
                            raceControlAttendanceStatuses.some(
                              (status) =>
                                status.value ===
                                plannedReplacement?.attendanceStatus
                            )
                              ? plannedReplacement.attendanceStatus
                              : "anwesend";
                        %>


                        <div
                          class="attendance-team-row <%= row.replacementFor ? 'is-replacement' : '' %>"
                          data-attendance-row
                        >


                          <% if (isUncertain) { %>

                            <!-- ================================= -->
                            <!-- UNSICHER -->
                            <!-- ================================= -->

                            <input
                              type="hidden"
                              name="uncertainDecision[d<%= row.id %>]"
                              value="<%= uncertainDecision %>"
                              data-uncertain-decision
                            >


                            <div class="uncertain-seat-choice">

                              <div>

                                <span>
                                  FEHLENDE RÜCKMELDUNG
                                </span>

                                <strong>

                                  <%= row.driver.name %>

                                  <% if (hasPlannedReplacement) { %>

                                    · vorgemerkt:
                                    <%= plannedReplacement.driver.name %>

                                  <% } %>

                                </strong>

                                <small>
                                  Entscheidung wird in der Race-Control getroffen.
                                </small>

                              </div>


                              <label class="uncertain-seat-toggle">

                                <input
                                  type="checkbox"
                                  name="uncertainPresent[d<%= row.id %>]"
                                  value="on"
                                  data-uncertain-present
                                  data-planned-replacement-driver-id="<%= plannedReplacement?.driver?.id || '' %>"
                                  <%= uncertainDecision === "regular" ? "checked" : "" %>
                                >

                                <span>
                                  <%= row.driver.name %> fährt
                                </span>

                              </label>

                            </div>


                            <!-- ================================= -->
                            <!-- STAMMFAHRER -->
                            <!-- ================================= -->

                            <div
                              class="attendance-active-driver"
                              data-regular-attendance
                              <%= regularActive ? "" : "hidden" %>
                            >

                              <div class="attendance-driver-head">

                                <div class="lineup-driver-name">

                                  <strong>
                                    #<%= row.driver.id %>
                                    ·
                                    <%= row.driver.name %>
                                  </strong>

                                  <small>
                                    Stammfahrer
                                  </small>

                                </div>

                              </div>


                              <div class="attendance-main-controls">

                                <label class="attendance-control">

                                  <span>
                                    Anwesenheit
                                  </span>


                                  <select
                                    name="attendance[d<%= row.id %>][status]"
                                    data-attendance-status
                                    <%= regularActive ? "" : "disabled" %>
                                  >

                                    <% raceControlAttendanceStatuses.forEach((status) => { %>

                                      <option
                                        value="<%= status.value %>"
                                        <%= regularAttendance === status.value
                                          ? "selected"
                                          : ""
                                        %>
                                      >
                                        <%= status.label %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>


                              <div
                                class="attendance-replacement-panel"
                                data-replacement-panel
                                <%= [
                                  "unabgemeldet",
                                  "zu_spaet_abgemeldet"
                                ].includes(regularAttendance)
                                  ? ""
                                  : "hidden"
                                %>
                              >

                                <label class="attendance-control">

                                  <span>
                                    Spontaner Ersatz
                                  </span>


                                  <select
                                    name="attendance[d<%= row.id %>][ReplacementDriverId]"
                                    <%= regularActive ? "" : "disabled" %>
                                  >

                                    <option value="">
                                      Kein Ersatz
                                    </option>


                                    <% availableReplacements.forEach((driver) => { %>

                                      <option value="<%= driver.id %>">
                                        <%= driver.name %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>

                            </div>


                            <!-- ================================= -->
                            <!-- VORGEMERKTER ERSATZ -->
                            <!-- ================================= -->

                            <% if (hasPlannedReplacement) { %>

                              <div
                                class="attendance-active-driver is-replacement"
                                data-replacement-attendance
                                <%= replacementActive ? "" : "hidden" %>
                              >

                                <div class="attendance-driver-head">

                                  <div class="lineup-driver-name">

                                    <strong>
                                      #<%= plannedReplacement.driver.id %>
                                      ·
                                      <%= plannedReplacement.driver.name %>
                                    </strong>

                                    <small>
                                      Ersatz für <%= row.driver.name %>
                                    </small>

                                  </div>

                                </div>


                                <div class="attendance-main-controls">

                                  <label class="attendance-control">

                                    <span>
                                      Anwesenheit
                                    </span>


                                    <select
                                      name="attendance[d<%= plannedReplacement.id %>][status]"
                                      data-attendance-status
                                      <%= replacementActive ? "" : "disabled" %>
                                    >

                                      <% raceControlAttendanceStatuses.forEach((status) => { %>

                                        <option
                                          value="<%= status.value %>"
                                          <%= replacementAttendance === status.value
                                            ? "selected"
                                            : ""
                                          %>
                                        >
                                          <%= status.label %>
                                        </option>

                                      <% }) %>

                                    </select>

                                  </label>

                                </div>


                                <div
                                  class="attendance-replacement-panel"
                                  data-replacement-panel
                                  <%= [
                                    "unabgemeldet",
                                    "zu_spaet_abgemeldet"
                                  ].includes(replacementAttendance)
                                    ? ""
                                    : "hidden"
                                  %>
                                >

                                  <label class="attendance-control">

                                    <span>
                                      Weiterer Ersatz
                                    </span>


                                    <select
                                      name="attendance[d<%= plannedReplacement.id %>][ReplacementDriverId]"
                                      <%= replacementActive ? "" : "disabled" %>
                                    >

                                      <option value="">
                                        Kein weiterer Ersatz
                                      </option>


                                      <% availableReplacements.forEach((driver) => { %>

                                        <% if (Number(driver.id) !== Number(plannedReplacement.driver.id)) { %>

                                          <option value="<%= driver.id %>">
                                            <%= driver.name %>
                                          </option>

                                        <% } %>

                                      <% }) %>

                                    </select>

                                  </label>

                                </div>

                              </div>

                            <% } %>


                          <% } else { %>

                            <!-- ================================= -->
                            <!-- NORMALER TEILNEHMER -->
                            <!-- ================================= -->

                            <%
                              const selectedAttendance =
                                raceControlAttendanceStatuses.some(
                                  (status) =>
                                    status.value === row.attendanceStatus
                                )
                                  ? row.attendanceStatus
                                  : "anwesend";
                            %>


                            <div class="attendance-driver-head">

                              <div class="lineup-driver-name">

                                <strong>
                                  #<%= row.driver.id %>
                                  ·
                                  <%= row.driver.name %>
                                </strong>

                                <small>

                                  <%= row.replacementFor
                                    ? `Ersatz für ${row.replacementFor.name}`
                                    : "Stammfahrer"
                                  %>

                                </small>

                              </div>

                            </div>


                            <div class="attendance-main-controls">

                              <label class="attendance-control">

                                <span>
                                  Anwesenheit
                                </span>


                                <select
                                  name="attendance[d<%= row.id %>][status]"
                                  data-attendance-status
                                >

                                  <% raceControlAttendanceStatuses.forEach((status) => { %>

                                    <option
                                      value="<%= status.value %>"
                                      <%= selectedAttendance === status.value
                                        ? "selected"
                                        : ""
                                      %>
                                    >
                                      <%= status.label %>
                                    </option>

                                  <% }) %>

                                </select>

                              </label>

                            </div>


                            <div
                              class="attendance-replacement-panel"
                              data-replacement-panel
                              <%= [
                                "unabgemeldet",
                                "zu_spaet_abgemeldet"
                              ].includes(selectedAttendance)
                                ? ""
                                : "hidden"
                              %>
                            >

                              <label class="attendance-control">

                                <span>
                                  Spontaner Ersatz
                                </span>


                                <select
                                  name="attendance[d<%= row.id %>][ReplacementDriverId]"
                                >

                                  <option value="">
                                    Kein Ersatz
                                  </option>


                                  <% availableReplacements.forEach((driver) => { %>

                                    <option value="<%= driver.id %>">
                                      <%= driver.name %>
                                    </option>

                                  <% }) %>

                                </select>

                              </label>

                            </div>

                          <% } %>

                        </div>

                      <% }) %>

                    </div>

                  </article>

                <% }) %>

              </div>


              <button
                class="button attendance-submit"
                type="submit"
              >
                ANWESENHEIT BESTÄTIGEN
              </button>


              <% if (raceControlExcludedRows.length) { %>

                <button
                  type="button"
                  class="button button-ghost attendance-submit"
                  data-toggle-attendance-corrections
                >
                  Ausgeschiedene Fahrer bearbeiten
                </button>

              <% } %>

            </form>


            <!-- =========================================== -->
            <!-- KORREKTUREN -->
            <!-- =========================================== -->

            <% if (raceControlExcludedRows.length) { %>

              <div
                class="attendance-corrections"
                data-attendance-corrections
                hidden
              >

                <div class="attendance-corrections-heading">

                  <span>
                    KORREKTUR
                  </span>

                  <h3>
                    AUSGESCHIEDENE FAHRER
                  </h3>

                  <p>
                    Versehendlich falsch gespeicherte
                    Anwesenheitsstatus können hier korrigiert werden.
                  </p>

                </div>


                <form
                  method="post"
                  action="/admin/race-weekend/f1/<%= race.id %>/attendance"
                  class="attendance-correction-form"
                >

                  <%
                    const excludedByTeam =
                      new Map();


                    raceControlExcludedRows.forEach(({
                      entry,
                      displayTeam,
                      currentReplacement
                    }) => {

                      const teamId =
                        displayTeam?.id ||
                        entry.TeamId ||
                        "unknown";


                      if (!excludedByTeam.has(teamId)) {

                        excludedByTeam.set(
                          teamId,
                          {
                            team:
                              displayTeam,

                            rows:
                              []
                          }
                        );

                      }


                      excludedByTeam
                        .get(teamId)
                        .rows
                        .push({
                          entry,
                          currentReplacement
                        });

                    });
                  %>


                  <div class="lineup-team-grid">


                    <% excludedByTeam.forEach(({ team, rows }) => { %>

                      <article
                        class="lineup-team-card"
                        style="--team-color:<%= team?.accentColor || '#6ef2f2' %>"
                      >


                        <header>

                          <% if (team?.logoPath) { %>

                            <img
                              src="<%= team.logoPath %>"
                              alt="Logo <%= team.name %>"
                            >

                          <% } %>


                          <div>

                            <span>
                              TEAM
                            </span>

                            <h3>
                              <%= team?.name || "Saisonteam" %>
                            </h3>

                          </div>

                        </header>


                        <div class="lineup-regular-list">


                          <% rows.forEach(({ entry: row, currentReplacement }) => { %>

                            <div class="attendance-team-row">


                              <div class="attendance-driver-head">

                                <div class="lineup-driver-name">

                                  <strong>
                                    #<%= row.driver.id %>
                                    ·
                                    <%= row.driver.name %>
                                  </strong>

                                  <small>

                                    <% if (row.roleType === "reserve" && row.replacementFor) { %>

                                      Ersatz für
                                      <%= row.replacementFor.name %>

                                    <% } else { %>

                                      Stammfahrer

                                    <% } %>

                                  </small>

                                </div>

                              </div>


                              <div class="attendance-main-controls">

                                <label class="attendance-control">

                                  <span>
                                    Anwesenheit korrigieren
                                  </span>


                                  <select
                                    name="correction[d<%= row.id %>][status]"
                                  >

                                    <% attendanceStatuses.forEach((status) => { %>

                                      <option
                                        value="<%= status.value %>"
                                        <%= row.attendanceStatus === status.value
                                          ? "selected"
                                          : ""
                                        %>
                                      >
                                        <%= status.label %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>


                              <% if (currentReplacement?.driver) { %>

                                <div class="attendance-current-replacement">

                                  <span>
                                    AKTUELLER ERSATZ
                                  </span>

                                  <strong>
                                    <%= currentReplacement.driver.name %>
                                  </strong>

                                  <small>
                                    Wird automatisch wieder freigegeben,
                                    wenn <%= row.driver.name %> wieder
                                    auf einen startberechtigten Status gesetzt wird.
                                  </small>

                                </div>

                              <% } %>

                            </div>

                          <% }) %>

                        </div>

                      </article>

                    <% }) %>

                  </div>


                  <button
                    class="button attendance-submit"
                    type="submit"
                  >
                    KORREKTUREN SPEICHERN
                  </button>

                </form>

              </div>

            <% } %>

          <% } %>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- SCHRITT 3 -->
      <!-- ================================================= -->

      <section
        class="weekend-step"
        id="ergebnisse"
      >

        <div class="weekend-step-number">
          03
        </div>


        <div>

          <span>
            RENNERGEBNIS
          </span>

          <h2>
            ERGEBNISSE EINTRAGEN
          </h2>

          <p>
            Nur tatsächlich startende Fahrer werden aus der
            Anwesenheitskontrolle übernommen.
          </p>


          <a
            class="button"
            href="<%= resultsHref %>"
          >
            Ergebnistabelle öffnen
          </a>

        </div>

      </section>

    <% } %>

  </div>

</section>


<script
  src="/js/f1-race-lineup.js"
  defer
></script>

<script
  src="/js/race-weekend.js"
  defer
></script>

<script
  src="/js/f1-race-control.js"
  defer
></script>

<%- include('../partials/footer') %>