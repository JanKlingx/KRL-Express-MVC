<%- include('../partials/header', { title }) %>
<section class="admin-shell table-hub-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">ZENTRALER EINSTIEG</span><h1>TABELLEN-HUB</h1><p class="admin-intro">Alle Ligen und Saisons mit Pflege, Frontend und vorhandenen CSV-Downloads an einem Ort.</p></div><a class="button" href="/admin/season-setup">Neue Saison einrichten</a></div>
  <% sections.forEach(({ league, seasons }) => { %><section class="table-hub-section" style="--hub-accent:<%= league.accentColor %>"><header><% if (league.logoPath) { %><img src="<%= league.logoPath %>" alt=""><% } %><div><span><%= league.type === 'f1' ? 'FORMEL 1' : league.type === 'lmu' ? 'LMU' : 'WDL' %></span><h2><%= league.name %></h2></div></header><% if (!seasons.length) { %><div class="empty-state">Noch keine Saison. <a href="/admin/season-setup?league=<%= league.id %>">Jetzt einrichten →</a></div><% } else { %><div class="table-hub-grid"><% seasons.forEach(({ season, races, editor, frontend, downloads }) => { %><article><div class="table-hub-season-state"><span class="<%= season.status %>"><%= season.status === 'active' ? 'AKTIV' : 'HISTORISCH' %></span><small><%= races %> Rennen</small></div><h3><%= season.name %></h3><div class="table-hub-primary"><a href="<%= editor %>">Tabelle pflegen</a><a href="<%= frontend %>" target="_blank" rel="noreferrer">Frontend ansehen</a></div><div class="table-hub-downloads"><span>Downloads</span><% downloads.forEach(([label, href]) => { %><a href="<%= href %>"><%= label %> ↓</a><% }) %></div></article><% }) %></div><% } %></section><% }) %>
</div></section>
<%- include('../partials/footer') %>
