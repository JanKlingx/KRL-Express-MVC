<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Katzes Racing League – Simracing, Community und fairer Wettbewerb.">
  <title><%= title %> | KRL</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Zum Inhalt springen</a>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="/" aria-label="KRL Startseite"><span class="brand-mark">K</span><span>KATZES<br>RACING LEAGUE</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Navigation öffnen">☰</button>
      <nav id="main-nav" class="main-nav" aria-label="Hauptnavigation">
        <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Start</a>
        <div class="nav-group">
          <button type="button" aria-expanded="false">F1 Liga ▾</button>
          <div class="dropdown"><a href="/f1/freitag">Freitagsliga</a><a href="/f1/sonntag">Sonntagsliga</a></div>
        </div>
        <a href="/lmu">LMU Liga</a>
        <a href="/wettkampf-der-ligen">Wettkampf</a>
        <a href="/#team">Unser Team</a>
        <a class="login-link" href="<%= isAdmin ? '/admin' : '/admin/login' %>"><%= isAdmin ? 'Admin' : 'Login' %></a>
        <a class="button button-small" href="https://discord.com" target="_blank" rel="noopener">Jetzt beitreten</a>
      </nav>
    </div>
  </header>
  <main id="main">
    <% if (flash) { %><div class="container flash flash-<%= flash.type %>" role="status"><%= flash.message %></div><% } %>
