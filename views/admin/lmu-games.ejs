<%- include('../partials/header',{title}) %><section class="admin-shell"><div class="container"><%- include('../partials/lmu-admin-heading',{title}) %>
<div class="admin-grid"><% games.forEach(game=>{ %><a class="admin-card" href="?game=<%= game.id %>"><% if(game.logoPath){ %><img class="lmu-game-preview" src="<%= game.logoPath %>" alt="<%= game.name %>"><% } %><h2><%= game.name %></h2><p><%= game.isActive?'Aktiv':'Inaktiv' %> · Bearbeiten →</p></a><% }); %></div>
<form class="resource-form" action="/admin/lmu-games<%= selected?'/'+selected.id:'' %>" method="post" enctype="multipart/form-data"><h2><%= selected?'Spiel bearbeiten':'Spiel anlegen' %></h2><label>Spielname<input name="name" maxlength="255" value="<%= selected?.name||'Le Mans Ultimate' %>" required></label><label>Logo für den Saisonverlauf<input type="file" name="image" accept="image/png,image/jpeg,image/webp"></label><label><input type="checkbox" name="isActive" <%= !selected||selected.isActive?'checked':'' %>> Für neue Saisons auswählbar</label><button class="button">Speichern</button><% if(selected){ %><a href="/admin/lmu-games">Neues Spiel</a><% } %></form>
</div></section><%- include('../partials/footer') %>
