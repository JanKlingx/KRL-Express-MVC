<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker"><%= discipline.toUpperCase() %> · Saisonverlauf</span><h1>RENNTABELLE PFLEGEN</h1><p class="admin-intro">Saison und Rennen werden direkt hier verwaltet. Strecken lassen sich aus dem <%= discipline.toUpperCase() %>-Kalender übernehmen oder frei eingeben.</p></div></div>
  <form class="race-selector series-race-selector" method="get" action="/admin/season-progress/<%= discipline %>"><label for="season">Saison</label><select id="season" name="season"><%- include('../partials/season-options', { seasons, selectedSeason }) %></select><label for="race">Rennen</label><select id="race" name="race"><% races.forEach((race) => { %><option value="<%= race.id %>" <%= selectedRace?.id === race.id ? 'selected' : '' %>>R<%= race.sortOrder %> · <%= race.title %></option><% }) %></select><noscript><button class="button button-small" type="submit">Öffnen</button></noscript></form>

  <div class="season-admin-tools">
    <details><summary>+ Saison anlegen</summary><form method="post" action="/admin/season-progress/<%= discipline %>/seasons" class="compact-admin-form"><input type="hidden" name="LeagueId" value="<%= league?.id || '' %>"><label>Saisonname<input name="name" required placeholder="z. B. Saison 4 oder 2023"></label><label>Art<select name="status"><option value="active">Aktuelle Saison</option><option value="historical">Historische Saison</option></select></label><button class="button button-small" type="submit">Saison anlegen</button></form></details>
    <% if (selectedSeason) { %>
      <details><summary>+ Rennen / Strecke selbst eingeben</summary><form method="post" action="/admin/season-progress/<%= discipline %>/races" class="compact-admin-form"><input type="hidden" name="LeagueId" value="<%= league.id %>"><input type="hidden" name="SeasonId" value="<%= selectedSeason.id %>"><label>Rennen<input name="title" required></label><label>Strecke<input name="circuit" required></label><label>Datum<input type="date" name="raceDate"></label><label>Rennrunde<input type="number" min="1" name="sortOrder"></label><label>Eingabe<select name="pointsMode"><option value="database">Plätze → Punkte aus Datenbank</option><option value="manual">Punkte direkt eingeben</option></select></label><button class="button button-small" type="submit">Rennen anlegen</button></form></details>
      <details><summary>↓ Strecken aus <%= discipline.toUpperCase() %>-Rennkalender importieren</summary><form method="post" action="/admin/season-progress/<%= discipline %>/import-calendar" class="compact-admin-form"><input type="hidden" name="LeagueId" value="<%= league.id %>"><input type="hidden" name="SeasonId" value="<%= selectedSeason.id %>"><label>Eingabe<select name="pointsMode"><option value="database">Plätze → Punkte aus Datenbank</option><option value="manual">Punkte direkt eingeben</option></select></label><button class="button button-small" type="submit">Kalender übernehmen</button></form></details>
    <% } %>
  </div>

  <% if (!selectedRace) { %><div class="empty-state">Noch kein Rennen vorhanden. Importiere den Rennkalender oder gib die erste Strecke oben selbst ein.</div><% } else { %>
    <div class="race-settings-bar"><form method="post" action="/admin/season-progress/<%= discipline %>/<%= selectedRace.id %>/settings" class="compact-admin-form"><label>Eingabemodus<select name="pointsMode"><option value="database" <%= selectedRace.pointsMode === 'database' ? 'selected' : '' %>>Plätze → Punkte aus Datenbank</option><option value="manual" <%= selectedRace.pointsMode === 'manual' ? 'selected' : '' %>>Punkte direkt eingeben</option></select></label><button class="button button-small" type="submit">Rennen aktualisieren</button></form><form method="post" action="/admin/season-progress/<%= discipline %>/<%= selectedRace.id %>?_method=DELETE" data-confirm="Rennen und Ergebnisse wirklich löschen?"><button class="button button-ghost button-small" type="submit">Rennen löschen</button></form></div>
    <form method="post" action="/admin/season-progress/<%= discipline %>/<%= selectedRace.id %>" class="race-sheet-form">
      <div class="race-sheet-heading"><div><span><%= selectedSeason.name %> · R<%= selectedRace.sortOrder %></span><h2><%= selectedRace.title %></h2></div><button class="button" type="submit">Gesamtes Rennen speichern</button></div>
      <div class="table-wrap race-sheet"><table><thead>
        <% if (discipline === 'lmu') { %><tr><th>Dabei</th><th>Fahrer</th><th>Team</th><th><%= selectedRace.pointsMode === 'manual' ? 'Punkte' : 'Platz' %></th><th>Status</th><% if (selectedRace.pointsMode === 'database') { %><th>SR</th><% } %></tr>
        <% } else { %><tr><th>WDL-Liga</th><th>Fahrer 1</th><th><%= selectedRace.pointsMode === 'manual' ? 'Punkte 1' : 'Platz 1' %></th><% if (selectedRace.pointsMode === 'database') { %><th>SR</th><% } %><th>Fahrer 2</th><th><%= selectedRace.pointsMode === 'manual' ? 'Punkte 2' : 'Platz 2' %></th><% if (selectedRace.pointsMode === 'database') { %><th>SR</th><% } %><th>Gesamt</th></tr><% } %>
      </thead><tbody>
        <% if (discipline === 'lmu') { rows.forEach(({ driver, teamName, entry }) => { %><tr class="<%= entry ? 'sheet-row-active' : '' %>"><td><input type="checkbox" name="rows[<%= driver.id %>][included]" <%= entry ? 'checked' : '' %>></td><td><strong>#<%= driver.id %> · <%= driver.name %></strong></td><td><input name="rows[<%= driver.id %>][teamName]" value="<%= entry?.teamName || teamName %>"></td><td><input type="number" min="<%= selectedRace.pointsMode === 'manual' ? 0 : 1 %>" step="<%= selectedRace.pointsMode === 'manual' ? 0.5 : 1 %>" name="rows[<%= driver.id %>][<%= selectedRace.pointsMode === 'manual' ? 'points' : 'position' %>]" value="<%= entry ? Number(selectedRace.pointsMode === 'manual' ? entry.points : entry.position || '') : '' %>"></td><td><select name="rows[<%= driver.id %>][status]"><% ['', 'DNF', 'DNS', 'DSQ'].forEach((status) => { %><option value="<%= status %>" <%= String(entry?.status || '') === status ? 'selected' : '' %>><%= status || 'Gewertet' %></option><% }) %></select></td><% if (selectedRace.pointsMode === 'database') { %><td><input type="checkbox" name="rows[<%= driver.id %>][fastestLap]" <%= entry?.fastestLap ? 'checked' : '' %>></td><% } %></tr><% })
        } else { rows.forEach(({ participant, entry, allowedDriverIds }) => { const selectableDrivers = selectedSeason.status === 'historical' ? drivers : drivers.filter((driver) => allowedDriverIds.includes(driver.id)); %><tr><td><strong><%= participant.name %></strong></td><td><select name="rows[<%= participant.id %>][Driver1Id]"><option value="">Fahrer wählen …</option><% selectableDrivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= entry?.Driver1Id === driver.id ? 'selected' : '' %>><%= driver.name %></option><% }) %></select></td><td><input type="number" min="<%= selectedRace.pointsMode === 'manual' ? 0 : 1 %>" step="<%= selectedRace.pointsMode === 'manual' ? 0.5 : 1 %>" name="rows[<%= participant.id %>][<%= selectedRace.pointsMode === 'manual' ? 'pointsOne' : 'positionOne' %>]" value="<%= entry ? Number(selectedRace.pointsMode === 'manual' ? entry.pointsOne : entry.positionOne || '') : '' %>"></td><% if (selectedRace.pointsMode === 'database') { %><td><input type="checkbox" name="rows[<%= participant.id %>][fastestLapOne]" <%= entry?.fastestLapOne ? 'checked' : '' %>></td><% } %><td><select name="rows[<%= participant.id %>][Driver2Id]"><option value="">Fahrer wählen …</option><% selectableDrivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= entry?.Driver2Id === driver.id ? 'selected' : '' %>><%= driver.name %></option><% }) %></select></td><td><input type="number" min="<%= selectedRace.pointsMode === 'manual' ? 0 : 1 %>" step="<%= selectedRace.pointsMode === 'manual' ? 0.5 : 1 %>" name="rows[<%= participant.id %>][<%= selectedRace.pointsMode === 'manual' ? 'pointsTwo' : 'positionTwo' %>]" value="<%= entry ? Number(selectedRace.pointsMode === 'manual' ? entry.pointsTwo : entry.positionTwo || '') : '' %>"></td><% if (selectedRace.pointsMode === 'database') { %><td><input type="checkbox" name="rows[<%= participant.id %>][fastestLapTwo]" <%= entry?.fastestLapTwo ? 'checked' : '' %>></td><% } %><td><strong><%= entry ? Number(entry.totalPoints) : 0 %></strong></td></tr><% }) } %>
      </tbody></table></div>
      <div class="sheet-help"><strong><%= selectedRace.pointsMode === 'manual' ? 'Direkte Punkteeingabe:' : 'Automatische Wertung:' %></strong> <%= selectedRace.pointsMode === 'manual' ? 'Die eingetragenen historischen Punkte werden unverändert gespeichert.' : 'Aus den Plätzen werden automatisch GP-Result und WM-Stand berechnet.' %></div>
      <button class="button" type="submit">Gesamtes Rennen speichern</button>
    </form>
  <% } %>
</div></section>
<%- include('../partials/footer') %>
