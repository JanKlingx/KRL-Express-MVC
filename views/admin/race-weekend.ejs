<%- include('../partials/header', { title }) %>

<%
  const raceControlResultCount = typeof resultCount === 'undefined' ? 0 : resultCount;
  const raceControlTeamCards = typeof teamCards === 'undefined' ? [] : teamCards;
  const raceControlReserveRows = typeof reserveRows === 'undefined' ? [] : reserveRows;
  const raceControlRegularStatuses = typeof regularStatuses === 'undefined' ? [] : regularStatuses;
  const raceControlReserveStatuses = typeof reserveStatuses === 'undefined' ? [] : reserveStatuses;
  const raceControlSelectedRace = typeof selectedRace === 'undefined' ? race : selectedRace;
  const raceControlExcludedRows = typeof excludedAttendanceRows === 'undefined' ? [] : excludedAttendanceRows;
%>

<section class="admin-shell">
  <div class="container">

    <div class="admin-heading">
      <div>
        <a class="back-link" href="/admin">
          ← Dashboard
        </a>

        <span class="form-kicker">
          FORMEL 1 · OPERATIVER PROZESS
        </span>

        <h1>
          RENNWOCHE
        </h1>

        <p class="admin-intro">
          Liga und Rennen wählen, anschließend Aufstellung,
          Anwesenheit und Ergebnis in dieser Reihenfolge abschließen.
        </p>
      </div>
    </div>


    <form class="race-selector" method="get">

      <label>
        Liga

        <select name="league">
          <% leagues.forEach((item) => { %>
            <option
              value="<%= item.id %>"
              <%= league?.id === item.id ? 'selected' : '' %>
            >
              <%= item.name %>
            </option>
          <% }) %>
        </select>
      </label>


      <label>
        Aktuelle Saison

        <select name="season">
          <% seasons.forEach((item) => { %>
            <option
              value="<%= item.id %>"
              <%= season?.id === item.id ? 'selected' : '' %>
            >
              <%= item.name %>
            </option>
          <% }) %>
        </select>
      </label>


      <label>
        Rennen

        <select name="event">
          <% events.forEach((item) => { %>
            <option
              value="<%= item.id %>"
              <%= event?.id === item.id ? 'selected' : '' %>
            >
              R<%= item.sortOrder %> · <%= item.title %>
            </option>
          <% }) %>
        </select>
      </label>


      <noscript>
        <button class="button">
          Öffnen
        </button>
      </noscript>

    </form>


    <% if (!race) { %>

      <div class="empty-state">
        Für diese Auswahl ist noch kein Rennkalender vorhanden.
      </div>

    <% } else { %>


      <div class="weekend-stepper">

        <a
          href="#aufstellung"
          class="<%= entries.length ? 'complete' : 'active' %>"
        >
          <span>1</span>
          <strong>Aufstellung</strong>
          <small>
            <%= entries.length ? 'gespeichert' : 'offen' %>
          </small>
        </a>


        <a
          href="#anwesenheit"
          class="<%= entries.length ? 'active' : '' %>"
        >
          <span>2</span>
          <strong>Anwesenheit</strong>
          <small>
            <%= attendanceRows.some((row) => row.entry.attendanceStatus)
              ? 'bearbeitet'
              : 'offen'
            %>
          </small>
        </a>


        <a href="#ergebnisse" class="<%= raceControlResultCount ? 'complete' : '' %>">
          <span>3</span>
          <strong>Ergebnisse</strong>
          <small><%= raceControlResultCount ? 'gespeichert' : 'Plätze & Punkte' %></small>
        </a>

      </div>


      <!-- ================================================= -->
      <!-- SCHRITT 1 -->
      <!-- ================================================= -->

      <section class="weekend-step" id="aufstellung">

        <div class="weekend-step-number">
          01
        </div>

        <div>

          <span>
            FAHREREINTEILUNG
          </span>

          <h2>
            AUFSTELLUNG
          </h2>

          <p>Stammfahrerstatus setzen, Ersatz per Drag & Drop zuweisen und Rennsperren kontrollieren.</p>
          <%- include('partials/f1-lineup-board', { selectedRace: raceControlSelectedRace, teamCards: raceControlTeamCards, reserveRows: raceControlReserveRows, regularStatuses: raceControlRegularStatuses, reserveStatuses: raceControlReserveStatuses }) %>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- SCHRITT 2 -->
      <!-- ================================================= -->

      <section class="weekend-step" id="anwesenheit">

        <div class="weekend-step-number">
          02
        </div>

        <div>

          <span>
            VOR DEM START
          </span>

          <h2>
            ANWESENHEITSKONTROLLE
          </h2>


          <% if (!entries.length) { %>

            <div class="empty-state">
              Bitte zuerst Schritt 1 speichern.
            </div>

          <% } else if (!attendanceRows.length) { %>

            <div class="empty-state">
              Aus der Aufstellung wurden keine Fahrer für die Anwesenheitskontrolle übernommen.
            </div>

          <% } else { %>


            <%
              const attendanceByTeam = new Map();

              attendanceRows.forEach(({
                entry,
                displayTeam,
                plannedReplacement
              }) => {

                const teamId =
                  displayTeam?.id ||
                  entry.TeamId ||
                  "unknown";

                if (!attendanceByTeam.has(teamId)) {
                  attendanceByTeam.set(teamId, {
                    team: displayTeam,
                    rows: []
                  });
                }

                attendanceByTeam
                  .get(teamId)
                  .rows
                  .push({
                    entry,
                    plannedReplacement
                  });
              });
            %>


            <form
              method="post"
              action="/admin/race-weekend/f1/<%= race.id %>/attendance"
              class="attendance-board"
            >

              <div class="lineup-team-grid">

                <% attendanceByTeam.forEach(({ team, rows }) => { %>

                  <article
                    class="lineup-team-card"
                    style="--team-color:<%= team?.accentColor || '#6ef2f2' %>"
                  >

                    <header>

                      <% if (team?.logoPath) { %>

                        <img
                          src="<%= team.logoPath %>"
                          alt="Logo <%= team.name %>"
                        >

                      <% } else { %>

                        <div class="roster-logo-fallback">
                          <%= (team?.name || "TEAM")
                            .slice(0, 2)
                            .toUpperCase()
                          %>
                        </div>

                      <% } %>


                      <div>
                        <span>TEAM</span>

                        <h3>
                          <%= team?.name || "Saisonteam" %>
                        </h3>
                      </div>

                    </header>


                    <div class="lineup-regular-list">

                      <% rows.forEach(({ entry: row, plannedReplacement }) => { %>

                        <%
                          const hasUncertainReplacement =
                            row.status === "unsicher" &&
                            Boolean(plannedReplacement?.driver);

                          const regularTakesSeat =
                            !hasUncertainReplacement ||
                            !(
                              plannedReplacement?.includeInResults === true &&
                              row.includeInResults !== true
                            );

                          const regularAttendance =
                            row.attendanceStatus ||
                            "anwesend";

                          const replacementAttendance =
                            plannedReplacement?.attendanceStatus ||
                            "anwesend";
                        %>


                        <div
                          class="attendance-team-row <%= row.replacementFor ? 'is-replacement' : '' %>"
                          data-attendance-row
                        >
                          <input type="hidden" name="attendance[<%= row.id %>][includeInResults]" value="<%= row.includeInResults ? 'on' : '' %>">


                          <% if (hasUncertainReplacement) { %>

                            <!-- ===================================== -->
                            <!-- UNSICHER: WER ÜBERNIMMT DAS COCKPIT? -->
                            <!-- ===================================== -->

                            <div class="uncertain-seat-choice">

                              <div>

                                <span>
                                  UNSICHERE TEILNAHME
                                </span>

                                <strong>
                                  <%= row.driver.name %>
                                  oder
                                  <%= plannedReplacement.driver.name %>
                                </strong>

                                <small>
                                  Festlegen, wer den Cockpitplatz für dieses Rennen übernimmt.
                                </small>

                              </div>


                              <label class="uncertain-seat-toggle">

                                <input
                                  type="checkbox"
                                  name="uncertainPresent[d<%= row.id %>]"
                                  value="on"
                                  data-uncertain-present
                                  data-planned-replacement-driver-id="<%= plannedReplacement.driver.id %>"
                                  <%= regularTakesSeat ? "checked" : "" %>
                                >

                                <span>
                                  <%= row.driver.name %> fährt
                                </span>

                              </label>

                            </div>


                            <!-- ===================================== -->
                            <!-- STAMMFAHRER AKTIV -->
                            <!-- ===================================== -->

                            <div
                              class="attendance-active-driver"
                              data-regular-attendance
                              <%= regularTakesSeat ? "" : "hidden" %>
                            >

                              <div class="attendance-driver-head">

                                <div class="lineup-driver-name">

                                  <strong>
                                    #<%= row.driver.id %>
                                    ·
                                    <%= row.driver.name %>
                                  </strong>

                                  <small>
                                    Stammfahrer
                                  </small>

                                </div>

                              </div>


                              <div class="attendance-main-controls">

                                <label class="attendance-control">

                                  <span>
                                    Anwesenheit
                                  </span>

                                  <select
                                    name="attendance[d<%= row.id %>][status]"
                                    data-attendance-status
                                    <%= regularTakesSeat ? "" : "disabled" %>
                                  >

                                    <% attendanceStatuses.forEach((status) => { %>

                                      <option
                                        value="<%= status.value %>"
                                        <%= regularAttendance === status.value
                                          ? "selected"
                                          : ""
                                        %>
                                      >
                                        <%= status.label %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>


                              <div
                                class="attendance-replacement-panel"
                                data-replacement-panel
                                <%= [
                                  "unabgemeldet",
                                  "zu_spaet_abgemeldet"
                                ].includes(regularAttendance)
                                  ? ""
                                  : "hidden"
                                %>
                              >

                                <label class="attendance-control">

                                  <span>
                                    Weiterer Ersatz
                                  </span>

                                  <select
                                    name="attendance[d<%= row.id %>][ReplacementDriverId]"
                                    <%= regularTakesSeat ? "" : "disabled" %>
                                  >

                                    <option value="">
                                      Kein weiterer Ersatz
                                    </option>

                                    <% availableReplacements.forEach((driver) => { %>

                                      <option value="<%= driver.id %>">
                                        <%= driver.name %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>

                            </div>


                            <!-- ===================================== -->
                            <!-- VORGEMERKTER ERSATZ AKTIV -->
                            <!-- ===================================== -->

                            <div
                              class="attendance-active-driver is-replacement"
                              data-replacement-attendance
                              <%= regularTakesSeat ? "hidden" : "" %>
                            >

                              <div class="attendance-driver-head">

                                <div class="lineup-driver-name">

                                  <strong>
                                    #<%= plannedReplacement.driver.id %>
                                    ·
                                    <%= plannedReplacement.driver.name %>
                                  </strong>

                                  <small>
                                    Ersatz für <%= row.driver.name %>
                                  </small>

                                </div>

                              </div>


                              <div class="attendance-main-controls">

                                <label class="attendance-control">

                                  <span>
                                    Anwesenheit
                                  </span>

                                  <select
                                    name="attendance[d<%= plannedReplacement.id %>][status]"
                                    data-attendance-status
                                    <%= regularTakesSeat ? "disabled" : "" %>
                                  >

                                    <% attendanceStatuses.forEach((status) => { %>

                                      <option
                                        value="<%= status.value %>"
                                        <%= replacementAttendance === status.value
                                          ? "selected"
                                          : ""
                                        %>
                                      >
                                        <%= status.label %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>


                              <div
                                class="attendance-replacement-panel"
                                data-replacement-panel
                                <%= [
                                  "unabgemeldet",
                                  "zu_spaet_abgemeldet"
                                ].includes(replacementAttendance)
                                  ? ""
                                  : "hidden"
                                %>
                              >

                                <label class="attendance-control">

                                  <span>
                                    Weiterer Ersatz
                                  </span>

                                  <select
                                    name="attendance[d<%= plannedReplacement.id %>][ReplacementDriverId]"
                                    <%= regularTakesSeat ? "disabled" : "" %>
                                  >

                                    <option value="">
                                      Kein weiterer Ersatz
                                    </option>

                                    <% availableReplacements.forEach((driver) => { %>

                                      <option value="<%= driver.id %>">
                                        <%= driver.name %>
                                      </option>

                                    <% }) %>

                                  </select>

                                </label>

                              </div>

                            </div>


                          <% } else { %>

                            <!-- ===================================== -->
                            <!-- NORMALER STAMM-/ERSATZFAHRER -->
                            <!-- ===================================== -->

                            <%
                              const selectedAttendance =
                                row.attendanceStatus ||
                                "anwesend";
                            %>


                            <div class="attendance-driver-head">

                              <div class="lineup-driver-name">

                                <strong>
                                  #<%= row.driver.id %>
                                  ·
                                  <%= row.driver.name %>
                                </strong>

                                <small>
                                  <%= row.replacementFor
                                    ? `Ersatz für ${row.replacementFor.name}`
                                    : "Stammfahrer"
                                  %>
                                </small>

                              </div>

                            </div>


                            <div class="attendance-main-controls">

                              <label class="attendance-control">

                                <span>
                                  Anwesenheit
                                </span>

                                <select
                                  name="attendance[d<%= row.id %>][status]"
                                  data-attendance-status
                                >

                                  <% attendanceStatuses.forEach((status) => { %>

                                    <option
                                      value="<%= status.value %>"
                                      <%= selectedAttendance === status.value
                                        ? "selected"
                                        : ""
                                      %>
                                    >
                                      <%= status.label %>
                                    </option>

                                  <% }) %>

                                </select>

                              </label>

                            </div>


                            <div
                              class="attendance-replacement-panel"
                              data-replacement-panel
                              <%= [
                                "unabgemeldet",
                                "zu_spaet_abgemeldet"
                              ].includes(selectedAttendance)
                                ? ""
                                : "hidden"
                              %>
                            >

                              <label class="attendance-control">

                                <span>
                                  Weiterer Ersatz
                                </span>

                                <select
                                  name="attendance[d<%= row.id %>][ReplacementDriverId]"
                                >

                                  <option value="">
                                    Kein weiterer Ersatz
                                  </option>

                                  <% availableReplacements.forEach((driver) => { %>

                                    <option value="<%= driver.id %>">
                                      <%= driver.name %>
                                    </option>

                                  <% }) %>

                                </select>

                              </label>

                            </div>

                          <% } %>

                        </div>

                      <% }) %>

                    </div>

                  </article>

                <% }) %>

              </div>


              <button
                class="button attendance-submit"
                type="submit"
              >
                Anwesenheit bestätigen
              </button>

              <% if (raceControlExcludedRows.length) { %>

<button
  type="button"
  class="button attendance-submit"
  data-toggle-attendance-corrections
>
  Ausgeschiedene Fahrer bearbeiten
</button>

<% } %>

            </form>

            <% if (raceControlExcludedRows.length) { %>

  <div
    class="attendance-corrections"
    data-attendance-corrections
    hidden
  >

    <div class="attendance-corrections-heading">

      <span>
        KORREKTUR
      </span>

      <h3>
        AUSGESCHIEDENE FAHRER
      </h3>

      <p>
        Hier können versehentlich als unabgemeldet oder
        zu spät abgemeldet gespeicherte Fahrer korrigiert werden.
      </p>

    </div>


    <form
      method="post"
      action="/admin/race-weekend/f1/<%= race.id %>/attendance"
      class="attendance-correction-form"
    >

      <div class="lineup-team-grid">

        <%
          const excludedByTeam =
            new Map();

          raceControlExcludedRows.forEach(({
            entry,
            displayTeam,
            currentReplacement
          }) => {

            const teamId =
              displayTeam?.id ||
              entry.TeamId ||
              "unknown";

            if (
              !excludedByTeam.has(
                teamId,
              )
            ) {
              excludedByTeam.set(
                teamId,
                {
                  team:
                    displayTeam,

                  rows:
                    []
                },
              );
            }

            excludedByTeam
              .get(teamId)
              .rows
              .push({
                entry,
                currentReplacement
              });
          });
        %>


        <% excludedByTeam.forEach(({ team, rows }) => { %>

          <article
            class="lineup-team-card"
            style="--team-color:<%= team?.accentColor || '#6ef2f2' %>"
          >

            <header>

              <% if (team?.logoPath) { %>

                <img
                  src="<%= team.logoPath %>"
                  alt="Logo <%= team.name %>"
                >

              <% } else { %>

                <div class="roster-logo-fallback">
                  <%= (team?.name || "TEAM")
                    .slice(0, 2)
                    .toUpperCase()
                  %>
                </div>

              <% } %>


              <div>

                <span>
                  TEAM
                </span>

                <h3>
                  <%= team?.name || "Saisonteam" %>
                </h3>

              </div>

            </header>


            <div class="lineup-regular-list">

              <% rows.forEach(({ entry: row, currentReplacement }) => { %>

                <div class="attendance-team-row">

                  <div class="attendance-driver-head">

                    <div class="lineup-driver-name">

                      <strong>
                        #<%= row.driver.id %>
                        ·
                        <%= row.driver.name %>
                      </strong>


                      <small>

                        <% if (row.roleType === "reserve" && row.replacementFor) { %>

                          Ersatz für
                          <%= row.replacementFor.name %>

                        <% } else { %>

                          Stammfahrer

                        <% } %>

                      </small>

                    </div>

                  </div>


                  <div class="attendance-main-controls">

                    <label class="attendance-control">

                      <span>
                        Anwesenheit korrigieren
                      </span>

                      <select
                        name="correction[d<%= row.id %>][status]"
                      >

                        <% attendanceStatuses.forEach((status) => { %>

                          <option
                            value="<%= status.value %>"
                            <%= row.attendanceStatus === status.value
                              ? "selected"
                              : ""
                            %>
                          >
                            <%= status.label %>
                          </option>

                        <% }) %>

                      </select>

                    </label>

                  </div>


                  <% if (currentReplacement?.driver) { %>

                    <div class="attendance-current-replacement">

                      <span>
                        AKTUELLER ERSATZ
                      </span>

                      <strong>
                        <%= currentReplacement.driver.name %>
                      </strong>

                      <small>
                        Wird automatisch wieder freigegeben,
                        wenn <%= row.driver.name %> auf
                        „Anwesend“ oder „Zu spät Vorbesprechung“
                        korrigiert wird.
                      </small>

                    </div>

                  <% } %>

                </div>

              <% }) %>

            </div>

          </article>

        <% }) %>

      </div>


      <button
        class="button attendance-submit"
        type="submit"
      >
        Korrekturen speichern
      </button>

    </form>

  </div>

<% } %>

          <% } %>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- SCHRITT 3 -->
      <!-- ================================================= -->

      <section class="weekend-step" id="ergebnisse">

        <div class="weekend-step-number">
          03
        </div>

        <div>

          <span>
            RENNERGEBNIS
          </span>

          <h2>
            ERGEBNISSE EINTRAGEN
          </h2>

          <p>
            Nur die aus der Anwesenheitskontrolle tatsächlich startenden Fahrer
            werden automatisch übernommen. Plätze reichen aus; das Punktesystem
            berechnet die Punkte anschließend automatisch.
          </p>

          <a
            class="button"
            href="<%= resultsHref %>"
          >
            Ergebnistabelle öffnen
          </a>

        </div>

      </section>

    <% } %>

  </div>
</section>


<script
  src="/js/race-weekend.js"
  defer
></script>
<script src="/js/f1-race-control.js" defer></script>

<%- include('../partials/footer') %>
