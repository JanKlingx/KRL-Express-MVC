<%
  /*
   * =====================================================
   * HILFSFUNKTIONEN
   * =====================================================
   */

  const normalizeStatus = (result) =>
    String(result?.status || '')
      .trim()
      .toUpperCase();


  const isDns = (result) =>
    normalizeStatus(result) === 'DNS';


  const displayPoints = (result) => {
    if (!result) {
      return 0;
    }

    const points =
      Number(result.points);

    return Number.isFinite(points)
      ? points
      : 0;
  };


  const hasRealResult = (result) => {
    if (!result) {
      return false;
    }

    return Boolean(
      result.position ||
      result.fastestLap ||
      (
        result.status &&
        normalizeStatus(result) !== 'DNS'
      ) ||
      Number(result.points)
    );
  };


  /*
   * Stammfahrer:
   *
   * DNS wird nur angezeigt, wenn die Logik
   * tatsächlich DNS geliefert hat.
   *
   * Noch nicht gefahrene Rennen bleiben "-".
   */
  const regularDisplayState = (
    result,
    race
  ) => {

    if (!race?.isCompleted) {
      return 'future';
    }

    if (isDns(result)) {
      return 'dns';
    }

    if (hasRealResult(result)) {
      return 'result';
    }

    return 'empty';
  };


  /*
   * Ersatzfahrer:
   *
   * Vergangenes Rennen ohne Einsatz = DNS
   * Zukünftiges Rennen = -
   */
  const reserveDisplayState = (
    result,
    race
  ) => {

    if (!race?.isCompleted) {
      return 'future';
    }

    if (
      isDns(result) ||
      !hasRealResult(result)
    ) {
      return 'dns';
    }

    return 'result';
  };
%>


<% if (history.seasons.length && selectedHistory) { %>


  <!-- ================================================= -->
  <!-- SAISON -->
  <!-- ================================================= -->

  <div class="season-history-toolbar">

    <div>

      <span class="season-history-kicker">
        SAISONVERLAUF
      </span>

      <strong>
        <%= selectedHistory.name %>
      </strong>

    </div>

  </div>


  <% if (history.warning && isAdmin) { %>

    <div
      class="history-notice"
      role="status"
    >
      <%= history.warning %>
    </div>

  <% } %>


  <!-- ================================================= -->
  <!-- CHART -->
  <!-- ================================================= -->

  <div class="season-chart-card">

    <div class="season-chart-heading">

      <div>

        <span>
          PUNKTEENTWICKLUNG
        </span>

        <h3>
          <%= selectedHistory.name %>
        </h3>

      </div>

      <p>
        Die acht bestplatzierten Stammfahrer im Saisonverlauf.
      </p>

    </div>


    <div class="season-chart-scroll">

      <div
        class="season-chart"
        data-season-chart
        aria-label="Punkteverlauf <%= selectedHistory.name %>"
      ></div>

    </div>


    <div
      class="season-chart-legend"
      data-season-legend
    ></div>


    <%
      const chartPayload =
        JSON.stringify({
          races:
            selectedHistory.races,

          drivers:
            selectedHistory.drivers.slice(
              0,
              8
            )
        })
          .replace(
            /</g,
            "\\u003c"
          );
    %>


    <script
      type="application/json"
      data-season-chart-data
    ><%- chartPayload %></script>

  </div>


  <!-- ================================================= -->
  <!-- WERTUNGSUMSCHALTER -->
  <!-- ================================================= -->

  <div class="season-history-switch">

    <button
      type="button"
      class="season-history-tab is-active"
      data-history-tab="regular"
    >

      <span>
        STAMM
      </span>

      <strong>
        Stammfahrerwertung
      </strong>

      <small>
        <%= selectedHistory.drivers.length %> Fahrer
      </small>

    </button>


    <button
      type="button"
      class="season-history-tab"
      data-history-tab="reserve"
    >

      <span>
        ERSATZ
      </span>

      <strong>
        Ersatzfahrerwertung
      </strong>

      <small>
        <%= (selectedHistory.reserveDrivers || []).length %> Fahrer
      </small>

    </button>

  </div>


  <!-- ================================================= -->
  <!-- STAMMFAHRER -->
  <!-- ================================================= -->

  <div
    class="season-history-panel"
    data-history-panel="regular"
  >

    <div class="season-history-panel-header">

      <div>

        <span>
          STAMMFAHRER
        </span>

        <strong>
          Meisterschaftsverlauf
        </strong>

      </div>

      <small>
        Angezeigt werden die erzielten Punkte pro Rennwochenende.
      </small>

    </div>


    <div class="table-wrap season-history-table season-history-points-table">

      <table>

        <thead>

          <tr>

            <th class="history-position-column">
              Pos.
            </th>

            <th class="history-driver-column">
              Fahrer
            </th>

            <th class="history-team-column">
              Team
            </th>


            <% selectedHistory.races.forEach((race) => { %>

              <th
                class="
                  history-race-head
                  <%= race.hasSprint ? 'has-sprint' : '' %>
                  <%= race.isCompleted ? 'is-completed' : 'is-upcoming' %>
                "
                title="Runde <%= race.round %> · <%= race.title %>"
              >

                <div class="history-race-flag">

                  <% if (race.countryFlagPath) { %>

                    <img
                      src="<%= race.countryFlagPath %>"
                      alt="<%= race.countryName || race.title || '' %>"
                      title="<%= race.countryName || race.title || '' %>"
                    >

                  <% } else { %>

                    <span>
                      <%= race.code %>
                    </span>

                  <% } %>

                </div>


                <small>
                  R<%= race.round %>
                </small>


                <% if (race.hasSprint) { %>

                  <span class="history-sprint-marker">
                    SPRINT
                  </span>

                <% } %>

              </th>

            <% }) %>


            <th class="history-stat-head">
              ∑
            </th>

            <th class="history-stat-head">
              Δ
            </th>

            <th class="history-stat-head">
              Ø
            </th>

          </tr>

        </thead>


        <tbody>

          <% selectedHistory.drivers.forEach((driver) => { %>

            <tr
              class="
                season-position-<%= driver.position %>
                <%= driver.isFormerDriver ? 'is-former-driver' : '' %>
              "
            >


              <!-- POSITION -->

              <td class="history-position-cell">

                <strong class="history-standing-position">
                  <%= driver.position %>
                </strong>

              </td>


              <!-- FAHRER -->

              <td class="history-driver-cell">

                <strong>
                  <%= driver.name %>
                </strong>


                <% if (driver.isFormerDriver) { %>

                  <small class="history-driver-state">

                    Ehemalig

                    <% if (driver.regularToRound) { %>
                      · bis R<%= driver.regularToRound %>
                    <% } %>

                  </small>


                <% } else if (
                  driver.regularFromRound &&
                  driver.regularFromRound > 1
                ) { %>

                  <small class="history-driver-state">
                    ab R<%= driver.regularFromRound %> Stammfahrer
                  </small>

                <% } %>

              </td>


              <!-- TEAM -->

              <td class="team-logo-cell history-team-cell">

                <% if (driver.teamLogoPath) { %>

                  <img
                    src="<%= driver.teamLogoPath %>"
                    alt="<%= driver.team || 'Team' %>"
                    title="<%= driver.team || '' %>"
                    class="team-logo-inline team-logo-history"
                  >

                <% } else { %>

                  <span>
                    <%= driver.team || "–" %>
                  </span>

                <% } %>

              </td>


              <!-- RENNWOCHENENDEN -->

              <% driver.results.forEach((weekendResult, resultIndex) => {

                const race =
                  selectedHistory.races[resultIndex];

                const main =
                  weekendResult.main ||
                  (
                    !Object.prototype
                      .hasOwnProperty
                      .call(
                        weekendResult,
                        'main'
                      )
                      ? weekendResult
                      : null
                  );

                const sprint =
                  weekendResult.sprint;

                const mainState =
                  regularDisplayState(
                    main,
                    race
                  );

                const sprintState =
                  regularDisplayState(
                    sprint,
                    race
                  );

              %>


                <td
                  class="
                    history-weekend-cell
                    <%= race?.hasSprint ? 'has-sprint-weekend' : '' %>
                    <%= !race?.isCompleted ? 'is-upcoming-cell' : '' %>
                  "
                >


                  <% if (race?.hasSprint) { %>

                    <div class="history-weekend-stack">


                      <!-- SPRINT -->

                      <div class="history-weekend-result history-weekend-sprint">

                        <span class="history-result-type">
                          S
                        </span>


                        <div class="history-result-points">

                          <% if (sprintState === 'future') { %>

                            <span class="history-no-result">
                              –
                            </span>


                          <% } else if (sprintState === 'dns') { %>

                            <span class="history-dns">
                              DNS
                            </span>


                          <% } else if (sprintState === 'result') { %>

                            <strong>
                              <%= displayPoints(sprint) %>
                            </strong>

                            <small>
                              PKT
                            </small>


                          <% } else { %>

                            <span class="history-no-result">
                              –
                            </span>

                          <% } %>

                        </div>

                      </div>


                      <!-- HAUPTRENNEN -->

                      <div class="history-weekend-result history-weekend-main">

                        <span class="history-result-type">
                          GP
                        </span>


                        <div class="history-result-points">

                          <% if (mainState === 'future') { %>

                            <span class="history-no-result">
                              –
                            </span>


                          <% } else if (mainState === 'dns') { %>

                            <span class="history-dns">
                              DNS
                            </span>


                          <% } else if (mainState === 'result') { %>

                            <strong>
                              <%= displayPoints(main) %>
                            </strong>

                            <small>
                              PKT
                            </small>


                          <% } else { %>

                            <span class="history-no-result">
                              –
                            </span>

                          <% } %>

                        </div>

                      </div>

                    </div>


                  <% } else { %>

                    <div class="history-single-result history-result-points">

                      <% if (mainState === 'future') { %>

                        <span class="history-no-result">
                          –
                        </span>


                      <% } else if (mainState === 'dns') { %>

                        <span class="history-dns">
                          DNS
                        </span>


                      <% } else if (mainState === 'result') { %>

                        <strong>
                          <%= displayPoints(main) %>
                        </strong>

                        <small>
                          PKT
                        </small>


                      <% } else { %>

                        <span class="history-no-result">
                          –
                        </span>

                      <% } %>

                    </div>

                  <% } %>

                </td>

              <% }) %>


              <!-- GESAMTPUNKTE -->

              <td class="season-total">

                <strong>
                  <%= driver.total %>
                </strong>

              </td>


              <!-- RÜCKSTAND -->

              <td class="history-stat-cell">

                <%= driver.position === 1
                  ? 'Leader'
                  : `+${Math.abs(driver.gap)}`
                %>

              </td>


              <!-- DURCHSCHNITT -->

              <td class="history-stat-cell">

                <%= Number(driver.average)
                  .toFixed(1)
                  .replace(".", ",")
                %>

              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- ERSATZFAHRER -->
  <!-- ================================================= -->

  <div
    class="season-history-panel season-history-panel-reserve"
    data-history-panel="reserve"
    hidden
  >


    <% if ((selectedHistory.reserveDrivers || []).length) { %>


      <div class="season-history-panel-header">

        <div>

          <span>
            ERSATZFAHRER
          </span>

          <strong>
            Ersatzfahrerwertung
          </strong>

        </div>

        <small>
          Vergangene Rennen ohne Einsatz = DNS · zukünftige Rennen = –
        </small>

      </div>


      <div class="table-wrap season-history-table season-history-reserve-table season-history-points-table">

        <table>

          <thead>

            <tr>

              <th class="history-position-column">
                Pos.
              </th>

              <th class="history-driver-column">
                Ersatzfahrer
              </th>

              <th class="history-team-column">
                Team
              </th>


              <% selectedHistory.races.forEach((race) => { %>

                <th
                  class="
                    history-race-head
                    <%= race.hasSprint ? 'has-sprint' : '' %>
                    <%= race.isCompleted ? 'is-completed' : 'is-upcoming' %>
                  "
                  title="Runde <%= race.round %> · <%= race.title %>"
                >

                  <div class="history-race-flag">

                    <% if (race.countryFlagPath) { %>

                      <img
                        src="<%= race.countryFlagPath %>"
                        alt="<%= race.countryName || race.title || '' %>"
                        title="<%= race.countryName || race.title || '' %>"
                      >

                    <% } else { %>

                      <span>
                        <%= race.code %>
                      </span>

                    <% } %>

                  </div>


                  <small>
                    R<%= race.round %>
                  </small>


                  <% if (race.hasSprint) { %>

                    <span class="history-sprint-marker">
                      SPRINT
                    </span>

                  <% } %>

                </th>

              <% }) %>


              <th class="history-stat-head">
                ∑
              </th>

              <th class="history-stat-head">
                Δ
              </th>

              <th class="history-stat-head">
                Ø
              </th>

            </tr>

          </thead>


          <tbody>

            <% (selectedHistory.reserveDrivers || [])
              .forEach((driver) => {
            %>

              <tr class="reserve-history-row">


                <!-- POSITION -->

                <td class="history-position-cell">

                  <strong class="history-standing-position">
                    <%= driver.position %>
                  </strong>

                </td>


                <!-- FAHRER -->

                <td class="history-driver-cell">

                  <strong>
                    <%= driver.name %>
                  </strong>


                  <% if (driver.promotedToRegular) { %>

                    <small class="history-driver-state">
                      ab R<%= driver.promotedFromRound %> Stammfahrer
                    </small>

                  <% } %>

                </td>


                <!-- TEAM -->

                <td class="team-logo-cell history-team-cell">

                  <% if (driver.teamLogoPath) { %>

                    <img
                      src="<%= driver.teamLogoPath %>"
                      alt="<%= driver.team || 'Team' %>"
                      title="<%= driver.team || '' %>"
                      class="team-logo-inline team-logo-history"
                    >

                  <% } else if (driver.team) { %>

                    <span>
                      <%= driver.team %>
                    </span>

                  <% } else { %>

                    <span>
                      –
                    </span>

                  <% } %>

                </td>


                <!-- RENNWOCHENENDEN -->

                <% driver.results.forEach((weekendResult, resultIndex) => {

                  const race =
                    selectedHistory.races[resultIndex];

                  const main =
                    weekendResult.main;

                  const sprint =
                    weekendResult.sprint;

                  const mainState =
                    reserveDisplayState(
                      main,
                      race
                    );

                  const sprintState =
                    reserveDisplayState(
                      sprint,
                      race
                    );

                %>


                  <td
                    class="
                      history-weekend-cell
                      <%= race?.hasSprint ? 'has-sprint-weekend' : '' %>
                      <%= !race?.isCompleted ? 'is-upcoming-cell' : '' %>
                    "
                  >


                    <% if (race?.hasSprint) { %>

                      <div class="history-weekend-stack">


                        <!-- SPRINT -->

                        <div class="history-weekend-result history-weekend-sprint">

                          <span class="history-result-type">
                            S
                          </span>


                          <div class="history-result-points">

                            <% if (sprintState === 'future') { %>

                              <span class="history-no-result">
                                –
                              </span>


                            <% } else if (sprintState === 'dns') { %>

                              <span class="history-dns">
                                DNS
                              </span>


                            <% } else { %>

                              <strong>
                                <%= displayPoints(sprint) %>
                              </strong>

                              <small>
                                PKT
                              </small>

                            <% } %>

                          </div>

                        </div>


                        <!-- HAUPTRENNEN -->

                        <div class="history-weekend-result history-weekend-main">

                          <span class="history-result-type">
                            GP
                          </span>


                          <div class="history-result-points">

                            <% if (mainState === 'future') { %>

                              <span class="history-no-result">
                                –
                              </span>


                            <% } else if (mainState === 'dns') { %>

                              <span class="history-dns">
                                DNS
                              </span>


                            <% } else { %>

                              <strong>
                                <%= displayPoints(main) %>
                              </strong>

                              <small>
                                PKT
                              </small>

                            <% } %>

                          </div>

                        </div>

                      </div>


                    <% } else { %>

                      <div class="history-single-result history-result-points">

                        <% if (mainState === 'future') { %>

                          <span class="history-no-result">
                            –
                          </span>


                        <% } else if (mainState === 'dns') { %>

                          <span class="history-dns">
                            DNS
                          </span>


                        <% } else { %>

                          <strong>
                            <%= displayPoints(main) %>
                          </strong>

                          <small>
                            PKT
                          </small>

                        <% } %>

                      </div>

                    <% } %>

                  </td>

                <% }) %>


                <td class="season-total">

                  <strong>
                    <%= driver.total %>
                  </strong>

                </td>


                <td class="history-stat-cell">

                  <%= driver.position === 1
                    ? 'Leader'
                    : `+${Math.abs(driver.gap)}`
                  %>

                </td>


                <td class="history-stat-cell">

                  <%= Number(driver.average)
                    .toFixed(1)
                    .replace(".", ",")
                  %>

                </td>

              </tr>

            <% }) %>

          </tbody>

        </table>

      </div>


    <% } else { %>

      <div class="empty-state">
        In dieser Saison wurde bisher kein Ersatzfahrer eingesetzt.
      </div>

    <% } %>

  </div>


<% } else { %>

  <div class="empty-state">
    Noch keine Ergebnisse eingetragen.
  </div>

<% } %>