<section
  id="setup-finish"
  class="setup-panel setup-finish-panel"
>

  <div class="setup-panel-number">
    08
  </div>

  <div class="setup-panel-content">

    <span>
      Kontrolle vor Veröffentlichung
    </span>

    <h2>
      ABSCHLUSS
    </h2>


    <!-- =============================== -->
    <!-- STATUS ÜBERSICHT -->
    <!-- =============================== -->

    <div class="setup-final-summary">

      <article class="setup-final-card">
        <span>Liga</span>

        <strong>
          <%= selectedLeague.name %>
        </strong>
      </article>


      <article class="setup-final-card">
        <span>Saison</span>

        <strong>
          <%= selectedSeason.name %>
        </strong>
      </article>


      <article class="setup-final-card">
        <span>Kalender</span>

        <strong>
          <%= calendar.length %>
        </strong>

        <small>
          Termine
        </small>
      </article>


      <article class="setup-final-card">
        <span>Fahrer</span>

        <strong>
          <%= setupStructure.allDrivers.length %>
        </strong>

        <small>
          ausgewählt
        </small>
      </article>


      <article class="setup-final-card">
        <span>Teams</span>

        <strong>
          <%= setupStructure.teams.length %>
        </strong>

        <small>
          ausgewählt
        </small>
      </article>


      <article class="setup-final-card">
        <span>Ersatzfahrer</span>

        <strong>
          <%= setupStructure.unassignedDrivers.length %>
        </strong>

        <small>
          verfügbar
        </small>
      </article>

    </div>


    <!-- =============================== -->
    <!-- LINE-UP KONTROLLE -->
    <!-- =============================== -->

    <div class="setup-finish-lineup">

      <div class="setup-finish-section-heading">

        <div>
          <span>
            Saison-Line-up
          </span>

          <h3>
            STAMMFAHRER
          </h3>
        </div>

        <strong>
          <%= setupStructure.allDrivers.length - setupStructure.unassignedDrivers.length %>
          zugeordnet
        </strong>

      </div>


      <div class="setup-finish-team-grid">

        <% setupStructure.teams.forEach((team) => { %>

          <article
            class="setup-finish-team"
            style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
          >

            <div class="setup-finish-team-head">

              <% if (team.logoPath) { %>

                <img
                  src="<%= team.logoPath %>"
                  alt=""
                >

              <% } %>

              <div>
                <span>
                  Saisonteam
                </span>

                <strong>
                  <%= team.name %>
                </strong>
              </div>

            </div>


            <div class="setup-finish-team-drivers">

              <% if ((team.drivers || []).length) { %>

                <% team.drivers.forEach((driver, index) => { %>

                  <div class="setup-finish-driver">

                    <span>
                      <%= index + 1 %>
                    </span>

                    <strong>
                      <%= driver.name %>
                    </strong>

                  </div>

                <% }) %>

              <% } else { %>

                <div class="setup-finish-driver is-empty">
                  Kein Stammfahrer zugeordnet
                </div>

              <% } %>

            </div>

          </article>

        <% }) %>

      </div>

    </div>


    <!-- =============================== -->
    <!-- ERSATZFAHRER -->
    <!-- =============================== -->

    <div class="setup-finish-reserves">

      <div class="setup-finish-section-heading">

        <div>
          <span>
            Nicht einem Team zugeordnet
          </span>

          <h3>
            ERSATZFAHRER
          </h3>
        </div>

        <strong>
          <%= setupStructure.unassignedDrivers.length %>
        </strong>

      </div>


      <% if (setupStructure.unassignedDrivers.length) { %>

        <div class="setup-reserve-driver-grid">

          <% setupStructure.unassignedDrivers.forEach((driver) => { %>

            <div class="setup-reserve-driver">

              <div class="setup-reserve-driver-number">
                <%= driver.number ? `#${driver.number}` : 'RES' %>
              </div>

              <div>
                <strong>
                  <%= driver.name %>
                </strong>

                <small>
                  Ersatzfahrer
                </small>
              </div>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="empty-state">
          Aktuell gibt es keine Ersatzfahrer.
        </div>

      <% } %>

    </div>


    <!-- =============================== -->
    <!-- ABSCHLIESSEN -->
    <!-- =============================== -->

    <div class="setup-finish-action">

      <div>

        <% if (setupFinishReady) { %>

          <strong>
            Saison ist vollständig eingerichtet.
          </strong>

          <p>
            Kalender, Punktesystem, Fahrer, Teams und Line-up
            sind vorhanden.
          </p>

        <% } else { %>

          <strong>
            Saison ist noch nicht vollständig.
          </strong>

          <p>
            Kalender, Punktesystem, Fahrer, Teams und mindestens
            eine Line-up-Zuordnung sind erforderlich.
          </p>

        <% } %>

      </div>


      <form
        method="post"
        action="/admin/season-setup/<%= selectedSeason.id %>/finish"
      >

        <button
          class="button"
          <%= setupFinishReady ? '' : 'disabled' %>
        >
          Saison abschließen & veröffentlichen
        </button>

      </form>

    </div>

  </div>

</section>


    <% } %>


  </div>
</section>


