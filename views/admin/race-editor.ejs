<%- include('../partials/header', { title }) %>
<% const currentMode = typeof currentOnly === 'boolean' ? currentOnly : false; %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">Formel 1 · Tabellenpflege</span><h1><%= currentMode ? 'ERGEBNISSE EINTRAGEN' : 'HISTORISCHEN SAISONVERLAUF PFLEGEN' %></h1><p class="admin-intro"><%= currentMode ? 'Aus der Anwesenheitskontrolle werden nur bestätigte Fahrer geladen. Danach wie in einem Google Sheet Plätze eintragen; Punkte und Teams folgen automatisch.' : 'Liga, historische Saison und Rennen auswählen. Line-Up und Ersatzfahrer kommen aus dem Saison-Assistenten.' %></p></div><% if (selectedSeason?.status === 'active') { %><a class="button button-ghost" href="/admin/race-weekend/f1?league=<%= selectedLeague?.id || '' %>&season=<%= selectedSeason.id %>&race=<%= selectedRace?.id || '' %>">Zurück zum Rennwochenende</a><% } %></div>

  <form class="race-selector" method="get" action="<%= currentMode ? '/admin/current-season-progress' : '/admin/race-editor' %>">
    <label for="league">Liga</label><select id="league" name="league"><% leagues.forEach((league) => { %><option value="<%= league.id %>" <%= selectedLeague?.id === league.id ? 'selected' : '' %>><%= league.name %></option><% }) %></select>
    <% if (currentMode) { %><label>Aktuelle Saison</label><strong><%= selectedSeason?.name || 'Noch keine aktive Saison' %></strong><% } else { %><label for="season">Saison</label><select id="season" name="season"><%- include('../partials/season-options', { seasons, selectedSeason }) %></select><% } %>
    <label for="race">Rennen</label><select id="race" name="race"><% races.forEach((race) => { %><option value="<%= race.id %>" <%= selectedRace?.id === race.id ? 'selected' : '' %>>R<%= race.sortOrder %> · <%= race.title %></option><% }) %></select>
    <noscript><button class="button button-small" type="submit">Öffnen</button></noscript>
  </form>

  <div class="workflow-hint"><strong>Rennen fehlen oder sind falsch?</strong> <a href="/admin/season-calendar?league=<%= selectedLeague?.id || '' %>&season=<%= selectedSeason?.id || '' %>">Rennkalender dieser Saison bearbeiten →</a></div>

  <% if (selectedSeason) { %><div class="season-progress-context">
    <div><span>VERBINDLICHE DATENQUELLE</span><strong><%= selectedLeague.name %> · <%= selectedSeason.name %></strong><small>Es werden ausschließlich Rennen aus dem Rennkalender dieser Saison geladen. Verwaiste oder fremde Ergebnisse bleiben ausgeblendet.</small></div>
    <div class="season-progress-count"><strong><%= races.length %></strong><span>Kalender-Rennen</span></div>
  </div><% } %>

  <% if (races.length) { %><nav class="season-race-tabs" aria-label="Rennen dieser Saison">
    <% races.forEach((race) => { const calendarRace = race.calendarEvent; %><a class="<%= selectedRace?.id === race.id ? 'is-active' : '' %>" href="<%= currentMode ? '/admin/current-season-progress' : '/admin/race-editor' %>?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&race=<%= race.id %>"><span>R<%= calendarRace?.sortOrder || race.sortOrder %></span><strong><%= calendarRace?.circuit || race.circuit || race.title %></strong><small><%= calendarRace?.isTestDay ? 'Testtag' : 'Rennen' %></small></a><% }) %>
  </nav><% } %>

  <% if (!selectedRace) { %><div class="empty-state">Für diese Saison gibt es noch kein Rennen. Lege die Termine im Saison-Assistenten oder in der Rennkalender-Pflege an.</div><% } else { %>
    <% if (!currentMode) { %><div class="race-settings-bar">
      <form method="post" action="/admin/race-editor/<%= selectedRace.id %>/settings" class="compact-admin-form"><label>Eingabemodus<select name="pointsMode"><option value="database" <%= selectedRace.pointsMode === 'database' ? 'selected' : '' %>>Plätze → Punkte aus Datenbank</option><option value="manual" <%= selectedRace.pointsMode === 'manual' ? 'selected' : '' %>>Punkte direkt eingeben</option></select></label><label class="checkbox-control"><input type="checkbox" name="hasSprint" <%= sprintRace ? 'checked' : '' %>><span>Sprint-Spalte</span></label><button class="button button-small" type="submit">Rennen aktualisieren</button></form>
      <form method="post" action="/admin/race-editor/<%= selectedRace.id %>?_method=DELETE" data-confirm="Rennen einschließlich Sprint und Ergebnissen wirklich löschen?"><button class="button button-ghost button-small" type="submit">Rennen löschen</button></form>
    </div><% } %>

    <% if (selectedSeason.status === 'historical') { %><div class="historical-driver-picker"><div><strong>Historisches Fahrerfeld</strong><span><%= historicalDriverIds.length %> von maximal 20 Fahrern hinzugefügt</span></div><form method="get" action="/admin/race-editor"><input type="hidden" name="league" value="<%= selectedLeague.id %>"><input type="hidden" name="season" value="<%= selectedSeason.id %>"><input type="hidden" name="race" value="<%= selectedRace.id %>"><input type="hidden" name="drivers" value="<%= historicalDriverIds.join(',') %>"><label for="historical-driver-search">Fahrer suchen</label><input id="historical-driver-search" type="search" list="historical-driver-options" name="addDriver" <%= historicalDriverIds.length >= 20 ? 'disabled' : 'required' %> placeholder="Name oder ID eingeben"><datalist id="historical-driver-options"><% availableDrivers.filter((driver) => !historicalDriverIds.includes(driver.id)).forEach((driver) => { %><option value="<%= driver.id %>" label="#<%= driver.id %> · <%= driver.name %><%= driver.aliases.length ? ` · ${driver.aliases.map((alias) => alias.alias).join(', ')}` : '' %>"></option><% }) %></datalist><button class="button button-small" type="submit" <%= historicalDriverIds.length >= 20 ? 'disabled' : '' %>>+ Fahrer hinzufügen</button></form><div class="historical-driver-chips"><% rows.forEach(({ driver }) => { const remaining = historicalDriverIds.filter((id) => id !== driver.id).join(','); %><a href="/admin/race-editor?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&race=<%= selectedRace.id %>&drivers=<%= remaining %>"><%= driver.name %> ×</a><% }) %></div></div><% } %>

    <form method="post" action="/admin/race-editor/<%= selectedRace.id %>" class="race-sheet-form">
      <input type="hidden" name="_return" value="<%= currentMode ? 'current' : 'all' %>">
      <% const hasSavedEntries = rows.some(({ entry, sprintEntry }) => entry || sprintEntry); %>
      <div class="race-sheet-heading"><div><span><%= selectedRace.league.name %> · <%= selectedSeason.name %> · R<%= selectedRace.calendarEvent?.sortOrder || selectedRace.sortOrder %></span><h2><%= selectedRace.calendarEvent?.title || selectedRace.title %></h2><small><%= sprintRace ? 'Sprint und Hauptrennen · zwei Ergebnis-Spalten aktiv' : 'Hauptrennen' %></small></div><button class="button" type="submit">Gesamte Tabelle speichern</button></div>
      <div class="table-wrap race-sheet"><table><thead><tr><th>Dabei</th><th>Fahrer / Aliase</th><th>Team</th><% if (selectedRace.pointsMode === 'manual') { %><th>GP-Punkte</th><% } else { %><th>GP-Platz</th><th>SR</th><% } %><% if (sprintRace) { if (sprintRace.pointsMode === 'manual') { %><th>Sprint-Punkte</th><% } else { %><th>Sprint-Platz</th><th>Sprint-SR</th><% } } %><th>Status</th><th>Rennsperre</th></tr></thead><tbody>
        <% rows.forEach(({ driver, entry, sprintEntry, assignedTeam, isReserve, planned, replacesDriver, raceBan }) => { const activeEntry = entry || sprintEntry; const includedByDefault = !hasSavedEntries && selectedSeason.status === 'active' && (planned || (assignedTeam && !isReserve)); %><tr class="<%= activeEntry ? 'sheet-row-active' : '' %>" style="--row-team-color:<%= assignedTeam?.accentColor || '#6ef2f2' %>">
          <td><% if (selectedSeason.status === 'historical') { %><input type="hidden" name="rows[<%= driver.id %>][included]" value="on"><span class="id-badge">Dabei</span><% } else { %><input type="checkbox" name="rows[<%= driver.id %>][included]" <%= activeEntry || includedByDefault ? 'checked' : '' %> aria-label="<%= driver.name %> berücksichtigen"><% } %></td>
          <td><div class="sheet-driver-identity"><% if (isReserve) { %><img src="/images/krl-placeholder.svg" alt="KRL"><% } else if (assignedTeam?.logoPath) { %><img src="<%= assignedTeam.logoPath %>" alt="Logo <%= assignedTeam.name %>"><% } %><span><strong>#<%= driver.id %> · <%= driver.name %></strong><% if (driver.aliases.length) { %><small><%= driver.aliases.map((alias) => alias.alias).join(' · ') %></small><% } %></span></div></td>
          <td><% if (selectedSeason.status === 'active' && assignedTeam) { %><input type="hidden" name="rows[<%= driver.id %>][TeamId]" value="<%= assignedTeam.id %>"><strong><%= assignedTeam.name %></strong><% if (replacesDriver) { %><small>Ersatz für <%= replacesDriver.name %></small><% } %><% } else { %><select name="rows[<%= driver.id %>][TeamId]"><option value="">Team wählen …</option><% teams.forEach((team) => { %><option value="<%= team.id %>" <%= activeEntry?.teamName === team.name ? 'selected' : '' %>><%= team.name %></option><% }) %></select><% } %></td>
          <% if (selectedRace.pointsMode === 'manual') { %><td><input type="number" min="0" step="0.5" name="rows[<%= driver.id %>][points]" value="<%= entry ? Number(entry.points) : '' %>"></td><% } else { %><td><input type="number" min="1" name="rows[<%= driver.id %>][position]" value="<%= entry?.position || '' %>"></td><td><input type="checkbox" name="rows[<%= driver.id %>][fastestLap]" <%= entry?.fastestLap ? 'checked' : '' %>></td><% } %>
          <% if (sprintRace) { if (sprintRace.pointsMode === 'manual') { %><td><input type="number" min="0" step="0.5" name="rows[<%= driver.id %>][sprintPoints]" value="<%= sprintEntry ? Number(sprintEntry.points) : '' %>"></td><% } else { %><td><input type="number" min="1" name="rows[<%= driver.id %>][sprintPosition]" value="<%= sprintEntry?.position || '' %>"></td><td><input type="checkbox" name="rows[<%= driver.id %>][sprintFastestLap]" <%= sprintEntry?.fastestLap ? 'checked' : '' %>></td><% } } %>
          <td><select name="rows[<%= driver.id %>][status]"><% statuses.forEach((status) => { %><option value="<%= status %>" <%= String(entry?.status || sprintEntry?.status || '') === status ? 'selected' : '' %>><%= status || 'Gewertet' %></option><% }) %></select></td><td><label class="result-checkbox"><input type="checkbox" name="rows[<%= driver.id %>][raceBan]" <%= raceBan ? 'checked' : '' %>><span>In Strafkartei</span></label></td>
        </tr><% }) %>
      </tbody></table></div>
      <div class="sheet-help"><strong><%= selectedRace.pointsMode === 'manual' ? 'Direkte Punkteeingabe:' : 'Automatische Wertung:' %></strong> <%= selectedRace.pointsMode === 'manual' ? 'Für frühere Punktesysteme werden die eingetragenen Punkte unverändert gespeichert.' : 'Du trägst nur Plätze ein; die gültige Punktetabelle berechnet GP- und WM-Punkte.' %> Bei einem Sprint erscheinen die Sprintfelder direkt als zusätzliche Spalten.</div>
      <button class="button" type="submit">Gesamte Tabelle speichern</button>
    </form>
  <% } %>
</div></section>
<%- include('../partials/footer') %>
