{
  "name": "krl-express-mvc",
  "version": "1.0.0",
  "private": true,
  "description": "Katzes Racing League mit Express, MVC und MariaDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node scripts/setup.js",
    "import:history": "node scripts/import-season-history.js",
    "check": "node --check server.js && node --check app.js && node --check controllers/adminController.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-session-sequelize": "^8.0.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "mariadb": "^3.5.3",
    "method-override": "^3.0.0",
    "multer": "^2.0.2",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
