<%- include('partials/header', { title }) %>
<section class="league-hero competition-hero"><div class="container"><% if (pageLeague.logoPath) { %><img class="league-hero-logo" src="<%= pageLeague.logoPath %>" alt="Logo <%= pageLeague.name %>"><% } %><span class="eyebrow">DAS COMMUNITY-EVENT · <%= selectedSeason?.name || '' %></span><h1>WETTKAMPF<br><span>DER LIGEN</span></h1><p><%= pageLeague.description %></p><div class="facts"><span>Ligen <strong><%= leagues.length %></strong></span><span>Fahrer <strong>2 pro Liga</strong></span><span>Rennen <strong><%= races.length %></strong></span><span>Start <strong><%= pageLeague.raceTime %></strong></span></div></div></section>
<section class="season-switcher container"><form method="get"><label for="season-select">Saison auswählen</label><select id="season-select" name="season"><%- include('partials/season-options', { seasons, selectedSeason }) %></select><noscript><button class="button button-small" type="submit">Saison laden</button></noscript></form></section>
<% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/participatingLeagues">✎ WDL-Ligen</a><a href="/admin/wdlSeasonCalendar">✎ Rennkalender</a><a href="/admin/season-progress/wdl">✎ Saisonverlauf pro Rennen</a><a href="/admin/seasons">✎ Saisons</a></div><% } %>

<section class="section container"><div class="section-heading"><span>DIE HERAUSFORDERER</span><h2>TEILNEHMENDE LIGEN</h2></div><div class="league-grid"><% leagues.forEach((league) => { %><article class="league-card red"><div class="wdl-card-logos"><% if (league.logoPath) { %><img class="league-logo" src="<%= league.logoPath %>" alt="Liga-Logo <%= league.name %>"><% } else { %><div class="roster-logo-fallback"><%= league.name.slice(0, 2).toUpperCase() %></div><% } %><% if (league.f1Team?.logoPath) { %><img class="league-logo" src="<%= league.f1Team.logoPath %>" alt="Teamlogo <%= league.f1Team.name %>"><% } %></div><div class="league-badge"><%= league.abbreviation || 'LIGA' %></div><h3><%= league.name %></h3><p><%= league.f1Team ? `F1-Team: ${league.f1Team.name}` : (league.constructorName || 'F1-Team offen') %></p><% if (league.websiteUrl) { %><a href="<%= league.websiteUrl %>" target="_blank" rel="noopener">Liga besuchen →</a><% } %></article><% }) %></div></section>

<section class="section section-dark"><div class="container"><div class="section-heading"><span>SAISONTERMINE</span><h2>WDL-RENNKALENDER</h2></div><%- include('partials/race-calendar', { calendar, league: pageLeague, emptyMessage: 'Für diese Saison wurde noch kein Kalender veröffentlicht.' }) %></div></section>

<section class="section container" id="wdl-standings"><div class="section-heading"><span>AUTOMATISCH BERECHNET</span><h2>LIGA-STANDINGS</h2><div class="export-actions"><a class="download-link" href="/wettkampf-der-ligen/download/standings.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#wdl-standings" data-png-title="<%= pageLeague.name %> · Liga-Standings" data-png-subtitle="<%= selectedSeason?.name || '' %>" data-png-filename="wdl-standings" data-png-logo="<%= pageLeague.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= pageLeague.accentColor %>">PNG ↓</button></div></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Liga</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% standings.forEach((row) => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.league.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div><div class="wdl-chart" aria-label="Punktediagramm"><% const maxPoints = Math.max(1, ...standings.map((row) => row.points)); standings.forEach((row) => { %><div class="wdl-chart-row"><span><%= row.league.abbreviation || row.league.name %></span><div><i style="width:<%= Math.max(2, row.points / maxPoints * 100) %>%"></i></div><strong><%= row.points %></strong></div><% }) %></div></section>

<section class="section section-dark" id="wdl-results"><div class="container"><div class="section-heading"><span>ALLE EINZELERGEBNISSE</span><h2>WDL-RESULTS</h2><div class="export-actions"><a class="download-link" href="/wettkampf-der-ligen/download/results.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#wdl-results" data-png-title="<%= pageLeague.name %> · Results" data-png-subtitle="<%= selectedSeason?.name || '' %>" data-png-filename="wdl-results" data-png-logo="<%= pageLeague.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= pageLeague.accentColor %>">PNG ↓</button></div></div><% races.forEach((race) => { %><article class="wdl-result" data-png-section="R<%= race.sortOrder %> · <%= race.title %>"><h3>R<%= race.sortOrder %> · <%= race.title %></h3><div class="table-wrap"><table><thead><tr><th>Liga</th><th>Fahrer 1</th><th>Platz</th><th>Fahrer 2</th><th>Platz</th><th>Punkte</th></tr></thead><tbody><% race.wdlEntries.forEach((entry) => { %><tr><td><%= entry.participatingLeague?.name || '–' %></td><td><%= entry.driverOne?.name || '–' %></td><td><%= entry.positionOne || '–' %></td><td><%= entry.driverTwo?.name || '–' %></td><td><%= entry.positionTwo || '–' %></td><td><strong><%= Number(entry.totalPoints) %></strong></td></tr><% }) %></tbody></table></div></article><% }) %><% if (!races.length) { %><div class="empty-state">Noch keine WDL-Ergebnisse für diese Saison.</div><% } %></div></section>
<%- include('partials/footer') %>
