<% const columns=[['driverOfTheDay','Driver of the Day','driverOfTheDay'],['first','1. Platz',''],['second','2. Platz',''],['third','3. Platz',''],['pole','Poleposition','polePosition'],['fastestLap','Schnellste Runde','fastestLap']]; const editable=typeof editHistoricalStats!=='undefined'&&editHistoricalStats; %>
<div class="f1-race-statistics__scroll"><table class="race-statistics-pairs"><thead><tr><th rowspan="2">#</th><th rowspan="2">Land / Strecke</th><th rowspan="2">Datum</th><% columns.forEach(([,label])=>{ %><th colspan="2" scope="colgroup"><%= label %></th><% }); %><% if(editable){ %><th rowspan="2">Bearbeiten</th><% } %></tr><tr><% columns.forEach(()=>{ %><th scope="col">Fahrer</th><th scope="col">Team</th><% }); %></tr></thead><tbody>
<% statisticsRows.forEach(row=>{ %><tr data-historical-statistics-round="<%= row.round %>"><td data-label="Runde" class="race-statistics-round"><% if(row.flagPath){ %><img class="race-statistics-watermark" src="<%= row.flagPath %>" alt="" aria-hidden="true"><% } %>R<%= row.round %></td><th data-label="Land / Strecke"><%= row.countryCode||row.countryName||row.country||row.circuit||'–' %></th><td data-label="Datum"><%= row.date?new Intl.DateTimeFormat('de-DE').format(new Date(String(row.date).slice(0,10)+'T12:00:00Z')):'–' %></td><% columns.forEach(([key,label,award])=>{ %><td data-label="<%= label %> · Fahrer" <% if(award){ %>data-historical-statistic="<%= award %>"<% } %>><%= row[key]||'–' %></td><td class="race-statistic-team" data-label="<%= label %> · Team" <% if(award){ %>data-historical-statistic-team="<%= award %>"<% } %>><%= row[key+'Team']||'' %></td><% }); %><% if(editable){ %><td data-label="Bearbeiten"><button type="button" class="historical-statistics-edit" data-historical-statistics-open="<%= row.round %>" aria-label="Auszeichnungen für Runde <%= row.round %> bearbeiten">✎ Auszeichnungen bearbeiten</button></td><% } %></tr><% }); %>
<% if(!statisticsRows.length){ %><tr><td colspan="<%= editable?16:15 %>">Noch keine Hauptrennenergebnisse vorhanden.</td></tr><% } %>
</tbody></table></div>
