<%- include('partials/header', { title }) %>
<div class="league-page" style="--accent:<%= league.accentColor %>;--season-accent:<%= league.seasonAccentColor || league.accentColor %>">
<% const displayedRosters = typeof teamRosters !== 'undefined'
  ? teamRosters
  : (typeof cockpits !== 'undefined' ? cockpits : []); %>
<section class="league-hero lmu-hero"><div class="container"><% if (league.logoPath) { %><img class="league-hero-logo" src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } %><span class="eyebrow">LE MANS ULTIMATE · <%= league.currentSeason %></span><h1>LE MANS<br><span>ULTIMATE</span></h1><p><%= league.description %></p><div class="facts"><span>Renntag <strong><%= league.raceDay %></strong></span><span>Start <strong><%= league.raceTime %></strong></span><span>Format <strong>3 Fahrer pro Team</strong></span></div></div></section>
<nav class="container league-section-nav" aria-label="Liga-Bereiche"><a class="button button-small button-ghost" href="#f1-standings-history">WM-Tabelle</a><a class="button button-small button-ghost" href="#lmu-calendar">Rennkalender</a><a class="button button-small button-ghost" href="#lmu-gp-results">GP-Ergebnisse</a><a class="button button-small button-ghost" href="#lmu-grid">Fahrerfeld</a><a class="button button-small button-ghost" href="#season-history">Saisonverlauf</a><a class="button button-small button-ghost" href="/lmu/regelwerk">Regelwerk</a><a class="button button-small button-ghost" href="/lmu/race-director-notes">Race-Director Notes</a></nav>
<section class="season-switcher container"><form method="get"><label for="season-select">Saison auswählen</label><select id="season-select" name="season"><%- include('partials/season-options', { seasons, selectedSeason }) %></select><noscript><button class="button button-small" type="submit">Saison laden</button></noscript></form></section>
<% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/lmuTeams">✎ LMU-Teams</a><a href="/admin/lmu-driver-change?season=<%= selectedSeason?.id||'' %>">✎ Fahrerwechsel</a><a href="/admin/lmu-car-assignments">✎ Fahrer-Autos</a><a href="/admin/lmu-season-calendar?league=<%= league.id %>&season=<%= selectedSeason?.id || '' %>">✎ Rennkalender</a><a href="/admin/race-weekend/lmu?season=<%= selectedSeason?.id||'' %>">✎ Rennwochenende</a></div><% } %>
<section class="section container" id="lmu-grid"><div class="section-heading"><span>TEAMS · FAHRER · FAHRZEUGE</span><h2>LMU-FAHRERFELD</h2></div><div class="cockpit-grid league-team-grid"><% displayedRosters.forEach((roster) => { %><article class="cockpit-card league-team-card" style="--team-color:<%= roster.team.accentColor || league.accentColor || '#6ef2f2' %>"><header class="league-team-heading"><div class="cockpit-branding league-team-logo"><% if (roster.team.logoPath) { %><img class="cockpit-logo" src="<%= roster.team.logoPath %>" alt="Logo <%= roster.team.name %>"><% } else { %><div class="roster-logo-fallback"><%= roster.team.name.slice(0, 2).toUpperCase() %></div><% } %></div><h3><%= roster.team.name %></h3></header><ul aria-label="Fahrer von <%= roster.team.name %>"><% roster.drivers.forEach((driver) => { %><li class="lmu-driver-with-car"><strong title="<%= driver.lmuDisplayName || driver.name %>"><%= driver.lmuDisplayName || driver.name %></strong><% if (driver.lmuCar?.logoPath) { %><img src="<%= driver.lmuCar.logoPath %>" alt="Logo <%= driver.lmuCar.manufacturer %>" title="<%= driver.lmuCar.manufacturer %> <%= driver.lmuCar.name %>"><% } %></li><% }) %><% if (!roster.drivers.length) { %><li>Noch kein Fahrer zugeordnet</li><% } %></ul></article><% }) %><% if (!displayedRosters.length) { %><div class="empty-state">Noch keine LMU-Teams mit Fahrern angelegt.</div><% } %></div></section>
<section class="section section-dark" id="lmu-calendar"><div class="container"><div class="section-heading"><span>SAISONTERMINE</span><h2>LMU-RENNKALENDER</h2></div><%- include('partials/race-calendar', { calendar, league, emptyMessage: 'Noch keine LMU-Renntermine veröffentlicht.' }) %></div></section>
<%- include('partials/league-standings', { standingsHistory: typeof standingsHistory === 'undefined' ? [] : standingsHistory, teams: typeof teams === 'undefined' ? displayedRosters.map(r=>r.team) : teams, league, gpResults, selectedSeason }) %>
<section class="section container gp-results-section" id="lmu-gp-results"><div class="section-heading"><h2>LMU GP-RESULTS</h2><div class="export-actions"><a class="download-link" href="/lmu/download/results.csv?league=<%= encodeURIComponent(league.slug) %>&amp;season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a></div></div><%- include('partials/gp-results', { items: gpResults, label: 'LMU-Ergebnisse' }) %></section>
<section class="section section-dark season-history-section" id="season-history"><div class="container season-history-wide"><div class="section-heading"><h2>SAISONVERLAUF</h2></div><%- include('partials/season-history', { history: typeof history === 'undefined' ? {seasons:[]} : history, selectedHistory: typeof selectedHistory === 'undefined' ? null : selectedHistory, league, selectedSeason }) %></div></section>
<section class="section container"><div class="section-heading"><h2>RENNSTATISTIK</h2></div><div class="table-wrap"><table><thead><tr><th>Runde</th><th>Rennen</th><th>Sieger</th><th>Pole</th><th>FL</th><th>DotD</th></tr></thead><tbody><% (typeof raceStatistics === 'undefined' ? [] : raceStatistics).forEach(row=>{ %><tr><td>R<%= row.round %></td><td><%= row.country %></td><td><%= row.first||'–' %></td><td><%= row.pole||'–' %></td><td><%= row.fastestLap||'–' %></td><td><%= row.driverOfTheDay||'–' %></td></tr><% }); %></tbody></table></div></section>
</div>
<script src="/js/season-history-tabs.js" defer></script><script src="/js/standings-history.js" defer></script>
<%- include('partials/footer') %>
