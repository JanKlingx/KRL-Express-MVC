<%
  /*
   * Kleine Hilfsfunktionen nur für die Darstellung.
   */

  const resultClass = (result) => {
    if (!result) {
      return '';
    }

    const classes = [];

    if (result.fastestLap) {
      classes.push('has-fastest-lap');
    }

    if (result.status) {
      classes.push('has-race-status');
    }

    if (
      Number(result.position) >= 1 &&
      Number(result.position) <= 3
    ) {
      classes.push(
        `season-race-position-${result.position}`
      );
    }

    return classes.join(' ');
  };
%>


<% if (history.seasons.length && selectedHistory) { %>


  <!-- ================================================= -->
  <!-- SAISON -->
  <!-- ================================================= -->

  <div class="season-history-toolbar">

    <div>

      <span class="season-history-kicker">
        SAISONVERLAUF
      </span>

      <strong>
        <%= selectedHistory.name %>
      </strong>

    </div>

  </div>


  <% if (history.warning && isAdmin) { %>

    <div
      class="history-notice"
      role="status"
    >
      <%= history.warning %>
    </div>

  <% } %>


  <!-- ================================================= -->
  <!-- CHART -->
  <!-- ================================================= -->

  <div class="season-chart-card">

    <div class="season-chart-heading">

      <div>

        <span>
          PUNKTEENTWICKLUNG
        </span>

        <h3>
          <%= selectedHistory.name %>
        </h3>

      </div>


      <p>
        Die acht bestplatzierten Stammfahrer im Saisonverlauf.
      </p>

    </div>


    <div class="season-chart-scroll">

      <div
        class="season-chart"
        data-season-chart
        aria-label="Punkteverlauf <%= selectedHistory.name %>"
      ></div>

    </div>


    <div
      class="season-chart-legend"
      data-season-legend
    ></div>


    <%
      const chartPayload =
        JSON.stringify({
          races:
            selectedHistory.races,

          drivers:
            selectedHistory.drivers.slice(
              0,
              8
            )
        })
          .replace(
            /</g,
            "\\u003c"
          );
    %>


    <script
      type="application/json"
      data-season-chart-data
    ><%- chartPayload %></script>

  </div>


  <!-- ================================================= -->
  <!-- WERTUNGSUMSCHALTER -->
  <!-- ================================================= -->

  <div class="season-history-switch">

    <button
      type="button"
      class="season-history-tab is-active"
      data-history-tab="regular"
    >

      <span>
        STAMM
      </span>

      <strong>
        Stammfahrerwertung
      </strong>

      <small>
        <%= selectedHistory.drivers.length %> Fahrer
      </small>

    </button>


    <button
      type="button"
      class="season-history-tab"
      data-history-tab="reserve"
    >

      <span>
        ERSATZ
      </span>

      <strong>
        Ersatzfahrerwertung
      </strong>

      <small>
        <%= (selectedHistory.reserveDrivers || []).length %> Fahrer
      </small>

    </button>

  </div>


  <!-- ================================================= -->
  <!-- STAMMFAHRER -->
  <!-- ================================================= -->

  <div
    class="season-history-panel"
    data-history-panel="regular"
  >

    <div class="season-history-panel-header">

      <div>

        <span>
          STAMMFAHRER
        </span>

        <strong>
          Meisterschaftsverlauf
        </strong>

      </div>


      <small>
        Sprint und Hauptrennen werden bei Sprintwochenenden
        innerhalb einer Runde getrennt dargestellt.
      </small>

    </div>


    <div class="table-wrap season-history-table">

      <table>

        <thead>

          <tr>

            <th>
              Pos.
            </th>

            <th>
              Fahrer
            </th>

            <th>
              Team
            </th>


            <% selectedHistory.races.forEach((race) => { %>

              <th
                class="<%= race.hasSprint ? 'history-race-head has-sprint' : 'history-race-head' %>"
                title="Runde <%= race.round %> · <%= race.title %>"
              >

                <strong>
                  <%= race.code %>
                </strong>

                <small>
                  R<%= race.round %>
                </small>


                <% if (race.hasSprint) { %>

                  <span class="history-sprint-marker">
                    SPRINT
                  </span>

                <% } %>

              </th>

            <% }) %>


            <th>
              ∑
            </th>

            <th>
              Δ
            </th>

            <th>
              Ø
            </th>

          </tr>

        </thead>


        <tbody>


          <% selectedHistory.drivers.forEach((driver) => { %>

            <tr class="season-position-<%= driver.position %>">


              <!-- POSITION -->

              <td>

                <strong
                  class="position-badge position-<%= driver.position %>"
                >
                  P<%= driver.position %>
                </strong>

              </td>


              <!-- FAHRER -->

              <td class="history-driver-cell">

                <strong>
                  <%= driver.name %>
                </strong>

              </td>


              <!-- TEAM -->

              <td class="team-logo-cell history-team-cell">

                <% if (driver.teamLogoPath) { %>

                  <img
                    src="<%= driver.teamLogoPath %>"
                    alt="<%= driver.team || 'Team' %>"
                    title="<%= driver.team || '' %>"
                    class="team-logo-inline team-logo-history"
                  >

                <% } else { %>

                  <span>
                    <%= driver.team || "–" %>
                  </span>

                <% } %>

              </td>


              <!-- RENNWOCHENENDEN -->

              <% driver.results.forEach((weekendResult, resultIndex) => {

                const race =
                  selectedHistory.races[resultIndex];

                const main =
                  weekendResult.main;

                const sprint =
                  weekendResult.sprint;

              %>

                <td
                  class="
                    history-weekend-cell
                    <%= race?.hasSprint ? 'has-sprint-weekend' : '' %>
                  "
                >


                  <!-- ================================= -->
                  <!-- SPRINTWOCHENENDE -->
                  <!-- ================================= -->

                  <% if (race?.hasSprint) { %>

                    <div class="history-weekend-stack">


                      <!-- SPRINT -->

                      <div class="history-weekend-result history-weekend-sprint">

                        <span class="history-result-type">
                          S
                        </span>


                        <div class="<%= resultClass(sprint) %>">

                          <% if (sprint?.status) { %>

                            <span
                              class="status-badge status-<%= sprint.status.toLowerCase() %>"
                            >
                              <%= sprint.status %>
                            </span>


                          <% } else if (sprint?.position) { %>

                            <span
                              class="position-badge position-<%= sprint.position %>"
                            >
                              P<%= sprint.position %>
                            </span>


                          <% } else { %>

                            <span class="history-no-result">
                              –
                            </span>

                          <% } %>


                          <% if (sprint?.fastestLap) { %>

                            <small
                              class="history-fastest-lap"
                              title="Schnellste Runde"
                            >
                              SR
                            </small>

                          <% } %>

                        </div>

                      </div>


                      <!-- HAUPTRENNEN -->

                      <div class="history-weekend-result history-weekend-main">

                        <span class="history-result-type">
                          GP
                        </span>


                        <div class="<%= resultClass(main) %>">

                          <% if (main?.status) { %>

                            <span
                              class="status-badge status-<%= main.status.toLowerCase() %>"
                            >
                              <%= main.status %>
                            </span>


                          <% } else if (main?.position) { %>

                            <span
                              class="position-badge position-<%= main.position %>"
                            >
                              P<%= main.position %>
                            </span>


                          <% } else { %>

                            <span class="history-no-result">
                              –
                            </span>

                          <% } %>


                          <% if (main?.fastestLap) { %>

                            <small
                              class="history-fastest-lap"
                              title="Schnellste Runde"
                            >
                              SR
                            </small>

                          <% } %>

                        </div>

                      </div>

                    </div>


                  <!-- ================================= -->
                  <!-- NORMALES WOCHENENDE -->
                  <!-- ================================= -->

                  <% } else { %>

                    <div class="history-single-result <%= resultClass(main) %>">

                      <% if (main?.status) { %>

                        <span
                          class="status-badge status-<%= main.status.toLowerCase() %>"
                        >
                          <%= main.status %>
                        </span>


                      <% } else if (main?.position) { %>

                        <span
                          class="position-badge position-<%= main.position %>"
                        >
                          P<%= main.position %>
                        </span>


                      <% } else { %>

                        <span class="history-no-result">
                          –
                        </span>

                      <% } %>


                      <% if (main?.fastestLap) { %>

                        <small
                          class="history-fastest-lap"
                          title="Schnellste Runde"
                        >
                          SR
                        </small>

                      <% } %>

                    </div>

                  <% } %>

                </td>

              <% }) %>


              <!-- PUNKTE -->

              <td class="season-total">

                <strong>
                  <%= driver.total %>
                </strong>

              </td>


              <!-- GAP -->

              <td class="history-stat-cell">

                <%= driver.position === 1
                  ? 'Leader'
                  : `+${Math.abs(driver.gap)}`
                %>

              </td>


              <!-- DURCHSCHNITT -->

              <td class="history-stat-cell">

                <%= Number(driver.average)
                  .toFixed(1)
                  .replace(".", ",")
                %>

              </td>

            </tr>

          <% }) %>


        </tbody>

      </table>

    </div>

  </div>


  <!-- ================================================= -->
  <!-- ERSATZFAHRER -->
  <!-- ================================================= -->

  <div
    class="season-history-panel season-history-panel-reserve"
    data-history-panel="reserve"
    hidden
  >


    <% if ((selectedHistory.reserveDrivers || []).length) { %>


      <div class="season-history-panel-header">

        <div>

          <span>
            ERSATZFAHRER
          </span>

          <strong>
            Ersatzfahrerwertung
          </strong>

        </div>


        <small>
          Angezeigt werden nur Fahrer, die in dieser Saison
          tatsächlich als Ersatzfahrer eingesetzt wurden.
        </small>

      </div>


      <div class="table-wrap season-history-table season-history-reserve-table">

        <table>

          <thead>

            <tr>

              <th>
                Pos.
              </th>

              <th>
                Ersatzfahrer
              </th>

              <th>
                Team
              </th>


              <% selectedHistory.races.forEach((race) => { %>

                <th
                  class="<%= race.hasSprint ? 'history-race-head has-sprint' : 'history-race-head' %>"
                  title="Runde <%= race.round %> · <%= race.title %>"
                >

                  <strong>
                    <%= race.code %>
                  </strong>

                  <small>
                    R<%= race.round %>
                  </small>


                  <% if (race.hasSprint) { %>

                    <span class="history-sprint-marker">
                      SPRINT
                    </span>

                  <% } %>

                </th>

              <% }) %>


              <th>
                ∑
              </th>

              <th>
                Δ
              </th>

              <th>
                Ø
              </th>

            </tr>

          </thead>


          <tbody>


            <% (selectedHistory.reserveDrivers || [])
              .forEach((driver) => {
            %>

              <tr class="reserve-history-row">


                <!-- POSITION -->

                <td>

                  <strong
                    class="position-badge position-<%= driver.position %>"
                  >
                    P<%= driver.position %>
                  </strong>

                </td>


                <!-- FAHRER -->

                <td class="history-driver-cell">

                  <strong>
                    <%= driver.name %>
                  </strong>

                </td>


                <!-- TEAM -->

                <td class="team-logo-cell history-team-cell">

                  <% if (driver.teamLogoPath) { %>

                    <img
                      src="<%= driver.teamLogoPath %>"
                      alt="<%= driver.team || 'Team' %>"
                      title="<%= driver.team || '' %>"
                      class="team-logo-inline team-logo-history"
                    >

                  <% } else if (driver.team) { %>

                    <span>
                      <%= driver.team %>
                    </span>

                  <% } else { %>

                    <span>
                      –
                    </span>

                  <% } %>

                </td>


                <!-- RENNWOCHENENDEN -->

                <% driver.results.forEach((weekendResult, resultIndex) => {

                  const race =
                    selectedHistory.races[resultIndex];

                  const main =
                    weekendResult.main;

                  const sprint =
                    weekendResult.sprint;

                %>

                  <td
                    class="
                      history-weekend-cell
                      <%= race?.hasSprint ? 'has-sprint-weekend' : '' %>
                    "
                  >


                    <% if (race?.hasSprint) { %>

                      <div class="history-weekend-stack">


                        <!-- SPRINT -->

                        <div class="history-weekend-result history-weekend-sprint">

                          <span class="history-result-type">
                            S
                          </span>


                          <div class="<%= resultClass(sprint) %>">

                            <% if (sprint?.status) { %>

                              <span
                                class="status-badge status-<%= sprint.status.toLowerCase() %>"
                              >
                                <%= sprint.status %>
                              </span>


                            <% } else if (sprint?.position) { %>

                              <span
                                class="position-badge position-<%= sprint.position %>"
                              >
                                P<%= sprint.position %>
                              </span>


                            <% } else { %>

                              <span class="history-no-result">
                                –
                              </span>

                            <% } %>

                          </div>

                        </div>


                        <!-- GP -->

                        <div class="history-weekend-result history-weekend-main">

                          <span class="history-result-type">
                            GP
                          </span>


                          <div class="<%= resultClass(main) %>">

                            <% if (main?.status) { %>

                              <span
                                class="status-badge status-<%= main.status.toLowerCase() %>"
                              >
                                <%= main.status %>
                              </span>


                            <% } else if (main?.position) { %>

                              <span
                                class="position-badge position-<%= main.position %>"
                              >
                                P<%= main.position %>
                              </span>


                            <% } else { %>

                              <span class="history-no-result">
                                –
                              </span>

                            <% } %>

                          </div>

                        </div>

                      </div>


                    <% } else { %>

                      <div class="history-single-result <%= resultClass(main) %>">

                        <% if (main?.status) { %>

                          <span
                            class="status-badge status-<%= main.status.toLowerCase() %>"
                          >
                            <%= main.status %>
                          </span>


                        <% } else if (main?.position) { %>

                          <span
                            class="position-badge position-<%= main.position %>"
                          >
                            P<%= main.position %>
                          </span>


                        <% } else { %>

                          <span class="history-no-result">
                            –
                          </span>

                        <% } %>

                      </div>

                    <% } %>

                  </td>

                <% }) %>


                <!-- PUNKTE -->

                <td class="season-total">

                  <strong>
                    <%= driver.total %>
                  </strong>

                </td>


                <!-- GAP -->

                <td class="history-stat-cell">

                  <%= driver.position === 1
                    ? 'Leader'
                    : `+${Math.abs(driver.gap)}`
                  %>

                </td>


                <!-- Ø -->

                <td class="history-stat-cell">

                  <%= Number(driver.average)
                    .toFixed(1)
                    .replace(".", ",")
                  %>

                </td>

              </tr>

            <% }) %>


          </tbody>

        </table>

      </div>


    <% } else { %>

      <div class="empty-state">

        In dieser Saison wurde bisher
        kein Ersatzfahrer eingesetzt.

      </div>

    <% } %>

  </div>


<% } else { %>

  <div class="empty-state">

    Noch keine Ergebnisse eingetragen.

  </div>

<% } %>