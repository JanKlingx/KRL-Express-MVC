<% const platform = driver?.platformRecord; %>
<% if (platform?.logoPath) { %><img class="driver-platform-logo" src="<%= platform.logoPath %>" alt="<%= platform.name %>" title="<%= platform.name %>"><% } else { %><span class="driver-platform-fallback" title="<%= platform?.name || driver?.platform || 'Plattform' %>"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 21h8m-4-4v4" fill="none" stroke="currentColor" stroke-width="2"/></svg><span class="sr-only"><%= platform?.name || driver?.platform || 'Plattform' %></span></span><% } %>
