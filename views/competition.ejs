<%- include('partials/header', { title }) %>
<section class="league-hero competition-hero"><div class="container"><span class="eyebrow">DAS COMMUNITY-EVENT</span><h1>WETTKAMPF<br><span>DER LIGEN</span></h1><p>Simracing-Communities treten gemeinsam für ihre Liga an. Fair, spannend und live kommentiert.</p><div class="facts"><span>Ligen <strong><%= leagues.length %></strong></span><span>Fahrer <strong>2 pro Liga</strong></span><span>Rennen <strong>6 Events</strong></span><span>Start <strong>Sonntag 19:30</strong></span></div></div></section>
<% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/participatingLeagues">✎ WDL-Ligen bearbeiten</a><a href="/admin/wdlDrivers">✎ WDL-Fahrer auswählen</a><a href="/admin/competitionStandings">✎ WDL-Wertung bearbeiten</a></div><% } %>
<section class="section container"><div class="section-heading"><span>DIE HERAUSFORDERER</span><h2>TEILNEHMENDE LIGEN</h2></div><div class="league-grid"><% leagues.forEach(league => { %><article class="league-card red"><% if (league.logoPath) { %><img class="league-logo" src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } %><div class="league-badge"><%= league.abbreviation || 'LIGA' %></div><h3><%= league.name %></h3><p><%= league.constructorName || 'Konstrukteur offen' %></p><% if (league.websiteUrl) { %><a href="<%= league.websiteUrl %>" target="_blank" rel="noopener">Liga besuchen →</a><% } %></article><% }) %></div></section>
<section class="section container"><div class="section-heading"><span>AUFGEBOTE</span><h2>WDL-FAHRERFELD</h2></div><div class="table-wrap"><table><thead><tr><th>ID</th><th>Fahrer</th><th>Plattform</th><th>WDL-Liga</th><th>Frühere Namen</th></tr></thead><tbody><% drivers.forEach((driver) => { %><tr><td>#<%= driver.id %></td><td><strong><%= driver.name %></strong></td><td><%= driver.platform %></td><td><%= driver.participatingLeague?.name || '–' %></td><td><%= driver.aliases.map((alias) => alias.alias).join(', ') || '–' %></td></tr><% }) %></tbody></table></div><% if (!drivers.length) { %><div class="empty-state">Noch keine WDL-Fahrer zugeordnet.</div><% } %></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><span>GESAMTWERTUNG</span><h2>TEAMSTANDINGS</h2></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Liga</th><th>Fahrer</th><th>Konstrukteur</th><th>Punkte</th><th>Siege</th><th>Gap</th></tr></thead><tbody><% standings.forEach(row => { const selectedDrivers = [row.driverOne?.name, row.driverTwo?.name].filter(Boolean).join(' / '); %><tr><td><strong><%= row.position %></strong></td><td><%= row.participatingLeague.name %></td><td><%= selectedDrivers || row.drivers || '–' %></td><td><%= row.constructorName || '–' %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td><td><%= row.gap || '–' %></td></tr><% }) %></tbody></table></div><div class="wdl-admin-link"><span>WDL-Organisation</span><a href="/admin/login">Im gemeinsamen Adminbereich verwalten →</a></div></div></section>
<%- include('partials/footer') %>
