<%- include('../partials/header', { title }) %>

<%
  const setupStructure =
    typeof structure === 'undefined'
      ? { allDrivers: [], teams: [], unassignedDrivers: [] }
      : structure;

  const setupTracks =
    typeof tracks === 'undefined'
      ? []
      : tracks;

  const setupEligibleDrivers =
    typeof eligibleDrivers === 'undefined'
      ? []
      : eligibleDrivers;

  const setupFinishReady =
    typeof finishReady === 'undefined'
      ? false
      : finishReady;

  const setupCalendarDraft =
    typeof calendarDraft === 'undefined' || !calendarDraft
      ? {}
      : calendarDraft;

  const selectedDriverIds = new Set(
    (setupStructure.allDrivers || []).map(
      (driver) => Number(driver.id)
    )
  );

  const selectedTeamTokens = new Set(
    (setupStructure.teams || []).map(
      (team) => `${team.sourceType}:${team.sourceId}`
    )
  );

  const assignedByTeam = new Map(
    (setupStructure.teams || []).map((team) => [
      Number(team.id),
      new Set(
        (team.drivers || []).map(
          (driver) =>
            Number(
              driver.DriverId ||
              driver.driver?.id ||
              driver.id
            )
        )
      )
    ])
  );
%>


<section class="admin-shell season-setup-shell">
  <div class="container">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="admin-heading">

      <div>
        <a class="back-link" href="/admin">
          ← Dashboard
        </a>

        <span class="form-kicker">
          FORMEL 1 · FIORI-ASSISTENT
        </span>

        <h1>
          F1-SAISON ERSTELLEN
        </h1>

        <p class="admin-intro">
          Alle acht Schritte greifen auf Stammdaten zurück.
          Die Saison wird erst im letzten Schritt veröffentlicht.
        </p>
      </div>

      <a
        class="button button-ghost"
        href="/admin/season-manager"
      >
        Saison bearbeiten
      </a>

    </div>


    <!-- ================================================= -->
    <!-- SCHRITT-NAVIGATION -->
    <!-- ================================================= -->

    <nav class="setup-steps setup-steps-eight">

      <a
        href="#setup-league"
        class="is-complete"
      >
        <span>1</span>
        <strong>Liga</strong>
      </a>

      <a
        href="#setup-season"
        class="<%= selectedLeague ? 'is-complete' : '' %>"
      >
        <span>2</span>
        <strong>Saison</strong>
      </a>

      <a
        href="#setup-calendar"
        class="<%= calendar.length ? 'is-complete' : '' %>"
      >
        <span>3</span>
        <strong>Kalender</strong>
      </a>

      <a
        href="#setup-points"
        class="<%= selectedSeason?.PointsSchemeId ? 'is-complete' : '' %>"
      >
        <span>4</span>
        <strong>Punkte</strong>
      </a>

      <a
        href="#setup-drivers"
        class="<%= setupStructure.allDrivers.length ? 'is-complete' : '' %>"
      >
        <span>5</span>
        <strong>Fahrer</strong>
      </a>

      <a
        href="#setup-teams"
        class="<%= setupStructure.teams.length ? 'is-complete' : '' %>"
      >
        <span>6</span>
        <strong>Teams</strong>
      </a>

      <a
        href="#setup-lineup"
        class="<%= setupStructure.teams.some((team) => (team.drivers || []).length) ? 'is-complete' : '' %>"
      >
        <span>7</span>
        <strong>Line-up</strong>
      </a>

      <a
        href="#setup-finish"
        class="<%= setupFinishReady ? 'is-complete' : '' %>"
      >
        <span>8</span>
        <strong>Abschluss</strong>
      </a>

    </nav>


    <!-- ================================================= -->
    <!-- 01 LIGA -->
    <!-- ================================================= -->

    <section
      id="setup-league"
      class="setup-panel"
    >

      <div class="setup-panel-number">
        01
      </div>

      <div class="setup-panel-content">

        <span>
          Freitag, Samstag oder Sonntag
        </span>

        <h2>
          LIGA AUSWÄHLEN
        </h2>

        <form
          method="get"
          class="setup-choice-grid"
        >

          <% leagues.forEach((league) => { %>

            <button
              class="setup-choice <%= selectedLeague?.id === league.id ? 'is-selected' : '' %>"
              style="--setup-accent:<%= league.accentColor %>"
              name="league"
              value="<%= league.id %>"
            >

              <% if (league.logoPath) { %>
                <img
                  src="<%= league.logoPath %>"
                  alt=""
                >
              <% } %>

              <span>
                FORMEL 1
              </span>

              <strong>
                <%= league.name %>
              </strong>

              <small>
                <%= league.raceDay %>
                ·
                <%= league.raceTime %>
              </small>

            </button>

          <% }) %>

        </form>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- 02 SAISON -->
    <!-- ================================================= -->

    <% if (selectedLeague) { %>

      <section
        id="setup-season"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          02
        </div>

        <div class="setup-panel-content">

          <span>
            Pflichtangaben
          </span>

          <h2>
            SAISON & FARBPROFIL
          </h2>

          <div class="setup-two-column">

            <form
              method="post"
              action="/admin/season-setup/seasons"
              class="setup-form"
            >

              <input
                type="hidden"
                name="LeagueId"
                value="<%= selectedLeague.id %>"
              >

              <label>
                Saisonname

                <input
                  name="name"
                  required
                >
              </label>

              <label>
                Status

                <select
                  name="status"
                  required
                >
                  <option value="active">
                    Aktuell
                  </option>

                  <option value="historical">
                    Historisch
                  </option>
                </select>
              </label>

              <label>
                Farbe

                <input
                  type="color"
                  name="accentColor"
                  value="<%= selectedLeague.accentColor %>"
                  required
                >
              </label>

              <button class="button">
                Saison anlegen
              </button>

            </form>


            <div class="setup-season-list">

              <strong>
                Vorhandene Saisons
              </strong>

              <% seasons.forEach((season) => { %>

                <a
                  href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= season.id %>"
                  class="<%= selectedSeason?.id === season.id ? 'is-selected' : '' %>"
                >

                  <span>
                    <%= season.status === 'active'
                      ? 'AKTUELL'
                      : 'HISTORISCH'
                    %>
                  </span>

                  <strong>
                    <%= season.name %>
                  </strong>

                  <small>
                    <%= season.isPublished
                      ? 'Veröffentlicht'
                      : 'Assistent noch offen'
                    %>
                  </small>

                </a>

              <% }) %>

            </div>

          </div>

        </div>

      </section>

    <% } %>


    <% if (selectedSeason) { %>


      <!-- ================================================= -->
      <!-- 03 RENNKALENDER -->
      <!-- ================================================= -->

<section id="setup-calendar" class="setup-panel">

  <div class="setup-panel-number">
    03
  </div>

  <div class="setup-panel-content">

    <span>Kalender ist die verbindliche Quelle dieser Saison</span>
    <h2>RENNKALENDER ERSTELLEN</h2>

    <%
      const events = calendar;

      const trackSelect = (event) => `
        <label>
          Strecke *
          <select name="F1TrackId" required>
            <option value="">Aus Streckenstamm wählen …</option>

            ${setupTracks.map((track) => `
              <option
                value="${track.id}"
                ${Number(event?.F1TrackId) === Number(track.id) ? 'selected' : ''}
              >
                ${track.name}
              </option>
            `).join('')}

          </select>

          <small>
            Land und Flagge werden automatisch übernommen.
          </small>
        </label>
      `;
    %>


    <!-- TERMIN HINZUFÜGEN -->

    <section class="setup-panel">

      <div class="setup-panel-number">+</div>

      <div class="setup-panel-content">

        <h2>TERMIN HINZUFÜGEN</h2>

        <p class="setup-note">
          Die Startzeit kommt fest aus dem Ligen-Stamm.
        </p>

        <form
          method="post"
          action="/admin/season-setup/<%= selectedSeason.id %>/calendar"
          class="setup-form setup-calendar-form setup-calendar-create"
        >

          <%- trackSelect(setupCalendarDraft) %>

          <label>
            Datum *
            <input
              type="date"
              name="date"
              value="<%= setupCalendarDraft.date || '' %>"
              required
            >
          </label>

          <label>
            Startzeit aus Ligen-Stamm
            <input
              type="time"
              value="<%= defaultTime %>"
              readonly
            >
          </label>

          <label>
            Rennen Nr. *
            <input
              type="number"
              name="sortOrder"
              min="1"
              value="<%= setupCalendarDraft.sortOrder || events.length + 1 %>"
              required
            >
          </label>

          <label class="checkbox-control">
            <input
              type="checkbox"
              name="isTestDay"
              <%= setupCalendarDraft.isTestDay ? 'checked' : '' %>
            >
            <span>Testtag</span>
          </label>

          <label class="checkbox-control">
            <input
              type="checkbox"
              name="hasSprint"
              <%= setupCalendarDraft.hasSprint ? 'checked' : '' %>
            >
            <span>Sprint</span>
          </label>

          <button
            type="submit"
            class="button"
          >
            Hinzufügen
          </button>

        </form>

      </div>
    </section>


    <!-- REIHENFOLGE -->

    <% if (events.length) { %>

      <form
        method="post"
        action="/admin/season-setup/<%= selectedSeason.id %>/calendar/reorder"
        class="calendar-reorder-bar"
        data-calendar-reorder-form
      >

        <div data-calendar-order-inputs>

          <% events.forEach((event) => { %>

            <input
              type="hidden"
              name="eventIds"
              value="<%= event.id %>"
            >

          <% }) %>

        </div>

        <span>
          ↕ Karten ziehen, um Rennen neu zu nummerieren.
        </span>

        <button
          type="submit"
          class="button button-small"
        >
          Reihenfolge speichern
        </button>

      </form>

    <% } %>


    <!-- BESTEHENDE TERMINE -->

    <div
      class="setup-calendar-list season-calendar-editor"
      data-sortable-calendar
    >

      <% events.forEach((event, index) => {

        const startsAt = new Date(event.startsAt);
        const valid = !Number.isNaN(startsAt.getTime());

      %>

        <article
          class="<%= event.isTestDay ? 'is-test' : '' %>"
          draggable="true"
          data-calendar-event="<%= event.id %>"
        >

          <div class="calendar-event-badges">
            <% if (event.isTestDay) { %><span class="calendar-option-badge is-test">TESTTAG</span><% } %>
            <% if (event.hasSprint) { %><span class="calendar-option-badge is-sprint">SPRINT + HAUPTRENNEN</span><% } else { %><span class="calendar-option-badge">HAUPTRENNEN</span><% } %>
          </div>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/calendar/<%= event.id %>/update"
            class="setup-form setup-calendar-form"
          >

            <span class="calendar-drag-handle">
              ↕ R<%= event.sortOrder || index + 1 %>
            </span>

            <%- trackSelect(event) %>


            <label>
              Land

              <div class="readonly-master-field">

                <% if (event.track?.countryRecord?.flagPath) { %>

                  <img
                    src="<%= event.track.countryRecord.flagPath %>"
                    alt="Flagge <%= event.track.countryRecord.name %>"
                  >

                <% } %>

                <strong>
                  <%= event.track?.countryRecord?.name
                    || event.track?.country
                    || 'aus Stammdaten'
                  %>
                </strong>

              </div>

            </label>


            <label>
              Datum

              <input
                type="date"
                name="date"
                value="<%= valid ? startsAt.toISOString().slice(0,10) : '' %>"
                required
              >
            </label>


            <label>
              Zeit aus Ligen-Stamm

              <input
                type="time"
                value="<%= defaultTime %>"
                readonly
              >
            </label>


            <input
              type="hidden"
              name="sortOrder"
              value="<%= event.sortOrder || index + 1 %>"
            >


            <label class="checkbox-control">
              <input
                type="checkbox"
                name="isTestDay"
                <%= event.isTestDay ? 'checked' : '' %>
              >
              <span>Testtag</span>
            </label>


            <label class="checkbox-control">
              <input
                type="checkbox"
                name="hasSprint"
                <%= event.hasSprint ? 'checked' : '' %>
              >
              <span>Sprint</span>
            </label>


            <button
              type="submit"
              class="button button-small"
            >
              Speichern
            </button>

          </form>


          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/calendar/<%= event.id %>/delete"
            data-confirm="Termin und Ergebnisse löschen?"
          >

            <button
              type="submit"
              class="button button-ghost button-small"
            >
              Löschen
            </button>

          </form>

        </article>

      <% }) %>


      <% if (!events.length) { %>

        <div class="empty-state">
          Diese Saison hat noch keine Termine.
        </div>

      <% } %>

    </div>

    <% if (events.length) { %>
      <div class="setup-calendar-review">
        <strong><%= events.length %> Termine aus <%= selectedSeason.name %></strong>
        <span><%= events.filter((event) => event.hasSprint).length %> Sprint-Events</span>
        <span><%= events.filter((event) => event.isTestDay).length %> Testtage</span>
        <small>Nur diese Termine werden später im Saisonverlauf angezeigt.</small>
      </div>
    <% } %>

  </div>

</section>


      <!-- ================================================= -->
      <!-- 04 PUNKTE -->
      <!-- ================================================= -->

      <section
        id="setup-points"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          04
        </div>

        <div class="setup-panel-content">

          <span>
            Pflichtfeld
          </span>

          <h2>
            PUNKTESYSTEM AUSWÄHLEN
          </h2>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/profile"
            class="setup-form"
          >

            <input
              type="hidden"
              name="accentColor"
              value="<%= selectedSeason.accentColor %>"
            >

            <label>
              Punktesystem

              <select
                name="PointsSchemeId"
                required
              >

                <option value="">
                  Punktesystem wählen …
                </option>

                <% pointsSchemes.forEach((scheme) => { %>

                  <option
                    value="<%= scheme.id %>"
                    <%= selectedSeason.PointsSchemeId === scheme.id
                      ? 'selected'
                      : ''
                    %>
                  >
                    <%= scheme.name %>
                  </option>

                <% }) %>

              </select>
            </label>

            <button class="button">
              Punktesystem speichern
            </button>

          </form>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 05 FAHRER -->
      <!-- ================================================= -->

      <section
        id="setup-drivers"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          05
        </div>

        <div class="setup-panel-content">

          <span>
            Stammfahrer oder ehemaliger F1-Fahrer
          </span>

          <h2>
            FAHRER AUSWÄHLEN
          </h2>

          <div class="setup-filter-toolbar" data-driver-filter-toolbar>
            <div class="setup-filter-buttons" role="group" aria-label="Fahrer nach Rang filtern">
              <button type="button" class="is-active" data-driver-filter="all">Alle</button>
              <button type="button" data-driver-filter="friday">Stamm Freitag</button>
              <button type="button" data-driver-filter="saturday">Stamm Samstag</button>
              <button type="button" data-driver-filter="sunday">Stamm Sonntag</button>
              <button type="button" data-driver-filter="former">Ehemalige F1</button>
            </div>
            <label class="setup-inline-search">
              <span>Fahrer suchen</span>
              <input type="search" placeholder="Name eingeben …" data-driver-search>
            </label>
            <strong data-driver-selected-count><%= selectedDriverIds.size %> ausgewählt</strong>
          </div>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/drivers"
          >

            <div class="setup-driver-grid">

              <% setupEligibleDrivers.forEach((driver) => {

                const roles = [];
                const roleKeys = [];

                if (driver.roleF1Friday) {
                  roles.push('Stamm Freitag');
                  roleKeys.push('friday');
                }

                if (driver.roleF1Saturday) {
                  roles.push('Stamm Samstag');
                  roleKeys.push('saturday');
                }

                if (driver.roleF1Sunday) {
                  roles.push('Stamm Sonntag');
                  roleKeys.push('sunday');
                }

                if (driver.roleFormerF1) {
                  roles.push('Ehemaliger F1-Fahrer');
                  roleKeys.push('former');
                }

              %>

                <label class="setup-driver-card" data-driver-card data-driver-roles="<%= roleKeys.join(' ') %>" data-driver-name="<%= driver.name.toLowerCase() %>">

                  <input
                    type="checkbox"
                    name="driverIds"
                    value="<%= driver.id %>"
                    <%= selectedDriverIds.has(Number(driver.id))
                      ? 'checked'
                      : ''
                    %>
                  >

                  <span class="setup-driver-info">

                    <strong>
                      <%= driver.name %>
                    </strong>

                    <small>
                      #<%= driver.id %>
                      ·
                      <%= roles.join(' · ') || 'F1 Fahrer' %>
                    </small>

                  </span>

                </label>

              <% }) %>

            </div>

            <div class="setup-sticky-action">
              <span>Nur angehakte Fahrer werden für Line-up und Ersatzpool übernommen.</span>
              <button type="submit" class="button setup-save-step">Fahrerauswahl speichern</button>
            </div>

          </form>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 06 TEAMS -->
      <!-- ================================================= -->

      <section
        id="setup-teams"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          06
        </div>

        <div class="setup-panel-content">

          <span>
            Maximal 11
          </span>

          <h2>
            AKTUELLE ODER HISTORISCHE TEAMS
          </h2>

          <div class="setup-team-toolbar">
            <label class="setup-inline-search">
              <span>Teams durchsuchen</span>
              <input type="search" placeholder="Teamname eingeben …" data-team-search>
            </label>
            <strong data-team-selected-count><%= selectedTeamTokens.size %> / 11 ausgewählt</strong>
          </div>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/teams"
            data-team-selection-form
          >

            <div class="setup-team-columns">


            <!-- AKTUELLE TEAMS -->

            <section class="setup-team-source">

              <header><div><span>TEAMSTAMM</span><h3>Aktuelle Teams</h3></div><small><%= f1Teams.length %> verfügbar</small></header>

              <div class="team-choice-grid">

                <% f1Teams.forEach((team) => {

                  const token = `current:${team.id}`;

                %>

                  <label class="team-choice-card setup-season-team-card <%= selectedTeamTokens.has(token) ? 'is-selected' : '' %>" data-team-card data-team-name="<%= team.name.toLowerCase() %>" style="--team-accent:<%= team.accentColor || '#6ef2f2' %>">

                    <input
                      type="checkbox"
                      name="teamTokens"
                      value="<%= token %>"
                      <%= selectedTeamTokens.has(token)
                        ? 'checked'
                        : ''
                      %>
                    >

                    <% if (team.logoPath) { %>

                      <img
                        src="<%= team.logoPath %>"
                        alt=""
                      >

                    <% } %>

                    <% if (!team.logoPath) { %><span class="setup-team-fallback"><%= team.name.slice(0, 2).toUpperCase() %></span><% } %>

                    <span class="setup-team-card-copy"><small>AKTUELL</small><strong><%= team.name %></strong></span>
                    <span class="setup-team-check">✓</span>

                  </label>

                <% }) %>

              </div>

            </section>


            <!-- HISTORISCHE TEAMS -->

            <section class="setup-team-source">

              <header><div><span>SAISON-PROFILE</span><h3>Historische Teams</h3></div><small><%= carProfiles.length %> verfügbar</small></header>

              <div class="team-choice-grid">

                <% carProfiles.forEach((team) => {

                  const token = `historical:${team.id}`;

                %>

                  <label class="team-choice-card setup-season-team-card <%= selectedTeamTokens.has(token) ? 'is-selected' : '' %>" data-team-card data-team-name="<%= `${team.name} ${team.baseTeam?.name || ''}`.toLowerCase() %>" style="--team-accent:<%= team.accentColor || '#6ef2f2' %>">

                    <input
                      type="checkbox"
                      name="teamTokens"
                      value="<%= token %>"
                      <%= selectedTeamTokens.has(token)
                        ? 'checked'
                        : ''
                      %>
                    >

                    <% if (team.logoPath) { %>

                      <img
                        src="<%= team.logoPath %>"
                        alt=""
                      >

                    <% } %>

                    <% if (!team.logoPath) { %><span class="setup-team-fallback"><%= team.name.slice(0, 2).toUpperCase() %></span><% } %>

                    <span class="setup-team-card-copy"><small>HISTORISCH · gehört zu <%= team.baseTeam?.name || 'keinem Basis-Team' %></small><strong><%= team.name %></strong></span>
                    <span class="setup-team-check">✓</span>

                  </label>

                <% }) %>

              </div>

            </section>

            </div>


            <div class="setup-sticky-action">
              <span>Maximal 11 Teams. Die Auswahl bestimmt die Karten in Schritt 7.</span>
              <button type="submit" class="button setup-save-step">Teams speichern</button>
            </div>

          </form>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 07 LINE-UP -->
      <!-- ================================================= -->

      <section
        id="setup-lineup"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          07
        </div>

        <div class="setup-panel-content">

          <span>
            Nur Fahrer aus Schritt 5
          </span>

          <h2>
            LINE-UP ERSTELLEN
          </h2>

          <p class="setup-note">
            Ordne jedem Team maximal zwei Stammfahrer zu.
            Nicht zugeordnete Fahrer bleiben automatisch als Ersatzfahrer.
            Ein Fahrer kann nur einem Team zugeordnet werden.
          </p>


          <% if (!setupStructure.teams.length) { %>

            <div class="empty-state">
              Bitte zuerst in Schritt 6 Teams auswählen.
            </div>


          <% } else if (!setupStructure.allDrivers.length) { %>

            <div class="empty-state">
              Bitte zuerst in Schritt 5 Fahrer auswählen.
            </div>


          <% } else { %>

            <form
              id="season-lineup-form"
              method="post"
              action="/admin/season-setup/<%= selectedSeason.id %>/lineup"
            >

              <div class="season-lineup-grid">

                <% setupStructure.teams.forEach((team) => {

                  const assignedIds = Array.from(
                    assignedByTeam.get(Number(team.id)) ||
                    new Set()
                  ).filter(Boolean);

                %>

                  <article
                    class="season-lineup-team"
                    style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
                  >

                    <header class="season-lineup-team-header">


                      <% if (team.logoPath) { %>

                        <div class="season-lineup-logo">

                          <img
                            src="<%= team.logoPath %>"
                            alt="<%= team.name %>"
                          >

                        </div>

                      <% } else { %>

                        <div class="season-lineup-logo-fallback">

                          <%= team.name
                            .slice(0, 2)
                            .toUpperCase()
                          %>

                        </div>

                      <% } %>


                      <div class="season-lineup-team-title">

                        <span>
                          SAISONTEAM
                        </span>

                        <strong>
                          <%= team.name %>
                        </strong>

                      </div>

                    </header>


                    <div class="season-lineup-driver-slots">

                      <% for (let slot = 0; slot < 2; slot++) {

                        const currentDriverId =
                          Number(assignedIds[slot]) || null;

                      %>

                        <label class="season-lineup-slot">

                          <span>
                            STAMMFAHRER
                            <%= slot + 1 %>
                          </span>

                          <select
                            class="season-lineup-driver-select"
                            name="lineup[<%= team.id %>]"
                            data-team-id="<%= team.id %>"
                            data-slot="<%= slot + 1 %>"
                          >

                            <option value="">
                              — Fahrer auswählen —
                            </option>

                            <% setupStructure.allDrivers.forEach((driver) => { %>

                              <option
                                value="<%= driver.id %>"
                                <%= currentDriverId === Number(driver.id)
                                  ? 'selected'
                                  : ''
                                %>
                              >
                                <%= driver.name %>
                              </option>

                            <% }) %>

                          </select>

                        </label>

                      <% } %>

                    </div>

                  </article>

                <% }) %>

              </div>


              <div class="season-lineup-footer">

                <p>
                  Alle nicht zugeordneten Fahrer werden automatisch
                  als Ersatzfahrer gespeichert.
                </p>

                <button
                  type="submit"
                  class="button setup-save-step"
                >
                  Line-up speichern
                </button>

              </div>

            </form>

          <% } %>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 08 ABSCHLUSS -->
      <!-- ================================================= -->

      <section
        id="setup-finish"
        class="setup-panel setup-finish-panel"
      >

        <div class="setup-panel-number">
          08
        </div>

        <div class="setup-panel-content">

          <div class="setup-finish-hero" style="--season-accent:<%= selectedSeason.accentColor || selectedLeague.accentColor || '#6ef2f2' %>">
            <div>
              <span>SCHRITT 08 · KONTROLLE</span>
              <h2><%= selectedSeason.name %> ist <%= setupFinishReady ? 'bereit' : 'fast bereit' %></h2>
              <p><%= selectedLeague.name %> · Prüfe die Bausteine und veröffentliche die Saison anschließend mit einem Klick.</p>
            </div>
            <% if (selectedLeague.logoPath) { %><img src="<%= selectedLeague.logoPath %>" alt="Logo <%= selectedLeague.name %>"><% } %>
          </div>


          <div class="setup-final-summary">

            <article class="setup-final-card">

              <span>
                Liga
              </span>

              <strong>
                <%= selectedLeague.name %>
              </strong>

            </article>


            <article class="setup-final-card">

              <span>
                Saison
              </span>

              <strong>
                <%= selectedSeason.name %>
              </strong>

            </article>


            <article class="setup-final-card">

              <span>
                Kalender
              </span>

              <strong>
                <%= calendar.length %>
              </strong>

              <small>
                Termine
              </small>

            </article>


            <article class="setup-final-card">

              <span>
                Fahrer
              </span>

              <strong>
                <%= setupStructure.allDrivers.length %>
              </strong>

              <small>
                ausgewählt
              </small>

            </article>


            <article class="setup-final-card">

              <span>
                Teams
              </span>

              <strong>
                <%= setupStructure.teams.length %>
              </strong>

              <small>
                ausgewählt
              </small>

            </article>


            <article class="setup-final-card">

              <span>
                Ersatzfahrer
              </span>

              <strong>
                <%= setupStructure.unassignedDrivers.length %>
              </strong>

              <small>
                verfügbar
              </small>

            </article>

          </div>

          <div class="setup-finish-layout">
            <article class="setup-finish-checklist">
              <span>VOLLSTÄNDIGKEIT</span>
              <h3>Bereit für die Ligaseite</h3>
              <ul>
                <li class="<%= calendar.length ? 'is-complete' : '' %>"><strong>Rennkalender</strong><small><%= calendar.length ? `${calendar.length} Termine gespeichert` : 'Mindestens einen Termin anlegen' %></small></li>
                <li class="<%= selectedSeason.PointsSchemeId ? 'is-complete' : '' %>"><strong>Punktesystem</strong><small><%= selectedSeason.pointsScheme?.name || 'Noch nicht ausgewählt' %></small></li>
                <li class="<%= setupStructure.allDrivers.length ? 'is-complete' : '' %>"><strong>Fahrerpool</strong><small><%= setupStructure.allDrivers.length %> Fahrer ausgewählt</small></li>
                <li class="<%= setupStructure.teams.length ? 'is-complete' : '' %>"><strong>Teams</strong><small><%= setupStructure.teams.length %> von maximal 11 Teams</small></li>
                <li class="<%= setupStructure.teams.some((team) => (team.drivers || []).length) ? 'is-complete' : '' %>"><strong>Line-up</strong><small>Fahrer den Cockpits zugeordnet</small></li>
              </ul>
            </article>

            <article class="setup-finish-preview">
              <span>VORSCHAU</span>
              <h3><%= selectedLeague.name %></h3>
              <div class="setup-finish-team-strip">
                <% setupStructure.teams.slice(0, 11).forEach((team) => { const finishTeamName = team.displayName || team.name || 'Team'; %>
                  <div title="<%= finishTeamName %>" style="--team-accent:<%= team.accentColor || '#6ef2f2' %>">
                    <% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt=""><% } else { %><strong><%= finishTeamName.slice(0, 2).toUpperCase() %></strong><% } %>
                  </div>
                <% }) %>
              </div>
              <p><strong><%= calendar.filter((event) => event.hasSprint).length %></strong> Sprint-Events · <strong><%= setupStructure.unassignedDrivers.length %></strong> verfügbare Ersatzfahrer</p>
            </article>
          </div>


          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/finish"
            class="setup-publish-box <%= setupFinishReady ? 'is-ready' : '' %>"
          >

            <div><span><%= setupFinishReady ? '✓ ALLE PFLICHTSCHRITTE ERLEDIGT' : 'NOCH NICHT VOLLSTÄNDIG' %></span><strong><%= setupFinishReady ? 'Saison veröffentlichen' : 'Fehlende Schritte ergänzen' %></strong></div>

            <button
              class="button"
              <%= setupFinishReady
                ? ''
                : 'disabled'
              %>
            >
              <%= setupFinishReady ? 'Saison abschließen & veröffentlichen' : 'Noch nicht bereit' %>
            </button>

          </form>


          <% if (!setupFinishReady) { %>

            <p class="setup-note setup-finish-warning">
              Noch nicht vollständig: Kalender, Punktesystem,
              Fahrer, Teams und mindestens eine
              Line-up-Zuordnung sind erforderlich.
            </p>

          <% } %>

        </div>

      </section>


    <% } %>


  </div>
</section>


<!-- ===================================================== -->
<!-- JAVASCRIPT -->
<!-- ===================================================== -->

<script>
document.addEventListener('DOMContentLoaded', function () {

  /*
   * =====================================================
   * STRECKE -> LAND
   * =====================================================
   */

  const trackSelect =
    document.getElementById('f1-track-select');

  const countryInput =
    document.getElementById('f1-track-country');


  if (trackSelect && countryInput) {

    function updateTrackCountry() {

      const selectedOption =
        trackSelect.options[
          trackSelect.selectedIndex
        ];

      if (
        !selectedOption ||
        !selectedOption.value
      ) {
        countryInput.value = '';
        return;
      }

      countryInput.value =
        selectedOption.dataset.country || '';
    }


    trackSelect.addEventListener(
      'change',
      updateTrackCountry
    );


    updateTrackCountry();
  }

  const driverCards = Array.from(document.querySelectorAll('[data-driver-card]'));
  const driverSearch = document.querySelector('[data-driver-search]');
  const driverFilterButtons = Array.from(document.querySelectorAll('[data-driver-filter]'));
  const driverSelectedCount = document.querySelector('[data-driver-selected-count]');
  let activeDriverFilter = 'all';

  function refreshDriverCards() {
    const query = (driverSearch?.value || '').trim().toLowerCase();
    driverCards.forEach(function (card) {
      const roles = (card.dataset.driverRoles || '').split(' ');
      const rankMatches = activeDriverFilter === 'all' || roles.includes(activeDriverFilter);
      const searchMatches = !query || (card.dataset.driverName || '').includes(query);
      card.hidden = !(rankMatches && searchMatches);
    });
    if (driverSelectedCount) {
      const count = driverCards.filter((card) => card.querySelector('input[type="checkbox"]')?.checked).length;
      driverSelectedCount.textContent = count + ' ausgewählt';
    }
  }

  driverFilterButtons.forEach(function (button) {
    button.addEventListener('click', function () {
      activeDriverFilter = button.dataset.driverFilter || 'all';
      driverFilterButtons.forEach((item) => item.classList.toggle('is-active', item === button));
      refreshDriverCards();
    });
  });
  driverSearch?.addEventListener('input', refreshDriverCards);
  driverCards.forEach((card) => card.querySelector('input[type="checkbox"]')?.addEventListener('change', refreshDriverCards));
  refreshDriverCards();

  const teamCards = Array.from(document.querySelectorAll('[data-team-card]'));
  const teamSearch = document.querySelector('[data-team-search]');
  const teamSelectedCount = document.querySelector('[data-team-selected-count]');

  function refreshTeamCards(changedInput) {
    const checked = teamCards.filter((card) => card.querySelector('input[type="checkbox"]')?.checked);
    if (checked.length > 11 && changedInput) {
      changedInput.checked = false;
      window.alert('Es können maximal 11 Teams ausgewählt werden.');
    }
    const currentCount = teamCards.filter((card) => card.querySelector('input[type="checkbox"]')?.checked).length;
    if (teamSelectedCount) teamSelectedCount.textContent = currentCount + ' / 11 ausgewählt';
    teamCards.forEach(function (card) {
      const input = card.querySelector('input[type="checkbox"]');
      card.classList.toggle('is-selected', Boolean(input?.checked));
      const query = (teamSearch?.value || '').trim().toLowerCase();
      card.hidden = Boolean(query && !(card.dataset.teamName || '').includes(query));
    });
  }

  teamCards.forEach(function (card) {
    const input = card.querySelector('input[type="checkbox"]');
    input?.addEventListener('change', function () { refreshTeamCards(input); });
  });
  teamSearch?.addEventListener('input', function () { refreshTeamCards(); });
  refreshTeamCards();


  /*
   * =====================================================
   * LINE-UP
   * Ein Fahrer darf nur einmal verwendet werden.
   * =====================================================
   */

  const lineupSelects = Array.from(
    document.querySelectorAll(
      '.season-lineup-driver-select'
    )
  );


  function updateLineupDriverOptions() {

    const selectedDrivers = new Set();


    /*
     * Alle belegten Fahrer sammeln
     */

    lineupSelects.forEach(function (select) {

      if (select.value) {
        selectedDrivers.add(select.value);
      }

    });


    /*
     * Bereits belegte Fahrer in anderen
     * Dropdowns deaktivieren.
     */

    lineupSelects.forEach(function (select) {

      Array.from(
        select.options
      ).forEach(function (option) {

        /*
         * Leerwert immer erlauben
         */

        if (!option.value) {
          option.disabled = false;
          return;
        }


        /*
         * Aktuell ausgewählter Fahrer
         * dieses Dropdowns bleibt aktiv
         */

        if (
          option.value === select.value
        ) {
          option.disabled = false;
          return;
        }


        option.disabled =
          selectedDrivers.has(
            option.value
          );

      });

    });

  }


  lineupSelects.forEach(function (select) {

    select.addEventListener(
      'change',
      updateLineupDriverOptions
    );

  });


  updateLineupDriverOptions();

});
</script>


<%- include('../partials/footer') %>
