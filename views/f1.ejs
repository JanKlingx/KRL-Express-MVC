<%- include('partials/header', { title }) %>
<% if(isAdmin && typeof seasonAliasData!=='undefined' && seasonAliasData){ %>
<script type="application/json" id="season-alias-data"><%- JSON.stringify(seasonAliasData).replace(/</g,'\\u003c') %></script>
<script src="/js/season-aliases.js" defer></script>
<% } %>

<%
  const findPublicTeam = (teamName) => {

    if (!teamName) {
      return null;
    }

    return (
      teams.find(
        (team) =>
          String(team.name || '')
            .trim()
            .toLowerCase() ===
          String(teamName || '')
            .trim()
            .toLowerCase()
      ) ||
      null
    );
  };

  const safeStandingsHistory =
    typeof standingsHistory === 'undefined'
      ? []
      : standingsHistory;

  const safeRaceStatistics =
    typeof raceStatistics === 'undefined'
      ? []
      : raceStatistics;
%>


<div
  class="league-page"
  style="--accent:<%= league.accentColor %>;--season-accent:<%= league.seasonAccentColor || league.accentColor %>"
>


  <!-- ================================================= -->
  <!-- HERO -->
  <!-- ================================================= -->

  <section class="league-hero">

    <div class="container">

      <% if (league.logoPath) { %>

        <img
          class="league-hero-logo"
          src="<%= league.logoPath %>"
          alt="Logo <%= league.name %>"
        >

      <% } %>


      <span class="eyebrow">
        FORMEL 1 · <%= league.currentSeason %>
      </span>


      <h1>
        <%= league.name %>
      </h1>


      <p>
        <%= league.description %>
      </p>


      <div class="facts">

        <span>
          Renntag
          <strong>
            <%= league.raceDay %>
          </strong>
        </span>

        <span>
          Start
          <strong>
            <%= league.raceTime %>
          </strong>
        </span>

        <span>
          Saison
          <strong>
            <%= league.currentSeason %>
          </strong>
        </span>

      </div>


      <div class="league-resource-links">

        <a href="/formel-1/regelwerk">
          Regelwerk
        </a>

        <a href="/formel-1/race-director-notes">
          Race-Director Notes
        </a>

      </div>

    </div>

  </section>


  <!-- ================================================= -->
  <!-- SAISON -->
  <!-- ================================================= -->

  <nav class="container league-section-nav" aria-label="Liga-Bereiche">
    <a class="button button-small button-ghost" href="#f1-standings-history">WM-Tabelle</a>
    <a class="button button-small button-ghost" href="#season-history">Saisonverlauf</a>
    <a class="button button-small button-ghost" href="#f1-calendar">Rennkalender</a>
    <% if (selectedSeason?.status !== "historical") { %><a class="button button-small button-ghost" href="#f1-lineup">Fahrereinteilung</a><% } %>
    <a class="button button-small button-ghost" href="#f1-gp-results">GP-Ergebnisse</a>
    <a class="button button-small button-ghost" href="#rennstatistik">Rennstatistik</a>
  </nav>
  <section class="season-switcher container">

    <form method="get">

      <label for="season-select">
        Saison auswählen
      </label>

      <select
        id="season-select"
        name="season"
      >

        <%- include(
          'partials/season-options',
          {
            seasons,
            selectedSeason
          }
        ) %>

      </select>


      <noscript>

        <button
          class="button button-small"
          type="submit"
        >
          Saison laden
        </button>

      </noscript>

    </form>

  </section>


  <!-- ================================================= -->
  <!-- ADMIN -->
  <!-- ================================================= -->

  <% if (isAdmin) { %>

    <div class="public-edit-bar">

      <a href="/admin/race-weekend/f1?league=<%= league.id %>&season=<%= selectedSeason?.id || '' %>">
        ✎ Rennwochenende
      </a>

      <a href="/admin/season-manager?league=<%= league.id %>">
        ✎ Saison
      </a>



    </div>

  <% } %>


  <!-- ================================================= -->
  <!-- TEAMS -->
  <!-- ================================================= -->

  <% if (selectedSeason) { %>

    <section class="section container" id="historical-teams">

      <div class="section-heading">

        <span>
          STARTAUFSTELLUNG
        </span>

        <h2>
          TEAMS & FAHRER
        </h2>
        <% if (isAdmin && selectedSeason?.status === 'historical') { %><button class="button button-ghost button-small" type="button" data-historical-open>Teams & Fahrer bearbeiten</button><button class="button button-small" type="button" data-historical-save-copy>Anzeigenamen speichern</button><small data-historical-message-copy role="status">Die Alias-Auswahl gilt nur für diese Saison.</small><% } %>

      </div>


      <div class="f1-team-grid league-team-grid">

        <% teams.forEach((team) => { %>

          <article
            class="f1-team-card league-team-card"
            style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
            aria-label="<%= team.name %>"
          >

            <header class="league-team-heading">
              <div class="league-team-logo">
                <% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt="Logo <%= team.name %>" loading="lazy"><% } else { %><span class="roster-logo-fallback"><%= team.name.slice(0, 2).toUpperCase() %></span><% } %>
              </div>
              <h3><%= team.name %></h3>
            </header>
            <ul aria-label="Fahrer von <%= team.name %>">

              <% team.drivers.forEach((driver) => { %>

                <li <%- isAdmin && selectedSeason?.status==='historical' ? `data-lineup-alias-driver="${Number(driver.id)}"` : '' %>>
                  <strong title="<%= driver.name %>">
                    <%= driver.name %>
                  </strong>
                </li>

              <% }) %>

            </ul>

          </article>

        <% }) %>

      </div>


      <% if (!teams.length) { %>

        <div class="empty-state">
          Noch keine Teams für diese Liga angelegt.
        </div>

      <% } %>

    </section>

  <% } %>


  <!-- ================================================= -->
  <!-- KALENDER -->
  <!-- ================================================= -->

  <% if (selectedSeason?.status !== 'historical') { %><%- include('partials/public-weekend-lineup') %><% } %>

  <section class="section container" id="f1-calendar">

    <div class="section-heading">

      <span>
        ALLE TERMINE
      </span>

      <h2>
        RENNKALENDER
      </h2>

    </div>


    <%- include(
      'partials/race-calendar',
      {
        calendar,
        league,
        emptyMessage:
          'Noch keine Renntermine veröffentlicht.'
      }
    ) %>

  </section>


  <!-- ================================================= -->
  <!-- WM-ZWISCHENSTÄNDE NACH JEDEM GP -->
  <!-- ================================================= -->

  <%- include('partials/league-standings', { standingsHistory: safeStandingsHistory, teams, league, gpResults, selectedSeason }) %>

  <!-- ================================================= -->
  <!-- RENNSTATISTIK -->
  <!-- ================================================= -->

  <section
    class="section container f1-race-statistics"
    id="rennstatistik"
  >

    <div class="section-heading">

      <span>
        HAUPTRENNEN · <%= selectedSeason?.name || league.currentSeason %>
      </span>

      <h2>
        RENNSTATISTIK
      </h2>

    </div>


    <% const editHistoricalStats = isAdmin && selectedSeason?.status === 'historical' && typeof historicalEditor !== 'undefined' && historicalEditor; %>
    <% if (editHistoricalStats) { %>
      <div class="historical-statistics-help">
        <p>Wähle beim Grand Prix „Auszeichnungen bearbeiten“, um Pole Position, schnellste Runde und Driver of the Day für Stamm- und Ersatzfahrer zuzuordnen. Punkte und Fahrerstatistiken werden beim Speichern aktualisiert.</p>
        <button class="button button-small" type="button" data-historical-save-copy>Änderungen speichern</button>
        <p data-historical-message-copy role="status" aria-live="polite">Auszeichnungen erscheinen auch im Saisonverlauf und in den GP-Ergebnissen.</p>
      </div>
    <% } %>
    <div class="f1-race-statistics__scroll">

      <table>

        <thead>

          <tr>
            <th>#</th>
            <th>Land</th>
            <th>Datum</th>
            <th>Driver of the Day</th>
            <th>1. Platz</th>
            <th>2. Platz</th>
            <th>3. Platz</th>
            <th>Poleposition</th>
            <th>Schnellste Runde</th>
            <% if (editHistoricalStats) { %><th>Bearbeiten</th><% } %>
          </tr>

        </thead>


        <tbody>

          <% safeRaceStatistics.forEach((row) => { %>

            <tr data-historical-statistics-round="<%= row.round %>">

              <td data-label="Runde" class="race-statistics-round">
                <% if (row.flagPath) { %><img class="race-statistics-watermark" src="<%= row.flagPath %>" alt="" aria-hidden="true"><% } %>
                R<%= row.round %>
              </td>

              <th data-label="Land">
                <%= row.countryCode || row.countryName || '–' %>
              </th>

              <td data-label="Datum">
                <%= row.date
                  ? new Intl.DateTimeFormat('de-DE').format(
                      new Date(`${row.date}T12:00:00Z`)
                    )
                  : '–'
                %>
              </td>

              <td data-label="Driver of the Day" data-historical-statistic="driverOfTheDay">
                <%= row.driverOfTheDay || '–' %>
              </td>

              <td data-label="1. Platz">
                <%= row.first || '–' %>
              </td>

              <td data-label="2. Platz">
                <%= row.second || '–' %>
              </td>

              <td data-label="3. Platz">
                <%= row.third || '–' %>
              </td>

              <td data-label="Poleposition" data-historical-statistic="polePosition">
                <%= row.pole || '–' %>
              </td>

              <td data-label="Schnellste Runde" data-historical-statistic="fastestLap">
                <%= row.fastestLap || '–' %>
              </td>
              <% if (editHistoricalStats) { %><td data-label="Bearbeiten"><button type="button" class="historical-statistics-edit" data-historical-statistics-open="<%= row.round %>" aria-label="Auszeichnungen für Runde <%= row.round %> bearbeiten">✎ Auszeichnungen bearbeiten</button></td><% } %>

            </tr>

          <% }) %>


          <% if (!safeRaceStatistics.length) { %>

            <tr>

              <td colspan="<%= editHistoricalStats ? 10 : 9 %>">
                Noch keine Hauptrennenergebnisse vorhanden.
              </td>

            </tr>

          <% } %>

        </tbody>

      </table>

    </div>

  </section>


  <!-- ================================================= -->
  <!-- GP RESULTS -->
  <!-- ================================================= -->

  <section
    class="section container gp-results-section"
    id="f1-gp-results"
  >

    <div class="section-heading">

      <h2>
        GP-ERGEBNISSE
      </h2>


      <div class="export-actions">

        <a
          class="download-link"
          href="/f1/<%= league.slug %>/download/gp-results.csv?season=<%= selectedSeason?.id || '' %>"
          download
        >
          CSV ↓
        </a>




      </div>

    </div>


    <%- include(
      'partials/gp-results',
      {
        items: gpResults,
        label: 'Grand-Prix-Ergebnisse',
        teams,
        league
      }
    ) %>

  </section>


  <!-- ================================================= -->
  <!-- SAISONVERLAUF -->
  <!-- ================================================= -->

  <section
    class="section section-dark season-history-section"
    id="season-history"
  >

    <div class="container season-history-wide">

      <div class="section-heading">

        <span>
          VOM AUFTAKT BIS ZUM FINALE
        </span>

        <h2>
          SAISONVERLAUF
        </h2>

      </div>


      <% if (isAdmin && typeof historicalEditor !== 'undefined' && historicalEditor) { %><%- include('partials/historical-grid-editor', {historicalEditor,selectedSeason}) %><% } %>
      <div data-historical-readonly>
      <%- include(
        'partials/season-history',
        {
          history,
          selectedHistory,
          league,
          selectedSeason
        }
      ) %>
      </div>

    </div>

  </section>

</div>


<script
  src="/js/season-history-tabs.js"
  defer
></script>


<script
  src="/js/standings-history.js"
  defer
></script>


<%- include('partials/footer') %>
