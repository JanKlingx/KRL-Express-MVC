<%- include('../partials/header', { title }) %>
<section class="admin-shell season-setup-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">SCHRITT FÜR SCHRITT</span><h1>SAISON-ASSISTENT</h1><p class="admin-intro">Jede Liga erhält ihre eigene Saison-Transaktion. Die Stammdaten der ausgewählten Liga liefern Name, Renntag, Startzeit, Farbe und Logo als Ausgangspunkt.</p></div><a class="button button-ghost" href="/admin/table-hub">Tabellen-Hub</a></div>

  <nav class="setup-steps" aria-label="Saison-Assistent">
    <a class="is-complete" href="#setup-league"><span>1</span><strong>Liga</strong></a>
    <a class="<%= selectedLeague ? 'is-complete' : '' %>" href="#setup-season"><span>2</span><strong>Saison & Farbe</strong></a>
    <a class="<%= selectedSeason ? 'is-complete' : '' %>" href="#setup-calendar"><span>3</span><strong>Rennkalender</strong></a>
    <a class="<%= selectedSeason?.PointsSchemeId ? 'is-complete' : '' %>" href="#setup-points"><span>4</span><strong>Punktesystem</strong></a>
    <a class="<%= selectedLeague?.type !== 'f1' || Object.keys(carAssignmentMap).length ? 'is-complete' : '' %>" href="#setup-cars"><span>5</span><strong><%= selectedLeague?.type === 'f1' ? 'Autos' : 'Abschluss' %></strong></a>
  </nav>

  <section id="setup-league" class="setup-panel"><div class="setup-panel-number">01</div><div class="setup-panel-content"><span>Wofür?</span><h2>LIGA AUSWÄHLEN</h2><form method="get" action="/admin/season-setup" class="setup-choice-grid"><% leagues.forEach((league) => { %><button type="submit" name="league" value="<%= league.id %>" class="setup-choice <%= selectedLeague?.id === league.id ? 'is-selected' : '' %>" style="--setup-accent:<%= league.accentColor %>"><% if (league.logoPath) { %><img src="<%= league.logoPath %>" alt=""><% } %><span><%= league.type === 'f1' ? 'FORMEL 1' : league.type === 'lmu' ? 'LMU' : 'WDL' %></span><strong><%= league.name %></strong><small><%= league.raceDay || 'Renntag offen' %> · <%= league.raceTime || 'Startzeit offen' %></small></button><% }) %></form></div></section>

  <% if (selectedLeague) { %><section id="setup-season" class="setup-panel"><div class="setup-panel-number">02</div><div class="setup-panel-content"><span>Eigene Transaktion für <%= selectedLeague.name %></span><h2>SAISON & FARBPROFIL</h2><div class="league-master-preview" style="--setup-accent:<%= selectedLeague.accentColor %>"><% if (selectedLeague.logoPath) { %><img src="<%= selectedLeague.logoPath %>" alt="Logo <%= selectedLeague.name %>"><% } %><div><strong><%= selectedLeague.name %></strong><small>Stammdaten: <%= selectedLeague.raceDay || 'kein Renntag' %> · <%= selectedLeague.raceTime || 'keine Startzeit' %></small></div></div>
    <div class="setup-two-column"><form method="post" action="/admin/season-setup/seasons" class="setup-form"><input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>"><label>Saisonname<input name="name" required placeholder="z. B. Saison 13 oder 2024"></label><label>Status<select name="status"><option value="active">Aktuelle Saison</option><option value="historical">Historische Saison</option></select></label><label>Saisonfarbe<input type="color" name="accentColor" value="<%= selectedLeague.accentColor || '#6ef2f2' %>"><small>Ersetzt nur in dieser Saison die allgemeine Ligafarbe.</small></label><label>Punktesystem<select name="PointsSchemeId"><option value="">Später auswählen</option><% pointsSchemes.forEach((scheme) => { %><option value="<%= scheme.id %>"><%= scheme.name %></option><% }) %></select></label><button class="button" type="submit">Saison anlegen & weiter</button></form>
    <div class="setup-season-list"><strong>Vorhandene Saisons</strong><% if (!seasons.length) { %><p>Noch keine Saison für diese Liga.</p><% } %><% seasons.forEach((season) => { %><a class="<%= selectedSeason?.id === season.id ? 'is-selected' : '' %>" href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= season.id %>"><span><%= season.status === 'active' ? 'AKTIV' : 'HISTORISCH' %></span><strong><%= season.name %></strong><small><%= season.pointsScheme?.name || 'Punktesystem noch offen' %></small></a><% }) %></div></div>
  </div></section><% } %>

  <% if (selectedSeason) { %><section id="setup-calendar" class="setup-panel"><div class="setup-panel-number">03</div><div class="setup-panel-content"><span><%= selectedSeason.name %></span><h2>RENNKALENDER ERSTELLEN</h2><p>Die Startzeit wird aus den Liga-Stammdaten vorbelegt. Jedes Rennen gehört ausschließlich zu dieser Saison.</p><form id="season-calendar-form" method="post" action="/admin/season-setup/<%= selectedSeason.id %>/calendar" class="setup-form setup-calendar-form"><label>Rennen<input name="title" required placeholder="z. B. 6H Spa"></label><label>Strecke<input name="circuit" placeholder="Spa-Francorchamps"></label><label>Datum<input type="date" name="date" required></label><label>Startzeit<input type="time" name="time" value="<%= defaultTime %>" required></label><label>Runde<input type="number" name="sortOrder" min="0" value="<%= calendar.length + 1 %>"></label><label>Dauer (Min.)<input type="number" name="durationMinutes" min="1" value="120"></label><label class="checkbox-control"><input type="checkbox" name="isTestDay"><span>Als Testtag markieren</span></label><button class="button" type="submit">Rennen hinzufügen</button></form>
    <% if (selectedLeague.type === 'f1') { %><label class="setup-sprint-toggle checkbox-control"><input form="season-calendar-form" type="checkbox" name="hasSprint"><span>Sprint-Event: zusätzliche Sprinttabelle für dieses Rennen anlegen</span></label><% } %><div class="setup-calendar-list"><% if (!calendar.length) { %><div class="empty-state">Noch keine Termine in dieser Saison.</div><% } %><% calendar.forEach((event, index) => { const startsAt = new Date(event.startsAt); %><article class="<%= event.isTestDay ? 'is-test' : '' %>"><span><%= event.isTestDay ? 'TEST' : `R${event.sortOrder || index + 1}` %></span><div><strong><%= event.title %></strong><small><%= event.circuit || '' %> · <%= Number.isNaN(startsAt.getTime()) ? 'Datum prüfen' : new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium', timeStyle: 'short' }).format(startsAt) %></small></div></article><% }) %></div>
  </div></section>

  <section id="setup-points" class="setup-panel"><div class="setup-panel-number">04</div><div class="setup-panel-content"><span>Berechnungsbasis</span><h2>PUNKTESYSTEM & SAISONFARBE</h2><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/profile" class="setup-summary-card setup-profile-form"><label>Saisonfarbe<input type="color" name="accentColor" value="<%= selectedSeason.accentColor || selectedLeague.accentColor || '#6ef2f2' %>"></label><label>Punktesystem<select name="PointsSchemeId"><option value="">Kein Punktesystem / Legacy-Tabelle</option><% pointsSchemes.forEach((scheme) => { %><option value="<%= scheme.id %>" <%= selectedSeason.PointsSchemeId === scheme.id ? 'selected' : '' %>><%= scheme.name %></option><% }) %></select></label><button class="button" type="submit">Profil speichern</button><a class="button button-ghost" href="/admin/pointsSchemes">Punktesysteme pflegen</a></form><p class="setup-note"><%= discipline.toUpperCase() %>: schnellste Runde und LMU-Pole werden direkt im ausgewählten Punktesystem gepflegt. Änderungen wirken sofort auf die Saisonberechnung.</p></div></section>

  <section id="setup-cars" class="setup-panel"><div class="setup-panel-number">05</div><div class="setup-panel-content"><% if (selectedLeague.type === 'f1') { %><span>Historische und aktuelle Fahrzeugprofile</span><h2>FORMEL-1-AUTOS ZUWEISEN</h2><% if (!carProfiles.length) { %><div class="empty-state">Noch keine Autoprofile vorhanden. <a href="/admin/f1CarProfiles/new">Erstes Autoprofil anlegen →</a></div><% } else { %><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/cars" class="setup-car-form"><% f1Teams.forEach((team) => { const linkedProfiles = carProfiles.filter((profile) => Number(profile.BaseTeamId) === team.id); %><label><span class="setup-team-dot" style="background:<%= team.accentColor %>"></span><strong><%= team.name %></strong><select name="cars[<%= team.id %>]" <%= linkedProfiles.length ? '' : 'disabled' %>><option value=""><%= linkedProfiles.length ? 'Kein saisonbezogenes Profil' : 'Zuerst Autoprofil für dieses Team anlegen' %></option><% linkedProfiles.forEach((profile) => { %><option value="<%= profile.id %>" <%= Number(carAssignmentMap[team.id]) === profile.id ? 'selected' : '' %>><%= profile.name %><%= profile.seasonLabel ? ` · ${profile.seasonLabel}` : '' %></option><% }) %></select></label><% }) %><button class="button" type="submit">Autozuweisungen speichern</button></form><p><a href="/admin/f1CarProfiles/new">+ Weiteres historisches Autoprofil anlegen</a></p><% } %><% } else { %><span>Konfiguration abschließen</span><h2>SAISONVERLAUF STARTEN</h2><p>Für <%= selectedLeague.name %> werden Teams, LMU-Fahrer beziehungsweise WDL-Ligen aus den zentralen Stammdaten geladen.</p><% } %><% if (progressHref) { %><a class="button setup-finish" href="<%= progressHref %>">Saisonverlauf <%= selectedSeason.name %> öffnen →</a><% } %></div></section><% } %>
</div></section>
<%- include('../partials/footer') %>
