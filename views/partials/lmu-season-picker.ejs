<form method="get" class="lmu-picker"><label>Liga<select name="league"><% leagues.forEach(row=>{ %><option value="<%= row.id %>" <%= league?.id===row.id?'selected':'' %>><%= row.name %></option><% }); %></select></label><label>Saison<select name="season"><% seasons.forEach(row=>{ %><option value="<%= row.id %>" <%= season?.id===row.id?'selected':'' %>><%= row.name %> · <%= row.status==='active'?'Aktuell':'Historisch' %><%= row.isPublished?'':' · ausgeblendet' %></option><% }); %></select></label><button class="button button-small">Auswahl laden</button></form>
