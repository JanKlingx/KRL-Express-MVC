<%
  const statusOf = (result) =>
    String(result?.status || '')
      .trim()
      .toUpperCase();

  const numberOf = (value) =>
    Number.isFinite(Number(value))
      ? Number(value)
      : 0;

  const hasResult = (result) =>
    Boolean(
      result &&
      (
        result.manualPoints ||
        result.position ||
        result.status ||
        result.fastestLap ||
        numberOf(result.points)
      )
    );

  const podiumClass = (result) => {
    const position = Number(
      result?.position
    );

    return position >= 1 &&
      position <= 3
      ? `season-race-position-${position}`
      : '';
  };


  /*
   * =====================================================
   * SCHNELLSTE RUNDE
   * =====================================================
   */

  const hasFastestLap = (result) =>
    Boolean(
      result?.fastestLap ||
      result?.fastest_lap ||
      result?.awardedFastestLapPoint
    );


  const resultLabel = (
    result,
    mode,
    race
  ) => {

    if (result?.unfilled) return {text:'–',kind:'future',title:'Noch nicht eingetragen'};
    /*
     * Ersatzfahrer außerhalb seines
     * Reserve-Stints:
     *
     * immer "-"
     */
    if (
      mode === 'reserve' &&
      result?.outsideStint
    ) {
      return {
        text: 'DNA',
        kind: 'dna',
        title: 'In dieser Runde kein Ersatzfahrer'
      };
    }


    /*
     * Stammfahrer außerhalb seines
     * Stammfahrer-Stints:
     *
     * DNS
     */
    if (
      mode === 'regular' &&
      result?.outsideStint
    ) {
      return {
        text: 'DNA',
        kind: 'dna',
        title: 'In dieser Runde kein Stammfahrer'
      };
    }


    /*
     * Zukünftiges Rennen
     */
    if (statusOf(result) === 'DNA') return { text: 'DNA', kind: 'dna', title: 'Nicht teilgenommen' };
    if (statusOf(result) === 'DNS') return { text: 'DNS', kind: 'dns', title: 'Nicht gestartet' };
    if (statusOf(result) === 'S') return { text: 'S', kind: 'suspended', title: 'Rennsperre' };

    if (!race?.isCompleted) {
      return {
        text: '–',
        kind: 'future'
      };
    }


    const status =
      statusOf(result);


    /*
     * DNF / DSQ explizit anzeigen
     */
    if (
      status === 'DNF' ||
      status === 'DSQ'
    ) {
      return {
        text: status,
        kind: status.toLowerCase()
      };
    }


    /*
     * Vergangenes Rennen ohne Resultat
     */
    if (
      status === 'DNS' ||
      !hasResult(result)
    ) {
      return {
        text: 'DNS',
        kind: 'dns'
      };
    }


    /*
     * Normales Ergebnis:
     * Punkte anzeigen
     */
    return {
      text: String(
        numberOf(result.points)
      ),
      kind: 'points'
    };
  };


  const activeSeason =
    typeof selectedSeason === 'undefined'
      ? null
      : selectedSeason;


  const game =
    activeSeason?.f1Game;


  const gameLabel =
    game?.name ||
    activeSeason?.gameName ||
    '';
%>


<style>

/* =========================================================
   SCHNELLSTE RUNDE
   ========================================================= */

.sheet-result-single,
.sheet-result-part {
  position: relative;
}


/*
 * Dezente Hervorhebung der Zelle
 */

.sheet-result-single.has-fastest-lap, .sheet-result-part.has-fastest-lap { box-shadow: none; }


/*
 * Kleiner goldener Akzent
 */

.sheet-result-single.has-fastest-lap::before, .sheet-result-part.has-fastest-lap::before { content: none; }


/*
 * FL Badge
 */

.sheet-fastest-lap-badge {
  position: absolute;

  top: 2px;
  right: 2px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 15px;
  height: 11px;

  padding: 0 3px;

  border-radius: 2px;

  background: #ffd60a;

  color: #071014;

  font-size: 7px;
  font-style: normal;
  font-weight: 900;

  line-height: 1;

  letter-spacing: 0.02em;

  z-index: 2;
}


/*
 * Punktzahl bei schnellster Runde
 */

.sheet-result-single.has-fastest-lap,
.sheet-result-part.has-fastest-lap b {
  font-weight: 900;
}


/*
 * Sprint-Zelle etwas kompakter
 */

.sheet-result-part.has-fastest-lap
.sheet-fastest-lap-badge {
  min-width: 13px;

  height: 10px;

  padding: 0 2px;

  font-size: 6px;
}

</style>


<%
if (
  history.seasons.length &&
  selectedHistory
) {
%>


  <!-- ================================================= -->
  <!-- SAISONHEADER -->
  <!-- ================================================= -->

  <header
    class="season-sheet-hero"
    style="--season-accent:<%= activeSeason?.accentColor || league.accentColor || '#6ef2f2' %>"
  >


    <!-- LIGA -->

    <div class="season-sheet-brand">

      <% if (league.logoPath) { %>

        <img
          src="<%= league.logoPath %>"
          alt="Logo <%= league.name %>"
        >

      <% } else { %>

        <span>
          KRL
        </span>

      <% } %>

    </div>


    <!-- SAISON -->

    <div>

      <span>
        MEISTERSCHAFTSVERLAUF
      </span>

      <h3>
        <%= selectedHistory.name %>
      </h3>

      <small>
        <%= league.name %>
        ·
        Punkte je Rennwochenende
      </small>

    </div>


    <!-- F1-SPIEL -->

    <div class="season-sheet-game">

      <% if (game?.logoPath) { %>

        <img
          src="<%= game.logoPath %>"
          alt="<%= game.name %>"
        >

      <% } else if (gameLabel) { %>

        <strong>
          <%= gameLabel %>
        </strong>

      <% } %>

    </div>

  </header>


  <!-- ================================================= -->
  <!-- ADMIN-HINWEIS -->
  <!-- ================================================= -->

  <%
  if (
    history.warning &&
    isAdmin
  ) {
  %>

    <div
      class="history-notice"
      role="status"
    >
      <%= history.warning %>
    </div>

  <% } %>


  <!-- ================================================= -->
  <!-- WERTUNGS-TABS -->
  <!-- ================================================= -->

  <div
    class="season-history-switch"
    role="tablist"
    aria-label="Wertung auswählen"
  >


    <!-- STAMM -->

    <button
      type="button"
      class="season-history-tab is-active"
      data-history-tab="regular"
      role="tab"
      aria-selected="true"
    >

      <span>
        STAMM
      </span>

      <strong>
        Fahrer-WM
      </strong>

      <small>
        <%= selectedHistory.drivers.length %>
        Fahrer
      </small>

    </button>


    <!-- ERSATZ -->

    <button
      type="button"
      class="season-history-tab"
      data-history-tab="reserve"
      role="tab"
      aria-selected="false"
    >

      <span>
        ERSATZ
      </span>

      <strong>
        Ersatzfahrer
      </strong>

      <small>
        <%= (selectedHistory.reserveDrivers || []).length %>
        Fahrer
      </small>

    </button>

  </div>


  <!-- ================================================= -->
  <!-- GEMEINSAME TABELLEN-FUNKTION -->
  <!-- ================================================= -->

  <%
    const raceColumns = selectedHistory.races.flatMap((race, index) => (race.hasSprint ? ["sprint", "main"] : ["main"]).map(type => ({ ...race, weekendIndex: index, type })));
    const renderSheet = (
      drivers,
      mode
    ) => {
      const groups = raceColumns.length > 6 ? [raceColumns, ...Array.from({ length: Math.ceil(raceColumns.length / 6) }, (_, i) => raceColumns.slice(i * 6, (i + 1) * 6))] : [raceColumns];
      const editable = isAdmin && activeSeason?.status === 'historical' && typeof historicalEditor !== 'undefined' && historicalEditor;
      const sheetDrivers = editable ? [...drivers, ...historicalEditor.drivers.filter(d => !drivers.some(row => Number(row.id) === Number(d.id))).map(d => ({id:d.id,name:d.name,results:[],total:0,isPlaceholder:true}))] : drivers;
      groups.forEach((columns, groupIndex) => {
  %>


    <div
      class="
        season-sheet-wrap
        <%= groups.length > 1 ? (groupIndex === 0 ? 'sheet-wide' : 'sheet-narrow') : '' %>
        <%= mode === 'reserve'
          ? 'season-sheet-wrap-reserve'
          : 'season-sheet-wrap-regular'
        %>
      "
      data-season-rounds="<%= selectedHistory.races.length %>" style="--sheet-columns:<%= columns.length %>"
    >


      <table
        class="
          season-sheet-table
          <%= mode === 'reserve'
            ? 'season-sheet-table-reserve'
            : 'season-sheet-table-regular'
          %>
        "
      >


        <!-- ============================================= -->
        <!-- SPALTEN -->
        <!-- ============================================= -->

        <colgroup>


          <!-- POSITION -->

          <col class="col-position">


          <!-- FAHRER -->

          <col class="col-driver">


          <!-- TEAM NUR BEI STAMMFAHRERN -->

          <% if (mode === 'regular') { %>

            <col class="col-team">

          <% } %>


          <!-- RENNEN -->

          <% columns.forEach(() => { %>

            <col class="col-race">

          <% }) %>


          <!-- STATISTIK -->

          <col class="col-stat">

          <col class="col-stat">

          <col class="col-stat">

          <col class="col-rate">

          <col class="col-rate">

        </colgroup>


        <!-- ============================================= -->
        <!-- HEADER -->
        <!-- ============================================= -->

        <thead>

          <tr>


            <!-- POSITION -->

            <th
              class="sheet-sticky sheet-position"
            >
              #
            </th>


            <!-- FAHRER -->

            <th
              class="sheet-sticky sheet-driver"
            >
              FAHRER
            </th>


            <!-- TEAM -->

            <% if (mode === 'regular') { %>

              <th
                class="sheet-sticky sheet-team"
              >
                TEAM
              </th>

            <% } %>


            <!-- RENNEN -->

            <% columns.forEach((race) => { %>

              <th
                class="
                  sheet-race-head
                  <%= race.isCompleted
                    ? 'is-completed'
                    : 'is-upcoming'
                  %>
                  <%= race.hasSprint
                    ? 'has-sprint'
                    : ''
                  %>
                "
                title="Runde <%= race.round %> · <%= race.title %> · <%= race.type === 'sprint' ? 'Sprint' : 'Grand Prix' %>"
              >


                <!-- FLAGGE -->

                <% if (race.countryCode) { %><span class="country-code"><%= race.countryCode %></span><% } %>
                <span class="sheet-flag">

                  <% if (race.countryFlagPath) { %>

                    <img
                      src="<%= race.countryFlagPath %>"
                      alt="<%= race.countryName || '' %>"
                    >

                  <% } else { %>

                    <b>
                      <%= race.code %>
                    </b>

                  <% } %>

                </span>


                <!-- RUNDE -->

                <strong>
                  R<%= race.round %>
                </strong>


                <!-- SPRINT -->

                <% if (race.hasSprint) { %>

                  <small>
                    <%= race.type === 'sprint' ? 'SPR' : 'GP' %>
                  </small>

                <% } %>

              </th>

            <% }) %>


            <!-- STATISTIK -->

            <th class="sheet-stat-head sheet-total-head" title="Kumulierte Gesamtpunkte der bisherigen Rennen">
              Gesamt
            </th>

            <th class="sheet-stat-head" title="Punkteabstand zum Führenden">
              Abstand
            </th>

            <th class="sheet-stat-head">
              Ø
            </th>

            <th
              class="sheet-stat-head sheet-rate-head"
              title="Startquote"
            >
              START
            </th>

            <th
              class="sheet-stat-head sheet-rate-head"
              title="Ausfallquote"
            >
              DNF
            </th>

          </tr>

        </thead>


        <!-- ============================================= -->
        <!-- FAHRER -->
        <!-- ============================================= -->

        <tbody>


          <% sheetDrivers.forEach((driver) => { %>


            <tr <%= driver.isPlaceholder ? 'hidden' : '' %> data-history-driver="<%= driver.id %>" data-history-role="<%= mode %>"
              class="
                <%= driver.isFormerDriver
                  ? 'is-former-driver'
                  : ''
                %>

                <%= mode === 'reserve'
                  ? 'is-reserve-driver'
                  : ''
                %>
              "
            >


              <!-- ======================================= -->
              <!-- POSITION -->
              <!-- ======================================= -->

              <td
                class="sheet-sticky sheet-position"
              >

                <strong>
                  <%= driver.position %>
                </strong>

              </td>


              <!-- ======================================= -->
              <!-- FAHRER -->
              <!-- ======================================= -->

              <td
                class="sheet-sticky sheet-driver"
              >


                <strong title="<%= driver.name %>"><a class="standing-profile-link" href="/krl-statistik?driver=<%= driver.id %>"><%= driver.name %></a></strong>


              </td>


              <!-- ======================================= -->
              <!-- TEAM -->
              <!-- ======================================= -->

              <% if (mode === 'regular') { %>

                <td
                  class="sheet-sticky sheet-team"
                >


                  <% if (driver.teamLogoPath) { %>

                    <img
                      src="<%= driver.teamLogoPath %>"
                      alt="<%= driver.team || 'Team' %>"
                      title="<%= driver.team || '' %>"
                    >

                  <% } else { %>

                    <span
                      title="<%= driver.team || '' %>"
                    >

                      <%= (driver.team || '–')
                        .slice(0, 3)
                        .toUpperCase()
                      %>

                    </span>

                  <% } %>


                </td>

              <% } %>


              <!-- ======================================= -->
              <!-- RENNWOCHENENDEN -->
              <!-- ======================================= -->

              <% columns.forEach((column) => {
                const weekend = driver.results[column.weekendIndex] || {};
                const result = column.type === 'sprint' ? weekend.sprint :
                  (Object.prototype.hasOwnProperty.call(weekend, 'main') ? weekend.main : weekend);
                const view = resultLabel(result, mode, column);
                const awards = { ...result, fastestLap: hasFastestLap(result) };
              %>
                <td class="sheet-result <%= result?.retired ? 'is-historical-retired' : '' %>" data-race-type="<%= column.type %>" data-round="<%= column.round %>">
                  <div class="sheet-result-tile <%= podiumClass(result) %> is-<%= view.kind %>" title="<%= view.title || `${column.title || ''} · ${column.type === 'sprint' ? 'Sprint' : 'Grand Prix'}` %>">
                    <b class="sheet-result-value"><%= view.text %></b>
                    <div class="sheet-result-awards"><%- include('race-awards', { result: awards, isMain: column.type === 'main' }) %></div>
                  </div>
                </td>
              <% }) %>

              <!-- ======================================= -->
              <!-- GESAMTPUNKTE -->
              <!-- ======================================= -->

              <td class="sheet-total">

                <strong>
                  <%= numberOf(driver.total) %>
                </strong>

              </td>


              <!-- ======================================= -->
              <!-- RÜCKSTAND -->
              <!-- ======================================= -->

              <td class="sheet-stat">

                <%= driver.position === 1
                  ? '—'
                  : `+${Math.abs(
                      numberOf(
                        driver.gap
                      )
                    )}`
                %>

              </td>


              <!-- ======================================= -->
              <!-- DURCHSCHNITT -->
              <!-- ======================================= -->

              <td class="sheet-stat">

                <%= numberOf(
                  driver.average
                )
                  .toFixed(1)
                  .replace(
                    '.',
                    ','
                  )
                %>

              </td>


              <!-- ======================================= -->
              <!-- STARTQUOTE -->
              <!-- ======================================= -->

              <td
                class="sheet-stat sheet-rate"
              >

                <%= numberOf(
                  driver.startRate
                ).toFixed(0) %>%

              </td>


              <!-- ======================================= -->
              <!-- AUSFALLQUOTE -->
              <!-- ======================================= -->

              <td
                class="sheet-stat sheet-rate"
              >

                <%= numberOf(
                  driver.failureRate
                ).toFixed(0) %>%

              </td>


            </tr>


          <% }) %>


        </tbody>


      </table>

    </div>


  <% }); }; %>


  <!-- ================================================= -->
  <!-- STAMMFAHRER -->
  <!-- ================================================= -->

  <section
    class="season-history-panel"
    data-history-panel="regular"
    role="tabpanel"
  >

    <%
      renderSheet(
        selectedHistory.drivers,
        'regular'
      );
    %>

  </section>


  <!-- ================================================= -->
  <!-- ERSATZFAHRER -->
  <!-- ================================================= -->

  <section
    class="season-history-panel"
    data-history-panel="reserve"
    role="tabpanel"
    hidden
  >


    <%
    if (
      (
        selectedHistory.reserveDrivers ||
        []
      ).length || (isAdmin && activeSeason?.status === 'historical' && typeof historicalEditor !== 'undefined' && historicalEditor)
    ) {
    %>


      <%
        renderSheet(
          selectedHistory.reserveDrivers,
          'reserve'
        );
      %>


    <% } else { %>


      <div class="empty-state">

        In dieser Saison wurde bisher
        kein Ersatzfahrer eingesetzt.

      </div>


    <% } %>


  </section>

<%- include("race-result-legend") %>
<% } else { %>


  <div class="empty-state">

    Noch keine Ergebnisse eingetragen.

  </div>


<% } %>


