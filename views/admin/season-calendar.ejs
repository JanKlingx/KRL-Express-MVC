<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">ALLE SAISONS</span><h1>RENNKALENDER BEARBEITEN</h1><p class="admin-intro">Liga und Saison auswählen. Danach Termine direkt ergänzen, ändern oder löschen.</p></div><a class="button button-ghost" href="/admin/season-setup">Neue Saison einrichten</a></div>
  <form class="race-selector" method="get"><label>Liga<select name="league" onchange="this.form.submit()"><% leagues.forEach((league) => { %><option value="<%= league.id %>" <%= selectedLeague?.id === league.id ? 'selected' : '' %>><%= league.name %></option><% }) %></select></label><label>Saison<select name="season" onchange="this.form.submit()"><%- include('../partials/season-options', { seasons, selectedSeason }) %></select></label><noscript><button class="button button-small">Öffnen</button></noscript></form>
  <% const trackSelect = (event) => `<label>Strecke *<select name="F1TrackId" required><option value="">Aus Streckenstamm wählen …</option>${tracks.map((track) => `<option value="${track.id}" ${event?.F1TrackId === track.id ? 'selected' : ''}>${track.country} · ${track.name}</option>`).join('')}</select><small>Land und Flagge werden automatisch übernommen.</small></label>`; %>
  <% if (selectedSeason) { %><section class="setup-panel"><div class="setup-panel-number">+</div><div class="setup-panel-content"><h2>TERMIN HINZUFÜGEN</h2><p class="setup-note">Die Startzeit kommt fest aus dem Ligen-Stamm.</p><form method="post" action="/admin/season-calendar/events" class="setup-form setup-calendar-form"><input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>"><input type="hidden" name="SeasonId" value="<%= selectedSeason.id %>"><%- trackSelect(null) %><label>Datum *<input type="date" name="date" required></label><label>Startzeit aus Ligen-Stamm<input type="time" value="<%= defaultTime %>" readonly></label><label>Rennen Nr. *<input type="number" min="1" name="sortOrder" value="<%= events.length + 1 %>" required></label><label class="checkbox-control"><input type="checkbox" name="isTestDay"><span>Testtag</span></label><label class="checkbox-control"><input type="checkbox" name="hasSprint"><span>Sprint</span></label><button class="button">Hinzufügen</button></form></div></section>
  <% if (events.length) { %><form method="post" action="/admin/season-calendar/reorder" class="calendar-reorder-bar" data-calendar-reorder-form><input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>"><input type="hidden" name="SeasonId" value="<%= selectedSeason.id %>"><div data-calendar-order-inputs><% events.forEach((event) => { %><input type="hidden" name="eventIds" value="<%= event.id %>"><% }) %></div><span>↕ Karten ziehen, um Rennen neu zu nummerieren.</span><button class="button button-small" type="submit">Reihenfolge speichern</button></form><% } %>
  <div class="setup-calendar-list season-calendar-editor" data-sortable-calendar><% events.forEach((event, index) => { const startsAt = new Date(event.startsAt); const valid = !Number.isNaN(startsAt.getTime()); %><article class="<%= event.isTestDay ? 'is-test' : '' %>" draggable="true" data-calendar-event="<%= event.id %>"><form method="post" action="/admin/season-calendar/events/<%= event.id %>?_method=PUT" class="setup-form setup-calendar-form"><span class="calendar-drag-handle">↕ R<%= event.sortOrder || index + 1 %></span><%- trackSelect(event) %><label>Land<div class="readonly-master-field"><% if (event.track?.countryRecord?.flagPath) { %><img src="<%= event.track.countryRecord.flagPath %>" alt="Flagge <%= event.track.countryRecord.name %>"><% } %><strong><%= event.track?.countryRecord?.name || event.track?.country || 'aus Stammdaten' %></strong></div></label><label>Datum<input type="date" name="date" value="<%= valid ? startsAt.toISOString().slice(0,10) : '' %>" required></label><label>Zeit aus Ligen-Stamm<input type="time" value="<%= defaultTime %>" readonly></label><input type="hidden" name="sortOrder" value="<%= event.sortOrder || index + 1 %>"><label class="checkbox-control"><input type="checkbox" name="isTestDay" <%= event.isTestDay ? 'checked' : '' %>><span>Testtag</span></label><label class="checkbox-control"><input type="checkbox" name="hasSprint" <%= event.hasSprint ? 'checked' : '' %>><span>Sprint</span></label><button class="button button-small">Speichern</button></form><form method="post" action="/admin/season-calendar/events/<%= event.id %>?_method=DELETE" data-confirm="Termin und Ergebnisse löschen?"><button class="button button-ghost button-small">Löschen</button></form></article><% }) %><% if (!events.length) { %><div class="empty-state">Diese Saison hat noch keine Termine.</div><% } %></div><% } %>
</div></section>
<%- include('../partials/footer') %>
