<% if (isMain) { %><span class="race-awards">
  <% if (result?.fastestLap) { %><em class="race-award race-award-fl" title="Schnellste Runde"><%= typeof compact !== 'undefined' && compact ? 'F' : 'FL' %></em><% } %>
  <% if (result?.polePosition) { %><em class="race-award race-award-pole" title="Pole Position"><%= typeof compact !== 'undefined' && compact ? 'PL' : 'POLE' %></em><% } %>
  <% if (result?.driverOfTheDay) { %><em class="race-award race-award-dotd" title="Driver of the Day"><%= typeof compact !== 'undefined' && compact ? 'D' : 'DotD' %></em><% } %>
</span><% } %>
