<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">FORMEL 1 · OPERATIVER PROZESS</span><h1>RENNWOCHENENDE</h1><p class="admin-intro">Liga und Rennen wählen, anschließend Aufstellung, Anwesenheit und Ergebnis in dieser Reihenfolge abschließen.</p></div></div>
  <form class="race-selector" method="get"><label>Liga<select name="league"><% leagues.forEach((item) => { %><option value="<%= item.id %>" <%= league?.id === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Aktuelle Saison<select name="season"><% seasons.forEach((item) => { %><option value="<%= item.id %>" <%= season?.id === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label><label>Rennen<select name="event"><% events.forEach((item) => { %><option value="<%= item.id %>" <%= event?.id === item.id ? 'selected' : '' %>>R<%= item.sortOrder %> · <%= item.title %></option><% }) %></select></label><noscript><button class="button">Öffnen</button></noscript></form>
  <% if (!race) { %><div class="empty-state">Für diese Auswahl ist noch kein Rennkalender vorhanden.</div><% } else { %>
    <div class="weekend-stepper"><a href="#aufstellung" class="<%= entries.length ? 'complete' : 'active' %>"><span>1</span><strong>Aufstellung</strong><small><%= entries.length ? 'gespeichert' : 'offen' %></small></a><a href="#anwesenheit" class="<%= entries.length ? 'active' : '' %>"><span>2</span><strong>Anwesenheit</strong><small><%= attendanceRows.some((row) => row.entry.attendanceStatus) ? 'bearbeitet' : 'offen' %></small></a><a href="#ergebnisse"><span>3</span><strong>Ergebnisse</strong><small>Plätze & Punkte</small></a></div>

    <section class="weekend-step" id="aufstellung"><div class="weekend-step-number">01</div><div><span>FAHREREINTEILUNG</span><h2>AUFSTELLUNG</h2><p>Stammfahrerstatus setzen, Ersatz zuweisen und Rennsperren kontrollieren.</p><a class="button" href="<%= lineupHref %>"><%= entries.length ? 'Aufstellung prüfen / ändern' : 'Aufstellung jetzt erstellen' %></a></div></section>

    <section class="weekend-step" id="anwesenheit"><div class="weekend-step-number">02</div><div><span>VOR DEM START</span><h2>ANWESENHEITSKONTROLLE</h2><% if (!entries.length) { %><div class="empty-state">Bitte zuerst Schritt 1 speichern.</div><% } else if (!attendanceRows.length) { %><div class="empty-state">Aus der Aufstellung wurden keine anwesenden oder unsicheren Fahrer übernommen.</div><% } else { %><form method="post" action="/admin/race-weekend/f1/<%= race.id %>/attendance" class="attendance-board"><div class="attendance-table"><div class="attendance-row attendance-head"><span>Fahrer</span><span>Rolle / Team</span><span>Anwesenheit</span><span>Ins Ergebnis</span><span>Ersatz in Schritt 2</span></div><% attendanceRows.forEach(({ entry: row, displayTeam }) => { %><div class="attendance-row"><div><strong><%= row.driver.name %></strong><small><%= row.replacementFor ? `Ersatz für ${row.replacementFor.name}` : 'Stammfahrer' %></small></div><div class="attendance-team"><% if (displayTeam?.logoPath) { %><img src="<%= displayTeam.logoPath %>" alt=""><% } %><span><%= displayTeam?.name || 'Saisonteams' %></span></div><label><select name="attendance[<%= row.id %>][status]" data-attendance-status><% attendanceStatuses.forEach((status) => { const selected = row.attendanceStatus || 'anwesend'; %><option value="<%= status.value %>" <%= selected === status.value ? 'selected' : '' %>><%= status.label %></option><% }) %></select></label><label class="result-checkbox"><input type="checkbox" name="attendance[<%= row.id %>][includeInResults]" <%= row.includeInResults || !row.attendanceStatus ? 'checked' : '' %>><span>Übernehmen</span></label><label><select name="attendance[<%= row.id %>][ReplacementDriverId]"><option value="">Kein weiterer Ersatz</option><% availableReplacements.forEach((driver) => { %><option value="<%= driver.id %>"><%= driver.name %></option><% }) %></select><small>Nur bei unangemeldet/zu spät abgemeldet</small></label></div><% }) %></div><button class="button" type="submit">Anwesenheit bestätigen</button></form><% } %></div></section>

    <section class="weekend-step" id="ergebnisse"><div class="weekend-step-number">03</div><div><span>RENNERGEBNIS</span><h2>ERGEBNISSE EINTRAGEN</h2><p>Nur in Schritt 2 markierte Fahrer werden übernommen. Plätze reichen aus; das Punktesystem berechnet automatisch.</p><a class="button" href="<%= resultsHref %>">Ergebnistabelle öffnen</a></div></section>
  <% } %>
</div></section>
<%- include('../partials/footer') %>
