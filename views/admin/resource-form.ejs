<%- include('../partials/header', { title }) %>
<section class="admin-shell">
  <div class="container narrow">
    <a class="back-link" href="<%= returnHref %>">← Zur Übersicht</a>
    <span class="form-kicker"><%= config.group %></span>
    <h1><%= entry && entry.id ? 'EINTRAG BEARBEITEN' : 'NEUER EINTRAG' %></h1>
    <p class="form-hint"><%= config.description %> Pflichtfelder sind mit * markiert.</p>
    <% if (error) { %><div class="form-error" role="alert"><strong>Speichern nicht möglich:</strong> <%= error %></div><% } %>
    <% if (duplicateDriver) { %><div class="duplicate-driver-warning"><div><strong>Namensgleiches Fahrerprofil gefunden</strong><span>Die Fahrer-ID bleibt eindeutig. Prüfe das vorhandene Profil und lege nur dann einen weiteren Fahrer an, wenn es wirklich eine andere Person ist.</span></div><a class="button button-small button-ghost" href="<%= adminBasePath %>/drivers/<%= duplicateDriver.id %>/edit" target="_blank">Profil #<%= duplicateDriver.id %> öffnen</a></div><% } %>

    <% if (resource === 'drivers' && entry?.id) { %><p class="form-hint">Stammränge werden über den Saison-Assistenten und <a href="/admin/season-driver-change">Fahrerwechsel</a> verwaltet. Neue Fahrer mit F1-Sicht starten als F1 Ersatz. Stammplätze werden im Saison-Assistenten oder über Fahrerwechsel vergeben. Ein Ausstieg wird über Fahrerwechsel erfasst.</p><% } %>
    <% if (resource === 'drivers' && entry?.f1SeasonRanks?.length) { %><details><summary>Stammplätze je Saison</summary><ul><% entry.f1SeasonRanks.forEach((rank) => { %><li><%= rank %></li><% }) %></ul></details><% } %>
    <form <%= resource === "drivers" ? "data-driver-wizard" : "" %> data-driver-id="<%= resource === 'drivers' ? (entry?.id || '') : '' %>" data-name-check-url="<%= adminBasePath %>/drivers/check-name" class="resource-form" method="post" enctype="multipart/form-data" action="<%= adminBasePath %>/<%= resource %><%= entry && entry.id ? `/${entry.id}?_method=PUT` : '' %>">
      <% if (resource === 'drivers') { const selectedViews = entry?.driverViews ? [].concat(entry.driverViews) : config.inferredViews(entry || {}); %>
        <input type="hidden" name="driverWizard" value="1">
        <fieldset data-driver-view-picker><legend>2 · Sichten auswählen</legend>
          <p>Wähle die Bereiche, die du pflegen möchtest. Bestehende Angaben in anderen Sichten bleiben erhalten.</p>
          <% [['f1', 'F1'], ['lmu', 'LMU'], ['formerF1', 'Ehemaliger Formel-1-Fahrer']].forEach(([value, label]) => { %>
            <label class="driver-view-choice"><input type="checkbox" name="driverViews" value="<%= value %>" <%= selectedViews.includes(value) ? 'checked' : '' %>><strong><%= label %></strong></label>
          <% }) %>
          <p data-view-error role="alert" hidden>Bitte mindestens eine Sicht auswählen.</p>
        </fieldset>
      <% } %>
      <% config.fields.filter((field) => (!field.visibleWhen || field.visibleWhen(entry)) && !(resource === "drivers" && entry?.id && ["roleF1Friday", "roleF1Saturday", "roleF1Sunday", "roleFormerF1"].includes(field.name))).forEach((field) => { const value = entry ? (entry[field.name] ?? '') : ''; const inputId = `${resource}-${field.name}`; %>
        <% if(field.name==='aliasesText'){ %><div class="field-aliases" data-alias-editor>
          <span><%= field.label %></span>
          <textarea name="aliasesText" aria-label="Aliase, ein Name je Zeile"><%= value %></textarea>
          <% if(entry?.aliasesJson){ %><input type="hidden" disabled data-alias-json name="aliasesJson" value="<%= entry.aliasesJson %>"><% } %>
          <small><%= field.help %></small>
        </div><% }else{ %>
        <label for="<%= inputId %>" class="field-<%= field.type %>" <%- resource === 'drivers' ? `data-driver-view="${config.driverFieldView(field.name)}"` : '' %>>
          <span><%= field.label %><% if (field.required) { %><b aria-hidden="true"> *</b><% } %></span>
          <% if (field.type === 'textarea') { %>
            <textarea id="<%= inputId %>" name="<%= field.name %>" rows="4" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %>><%= value %></textarea>
          <% } else if (field.type === 'checkbox') { %>
            <span class="checkbox-control"><input id="<%= inputId %>" type="checkbox" name="<%= field.name %>" <%= value ? 'checked' : '' %>><span>Aktivieren</span></span>
          <% } else if (field.type === 'select') { %>
            <select id="<%= inputId %>" name="<%= field.name %>" <%= field.required ? 'required' : '' %>>
              <option value=""><%= field.required ? 'Bitte auswählen …' : 'Keine Auswahl / nicht gesetzt' %></option>
              <% (fieldOptions[field.name] || []).forEach((option) => { %>
                <option value="<%= option.value %>" <%= String(value) === option.value ? 'selected' : '' %>><%= option.label %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input id="<%= inputId %>" type="<%= field.type %>" name="<%= field.name %>" value="<%= value %>" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %> <%= field.readonly ? 'readonly aria-readonly="true"' : '' %> <%= field.step ? `step="${field.step}"` : '' %> <%= field.min !== undefined ? `min="${field.min}"` : '' %>>
          <% } %>
          <% if (field.help) { %><small><%= field.help %></small><% } %>
        </label>
        <% } %>
      <% }) %>

      <% if(config.teamLogoGallery && entry?.id) { %>
        <div id="team-logos" class="team-logo-settings">
          <%- include('../partials/team-logo-picker', {picker: {name:'defaultLogo', legend:'Standardlogo für neue Saisons', logos:entry.logoVariants || [], value:entry.logoPath, labelsName:'logoLabels'}}) %>
          <p class="form-hint">Wähle ein Bild als Standard und speichere unten. Bestehende Saisons behalten ihr eigenes Logo. Die Bezeichnungen kannst du direkt unter den Bildern ändern.</p>
        </div>
      <% } %>
      <% if (config.upload && (!config.teamLogoGallery || !entry?.id)) { %>
        <label class="upload-field"><%= config.upload.label || 'Bild' %> <%= entry && entry.id ? (config.teamLogoGallery ? '(optional hinzufügen)' : '(optional ersetzen)') : (config.upload.required ? '*' : '(optional)') %>
          <span class="upload-dropzone" data-upload-dropzone><input type="file" name="image" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" <%= !entry?.id && config.upload.required ? 'required' : '' %>><strong>Bild hierher ziehen</strong><span data-upload-name>oder zum Auswählen klicken</span><img data-upload-local-preview alt="Neue Bildvorschau" hidden></span>
          <small>Upload vom Gerät: PNG, JPG oder WebP, maximal 10 MB. Externe Bild-URLs sind nicht möglich.</small>
        </label>
        <% if (entry && entry[config.upload.field]) { %><figure class="upload-current"><img class="upload-preview" src="<%= entry[config.upload.field] %>" alt="Aktuell gespeichertes Bild"><figcaption><%= config.teamLogoGallery ? 'Standardlogo – frühere Logos bleiben in der Auswahl erhalten.' : 'Gespeichertes Bild – bleibt erhalten, bis du ein neues Bild speicherst.' %></figcaption></figure><% } %>
      <% } %>

      <div class="form-actions">
        <button class="button" type="submit">Speichern</button>
        <a class="button button-ghost" href="<%= returnHref %>">Abbrechen</a>
      </div>
    </form>
    <% if(config.teamLogoGallery && entry?.id) { %>
      <form id="team-logo-upload" class="team-logo-upload" method="post" action="<%= adminBasePath %>/teams/<%= entry.id %>/logos" enctype="multipart/form-data" data-team-logo-upload>
        <h2>Weitere Logos hinzufügen</h2>
        <p>Wähle mehrere Bilder auf einmal. Die Logos werden ergänzt; dein Standardlogo und die Saisonlogos bleiben erhalten.</p>
        <label class="team-logo-drop" data-team-logo-drop>Bilder auswählen oder hier ablegen<input type="file" name="images" multiple required accept="image/png,image/jpeg,image/webp" data-team-logo-files></label>
        <small>Bis zu 12 Bilder · PNG, JPG oder WebP · maximal 10 MB je Bild. Nach dem Upload kannst du die Bezeichnungen ändern.</small>
        <div class="team-logo-upload-previews" data-team-logo-previews aria-live="polite"></div>
        <button type="submit" class="button">Ausgewählte Logos hochladen</button>
      </form>
      <script src="/js/team-logos.js" defer></script>
    <% } %>
  </div>
</section>
<% if (resource === 'drivers') { %><script src="/js/driver-wizard.js" defer></script><% } %>
<script src="/js/alias-chips.js" defer></script>
<%- include('../partials/footer') %>
