<%- include('partials/header', { title }) %>
<section class="league-hero lmu-hero"><div class="container"><span class="eyebrow">LE MANS ULTIMATE · <%= league.currentSeason %></span><h1>LE MANS<br><span>ULTIMATE</span></h1><p><%= league.description %></p><div class="facts"><span>Renntag <strong><%= league.raceDay %></strong></span><span>Start <strong><%= league.raceTime %></strong></span><span>Format <strong>3 Fahrer pro Team</strong></span></div></div></section>
<section class="season-switcher container"><form method="get"><label for="season-select">Saison auswählen</label><select id="season-select" name="season"><% seasons.forEach((season) => { %><option value="<%= season.id %>" <%= selectedSeason?.id === season.id ? 'selected' : '' %>><%= season.name %><%= season.status === 'active' ? ' · Aktiv' : ' · Historisch' %></option><% }) %></select><noscript><button class="button button-small" type="submit">Saison laden</button></noscript></form></section>
<% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/drivers">✎ Fahrer-Stammdaten</a><a href="/admin/cockpits">✎ LMU-Teams/Cockpits</a><a href="/admin/lmuSeasonCalendar">✎ Rennkalender</a><a href="/admin/lmuResultEntries">✎ Saisonverlauf</a></div><% } %>
<section class="section container"><div class="section-heading"><span>STAMMDATEN</span><h2>LMU-FAHRERFELD</h2></div><div class="driver-grid"><% drivers.forEach((driver) => { %><article class="driver-card"><div class="avatar"><% if (driver.avatarPath) { %><img src="<%= driver.avatarPath %>" alt="<%= driver.name %>"><% } else { %><%= driver.name.charAt(0) %><% } %></div><h3><%= driver.name %></h3><span><%= driver.team?.name || 'Team offen' %></span><small><%= driver.platform %><% if (driver.aliases.length) { %> · früher <%= driver.aliases.map((alias) => alias.alias).join(', ') %><% } %></small></article><% }) %><% if (!drivers.length) { %><div class="empty-state">Noch keine LMU-Fahrer angelegt.</div><% } %></div></section>
<section class="section container"><div class="section-heading"><span>TEAMWORK AUF DER LANGSTRECKE</span><h2>COCKPITS</h2></div><div class="cockpit-grid"><% cockpits.forEach(cockpit => { %><article class="cockpit-card"><% if (cockpit.logoPath) { %><img class="cockpit-logo" src="<%= cockpit.logoPath %>" alt="Logo <%= cockpit.teamName %>"><% } %><div class="car-number">#<%= cockpit.carNumber || '00' %></div><span><%= cockpit.vehicleClass || 'Hypercar' %></span><h3><%= cockpit.teamName %></h3><p><%= cockpit.car || 'Le Mans Prototype' %></p><ul><li><%= cockpit.driverOne?.name || cockpit.driver1 || 'Freier Platz' %></li><li><%= cockpit.driverTwo?.name || cockpit.driver2 || 'Freier Platz' %></li><li><%= cockpit.driverThree?.name || cockpit.driver3 || 'Freier Platz' %></li><% if (cockpit.reserve?.name || cockpit.reserveDriver) { %><li>Ersatz: <%= cockpit.reserve?.name || cockpit.reserveDriver %></li><% } %></ul></article><% }) %></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><span>SAISONTERMINE</span><h2>LMU-RENNKALENDER</h2></div><div class="calendar-grid"><% calendar.forEach((race) => { %><article class="calendar-card"><time datetime="<%= race.startsAt.toISOString() %>"><%= new Intl.DateTimeFormat('de-DE', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit', timeZone:'Europe/Berlin' }).format(race.startsAt) %></time><h3><%= race.title %></h3><p><%= race.circuit || league.name %></p></article><% }) %><% if (!calendar.length) { %><div class="empty-state">Noch keine LMU-Renntermine veröffentlicht.</div><% } %></div></div></section>
<section class="section section-dark"><div class="container standings-grid"><div><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>LMU WM-STAND</h2><a class="download-link" href="/lmu/download/wm.csv?season=<%= selectedSeason?.id || '' %>" download>WM herunterladen (.csv) ↓</a></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Fahrer</th><th>Team</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% driverStandings.forEach((row) => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.driver.name %></td><td><%= row.driver.team.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div></div><div><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>TEAM-WM</h2></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Team</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% teamStandings.forEach((row) => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.team.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div></div></div></section>
<section class="section container gp-results-section"><div class="section-heading"><span>AUTOMATISCH AUS DEM SAISONVERLAUF</span><h2>LMU GP-RESULTS</h2><a class="download-link" href="/lmu/download/results.csv?season=<%= selectedSeason?.id || '' %>" download>Results herunterladen (.csv) ↓</a></div><%- include('partials/gp-results', { items: gpResults, label: 'LMU-Ergebnisse' }) %></section>
<%- include('partials/footer') %>
