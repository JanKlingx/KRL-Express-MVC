<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker"><%= discipline.toUpperCase() %> · Saisonverlauf</span><h1>RENNEINGABE PRO STRECKE</h1><p class="admin-intro">Saison und Kalenderrennen auswählen und anschließend das komplette Rennen in einer Tabelle pflegen.</p></div></div>
  <form class="race-selector series-race-selector" method="get" action="/admin/season-progress/<%= discipline %>">
    <label for="season">Saison auswählen</label><select id="season" name="season"><%- include('../partials/season-options', { seasons, selectedSeason }) %></select>
    <label for="race">Rennen auswählen</label><select id="race" name="race"><% races.forEach((race) => { %><option value="<%= race.id %>" <%= selectedRace?.id === race.id ? 'selected' : '' %>>R<%= race.sortOrder %> · <%= race.title %></option><% }) %></select>
    <noscript><button class="button button-small" type="submit">Öffnen</button></noscript>
  </form>
  <% if (!selectedRace) { %><div class="empty-state">Lege zuerst ein Rennen im Kalender oder in der historischen Saisonverwaltung an.</div><% } else { %>
  <form method="post" action="/admin/season-progress/<%= discipline %>/<%= selectedRace.id %>" class="race-sheet-form">
    <div class="race-sheet-heading"><div><span><%= selectedSeason.name %> · R<%= selectedRace.sortOrder %></span><h2><%= selectedRace.title %></h2></div><button class="button" type="submit">Gesamtes Rennen speichern</button></div>
    <div class="table-wrap race-sheet"><table><thead><% if (discipline === 'lmu') { %><tr><th>Dabei</th><th>Fahrer</th><th>Team</th><th>Platz</th><th>Status</th><th>Punkte</th><th>SR</th></tr><% } else { %><tr><th>WDL-Liga</th><th>Fahrer 1</th><th>Platz</th><th>SR</th><th>Fahrer 2</th><th>Platz</th><th>SR</th><th>Punkte</th></tr><% } %></thead><tbody>
      <% if (discipline === 'lmu') { rows.forEach(({ driver, teamName, entry }) => { %><tr class="<%= entry ? 'sheet-row-active' : '' %>"><td><input type="checkbox" name="rows[<%= driver.id %>][included]" <%= entry ? 'checked' : '' %>></td><td><strong>#<%= driver.id %> · <%= driver.name %></strong></td><td><input name="rows[<%= driver.id %>][teamName]" value="<%= entry?.teamName || teamName %>"></td><td><input type="number" min="1" name="rows[<%= driver.id %>][position]" value="<%= entry?.position || '' %>"></td><td><select name="rows[<%= driver.id %>][status]"><% ['', 'DNF', 'DNS', 'DSQ'].forEach((status) => { %><option value="<%= status %>" <%= String(entry?.status || '') === status ? 'selected' : '' %>><%= status || 'Gewertet' %></option><% }) %></select></td><td><strong><%= entry ? Number(entry.points) : 'auto' %></strong></td><td><input type="checkbox" name="rows[<%= driver.id %>][fastestLap]" <%= entry?.fastestLap ? 'checked' : '' %>></td></tr><% }) } else { rows.forEach(({ participant, entry, allowedDriverIds }) => { const selectableDrivers = selectedSeason.status === 'historical' ? drivers : drivers.filter((driver) => allowedDriverIds.includes(driver.id)); %><tr><td><strong><%= participant.name %></strong></td><td><select name="rows[<%= participant.id %>][Driver1Id]"><option value="">Fahrer wählen …</option><% selectableDrivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= entry?.Driver1Id === driver.id ? 'selected' : '' %>><%= driver.name %></option><% }) %></select></td><td><input type="number" min="1" name="rows[<%= participant.id %>][positionOne]" value="<%= entry?.positionOne || '' %>"></td><td><input type="checkbox" name="rows[<%= participant.id %>][fastestLapOne]" <%= entry?.fastestLapOne ? 'checked' : '' %>></td><td><select name="rows[<%= participant.id %>][Driver2Id]"><option value="">Fahrer wählen …</option><% selectableDrivers.forEach((driver) => { %><option value="<%= driver.id %>" <%= entry?.Driver2Id === driver.id ? 'selected' : '' %>><%= driver.name %></option><% }) %></select></td><td><input type="number" min="1" name="rows[<%= participant.id %>][positionTwo]" value="<%= entry?.positionTwo || '' %>"></td><td><input type="checkbox" name="rows[<%= participant.id %>][fastestLapTwo]" <%= entry?.fastestLapTwo ? 'checked' : '' %>></td><td><strong><%= entry ? Number(entry.totalPoints) : 'auto' %></strong></td></tr><% }) } %>
    </tbody></table></div>
    <div class="sheet-help">Punkte und Schnellste-Runde-Bonus werden über das zum Renndatum gültige Punktesystem berechnet. Jede Platzierung darf innerhalb eines Rennens nur einmal vorkommen.</div>
    <button class="button" type="submit">Gesamtes Rennen speichern</button>
  </form><% } %>
</div></section>
<%- include('../partials/footer') %>
