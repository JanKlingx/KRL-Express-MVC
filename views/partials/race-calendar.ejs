<% const visibleCalendar = calendar.filter((race) => race.isPublished !== false || (typeof isAdmin !== 'undefined' && isAdmin)); %>
<% if (visibleCalendar.length) { %>

  <div class="race-calendar-grid">

    <% visibleCalendar.forEach((race, index) => {

      const startsAt =
        new Date(race.startsAt);

      const hasValidDate =
        Boolean(race.startsAt) &&
        !Number.isNaN(
          startsAt.getTime()
        );

      const month =
        hasValidDate
          ? new Intl.DateTimeFormat(
              "de-DE",
              {
                month: "short",
                timeZone:
                  "Europe/Berlin",
              }
            )
              .format(startsAt)
              .replace(".", "")
              .toUpperCase()
          : "OFFEN";

      const cardClasses = [
        "race-calendar-card",
        race.isCompleted && "is-completed",

        race.isTestDay &&
          "race-calendar-test",

        !hasValidDate &&
          "race-calendar-invalid",
      ]
        .filter(Boolean)
        .join(" ");

    %>

      <article
        class="<%= cardClasses %>"
        style="--calendar-accent:<%= league.accentColor || '#6ef2f2' %>"
      >

        <% if (typeof isAdmin !== 'undefined' && isAdmin && Number.isInteger(Number(race.id))) { %><a class="calendar-edit-pencil" href="/admin/calendar-events/<%= race.id %>/edit" aria-label="<%= race.title %> bearbeiten" title="Termin bearbeiten">✎</a><% } %>
        <% if (typeof isAdmin !== 'undefined' && isAdmin && Number.isInteger(Number(race.id))) { %>
          <form class="calendar-completion-action" method="post" action="/admin/calendar-events/<%= race.id %>/completion">
            <input type="hidden" name="completed" value="<%= race.isCompleted ? '0' : '1' %>">
            <button type="submit" aria-label="<%= race.isCompleted ? 'Wieder als offen markieren' : 'Als gefahren markieren' %>" title="<%= race.isCompleted ? 'Wieder als offen markieren' : 'Als gefahren markieren' %>"><%= race.isCompleted ? '×' : '✓' %></button>
          </form>
        <% } %>
        <% if (race.isCompleted) { %><span class="calendar-completed-badge">✓ Gefahren</span><% } %>
        <% if (league.logoPath) { %>

          <img class="race-calendar-watermark" src="<%= league.logoPath %>" alt="" aria-hidden="true">

        <% } %>


        <div class="race-calendar-round">

          <span>
            <%= race.isTestDay
              ? "TESTTAG"
              : "RUNDE"
            %>
          </span>

          <% if (!race.isTestDay) { %>
            <strong><%= String(race.sortOrder).padStart(2, "0") %></strong>
          <% } %>

        </div>


        <time
          <% if (hasValidDate) { %>
            datetime="<%= startsAt.toISOString() %>"
          <% } %>
        >

          <strong>

            <%= hasValidDate
              ? new Intl.DateTimeFormat(
                  "de-DE",
                  {
                    day:
                      "2-digit",

                    timeZone:
                      "Europe/Berlin",
                  }
                ).format(
                  startsAt
                )
              : "–"
            %>

          </strong>


          <span>
            <%= month %>
          </span>


          <small>

            <%= hasValidDate
              ? new Intl.DateTimeFormat(
                  "de-DE",
                  {
                    year:
                      "numeric",

                    timeZone:
                      "Europe/Berlin",
                  }
                ).format(
                  startsAt
                )
              : "DATUM"
            %>

          </small>

        </time>


        <div class="race-calendar-info">


          <div class="race-calendar-tags">

            <span>

              <%= hasValidDate
                ? `${new Intl.DateTimeFormat(
                    "de-DE",
                    {
                      weekday:
                        "long",

                      hour:
                        "2-digit",

                      minute:
                        "2-digit",

                      timeZone:
                        "Europe/Berlin",
                    }
                  ).format(
                    startsAt
                  )} Uhr`
                : "TERMIN IM ADMIN PRÜFEN"
              %>

            </span>


            <% if (race.isTestDay) { %>

              <strong>TESTTAG</strong>

            <% } %>


            <% if (
              race.hasSprint &&
              !race.isTestDay
            ) { %>

              <strong
                class="calendar-sprint-badge"
              >
                SPRINT
              </strong>

            <% } %>


            <% if (race.calendarChanged) { %>

              <strong
                class="calendar-change-badge"
              >
                GEÄNDERT
              </strong>

            <% } %>

          </div>


          <div class="race-calendar-title">

            <% if (
              race.track
                ?.countryRecord
                ?.flagPath
            ) { %>

              <img
                src="<%= race.track.countryRecord.flagPath %>"
                alt="Flagge <%= race.track.countryRecord.name %>"
              >

            <% } %>


            <h3>
              <%= race.isTestDay ? (race.track?.countryRecord?.name || race.track?.country || String(race.title || '').replace(/^testtag\s*[·:–-]?\s*/i, '')) : race.title %>
            </h3>

          </div>


         


          <% if (
            race.calendarChanged &&
            race.previousStartsAt
          ) {

            const oldDate =
              new Date(
                race.previousStartsAt
              );

          %>

            <small
              class="calendar-old-date"
            >

              Alter Termin:

              <%= Number.isNaN(
                oldDate.getTime()
              )
                ? "unbekannt"
                : new Intl.DateTimeFormat(
                    "de-DE",
                    {
                      day:
                        "2-digit",

                      month:
                        "2-digit",

                      year:
                        "numeric",

                      hour:
                        "2-digit",

                      minute:
                        "2-digit",

                      timeZone:
                        "Europe/Berlin",
                    }
                  ).format(
                    oldDate
                  )
              %>

              Uhr

            </small>

          <% } %>


        </div>

      </article>

    <% }) %>

  </div>

<% } else { %>

  <div class="empty-state">

    <%= emptyMessage %>

  </div>

<% } %>
