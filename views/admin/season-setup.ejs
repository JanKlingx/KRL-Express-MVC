<%- include('../partials/header', { title }) %>

<%
  const historicalSetup = selectedSeason?.status === 'historical';
  const setupWizard = typeof wizard === 'undefined' ? { current: 1, available: 8 } : wizard;
  const setupStructure =
    typeof structure === 'undefined'
      ? { allDrivers: [], teams: [], unassignedDrivers: [] }
      : structure;

  const setupTracks =
    typeof tracks === 'undefined'
      ? []
      : tracks;

  const setupEligibleDrivers =
    typeof eligibleDrivers === 'undefined'
      ? []
      : eligibleDrivers;

  const setupFinishReady =
    typeof finishReady === 'undefined'
      ? false
      : finishReady;

  const setupF1Games =
    typeof f1Games === 'undefined'
      ? []
      : f1Games;

  const setupCentralCalendars =
    typeof centralCalendars === 'undefined' ? [] : centralCalendars;

  const setupSelectedCentralCalendar =
    typeof selectedCentralCalendar === 'undefined' ? null : selectedCentralCalendar;

  const setupLineupProtected =
    typeof lineupProtected === 'undefined'
      ? false
      : lineupProtected;

const setupDriverRankFilter =
  typeof driverRankFilter === 'undefined'
    ? 'all'
    : driverRankFilter;

  const selectedDriverIds = new Set(
    (setupStructure.allDrivers || []).map(
      (driver) => Number(driver.id)
    )
  );

  const selectedTeamTokens = new Set(
    (setupStructure.teams || []).map(
      (team) => `${team.sourceType}:${team.sourceId}`
    )
  );

  const assignedByTeam = new Map(
    (setupStructure.teams || []).map((team) => [
      Number(team.id),
      new Set(
        (team.drivers || []).map(
          (driver) =>
            Number(
              driver.DriverId ||
              driver.driver?.id ||
              driver.id
            )
        )
      )
    ])
  );
%>


<section class="admin-shell season-setup-shell" data-season-wizard data-current-step="<%= setupWizard.current %>" data-available-step="<%= setupWizard.available %>">
  <div class="container">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="admin-heading">

      <div>
        <a class="back-link" href="/admin">
          ← Dashboard
        </a>

        <span class="form-kicker">
          FORMEL 1 · FIORI-ASSISTENT
        </span>

        <h1>
          F1-SAISON ERSTELLEN
        </h1>

        <p class="admin-intro">
          <%= historicalSetup ? 'Sieben' : 'Acht' %> Schritte greifen auf Stammdaten zurück.
          Die Saison wird erst im letzten Schritt veröffentlicht.
        </p>
      </div>

      <a
        class="button button-ghost"
        href="/admin/season-manager"
      >
        Saison bearbeiten
      </a>

    </div>


    <!-- ================================================= -->
    <!-- SCHRITT-NAVIGATION -->
    <!-- ================================================= -->

    <nav class="setup-steps setup-steps-eight">

      <a
        href="#setup-league" data-step-link="1" aria-disabled="<%= setupWizard.available < 1 %>"
        class="is-complete"
      >
        <span>1</span>
        <strong>Liga</strong>
      </a>

      <a
        href="#setup-season" data-step-link="2" aria-disabled="<%= setupWizard.available < 2 %>"
        class="<%= selectedLeague ? 'is-complete' : '' %>"
      >
        <span>2</span>
        <strong>Saison</strong>
      </a>

      <a
        href="#setup-calendar" data-step-link="3" aria-disabled="<%= setupWizard.available < 3 %>"
        class="<%= calendar.length ? 'is-complete' : '' %>"
      >
        <span>3</span>
        <strong>Kalender</strong>
      </a>

      <a
        href="#setup-points" data-step-link="4" aria-disabled="<%= setupWizard.available < 4 %>"
        class="<%= selectedSeason?.PointsSchemeId ? 'is-complete' : '' %>"
      >
        <span>4</span>
        <strong>Punkte</strong>
      </a>

      <a
        href="#setup-drivers" data-step-link="5" aria-disabled="<%= setupWizard.available < 5 %>"
        class="<%= setupStructure.allDrivers.length ? 'is-complete' : '' %>"
      >
        <span>5</span>
        <strong>Fahrer</strong>
      </a>

      <a
        href="#setup-teams" data-step-link="6" aria-disabled="<%= setupWizard.available < 6 %>"
        class="<%= setupStructure.teams.length ? 'is-complete' : '' %>"
      >
        <span>6</span>
        <strong>Teams</strong>
      </a>

      <% if (!historicalSetup) { %><a
        href="#setup-lineup" data-step-link="7" aria-disabled="<%= setupWizard.available < 7 %>"
        class="<%= setupStructure.teams.some((team) => (team.drivers || []).length) ? 'is-complete' : '' %>"
      >
        <span>7</span>
        <strong>Line-up</strong>
      </a><% } %>

      <a
        href="#setup-finish" data-step-link="8" aria-disabled="<%= setupWizard.available < 8 %>"
        class="<%= setupFinishReady ? 'is-complete' : '' %>"
      >
        <span><%= historicalSetup ? 7 : 8 %></span>
        <strong>Abschluss</strong>
      </a>

    </nav>

    <% if (selectedSeason && setupLineupProtected) { %>
      <aside class="season-lineup-lock" role="status">
        <div><strong>SAISON-LINE-UP GESCHÜTZT</strong><span>Stammfahrer einer laufenden Saison können nur über Fahrerwechsel geändert werden.</span></div>
        <a class="button button-small" href="/admin/season-driver-change?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>">FAHRERWECHSEL ÖFFNEN</a>
      </aside>
    <% } %>


    <!-- ================================================= -->
    <!-- 01 LIGA -->
    <!-- ================================================= -->

    <section
      id="setup-league" data-setup-step="1" <%= setupWizard.current !== 1 ? 'hidden' : '' %>
      class="setup-panel"
    >

      <div class="setup-panel-number">
        01
      </div>

      <div class="setup-panel-content">

        <span>
          Freitag, Samstag oder Sonntag
        </span>

        <h2>
          LIGA AUSWÄHLEN
        </h2>

        <form
          method="get"
          class="setup-choice-grid"
        >

          <% leagues.forEach((league) => { %>

            <button
              class="setup-choice <%= selectedLeague?.id === league.id ? 'is-selected' : '' %>"
              style="--setup-accent:<%= league.accentColor %>"
              name="league"
              value="<%= league.id %>"
            >

              <% if (league.logoPath) { %>
                <img
                  src="<%= league.logoPath %>"
                  alt=""
                >
              <% } %>

              <span>
                FORMEL 1
              </span>

              <strong>
                <%= league.name %>
              </strong>

              <small>
                <%= league.raceDay %>
                ·
                <%= league.raceTime %>
              </small>

            </button>

          <% }) %>

        </form>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- 02 SAISON -->
    <!-- ================================================= -->

    <% if (selectedLeague) { %>

      <section
        id="setup-season" data-setup-step="2" <%= setupWizard.current !== 2 ? 'hidden' : '' %>
        class="setup-panel"
      >

        <div class="setup-panel-number">
          02
        </div>

        <div class="setup-panel-content">

          <span>
            Pflichtangaben
          </span>

          <h2>
            SAISON & FARBPROFIL
          </h2>

          <div class="setup-two-column">

            <% if (selectedSeason) { %>
              <form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/metadata" class="setup-form">
                <p><strong><%= selectedSeason.status === 'historical' ? 'Historische Saison' : 'Aktuelle Saison' %></strong> · Angaben nachträglich bearbeiten</p>
                <label>Saisonname<input name="name" value="<%= selectedSeason.name %>" maxlength="255" required></label>
                <label>Farbe<input type="color" name="accentColor" value="<%= selectedSeason.accentColor || selectedLeague.accentColor %>" required></label>
                <label>F1-Spiel<select name="F1GameId"><option value="">Kein Spiel</option><% setupF1Games.forEach((game) => { %><option value="<%= game.id %>" <%= Number(selectedSeason.F1GameId) === Number(game.id) ? 'selected' : '' %>><%= game.name %></option><% }) %></select></label>
                <button class="button">Änderungen speichern</button>
                <a href="/admin/season-setup?league=<%= selectedLeague.id %>&step=2">Neue Saison anlegen</a>
                <a href="/admin/season-manager?league=<%= selectedLeague.id %>">Saisonstatus bearbeiten</a>
              </form>
            <% } else { %>
            <form
              method="post"
              action="/admin/season-setup/seasons"
              class="setup-form"
            >

              <input
                type="hidden"
                name="LeagueId"
                value="<%= selectedLeague.id %>"
              >

              <label>
                Saisonname

                <input
                  name="name"
                  required
                >
              </label>

              <label>
                Status

                <select
                  name="status"
                  required
                >
                  <option value="active">
                    Aktuell
                  </option>

                  <option value="historical">
                    Historisch
                  </option>
                </select>
              </label>

              <label>
                Farbe

                <input
                  type="color"
                  name="accentColor"
                  value="<%= selectedLeague.accentColor %>"
                  required
                >
              </label>

              <label>
                F1-Spiel
                <select name="F1GameId">
                  <option value="">Kein Spiel ausgewählt</option>
                  <% setupF1Games.forEach((game) => { %>
                    <option value="<%= game.id %>"><%= game.name %></option>
                  <% }) %>
                </select>
                <small>Logo und Spielname werden im öffentlichen Saisonverlauf angezeigt.</small>
              </label>

              <% if (setupCentralCalendars.length) { %>
                <label>
                  Zentraler F1-Rennkalender
                  <select name="F1CalendarId" required>
                    <option value="">Kalender auswählen …</option>
                    <% setupCentralCalendars.forEach((calendar) => { %>
                      <option value="<%= calendar.id %>"><%= calendar.name %></option>
                    <% }) %>
                  </select>
                  <small>Die Auswahl wird dauerhaft in der neuen Saison gespeichert.</small>
                </label>
              <% } else { %>
                <div class="setup-calendar-missing">
                  <strong>Kein zentraler F1-Rennkalender vorhanden</strong>
                  <span><a href="/admin/f1-calendars">Zentralen F1-Rennkalender zuerst in den Stammdaten anlegen →</a></span>
                </div>
              <% } %>

              <label class="checkbox-control setup-option-card">
                <input
                  type="checkbox"
                  name="reservePointsForConstructors"
                  checked
                >
                <span>
                  <strong>Ersatzfahrer-Punkte in Team-WM berücksichtigen</strong>
                  <small>Aktiv: Ersatzfahrer sammeln Punkte für das eingesetzte Team. Deaktiviert: Ersatzfahrer erhalten ihre Fahrer-Punkte, diese werden jedoch nicht zur Team-WM addiert.</small>
                </span>
              </label>

              <button class="button" <%= setupCentralCalendars.length ? '' : 'disabled' %>>
                Saison anlegen
              </button>

            </form>
            <% } %>


            <div class="setup-season-list">

              <strong>
                Vorhandene Saisons
              </strong>

              <% seasons.forEach((season) => { %>

                <a
                  href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= season.id %>"
                  class="<%= selectedSeason?.id === season.id ? 'is-selected' : '' %>"
                >

                  <span>
                    <%= season.status === 'active'
                      ? 'AKTUELL'
                      : 'HISTORISCH'
                    %>
                  </span>

                  <strong>
                    <%= season.name %>
                  </strong>

                  <small>
                    <%= season.isPublished
                      ? 'Veröffentlicht'
                      : 'Assistent noch offen'
                    %>
                  </small>

                </a>

              <% }) %>

            </div>

          </div>

          <% if (selectedSeason) { %>
            <form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/central-calendar/select" class="setup-form setup-calendar-selection-form">
              <div>
                <span>ZENTRALER F1-RENNKALENDER DIESER SAISON</span>
                <strong><%= setupSelectedCentralCalendar?.name || 'Noch nicht ausgewählt' %></strong>
                <small>Bestehende RaceEvents werden nur über Rundennummer und identische Strecke sicher verknüpft. Ergebnisse und Line-ups bleiben unverändert.</small>
              </div>
              <% if (setupCentralCalendars.length) { %>
                <label>Kalendervorlage
                  <select name="F1CalendarId" required>
                    <option value="">Kalender auswählen …</option>
                    <% setupCentralCalendars.forEach((calendar) => { %>
                      <option value="<%= calendar.id %>" <%= Number(selectedSeason.F1CalendarId) === Number(calendar.id) ? 'selected' : '' %>><%= calendar.name %> · <%= calendar.rounds?.length || 0 %> Runden</option>
                    <% }) %>
                  </select>
                </label>
                <button class="button button-small">Auswahl speichern</button>
              <% } else { %>
                <a class="button button-ghost" href="/admin/f1-calendars">Zentrale Stammdaten öffnen</a>
              <% } %>
            </form>
          <% } %>

        </div>

      </section>

    <% } %>


    <% if (selectedSeason) { %>


      <!-- ================================================= -->
      <!-- 03 RENNKALENDER -->
      <section id="setup-calendar" data-setup-step="3" <%= setupWizard.current !== 3 ? 'hidden' : '' %> class="setup-panel">
        <div class="setup-panel-number">03</div>
        <div class="setup-panel-content">
          <span>DATUM + FESTE LIGA-UHRZEIT</span>
          <h2>RENNTERMINE FESTLEGEN</h2>
          <p class="setup-note">Runden, Strecken, Länder, Sprint und Testtag stammen ausschließlich aus dem in Schritt 2 gespeicherten zentralen F1-Kalender.</p>

          <% if (!selectedSeason.F1CalendarId || !setupSelectedCentralCalendar) { %>
            <div class="empty-state setup-calendar-required">
              <strong>Für diese Saison ist noch kein zentraler F1-Rennkalender gespeichert.</strong>
              <span>Wählen Sie den Kalender zuerst in Schritt 2 aus.</span>
              <a class="button button-small" href="#setup-season" data-step-link="2" aria-disabled="<%= setupWizard.available < 2 %>">Zu Schritt 2</a>
            </div>
          <% } else { %>
            <div class="setup-calendar-master-summary">
              <div>
                <span>AKTUELLER ZENTRALER F1-RENNKALENDER</span>
                <strong><%= setupSelectedCentralCalendar.name %></strong>
                <small><%= setupSelectedCentralCalendar.rounds?.length || 0 %> Runden · Zeit aus <%= selectedLeague.name %>: <%= defaultTime %></small>
              </div>
              <a class="button button-ghost button-small" href="/admin/f1-calendars?calendar=<%= setupSelectedCentralCalendar.id %>">Zentralen Kalender öffnen</a>
            </div>

            <% const eventByRound = new Map(calendar.filter((event) => event.F1CalendarRoundId).map((event) => [Number(event.F1CalendarRoundId), event])); %>
            <form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/central-calendar" class="setup-calendar-dates-form">
              <div class="table-wrap setup-calendar-table-wrap">
                <table class="setup-calendar-table">
                  <thead>
                    <tr><th>Runde</th><th>Flagge</th><th>Land</th><th>Strecke</th><th>Sprint</th><th>Testtag</th><th>Datum</th></tr>
                  </thead>
                  <tbody>
                    <% (setupSelectedCentralCalendar.rounds || []).forEach((round) => {
                      const event = eventByRound.get(Number(round.id)) || calendar.find((candidate) => Number(candidate.sortOrder) === Number(round.roundNumber || round.sortOrder) && Number(candidate.F1TrackId) === Number(round.F1TrackId));
                      const startsAt = event?.startsAt ? new Date(event.startsAt) : null;
                      const draft = typeof calendarDraft !== 'undefined' ? calendarDraft : null;
                      const dateValue = draft && Object.hasOwn(draft.dates, round.id) ? draft.dates[round.id] : startsAt && !Number.isNaN(startsAt.getTime()) ? localDateTime(startsAt).slice(0, 10) : '';
                      const dateError = draft?.errors?.[round.id];
                      const countryName = round.track?.countryRecord?.name || round.track?.country || '–';
                    %>
                      <tr class="<%= round.isTestDay ? 'is-test' : '' %>">
                        <td><strong><%= round.isTestDay ? 'TEST' : `R${round.roundNumber || round.sortOrder}` %></strong></td>
                        <td class="setup-calendar-flag"><% if (round.track?.countryRecord?.flagPath) { %><img src="<%= round.track.countryRecord.flagPath %>" alt="Flagge <%= countryName %>"><% } else { %><span aria-hidden="true">🏁</span><% } %></td>
                        <td><%= countryName %></td>
                        <td><strong><%= round.track?.name || round.circuit %></strong></td>
                        <td><span class="setup-readonly-state <%= round.hasSprint ? 'is-active' : '' %>"><%= round.hasSprint ? '✓' : '–' %></span></td>
                        <td><span class="setup-readonly-state <%= round.isTestDay ? 'is-active' : '' %>"><%= round.isTestDay ? '✓' : '–' %></span></td>
                        <td><input type="date" name="dates[r<%= round.id %>]" value="<%= dateValue %>" required aria-invalid="<%= Boolean(dateError) %>" aria-label="Datum für <%= round.track?.name || round.circuit %>"><% if (dateError) { %><small role="alert"><%= dateError %></small><% } %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
              <div class="setup-calendar-savebar">
                <p>Wähle für jede Runde das Renndatum.</p>
                <button class="button">Alle Renndaten speichern</button>
              </div>
            </form>
          <% } %>
        </div>
      </section>



      <!-- 04 PUNKTE -->
      <!-- ================================================= -->

      <section
        id="setup-points" data-setup-step="4" <%= setupWizard.current !== 4 ? 'hidden' : '' %>
        class="setup-panel"
      >

        <div class="setup-panel-number">
          04
        </div>

        <div class="setup-panel-content">

          <span>
            Pflichtfeld
          </span>

          <h2>
            PUNKTESYSTEM AUSWÄHLEN
          </h2>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/profile"
            class="setup-form"
          >

            <input
              type="hidden"
              name="accentColor"
              value="<%= selectedSeason.accentColor %>"
            >

            <label>
              F1-Spiel
              <select name="F1GameId">
                <option value="">Kein Spiel ausgewählt</option>
                <% setupF1Games.forEach((game) => { %>
                  <option value="<%= game.id %>" <%= Number(selectedSeason.F1GameId) === Number(game.id) ? 'selected' : '' %>><%= game.name %></option>
                <% }) %>
              </select>
            </label>

            <label>
              Punktesystem

              <select
                name="PointsSchemeId"
                required
              >

                <option value="">
                  Punktesystem wählen …
                </option>

                <% pointsSchemes.forEach((scheme) => { %>

                  <option
                    value="<%= scheme.id %>"
                    <%= selectedSeason.PointsSchemeId === scheme.id
                      ? 'selected'
                      : ''
                    %>
                  >
                    <%= scheme.name %>
                  </option>

                <% }) %>

              </select>
            </label>

            <label class="checkbox-control setup-option-card">
              <input
                type="checkbox"
                name="reservePointsForConstructors"
                <%= selectedSeason.reservePointsForConstructors !== false
                  ? 'checked'
                  : ''
                %>
              >
              <span>
                <strong>Ersatzfahrer-Punkte in Team-WM berücksichtigen</strong>
                <small>Aktiv: Ersatzfahrer sammeln Punkte für das eingesetzte Team. Deaktiviert: Ersatzfahrer erhalten ihre Fahrer-Punkte, diese werden jedoch nicht zur Team-WM addiert.</small>
              </span>
            </label>

            <button class="button">
              Punktesystem speichern
            </button>

          </form>

        </div>

      </section>


    <!-- ================================================= -->
<!-- 05 FAHRER -->
<!-- ================================================= -->

<section
  id="setup-drivers" data-setup-step="5" <%= setupWizard.current !== 5 ? 'hidden' : '' %>
  class="setup-panel <%= setupLineupProtected ? 'is-season-locked' : '' %>"
>

  <div class="setup-panel-number">
    05
  </div>

  <div class="setup-panel-content">

    <span>
      Fahrer mit F1-Sicht
    </span>

    <h2>
      FAHRER AUSWÄHLEN
    </h2>

    <form
      method="post"
      action="/admin/season-setup/<%= selectedSeason.id %>/drivers" <%= setupLineupProtected ? 'inert' : '' %>
    >

      <!-- FILTER -->

<div class="setup-selection-toolbar"><label class="setup-driver-search"><%= historicalSetup ? 'Fahrer suchen' : 'Stammfahrer suchen' %><input type="search" data-driver-search placeholder="Name oder Alias …"></label><output class="setup-selection-count" data-selection-count="driverIds" data-selection-label="<%= historicalSetup ? 'Fahrer' : 'Stammfahrer' %>" aria-live="polite"><%= selectedDriverIds.size %> Stammfahrer ausgewählt</output></div>
<% if (!historicalSetup) { %><p>Für eine aktuelle Saison Fahrer aus dem F1-Ersatzfahrerpool auswählen. Beim Abschluss erhalten sie den Stammrang dieser Liga und verlieren den Ersatzrang. Einsätze als Ersatzfahrer anderer Ligen werden im Rennwochenende erfasst.</p><% } else { %><p>Wähle alle Teilnehmer dieser historischen Saison aus, auch reine Ersatzfahrer. Eine feste Aufstellung ist hier nicht erforderlich.</p><% } %>
<p><%= selectedSeason.status === 'historical' ? `Die Zuordnung gilt nur für ${selectedSeason.name}; aktuelle Ränge bleiben unverändert.` : 'Aktuelle Stammränge werden beim Abschluss automatisch aus den besetzten Cockpits vergeben.' %></p>
<div class="setup-driver-grid">
<% setupEligibleDrivers.forEach((driver) => { const roles = []; const driverMatchesFilter = true;
 if (selectedDriverIds.has(Number(driver.id))) roles.push(`Stamm ${selectedLeague.name} · ${selectedSeason.name}`);
%>
<label
  class="setup-driver-card <%= driverMatchesFilter ? '' : 'setup-driver-filter-hidden' %>"
>

            <input
              type="checkbox"
              name="driverIds"
              value="<%= driver.id %>"
              <%= selectedDriverIds.has(Number(driver.id))
                ? 'checked'
                : ''
              %>
            >

            <span class="setup-driver-info">

              <strong>
                <%= driver.name %>
              </strong>

              <small>
                #<%= driver.id %>
                ·
                <%= roles.join(' · ') || 'F1-Sicht' %>
                <span class="sr-only"><%= (driver.aliases || []).map((alias) => alias.alias).join(' ') %></span>
              </small>

            </span>

          </label>

        <% }) %>

      </div>


      <button
        type="submit"
        class="button setup-save-step"
      >
        Fahrerauswahl speichern
      </button>

    </form>

  </div>

</section>


      <!-- ================================================= -->
      <!-- 06 TEAMS -->
      <!-- ================================================= -->

      <section
        id="setup-teams" data-setup-step="6" <%= setupWizard.current !== 6 ? 'hidden' : '' %>
        class="setup-panel <%= setupLineupProtected ? 'is-season-locked' : '' %>"
            >

        <div class="setup-panel-number">
          06
        </div>

        <div class="setup-panel-content">

          <span>
            Maximal 11
          </span>

          <h2>
            AKTUELLE ODER HISTORISCHE TEAMS
          </h2>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/teams" <%= setupLineupProtected ? 'inert' : '' %>
          >


            <output class="setup-selection-count" data-selection-count="teamTokens" aria-live="polite"><%= selectedTeamTokens.size %> Teams ausgewählt</output>
            <!-- AKTUELLE TEAMS -->

            <div class="setup-team-source">

              <h3>
                Aktuelle Teams
              </h3>

              <div class="team-choice-grid">

                <% f1Teams.forEach((team) => {

                  const token = `current:${team.id}`;

                %>

                  <label class="team-choice-card">

                    <input
                      type="checkbox"
                      name="teamTokens"
                      value="<%= token %>"
                      <%= selectedTeamTokens.has(token)
                        ? 'checked'
                        : ''
                      %>
                    >

                    <% if (team.logoPath) { %>

                      <img
                        src="<%= team.logoPath %>"
                        alt=""
                      >

                    <% } %>

                    <strong>
                      <%= team.name %>
                    </strong>

                  </label>

                <% }) %>

              </div>

            </div>


            <!-- HISTORISCHE TEAMS -->

            <div class="setup-team-source">

              <h3>
                Historische Teams
              </h3>

              <div class="team-choice-grid">

                <% carProfiles.forEach((team) => {

                  const token = `historical:${team.id}`;

                %>

                  <label class="team-choice-card">

                    <input
                      type="checkbox"
                      name="teamTokens"
                      value="<%= token %>"
                      <%= selectedTeamTokens.has(token)
                        ? 'checked'
                        : ''
                      %>
                    >

                    <% if (team.logoPath) { %>

                      <img
                        src="<%= team.logoPath %>"
                        alt=""
                      >

                    <% } %>

                    <strong>
                      <%= team.name %>
                    </strong>

                    <small>gehört zu <%= team.baseTeam?.name || '–' %></small>

                  </label>

                <% }) %>

              </div>

            </div>


            <button
              type="submit"
              class="button setup-save-step"
            >
              Teams speichern
            </button>

          </form>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 07 LINE-UP -->
      <!-- ================================================= -->

      <% if (!historicalSetup) { %><section
        id="setup-lineup" data-setup-step="7" <%= setupWizard.current !== 7 ? 'hidden' : '' %>
        class="setup-panel <%= setupLineupProtected ? 'is-season-locked' : '' %>"
            >

        <div class="setup-panel-number">
          07
        </div>

        <div class="setup-panel-content">

          <span>
            Nur Fahrer aus Schritt 5
          </span>

          <h2>
            LINE-UP ERSTELLEN
          </h2>

          <p class="setup-note">
            Ordne jedem Team maximal zwei Stammfahrer zu.
            Jeder ausgewählte Stammfahrer benötigt ein Cockpit.
            Ein Fahrer kann nur einem Team zugeordnet werden.
          </p>


          <% if (!setupStructure.teams.length) { %>

            <div class="empty-state">
              Bitte zuerst in Schritt 6 Teams auswählen.
            </div>


          <% } else if (!setupStructure.allDrivers.length) { %>

            <div class="empty-state">
              Bitte zuerst in Schritt 5 Fahrer auswählen.
            </div>


          <% } else { %>

            <form
              id="season-lineup-form"
              method="post"
              action="/admin/season-setup/<%= selectedSeason.id %>/lineup" <%= setupLineupProtected ? 'inert' : '' %>
            >

              <div class="season-lineup-grid">

                <% setupStructure.teams.forEach((team) => {

                  const assignedIds = Array.from(
                    assignedByTeam.get(Number(team.id)) ||
                    new Set()
                  ).filter(Boolean);

                %>

                  <article
                    class="season-lineup-team"
                    style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
                  >

                    <header class="season-lineup-team-header">


                      <% if (team.logoPath) { %>

                        <div class="season-lineup-logo">

                          <img
                            src="<%= team.logoPath %>"
                            alt="<%= team.name %>"
                          >

                        </div>

                      <% } else { %>

                        <div class="season-lineup-logo-fallback">

                          <%= team.name
                            .slice(0, 2)
                            .toUpperCase()
                          %>

                        </div>

                      <% } %>


                      <div class="season-lineup-team-title">



                        <strong>
                          <%= team.name %>
                        </strong>

                      </div>

                    </header>


                    <div class="season-lineup-driver-slots">

                      <% for (let slot = 0; slot < 2; slot++) {

                        const currentDriverId =
                          Number(assignedIds[slot]) || null;

                      %>

                        <label class="season-lineup-slot">

                          <span>
                            STAMMFAHRER
                            <%= slot + 1 %>
                          </span>

<select
  class="season-lineup-driver-select"
  name="lineup[t<%= team.id %>][]"
  data-team-id="<%= team.id %>"
  data-slot="<%= slot + 1 %>"
  <%= setupLineupProtected ? 'disabled' : '' %>
>

                            <option value="">
                              — Fahrer auswählen —
                            </option>

                            <% setupStructure.allDrivers.forEach((driver) => { %>

                              <option
                                value="<%= driver.id %>"
                                <%= currentDriverId === Number(driver.id)
                                  ? 'selected'
                                  : ''
                                %>
                              >
                                <%= driver.name %>
                              </option>

                            <% }) %>

                          </select>

                        </label>

                      <% } %>

                    </div>

                  </article>

                <% }) %>

              </div>


              <div class="season-lineup-footer">

                <p>
                  Bitte alle ausgewählten Stammfahrer zuordnen. Ersatzfahrer werden direkt im Rennwochenende ausgewählt.
                </p>

                <% if (setupLineupProtected) { %>
                  <a class="button setup-save-step" href="/admin/season-driver-change?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>">FAHRERWECHSEL ÖFFNEN</a>
                <% } else { %>
                  <button type="submit" class="button setup-save-step">Line-up speichern</button>
                <% } %>

              </div>

            </form>

          <% } %>

        </div>

      </section><% } %>


      <!-- ================================================= -->
      <!-- 08 ABSCHLUSS -->
      <!-- ================================================= -->

 <!-- ================================================= -->
<!-- 08 ABSCHLUSS -->
<!-- ================================================= -->

<section
  id="setup-finish" data-setup-step="8" <%= setupWizard.current !== 8 ? 'hidden' : '' %>
  class="setup-panel setup-finish-panel"
>

  <div class="setup-panel-number">
    <%= historicalSetup ? '07' : '08' %>
  </div>

  <div class="setup-panel-content">

    <span>
      Kontrolle vor Veröffentlichung
    </span>

    <h2>
      ABSCHLUSS
    </h2>


    <!-- =============================== -->
    <!-- STATUS ÜBERSICHT -->
    <!-- =============================== -->

    <div class="setup-final-summary">

      <article class="setup-final-card">
        <span>Liga</span>

        <strong>
          <%= selectedLeague.name %>
        </strong>
      </article>


      <article class="setup-final-card">
        <span>Saison</span>

        <strong>
          <%= selectedSeason.name %>
        </strong>
      </article>


      <article class="setup-final-card">
        <span>Kalender</span>

        <strong>
          <%= calendar.length %>
        </strong>

        <small>
          Termine
        </small>
      </article>


      <article class="setup-final-card">
        <span>Fahrer</span>

        <strong>
          <%= setupStructure.allDrivers.length %>
        </strong>

        <small>
          ausgewählt
        </small>
      </article>


      <article class="setup-final-card">
        <span>Teams</span>

        <strong>
          <%= setupStructure.teams.length %>
        </strong>

        <small>
          ausgewählt
        </small>
      </article>




    </div>


    <!-- =============================== -->
    <!-- LINE-UP KONTROLLE -->
    <!-- =============================== -->

    <% if (!historicalSetup) { %><div class="setup-finish-lineup">

      <div class="setup-finish-section-heading">

        <div>
          <span>
            Saison-Line-up
          </span>

          <h3>
            STAMMFAHRER
          </h3>
        </div>

        <strong>
          <%= setupStructure.allDrivers.length - setupStructure.unassignedDrivers.length %>
          zugeordnet
        </strong>

      </div>


      <div class="setup-finish-team-grid">

        <% setupStructure.teams.forEach((team) => { %>

          <article
            class="setup-finish-team"
            style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
          >

            <div class="setup-finish-team-head">

              <% if (team.logoPath) { %>

                <img
                  src="<%= team.logoPath %>"
                  alt=""
                >

              <% } %>

              <div>


                <strong>
                  <%= team.name %>
                </strong>
              </div>

            </div>


            <div class="setup-finish-team-drivers">

              <% if ((team.drivers || []).length) { %>

                <% team.drivers.forEach((driver, index) => { %>

                  <div class="setup-finish-driver">

                    <span>
                      <%= index + 1 %>
                    </span>

                    <strong>
                      <%= driver.name %>
                    </strong>

                  </div>

                <% }) %>

              <% } else { %>

                <div class="setup-finish-driver is-empty">
                  Kein Stammfahrer zugeordnet
                </div>

              <% } %>

            </div>

          </article>

        <% }) %>

      </div>

    </div><% } else { %><p>Alle ausgewählten Fahrer werden in beiden Wertungen vorbereitet. Auf der Ligenseite kannst du Zeilen entfernen, Teams zuordnen und Ergebnisse eintragen.</p><% } %>


    <!-- =============================== -->
    <!-- ERSATZFAHRER -->
    <!-- =============================== -->

    <div class="setup-finish-action">

      <div>

        <% if (setupFinishReady) { %>

          <strong>
            Saison ist vollständig eingerichtet.
          </strong>

          <p>
            Kalender, Punktesystem, Fahrer und Teams <%= historicalSetup ? '' : 'sowie Line-up' %>
            sind vorhanden.
          </p>

        <% } else { %>

          <strong>
            Saison ist noch nicht vollständig.
          </strong>

          <p>
            Kalender, Punktesystem, Fahrer, Teams und mindestens
            eine Line-up-Zuordnung sind erforderlich.
          </p>

        <% } %>

      </div>


      <form
        method="post"
        action="/admin/season-setup/<%= selectedSeason.id %>/finish"
      >

        <button
          class="button"
          <%= setupFinishReady ? '' : 'disabled' %>
        >
          Saison abschließen & veröffentlichen
        </button>

      </form>

    </div>

  </div>

</section>


    <% } %>


  </div>
</section>


<!-- ===================================================== -->
<!-- JAVASCRIPT -->
<!-- ===================================================== -->

<script src="/js/season-lineup-select.js" defer></script>


<script src="/js/season-wizard.js" defer></script>
<%- include('../partials/footer') %>

