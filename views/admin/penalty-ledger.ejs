<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">RENNLEITUNG · FREITAG · SAMSTAG · SONNTAG</span><h1>FORMEL 1 STRAFKARTEI</h1><p class="admin-intro">Alle drei Ligen in einer Übersicht. Fahrernamen kommen unveränderbar aus dem Fahrerstamm; Einträge verfallen nach einem Jahr.</p></div><div><a class="button button-ghost" href="/admin/penaltyRules">Strafenkatalog</a><a class="button button-ghost" href="/admin/f1PenaltySettings">SP-Limits</a></div></div>
  <nav class="penalty-league-nav"><% ledgers.forEach(({ league }) => { %><a href="#liga-<%= league.id %>"><%= league.name %></a><% }) %></nav>
  <% ledgers.forEach(({ league, activeSeason, races, threshold, groups }) => { const allRows = [...groups.regular, ...groups.reserve, ...groups.former]; %><section class="penalty-league-section" id="liga-<%= league.id %>" style="--league-color:<%= league.accentColor %>">
    <header><div><span><%= activeSeason?.name || 'KEINE AKTUELLE SAISON' %></span><h2><%= league.name %></h2></div><strong>Rennsperre ab <%= threshold %> SP</strong></header>
    <% if (allRows.some((row) => row.suspended)) { %><div class="flash flash-error">Rennsperre aktiv: Markierte Fahrer können beim betroffenen Rennen nicht ersetzt werden.</div><% } %>
    <details class="penalty-entry-panel"><summary>+ Manuelle Strafe oder Rennsperre eintragen</summary><form method="post" action="/admin/penalty-ledger" class="setup-form"><input type="hidden" name="LeagueId" value="<%= league.id %>"><label>Fahrer *<select name="DriverId" required><option value="">Aus Fahrerstamm wählen …</option><% allRows.forEach((row) => { %><option value="<%= row.id %>"><%= row.name %></option><% }) %></select></label><label>Rennen<select name="GrandPrixResultId"><option value="">Kein bestimmtes Rennen</option><% races.forEach((race) => { %><option value="<%= race.id %>">R<%= race.sortOrder %> · <%= race.title %></option><% }) %></select></label><label>Strafpunkte<input type="number" min="0" name="points" value="0"></label><label>Grund *<input name="reason" value="Manuelle Strafe" required></label><label>Kommentar<input name="comment"></label><label>Datum<input type="date" name="awardedOn" value="<%= new Date().toISOString().slice(0,10) %>"></label><label class="checkbox-control"><input type="checkbox" name="isRaceBan"><span>Rennsperre für gewähltes Rennen</span></label><button class="button">Eintragen</button></form></details>
    <% [['regular','STAMMFAHRER'],['reserve','ERSATZFAHRER'],['former','EHEMALIGE FAHRER MIT SP']].forEach(([key, label]) => { const rows = groups[key]; %><section class="penalty-group"><h3><%= label %></h3><% if (!rows.length) { %><div class="empty-state">Keine Einträge.</div><% } else { %><div class="table-wrap"><table class="penalty-table"><thead><tr><th>Fahrer</th><th>Team</th><th>Strafen</th><th>SP</th><th>Bis Sperre</th><th>Status</th></tr></thead><tbody><% rows.forEach((row) => { %><tr class="<%= row.suspended ? 'row-danger' : '' %>" style="--team-color:<%= row.team?.accentColor || league.accentColor %>"><td><strong><%= row.name %></strong></td><td><div class="penalty-team"><% if (row.team?.logoPath) { %><img src="<%= row.team.logoPath %>" alt=""><% } %><span><%= row.team?.name || '–' %></span></div></td><td><div class="penalty-tags"><% row.penalties.forEach((penalty) => { %><span class="<%= penalty.isRaceBan ? 'ban' : '' %>"><%= penalty.isRaceBan ? 'Rennsperre' : `${penalty.points} SP` %> · <%= penalty.reason %><form method="post" action="/admin/penalty-ledger/<%= penalty.id %>?_method=DELETE" data-confirm="Diesen Eintrag entfernen?"><button type="submit">×</button></form></span><% }) %><% if (!row.penalties.length) { %>Keine<% } %></div></td><td><strong><%= row.points %></strong></td><td><%= row.remaining %></td><td><%= row.suspended ? 'RENNGESPERRT' : 'Frei' %></td></tr><% }) %></tbody></table></div><% } %></section><% }) %>
  </section><% }) %>
</div></section>
<%- include('../partials/footer') %>
