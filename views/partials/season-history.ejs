<%
  const statusOf = (result) =>
    String(result?.status || '')
      .trim()
      .toUpperCase();

  const numberOf = (value) =>
    Number.isFinite(Number(value))
      ? Number(value)
      : 0;

  const hasResult = (result) =>
    Boolean(
      result &&
      (
        result.position ||
        result.status ||
        result.fastestLap ||
        numberOf(result.points)
      )
    );

  const podiumClass = (result) => {
    const position = Number(
      result?.position
    );

    return position >= 1 &&
      position <= 3
      ? `season-race-position-${position}`
      : '';
  };


  /*
   * =====================================================
   * SCHNELLSTE RUNDE
   * =====================================================
   */

  const hasFastestLap = (result) =>
    Boolean(
      result?.fastestLap ||
      result?.fastest_lap ||
      result?.awardedFastestLapPoint
    );


  const resultLabel = (
    result,
    mode,
    race
  ) => {

    /*
     * Ersatzfahrer außerhalb seines
     * Reserve-Stints:
     *
     * immer "-"
     */
    if (
      mode === 'reserve' &&
      result?.outsideStint
    ) {
      return {
        text: '–',
        kind: 'inactive'
      };
    }


    /*
     * Stammfahrer außerhalb seines
     * Stammfahrer-Stints:
     *
     * DNS
     */
    if (
      mode === 'regular' &&
      result?.outsideStint
    ) {
      return {
        text: 'DNS',
        kind: 'dns'
      };
    }


    /*
     * Zukünftiges Rennen
     */
    if (!race?.isCompleted) {
      return {
        text: '–',
        kind: 'future'
      };
    }


    const status =
      statusOf(result);


    /*
     * DNF / DSQ explizit anzeigen
     */
    if (
      status === 'DNF' ||
      status === 'DSQ'
    ) {
      return {
        text: status,
        kind: status.toLowerCase()
      };
    }


    /*
     * Vergangenes Rennen ohne Resultat
     */
    if (
      status === 'DNS' ||
      !hasResult(result)
    ) {
      return {
        text: 'DNS',
        kind: 'dns'
      };
    }


    /*
     * Normales Ergebnis:
     * Punkte anzeigen
     */
    return {
      text: String(
        numberOf(result.points)
      ),
      kind: 'points'
    };
  };


  const activeSeason =
    typeof selectedSeason === 'undefined'
      ? null
      : selectedSeason;


  const game =
    activeSeason?.f1Game;


  const gameLabel =
    game?.name ||
    activeSeason?.gameName ||
    '';
%>


<style>

/* =========================================================
   SCHNELLSTE RUNDE
   ========================================================= */

.sheet-result-single,
.sheet-result-part {
  position: relative;
}


/*
 * Dezente Hervorhebung der Zelle
 */

.sheet-result-single.has-fastest-lap,
.sheet-result-part.has-fastest-lap {
  box-shadow:
    inset 0 0 0 1px
      rgba(255, 214, 10, 0.82),
    0 0 8px
      rgba(255, 214, 10, 0.12);
}


/*
 * Kleiner goldener Akzent
 */

.sheet-result-single.has-fastest-lap::before,
.sheet-result-part.has-fastest-lap::before {
  content: "";

  position: absolute;

  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      135deg,
      rgba(255, 214, 10, 0.13),
      rgba(255, 214, 10, 0.03) 48%,
      transparent 70%
    );
}


/*
 * FL Badge
 */

.sheet-fastest-lap-badge {
  position: absolute;

  top: 2px;
  right: 2px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 15px;
  height: 11px;

  padding: 0 3px;

  border-radius: 2px;

  background: #ffd60a;

  color: #071014;

  font-size: 7px;
  font-style: normal;
  font-weight: 900;

  line-height: 1;

  letter-spacing: 0.02em;

  z-index: 2;
}


/*
 * Punktzahl bei schnellster Runde
 */

.sheet-result-single.has-fastest-lap,
.sheet-result-part.has-fastest-lap b {
  font-weight: 900;
}


/*
 * Sprint-Zelle etwas kompakter
 */

.sheet-result-part.has-fastest-lap
.sheet-fastest-lap-badge {
  min-width: 13px;

  height: 10px;

  padding: 0 2px;

  font-size: 6px;
}

</style>


<%
if (
  history.seasons.length &&
  selectedHistory
) {
%>


  <!-- ================================================= -->
  <!-- SAISONHEADER -->
  <!-- ================================================= -->

  <header
    class="season-sheet-hero"
    style="--season-accent:<%= activeSeason?.accentColor || league.accentColor || '#6ef2f2' %>"
  >


    <!-- LIGA -->

    <div class="season-sheet-brand">

      <% if (league.logoPath) { %>

        <img
          src="<%= league.logoPath %>"
          alt="Logo <%= league.name %>"
        >

      <% } else { %>

        <span>
          KRL
        </span>

      <% } %>

    </div>


    <!-- SAISON -->

    <div>

      <span>
        MEISTERSCHAFTSVERLAUF
      </span>

      <h3>
        <%= selectedHistory.name %>
      </h3>

      <small>
        <%= league.name %>
        ·
        Punkte je Rennwochenende
      </small>

    </div>


    <!-- F1-SPIEL -->

    <div class="season-sheet-game">

      <% if (game?.logoPath) { %>

        <img
          src="<%= game.logoPath %>"
          alt="<%= game.name %>"
        >

      <% } else if (gameLabel) { %>

        <strong>
          <%= gameLabel %>
        </strong>

      <% } %>

    </div>

  </header>


  <!-- ================================================= -->
  <!-- ADMIN-HINWEIS -->
  <!-- ================================================= -->

  <%
  if (
    history.warning &&
    isAdmin
  ) {
  %>

    <div
      class="history-notice"
      role="status"
    >
      <%= history.warning %>
    </div>

  <% } %>


  <!-- ================================================= -->
  <!-- WERTUNGS-TABS -->
  <!-- ================================================= -->

  <div
    class="season-history-switch"
    role="tablist"
    aria-label="Wertung auswählen"
  >


    <!-- STAMM -->

    <button
      type="button"
      class="season-history-tab is-active"
      data-history-tab="regular"
      role="tab"
      aria-selected="true"
    >

      <span>
        STAMM
      </span>

      <strong>
        Fahrer-WM
      </strong>

      <small>
        <%= selectedHistory.drivers.length %>
        Fahrer
      </small>

    </button>


    <!-- ERSATZ -->

    <button
      type="button"
      class="season-history-tab"
      data-history-tab="reserve"
      role="tab"
      aria-selected="false"
    >

      <span>
        ERSATZ
      </span>

      <strong>
        Ersatzfahrer
      </strong>

      <small>
        <%= (selectedHistory.reserveDrivers || []).length %>
        Fahrer
      </small>

    </button>

  </div>


  <!-- ================================================= -->
  <!-- GEMEINSAME TABELLEN-FUNKTION -->
  <!-- ================================================= -->

  <%
    const renderSheet = (
      drivers,
      mode
    ) => {
  %>


    <div
      class="
        season-sheet-wrap
        <%= mode === 'reserve'
          ? 'season-sheet-wrap-reserve'
          : 'season-sheet-wrap-regular'
        %>
      "
      data-season-rounds="<%= selectedHistory.races.length %>"
    >


      <table
        class="
          season-sheet-table
          <%= mode === 'reserve'
            ? 'season-sheet-table-reserve'
            : 'season-sheet-table-regular'
          %>
        "
      >


        <!-- ============================================= -->
        <!-- SPALTEN -->
        <!-- ============================================= -->

        <colgroup>


          <!-- POSITION -->

          <col class="col-position">


          <!-- FAHRER -->

          <col class="col-driver">


          <!-- TEAM NUR BEI STAMMFAHRERN -->

          <% if (mode === 'regular') { %>

            <col class="col-team">

          <% } %>


          <!-- RENNEN -->

          <% selectedHistory.races.forEach(() => { %>

            <col class="col-race">

          <% }) %>


          <!-- STATISTIK -->

          <col class="col-stat">

          <col class="col-stat">

          <col class="col-stat">

          <col class="col-rate">

          <col class="col-rate">

        </colgroup>


        <!-- ============================================= -->
        <!-- HEADER -->
        <!-- ============================================= -->

        <thead>

          <tr>


            <!-- POSITION -->

            <th
              class="sheet-sticky sheet-position"
            >
              #
            </th>


            <!-- FAHRER -->

            <th
              class="sheet-sticky sheet-driver"
            >
              FAHRER
            </th>


            <!-- TEAM -->

            <% if (mode === 'regular') { %>

              <th
                class="sheet-sticky sheet-team"
              >
                TEAM
              </th>

            <% } %>


            <!-- RENNEN -->

            <% selectedHistory.races.forEach((race) => { %>

              <th
                class="
                  sheet-race-head
                  <%= race.isCompleted
                    ? 'is-completed'
                    : 'is-upcoming'
                  %>
                  <%= race.hasSprint
                    ? 'has-sprint'
                    : ''
                  %>
                "
                title="Runde <%= race.round %> · <%= race.title %>"
              >


                <!-- FLAGGE -->

                <span class="sheet-flag">

                  <% if (race.countryFlagPath) { %>

                    <img
                      src="<%= race.countryFlagPath %>"
                      alt="<%= race.countryName || '' %>"
                    >

                  <% } else { %>

                    <b>
                      <%= race.code %>
                    </b>

                  <% } %>

                </span>


                <!-- RUNDE -->

                <strong>
                  R<%= race.round %>
                </strong>


                <!-- SPRINT -->

                <% if (race.hasSprint) { %>

                  <small>
                    SPR
                  </small>

                <% } %>

              </th>

            <% }) %>


            <!-- STATISTIK -->

            <th class="sheet-stat-head">
              Σ
            </th>

            <th class="sheet-stat-head">
              Δ
            </th>

            <th class="sheet-stat-head">
              Ø
            </th>

            <th
              class="sheet-stat-head sheet-rate-head"
              title="Startquote"
            >
              START
            </th>

            <th
              class="sheet-stat-head sheet-rate-head"
              title="Ausfallquote"
            >
              DNF
            </th>

          </tr>

        </thead>


        <!-- ============================================= -->
        <!-- FAHRER -->
        <!-- ============================================= -->

        <tbody>


          <% drivers.forEach((driver) => { %>


            <tr
              class="
                <%= driver.isFormerDriver
                  ? 'is-former-driver'
                  : ''
                %>

                <%= mode === 'reserve'
                  ? 'is-reserve-driver'
                  : ''
                %>
              "
            >


              <!-- ======================================= -->
              <!-- POSITION -->
              <!-- ======================================= -->

              <td
                class="sheet-sticky sheet-position"
              >

                <strong>
                  <%= driver.position %>
                </strong>

              </td>


              <!-- ======================================= -->
              <!-- FAHRER -->
              <!-- ======================================= -->

              <td
                class="sheet-sticky sheet-driver"
              >


                <strong
                  title="<%= driver.name %>"
                >
                  <%= driver.name %>
                </strong>


                <!-- EHEMALIGER STAMMFAHRER -->

                <% if (driver.isFormerDriver) { %>

                  <small>

                    Ehemalig

                    <% if (driver.regularToRound) { %>

                      · bis R<%= driver.regularToRound %>

                    <% } %>

                  </small>

                <% } %>


                <!-- NEUER STAMMFAHRER -->

                <%
                if (
                  !driver.isFormerDriver &&
                  driver.regularFromRound > 1
                ) {
                %>

                  <small>
                    ab R<%= driver.regularFromRound %>
                  </small>

                <% } %>


                <!-- BEFÖRDERTER ERSATZFAHRER -->

                <%
                if (
                  mode === 'reserve' &&
                  driver.promotedToRegular
                ) {
                %>

                  <small>
                    ab R<%= driver.promotedFromRound %>
                    Stammfahrer
                  </small>

                <% } %>


              </td>


              <!-- ======================================= -->
              <!-- TEAM -->
              <!-- ======================================= -->

              <% if (mode === 'regular') { %>

                <td
                  class="sheet-sticky sheet-team"
                >


                  <% if (driver.teamLogoPath) { %>

                    <img
                      src="<%= driver.teamLogoPath %>"
                      alt="<%= driver.team || 'Team' %>"
                      title="<%= driver.team || '' %>"
                    >

                  <% } else { %>

                    <span
                      title="<%= driver.team || '' %>"
                    >

                      <%= (driver.team || '–')
                        .slice(0, 3)
                        .toUpperCase()
                      %>

                    </span>

                  <% } %>


                </td>

              <% } %>


              <!-- ======================================= -->
              <!-- RENNWOCHENENDEN -->
              <!-- ======================================= -->

              <%
              driver.results.forEach(
                (
                  weekend,
                  index
                ) => {

                  const race =
                    selectedHistory.races[
                      index
                    ];


                  const main =
                    weekend.main ||
                    (
                      !Object.prototype
                        .hasOwnProperty
                        .call(
                          weekend,
                          'main'
                        )
                        ? weekend
                        : null
                    );


                  const sprint =
                    weekend.sprint;


                  const mainView =
                    resultLabel(
                      main,
                      mode,
                      race
                    );


                  const sprintView =
                    resultLabel(
                      sprint,
                      mode,
                      race
                    );


                  /*
                   * Schnellste Runde
                   */

                  const mainFastestLap =
                    hasFastestLap(
                      main
                    );


                  const sprintFastestLap =
                    hasFastestLap(
                      sprint
                    );
              %>


                <td
                  class="
                    sheet-result
                    <%= race?.hasSprint
                      ? 'has-sprint'
                      : ''
                    %>
                  "
                >


                  <!-- ================================= -->
                  <!-- SPRINT + GP -->
                  <!-- ================================= -->

                  <% if (race?.hasSprint) { %>


                    <!-- SPRINT -->

                    <span
                      class="
                        sheet-result-part
                        is-sprint
                        <%= `is-${sprintView.kind}` %>
                        <%= podiumClass(sprint) %>
                        <%= sprintFastestLap
                          ? 'has-fastest-lap'
                          : ''
                        %>
                      "
                    >

                      <i>
                        S
                      </i>

                      <b>
                        <%= sprintView.text %>
                      </b>


                      <% if (sprintFastestLap) { %>

                        <em
                          class="sheet-fastest-lap-badge"
                          title="Schnellste Runde"
                        >
                          FL
                        </em>

                      <% } %>

                    </span>


                    <!-- HAUPTRENNEN -->

                    <span
                      class="
                        sheet-result-part
                        is-main
                        <%= `is-${mainView.kind}` %>
                        <%= podiumClass(main) %>
                        <%= mainFastestLap
                          ? 'has-fastest-lap'
                          : ''
                        %>
                      "
                    >

                      <i>
                        GP
                      </i>

                      <b>
                        <%= mainView.text %>
                      </b>


                      <% if (mainFastestLap) { %>

                        <em
                          class="sheet-fastest-lap-badge"
                          title="Schnellste Runde"
                        >
                          FL
                        </em>

                      <% } %>

                    </span>


                  <% } else { %>


                    <!-- NORMALES RENNEN -->

                    <span
                      class="
                        sheet-result-single
                        <%= `is-${mainView.kind}` %>
                        <%= podiumClass(main) %>
                        <%= mainFastestLap
                          ? 'has-fastest-lap'
                          : ''
                        %>
                      "
                    >

                      <%= mainView.text %>


                      <% if (mainFastestLap) { %>

                        <em
                          class="sheet-fastest-lap-badge"
                          title="Schnellste Runde"
                        >
                          FL
                        </em>

                      <% } %>

                    </span>


                  <% } %>


                </td>


              <%
                }
              );
              %>


              <!-- ======================================= -->
              <!-- GESAMTPUNKTE -->
              <!-- ======================================= -->

              <td class="sheet-total">

                <strong>
                  <%= numberOf(driver.total) %>
                </strong>

              </td>


              <!-- ======================================= -->
              <!-- RÜCKSTAND -->
              <!-- ======================================= -->

              <td class="sheet-stat">

                <%= driver.position === 1
                  ? '—'
                  : `+${Math.abs(
                      numberOf(
                        driver.gap
                      )
                    )}`
                %>

              </td>


              <!-- ======================================= -->
              <!-- DURCHSCHNITT -->
              <!-- ======================================= -->

              <td class="sheet-stat">

                <%= numberOf(
                  driver.average
                )
                  .toFixed(1)
                  .replace(
                    '.',
                    ','
                  )
                %>

              </td>


              <!-- ======================================= -->
              <!-- STARTQUOTE -->
              <!-- ======================================= -->

              <td
                class="sheet-stat sheet-rate"
              >

                <%= numberOf(
                  driver.startRate
                ).toFixed(0) %>%

              </td>


              <!-- ======================================= -->
              <!-- AUSFALLQUOTE -->
              <!-- ======================================= -->

              <td
                class="sheet-stat sheet-rate"
              >

                <%= numberOf(
                  driver.failureRate
                ).toFixed(0) %>%

              </td>


            </tr>


          <% }) %>


        </tbody>


      </table>

    </div>


  <% }; %>


  <!-- ================================================= -->
  <!-- STAMMFAHRER -->
  <!-- ================================================= -->

  <section
    class="season-history-panel"
    data-history-panel="regular"
    role="tabpanel"
  >

    <%
      renderSheet(
        selectedHistory.drivers,
        'regular'
      );
    %>

  </section>


  <!-- ================================================= -->
  <!-- ERSATZFAHRER -->
  <!-- ================================================= -->

  <section
    class="season-history-panel"
    data-history-panel="reserve"
    role="tabpanel"
    hidden
  >


    <%
    if (
      (
        selectedHistory.reserveDrivers ||
        []
      ).length
    ) {
    %>


      <%
        renderSheet(
          selectedHistory.reserveDrivers,
          'reserve'
        );
      %>


    <% } else { %>


      <div class="empty-state">

        In dieser Saison wurde bisher
        kein Ersatzfahrer eingesetzt.

      </div>


    <% } %>


  </section>

<div class="season-sheet-legend">

  <div class="season-sheet-legend__title">
    LEGENDE
  </div>

  <div class="season-sheet-legend__items">

    <div class="season-sheet-legend__item">
      <span class="season-sheet-legend__code is-dns">
        DNS
      </span>

      <span>
        Did Not Start
      </span>
    </div>


    <div class="season-sheet-legend__item">
      <span class="season-sheet-legend__code is-dna">
        DNA
      </span>

      <span>
        Did Not Attend
      </span>
    </div>


    <div class="season-sheet-legend__item">
      <span class="season-sheet-legend__code is-dnf">
        DNF
      </span>

      <span>
        Did Not Finish
      </span>
    </div>


    <div class="season-sheet-legend__item">
      <span class="season-sheet-legend__code is-fl">
        FL
      </span>

      <span>
        Fastest Lap · Schnellste Runde
      </span>
    </div>

  </div>

</div>
<% } else { %>


  <div class="empty-state">

    Noch keine Ergebnisse eingetragen.

  </div>


<% } %>

