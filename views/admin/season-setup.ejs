<%- include('../partials/header', { title }) %>

<%
  const setupStructure =
    typeof structure === 'undefined'
      ? { allDrivers: [], teams: [], unassignedDrivers: [] }
      : structure;

  const setupTracks =
    typeof tracks === 'undefined'
      ? []
      : tracks;

  const setupEligibleDrivers =
    typeof eligibleDrivers === 'undefined'
      ? []
      : eligibleDrivers;

  const setupFinishReady =
    typeof finishReady === 'undefined'
      ? false
      : finishReady;

const setupDriverRankFilter =
  typeof driverRankFilter === 'undefined'
    ? 'all'
    : driverRankFilter;

  const selectedDriverIds = new Set(
    (setupStructure.allDrivers || []).map(
      (driver) => Number(driver.id)
    )
  );

  const selectedTeamTokens = new Set(
    (setupStructure.teams || []).map(
      (team) => `${team.sourceType}:${team.sourceId}`
    )
  );

  const assignedByTeam = new Map(
    (setupStructure.teams || []).map((team) => [
      Number(team.id),
      new Set(
        (team.drivers || []).map(
          (driver) =>
            Number(
              driver.DriverId ||
              driver.driver?.id ||
              driver.id
            )
        )
      )
    ])
  );
%>


<section class="admin-shell season-setup-shell">
  <div class="container">


    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="admin-heading">

      <div>
        <a class="back-link" href="/admin">
          ← Dashboard
        </a>

        <span class="form-kicker">
          FORMEL 1 · FIORI-ASSISTENT
        </span>

        <h1>
          F1-SAISON ERSTELLEN
        </h1>

        <p class="admin-intro">
          Alle acht Schritte greifen auf Stammdaten zurück.
          Die Saison wird erst im letzten Schritt veröffentlicht.
        </p>
      </div>

      <a
        class="button button-ghost"
        href="/admin/season-manager"
      >
        Saison bearbeiten
      </a>

    </div>


    <!-- ================================================= -->
    <!-- SCHRITT-NAVIGATION -->
    <!-- ================================================= -->

    <nav class="setup-steps setup-steps-eight">

      <a
        href="#setup-league"
        class="is-complete"
      >
        <span>1</span>
        <strong>Liga</strong>
      </a>

      <a
        href="#setup-season"
        class="<%= selectedLeague ? 'is-complete' : '' %>"
      >
        <span>2</span>
        <strong>Saison</strong>
      </a>

      <a
        href="#setup-calendar"
        class="<%= calendar.length ? 'is-complete' : '' %>"
      >
        <span>3</span>
        <strong>Kalender</strong>
      </a>

      <a
        href="#setup-points"
        class="<%= selectedSeason?.PointsSchemeId ? 'is-complete' : '' %>"
      >
        <span>4</span>
        <strong>Punkte</strong>
      </a>

      <a
        href="#setup-drivers"
        class="<%= setupStructure.allDrivers.length ? 'is-complete' : '' %>"
      >
        <span>5</span>
        <strong>Fahrer</strong>
      </a>

      <a
        href="#setup-teams"
        class="<%= setupStructure.teams.length ? 'is-complete' : '' %>"
      >
        <span>6</span>
        <strong>Teams</strong>
      </a>

      <a
        href="#setup-lineup"
        class="<%= setupStructure.teams.some((team) => (team.drivers || []).length) ? 'is-complete' : '' %>"
      >
        <span>7</span>
        <strong>Line-up</strong>
      </a>

      <a
        href="#setup-finish"
        class="<%= setupFinishReady ? 'is-complete' : '' %>"
      >
        <span>8</span>
        <strong>Abschluss</strong>
      </a>

    </nav>


    <!-- ================================================= -->
    <!-- 01 LIGA -->
    <!-- ================================================= -->

    <section
      id="setup-league"
      class="setup-panel"
    >

      <div class="setup-panel-number">
        01
      </div>

      <div class="setup-panel-content">

        <span>
          Freitag, Samstag oder Sonntag
        </span>

        <h2>
          LIGA AUSWÄHLEN
        </h2>

        <form
          method="get"
          class="setup-choice-grid"
        >

          <% leagues.forEach((league) => { %>

            <button
              class="setup-choice <%= selectedLeague?.id === league.id ? 'is-selected' : '' %>"
              style="--setup-accent:<%= league.accentColor %>"
              name="league"
              value="<%= league.id %>"
            >

              <% if (league.logoPath) { %>
                <img
                  src="<%= league.logoPath %>"
                  alt=""
                >
              <% } %>

              <span>
                FORMEL 1
              </span>

              <strong>
                <%= league.name %>
              </strong>

              <small>
                <%= league.raceDay %>
                ·
                <%= league.raceTime %>
              </small>

            </button>

          <% }) %>

        </form>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- 02 SAISON -->
    <!-- ================================================= -->

    <% if (selectedLeague) { %>

      <section
        id="setup-season"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          02
        </div>

        <div class="setup-panel-content">

          <span>
            Pflichtangaben
          </span>

          <h2>
            SAISON & FARBPROFIL
          </h2>

          <div class="setup-two-column">

            <form
              method="post"
              action="/admin/season-setup/seasons"
              class="setup-form"
            >

              <input
                type="hidden"
                name="LeagueId"
                value="<%= selectedLeague.id %>"
              >

              <label>
                Saisonname

                <input
                  name="name"
                  required
                >
              </label>

              <label>
                Status

                <select
                  name="status"
                  required
                >
                  <option value="active">
                    Aktuell
                  </option>

                  <option value="historical">
                    Historisch
                  </option>
                </select>
              </label>

              <label>
                Farbe

                <input
                  type="color"
                  name="accentColor"
                  value="<%= selectedLeague.accentColor %>"
                  required
                >
              </label>

              <label class="checkbox-control setup-option-card">
                <input
                  type="checkbox"
                  name="reservePointsForConstructors"
                  checked
                >
                <span>
                  <strong>Ersatzfahrer-Punkte in Team-WM berücksichtigen</strong>
                  <small>Aktiv: Ersatzfahrer sammeln Punkte für das eingesetzte Team. Deaktiviert: Ersatzfahrer erhalten ihre Fahrer-Punkte, diese werden jedoch nicht zur Team-WM addiert.</small>
                </span>
              </label>

              <button class="button">
                Saison anlegen
              </button>

            </form>


            <div class="setup-season-list">

              <strong>
                Vorhandene Saisons
              </strong>

              <% seasons.forEach((season) => { %>

                <a
                  href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= season.id %>"
                  class="<%= selectedSeason?.id === season.id ? 'is-selected' : '' %>"
                >

                  <span>
                    <%= season.status === 'active'
                      ? 'AKTUELL'
                      : 'HISTORISCH'
                    %>
                  </span>

                  <strong>
                    <%= season.name %>
                  </strong>

                  <small>
                    <%= season.isPublished
                      ? 'Veröffentlicht'
                      : 'Assistent noch offen'
                    %>
                  </small>

                </a>

              <% }) %>

            </div>

          </div>

        </div>

      </section>

    <% } %>


    <% if (selectedSeason) { %>


      <!-- ================================================= -->
      <!-- 03 RENNKALENDER -->
      <!-- ================================================= -->

<section id="setup-calendar" class="setup-panel">

  <div class="setup-panel-number">
    03
  </div>

  <div class="setup-panel-content">

    <span>Nur aus F1-Streckenstamm</span>
    <h2>RENNKALENDER ERSTELLEN</h2>

    <%
  const events = calendar;

  const nextRaceNumber =
    events.filter((event) => !event.isTestDay).length + 1;

  const trackSelect = (event) => `
        <label>
          Strecke *
          <select name="F1TrackId" required>
            <option value="">Aus Streckenstamm wählen …</option>

            ${setupTracks.map((track) => `
              <option
                value="${track.id}"
                ${Number(event?.F1TrackId) === Number(track.id) ? 'selected' : ''}
              >
                ${track.name}
              </option>
            `).join('')}

          </select>

          <small>
            Land und Flagge werden automatisch übernommen.
          </small>
        </label>
      `;
    %>


    <!-- TERMIN HINZUFÜGEN -->

    <section class="setup-panel">

      <div class="setup-panel-number">+</div>

      <div class="setup-panel-content">

        <h2>TERMIN HINZUFÜGEN</h2>

        <p class="setup-note">
          Die Startzeit kommt fest aus dem Ligen-Stamm.
        </p>

        <form
          method="post"
          action="/admin/season-setup/<%= selectedSeason.id %>/calendar"
          class="setup-form setup-calendar-form"
        >

          <%- trackSelect(null) %>

          <label>
            Datum *
            <input
              type="date"
              name="date"
              required
            >
          </label>

          <label>
            Startzeit aus Ligen-Stamm
            <input
              type="time"
              value="<%= defaultTime %>"
              readonly
            >
          </label>





 <label>
  Rennen Nr.

  <input
    type="number"
    name="sortOrder"
    min="1"
    value="<%= nextRaceNumber %>"
  >
</label>

<label class="checkbox-control">
  <input
    type="checkbox"
    name="isTestDay"
  >
  <span>Testtag</span>
</label>





          <label class="checkbox-control">
            <input
              type="checkbox"
              name="hasSprint"
            >
            <span>Sprint</span>
          </label>

          <button
            type="submit"
            class="button"
          >
            Hinzufügen
          </button>

        </form>

      </div>
    </section>


    <!-- REIHENFOLGE -->

    <% if (events.length) { %>

  <form
    method="post"
    action="/admin/season-setup/<%= selectedSeason.id %>/calendar/reorder"
    class="calendar-reorder-bar"
    data-calendar-reorder-form
  >

    <input
      type="hidden"
      name="LeagueId"
      value="<%= selectedLeague.id %>"
    >

    <input
      type="hidden"
      name="SeasonId"
      value="<%= selectedSeason.id %>"
    >

    <div data-calendar-order-inputs>

      <% events.forEach((event) => { %>

        <input
          type="hidden"
          name="eventIds"
          value="<%= event.id %>"
        >

      <% }) %>

    </div>

    <span>
      ↕ Karten ziehen, um Rennen neu zu nummerieren.
    </span>

    <button
      type="submit"
      class="button button-small"
    >
      Reihenfolge speichern
    </button>

  </form>

<% } %>


    <!-- BESTEHENDE TERMINE -->

    <div
      class="setup-calendar-list season-calendar-editor"
      data-sortable-calendar
    >

      <% events.forEach((event, index) => {

        const startsAt = new Date(event.startsAt);
        const valid = !Number.isNaN(startsAt.getTime());

      %>

        <article
          class="<%= event.isTestDay ? 'is-test' : '' %>"
          draggable="true"
          data-calendar-event="<%= event.id %>"
        >

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/calendar/<%= event.id %>/update"
            class="setup-form setup-calendar-form"
          >

          <span class="calendar-drag-handle">
  <% if (event.isTestDay) { %>
    ↕ TEST
  <% } else { %>
    ↕ R<%= event.sortOrder %>
  <% } %>
</span>

            <%- trackSelect(event) %>


            <label>
              Land

              <div class="readonly-master-field">

                <% if (event.track?.countryRecord?.flagPath) { %>

                  <img
                    src="<%= event.track.countryRecord.flagPath %>"
                    alt="Flagge <%= event.track.countryRecord.name %>"
                  >

                <% } %>

                <strong>
                  <%= event.track?.countryRecord?.name
                    || event.track?.country
                    || 'aus Stammdaten'
                  %>
                </strong>

              </div>

            </label>


            <label>
              Datum

              <input
                type="date"
                name="date"
                value="<%= valid ? startsAt.toISOString().slice(0,10) : '' %>"
                required
              >
            </label>


            <label>
              Zeit aus Ligen-Stamm

              <input
                type="time"
                value="<%= defaultTime %>"
                readonly
              >
            </label>


          <input
  type="hidden"
  name="sortOrder"
  value="<%= event.isTestDay ? 0 : event.sortOrder %>"
>


            <label class="checkbox-control">
              <input
                type="checkbox"
                name="isTestDay"
                <%= event.isTestDay ? 'checked' : '' %>
              >
              <span>Testtag</span>
            </label>


            <label class="checkbox-control">
              <input
                type="checkbox"
                name="hasSprint"
                <%= event.hasSprint ? 'checked' : '' %>
              >
              <span>Sprint</span>
            </label>


            <button
              type="submit"
              class="button button-small"
            >
              Speichern
            </button>

          </form>


          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/calendar/<%= event.id %>/delete"
            data-confirm="Termin und Ergebnisse löschen?"
          >

            <button
              type="submit"
              class="button button-ghost button-small"
            >
              Löschen
            </button>

          </form>

        </article>

      <% }) %>


      <% if (!events.length) { %>

        <div class="empty-state">
          Diese Saison hat noch keine Termine.
        </div>

      <% } %>

    </div>

  </div>

</section>


      <!-- ================================================= -->
      <!-- 04 PUNKTE -->
      <!-- ================================================= -->

      <section
        id="setup-points"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          04
        </div>

        <div class="setup-panel-content">

          <span>
            Pflichtfeld
          </span>

          <h2>
            PUNKTESYSTEM AUSWÄHLEN
          </h2>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/profile"
            class="setup-form"
          >

            <input
              type="hidden"
              name="accentColor"
              value="<%= selectedSeason.accentColor %>"
            >

            <label>
              Punktesystem

              <select
                name="PointsSchemeId"
                required
              >

                <option value="">
                  Punktesystem wählen …
                </option>

                <% pointsSchemes.forEach((scheme) => { %>

                  <option
                    value="<%= scheme.id %>"
                    <%= selectedSeason.PointsSchemeId === scheme.id
                      ? 'selected'
                      : ''
                    %>
                  >
                    <%= scheme.name %>
                  </option>

                <% }) %>

              </select>
            </label>

            <label class="checkbox-control setup-option-card">
              <input
                type="checkbox"
                name="reservePointsForConstructors"
                <%= selectedSeason.reservePointsForConstructors !== false
                  ? 'checked'
                  : ''
                %>
              >
              <span>
                <strong>Ersatzfahrer-Punkte in Team-WM berücksichtigen</strong>
                <small>Aktiv: Ersatzfahrer sammeln Punkte für das eingesetzte Team. Deaktiviert: Ersatzfahrer erhalten ihre Fahrer-Punkte, diese werden jedoch nicht zur Team-WM addiert.</small>
              </span>
            </label>

            <button class="button">
              Punktesystem speichern
            </button>

          </form>

        </div>

      </section>


    <!-- ================================================= -->
<!-- 05 FAHRER -->
<!-- ================================================= -->

<section
  id="setup-drivers"
  class="setup-panel"
>

  <div class="setup-panel-number">
    05
  </div>

  <div class="setup-panel-content">

    <span>
      Stammfahrer oder ehemaliger F1-Fahrer
    </span>

    <h2>
      FAHRER AUSWÄHLEN
    </h2>

    <form
      method="post"
      action="/admin/season-setup/<%= selectedSeason.id %>/drivers"
    >

      <!-- FILTER -->

<div class="setup-driver-filter">

  <a
    class="button button-small <%= setupDriverRankFilter === 'all' ? '' : 'button-ghost' %>"
    href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&driverRank=all#setup-drivers"
  >
    Alle
  </a>

  <a
    class="button button-small <%= setupDriverRankFilter === 'friday' ? '' : 'button-ghost' %>"
    href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&driverRank=friday#setup-drivers"
  >
    Freitag
  </a>

  <a
    class="button button-small <%= setupDriverRankFilter === 'saturday' ? '' : 'button-ghost' %>"
    href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&driverRank=saturday#setup-drivers"
  >
    Samstag
  </a>

  <a
    class="button button-small <%= setupDriverRankFilter === 'sunday' ? '' : 'button-ghost' %>"
    href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&driverRank=sunday#setup-drivers"
  >
    Sonntag
  </a>

  <a
    class="button button-small <%= setupDriverRankFilter === 'former' ? '' : 'button-ghost' %>"
    href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>&driverRank=former#setup-drivers"
  >
    Ehemalige F1
  </a>

</div>


      <!-- FAHRER -->

      <div class="setup-driver-grid">

        <% setupEligibleDrivers.forEach((driver) => {

  const roles = [];

  if (driver.roleF1Friday) {
    roles.push('Freitag');
  }

  if (driver.roleF1Saturday) {
    roles.push('Samstag');
  }

  if (driver.roleF1Sunday) {
    roles.push('Sonntag');
  }

  if (driver.roleFormerF1) {
    roles.push('Ehemaliger F1-Fahrer');
  }

  let driverMatchesFilter = true;

  if (setupDriverRankFilter === 'friday') {
    driverMatchesFilter =
      Boolean(driver.roleF1Friday);
  }

  if (setupDriverRankFilter === 'saturday') {
    driverMatchesFilter =
      Boolean(driver.roleF1Saturday);
  }

  if (setupDriverRankFilter === 'sunday') {
    driverMatchesFilter =
      Boolean(driver.roleF1Sunday);
  }

  if (setupDriverRankFilter === 'former') {
    driverMatchesFilter =
      Boolean(driver.roleFormerF1);
  }

%>
<label
  class="setup-driver-card <%= driverMatchesFilter ? '' : 'setup-driver-filter-hidden' %>"
>

            <input
              type="checkbox"
              name="driverIds"
              value="<%= driver.id %>"
              <%= selectedDriverIds.has(Number(driver.id))
                ? 'checked'
                : ''
              %>
            >

            <span class="setup-driver-info">

              <strong>
                <%= driver.name %>
              </strong>

              <small>
                #<%= driver.id %>
                ·
                <%= roles.join(' · ') || 'F1 Fahrer' %>
              </small>

            </span>

          </label>

        <% }) %>

      </div>


      <button
        type="submit"
        class="button setup-save-step"
      >
        Fahrerauswahl speichern
      </button>

    </form>

  </div>

</section>


      <!-- ================================================= -->
      <!-- 06 TEAMS -->
      <!-- ================================================= -->

      <section
        id="setup-teams"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          06
        </div>

        <div class="setup-panel-content">

          <span>
            Maximal 11
          </span>

          <h2>
            AKTUELLE ODER HISTORISCHE TEAMS
          </h2>

          <form
            method="post"
            action="/admin/season-setup/<%= selectedSeason.id %>/teams"
          >


            <!-- AKTUELLE TEAMS -->

            <div class="setup-team-source">

              <h3>
                Aktuelle Teams
              </h3>

              <div class="team-choice-grid">

                <% f1Teams.forEach((team) => {

                  const token = `current:${team.id}`;

                %>

                  <label class="team-choice-card">

                    <input
                      type="checkbox"
                      name="teamTokens"
                      value="<%= token %>"
                      <%= selectedTeamTokens.has(token)
                        ? 'checked'
                        : ''
                      %>
                    >

                    <% if (team.logoPath) { %>

                      <img
                        src="<%= team.logoPath %>"
                        alt=""
                      >

                    <% } %>

                    <strong>
                      <%= team.name %>
                    </strong>

                  </label>

                <% }) %>

              </div>

            </div>


            <!-- HISTORISCHE TEAMS -->

            <div class="setup-team-source">

              <h3>
                Historische Teams
              </h3>

              <div class="team-choice-grid">

                <% carProfiles.forEach((team) => {

                  const token = `historical:${team.id}`;

                %>

                  <label class="team-choice-card">

                    <input
                      type="checkbox"
                      name="teamTokens"
                      value="<%= token %>"
                      <%= selectedTeamTokens.has(token)
                        ? 'checked'
                        : ''
                      %>
                    >

                    <% if (team.logoPath) { %>

                      <img
                        src="<%= team.logoPath %>"
                        alt=""
                      >

                    <% } %>

                    <strong>
                      <%= team.name %>
                    </strong>

                    <small>
                      gehört zu
                      <%= team.baseTeam?.name || '–' %>
                    </small>

                  </label>

                <% }) %>

              </div>

            </div>


            <button
              type="submit"
              class="button setup-save-step"
            >
              Teams speichern
            </button>

          </form>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 07 LINE-UP -->
      <!-- ================================================= -->

      <section
        id="setup-lineup"
        class="setup-panel"
      >

        <div class="setup-panel-number">
          07
        </div>

        <div class="setup-panel-content">

          <span>
            Nur Fahrer aus Schritt 5
          </span>

          <h2>
            LINE-UP ERSTELLEN
          </h2>

          <p class="setup-note">
            Ordne jedem Team maximal zwei Stammfahrer zu.
            Nicht zugeordnete Fahrer bleiben automatisch Ersatzfahrer.
            Ein Fahrer kann nur einem Team zugeordnet werden.
          </p>


          <% if (!setupStructure.teams.length) { %>

            <div class="empty-state">
              Bitte zuerst in Schritt 6 Teams auswählen.
            </div>


          <% } else if (!setupStructure.allDrivers.length) { %>

            <div class="empty-state">
              Bitte zuerst in Schritt 5 Fahrer auswählen.
            </div>


          <% } else { %>

            <form
              id="season-lineup-form"
              method="post"
              action="/admin/season-setup/<%= selectedSeason.id %>/lineup"
            >

              <div class="season-lineup-grid">

                <% setupStructure.teams.forEach((team) => {

                  const assignedIds = Array.from(
                    assignedByTeam.get(Number(team.id)) ||
                    new Set()
                  ).filter(Boolean);

                %>

                  <article
                    class="season-lineup-team"
                    style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
                  >

                    <header class="season-lineup-team-header">


                      <% if (team.logoPath) { %>

                        <div class="season-lineup-logo">

                          <img
                            src="<%= team.logoPath %>"
                            alt="<%= team.name %>"
                          >

                        </div>

                      <% } else { %>

                        <div class="season-lineup-logo-fallback">

                          <%= team.name
                            .slice(0, 2)
                            .toUpperCase()
                          %>

                        </div>

                      <% } %>


                      <div class="season-lineup-team-title">

                        <span>
                          SAISONTEAM
                        </span>

                        <strong>
                          <%= team.name %>
                        </strong>

                      </div>

                    </header>


                    <div class="season-lineup-driver-slots">

                      <% for (let slot = 0; slot < 2; slot++) {

                        const currentDriverId =
                          Number(assignedIds[slot]) || null;

                      %>

                        <label class="season-lineup-slot">

                          <span>
                            STAMMFAHRER
                            <%= slot + 1 %>
                          </span>

                        <select
  class="season-lineup-driver-select"
  name="lineup[<%= team.id %>][]"
  data-team-id="<%= team.id %>"
  data-slot="<%= slot + 1 %>"
>

                            <option value="">
                              — Fahrer auswählen —
                            </option>

                            <% setupStructure.allDrivers.forEach((driver) => { %>

                              <option
                                value="<%= driver.id %>"
                                <%= currentDriverId === Number(driver.id)
                                  ? 'selected'
                                  : ''
                                %>
                              >
                                <%= driver.name %>
                              </option>

                            <% }) %>

                          </select>

                        </label>

                      <% } %>

                    </div>

                  </article>

                <% }) %>

              </div>


              <div class="season-lineup-footer">

                <p>
                  Alle nicht zugeordneten Fahrer werden automatisch
                  als Ersatzfahrer gespeichert.
                </p>

                <button
                  type="submit"
                  class="button setup-save-step"
                >
                  Line-up speichern
                </button>

              </div>

            </form>

          <% } %>

        </div>

      </section>


      <!-- ================================================= -->
      <!-- 08 ABSCHLUSS -->
      <!-- ================================================= -->

 <!-- ================================================= -->
<!-- 08 ABSCHLUSS -->
<!-- ================================================= -->

<section
  id="setup-finish"
  class="setup-panel setup-finish-panel"
>

  <div class="setup-panel-number">
    08
  </div>

  <div class="setup-panel-content">

    <span>
      Kontrolle vor Veröffentlichung
    </span>

    <h2>
      ABSCHLUSS
    </h2>


    <!-- =============================== -->
    <!-- STATUS ÜBERSICHT -->
    <!-- =============================== -->

    <div class="setup-final-summary">

      <article class="setup-final-card">
        <span>Liga</span>

        <strong>
          <%= selectedLeague.name %>
        </strong>
      </article>


      <article class="setup-final-card">
        <span>Saison</span>

        <strong>
          <%= selectedSeason.name %>
        </strong>
      </article>


      <article class="setup-final-card">
        <span>Kalender</span>

        <strong>
          <%= calendar.length %>
        </strong>

        <small>
          Termine
        </small>
      </article>


      <article class="setup-final-card">
        <span>Fahrer</span>

        <strong>
          <%= setupStructure.allDrivers.length %>
        </strong>

        <small>
          ausgewählt
        </small>
      </article>


      <article class="setup-final-card">
        <span>Teams</span>

        <strong>
          <%= setupStructure.teams.length %>
        </strong>

        <small>
          ausgewählt
        </small>
      </article>


      <article class="setup-final-card">
        <span>Ersatzfahrer</span>

        <strong>
          <%= setupStructure.unassignedDrivers.length %>
        </strong>

        <small>
          verfügbar
        </small>
      </article>

    </div>


    <!-- =============================== -->
    <!-- LINE-UP KONTROLLE -->
    <!-- =============================== -->

    <div class="setup-finish-lineup">

      <div class="setup-finish-section-heading">

        <div>
          <span>
            Saison-Line-up
          </span>

          <h3>
            STAMMFAHRER
          </h3>
        </div>

        <strong>
          <%= setupStructure.allDrivers.length - setupStructure.unassignedDrivers.length %>
          zugeordnet
        </strong>

      </div>


      <div class="setup-finish-team-grid">

        <% setupStructure.teams.forEach((team) => { %>

          <article
            class="setup-finish-team"
            style="--team-color:<%= team.accentColor || '#6ef2f2' %>"
          >

            <div class="setup-finish-team-head">

              <% if (team.logoPath) { %>

                <img
                  src="<%= team.logoPath %>"
                  alt=""
                >

              <% } %>

              <div>
                <span>
                  Saisonteam
                </span>

                <strong>
                  <%= team.name %>
                </strong>
              </div>

            </div>


            <div class="setup-finish-team-drivers">

              <% if ((team.drivers || []).length) { %>

                <% team.drivers.forEach((driver, index) => { %>

                  <div class="setup-finish-driver">

                    <span>
                      <%= index + 1 %>
                    </span>

                    <strong>
                      <%= driver.name %>
                    </strong>

                  </div>

                <% }) %>

              <% } else { %>

                <div class="setup-finish-driver is-empty">
                  Kein Stammfahrer zugeordnet
                </div>

              <% } %>

            </div>

          </article>

        <% }) %>

      </div>

    </div>


    <!-- =============================== -->
    <!-- ERSATZFAHRER -->
    <!-- =============================== -->

    <div class="setup-finish-reserves">

      <div class="setup-finish-section-heading">

        <div>
          <span>
            Nicht einem Team zugeordnet
          </span>

          <h3>
            ERSATZFAHRER
          </h3>
        </div>

        <strong>
          <%= setupStructure.unassignedDrivers.length %>
        </strong>

      </div>


      <% if (setupStructure.unassignedDrivers.length) { %>

        <div class="setup-reserve-driver-grid">

          <% setupStructure.unassignedDrivers.forEach((driver) => { %>

            <div class="setup-reserve-driver">

              <div class="setup-reserve-driver-number">
                <%= driver.number ? `#${driver.number}` : 'RES' %>
              </div>

              <div>
                <strong>
                  <%= driver.name %>
                </strong>

                <small>
                  Ersatzfahrer
                </small>
              </div>

            </div>

          <% }) %>

        </div>

      <% } else { %>

        <div class="empty-state">
          Aktuell gibt es keine Ersatzfahrer.
        </div>

      <% } %>

    </div>


    <!-- =============================== -->
    <!-- ABSCHLIESSEN -->
    <!-- =============================== -->

    <div class="setup-finish-action">

      <div>

        <% if (setupFinishReady) { %>

          <strong>
            Saison ist vollständig eingerichtet.
          </strong>

          <p>
            Kalender, Punktesystem, Fahrer, Teams und Line-up
            sind vorhanden.
          </p>

        <% } else { %>

          <strong>
            Saison ist noch nicht vollständig.
          </strong>

          <p>
            Kalender, Punktesystem, Fahrer, Teams und mindestens
            eine Line-up-Zuordnung sind erforderlich.
          </p>

        <% } %>

      </div>


      <form
        method="post"
        action="/admin/season-setup/<%= selectedSeason.id %>/finish"
      >

        <button
          class="button"
          <%= setupFinishReady ? '' : 'disabled' %>
        >
          Saison abschließen & veröffentlichen
        </button>

      </form>

    </div>

  </div>

</section>


    <% } %>


  </div>
</section>


