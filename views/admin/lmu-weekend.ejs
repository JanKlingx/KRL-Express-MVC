<%- include('../partials/header',{title}) %><section class="admin-shell"><div class="container"><%- include('../partials/lmu-admin-heading',{title}) %><%- include('../partials/lmu-season-picker') %>
<% if(season){ %><form method="get" class="lmu-picker"><input type="hidden" name="season" value="<%= season.id %>"><input type="hidden" name="league" value="<%= league.id %>"><label>Rennen<select name="race"><% races.forEach(r=>{ %><option value="<%= r.id %>" <%= details?.race.id===r.id?'selected':'' %>>R<%= r.sortOrder %> · <%= r.title %></option><% }); %></select></label><button class="button">Rennen öffnen</button></form><% } %>
<% if(details){ const d=details; const locked=d.results.length>0; const name=driver=>driver?.lmuDisplayName||driver?.name||'Unbekannt'; %>
<nav class="league-section-nav"><a href="#aufstellung" class="button button-ghost">1 · Aufstellung</a><a href="#anwesenheit" class="button button-ghost">2 · Anwesenheit</a><a href="#ergebnisse" class="button button-ghost">3 · Ergebnisse</a></nav>
<section class="lmu-workflow-step" id="aufstellung"><h2>1 · Aufstellung planen</h2><p>Abgemeldete Plätze können ersetzt werden. „Unsicher“ zuerst klären; eine Rennsperre blockiert das Cockpit. Auf-Abruf-Fahrer ohne Einsatz erhalten keine Punkte.</p><% if(locked){ %><p class="flash">Ergebnisse vorhanden. Für Änderungen an der Aufstellung zuerst die Ergebnisse zurücksetzen.</p><% } %>
<form method="post" action="/admin/lmu-weekends/<%= d.race.id %>/lineup"><input type="hidden" name="version" value="<%= d.version %>"><fieldset <%= locked?'disabled':'' %>><div class="lineup-team-grid"><% d.teams.forEach(team=>{ %><article class="lineup-team-card" style="--team-color:<%= team.accentColor %>"><h3><%= team.name %></h3><% d.regulars.filter(r=>r.team.id===team.id).forEach(row=>{ const entry=d.entries.find(e=>e.DriverId===row.driver.id); %><label><strong><%= name(row.driver) %></strong><select name="regular[d<%= row.driver.id %>][status]" <%= d.penalty.banned.has(row.driver.id)?'disabled':'' %>><% regularStatuses.forEach(status=>{ %><option value="<%= status.value %>" <%= (d.penalty.banned.has(row.driver.id)?'rennsperre':entry?.status||'anwesend')===status.value?'selected':'' %>><%= status.label %></option><% }); %></select></label><% }); %></article><% }); %></div>
<details class="lmu-reserves" open><summary>Ersatzfahrer und freie Plätze</summary><p>Gewünschte Fahrer aktivieren, Status und gegebenenfalls einen Platz auswählen.</p><div class="table-wrap"><table><thead><tr><th>Einplanen</th><th>Fahrer</th><th>Status</th><th>Einsatz</th></tr></thead><tbody><% d.reserves.forEach(driver=>{const entry=d.entries.find(e=>e.DriverId===driver.id);const seat=entry?.vacantSeat||(entry?.ReplacementForDriverId?'d'+entry.ReplacementForDriverId:''); %><tr><td><input aria-label="<%= name(driver) %> einplanen" type="checkbox" name="reserves[d<%= driver.id %>][selected]" <%= entry?'checked':'' %>></td><td><%= name(driver) %></td><td><select name="reserves[d<%= driver.id %>][status]"><% reserveStatuses.forEach(status=>{ %><option value="<%= status.value %>" <%= (entry?.status||'auf_abruf')===status.value?'selected':'' %>><%= status.label %></option><% }); %></select></td><td><select name="reserves[d<%= driver.id %>][seat]"><option value="">Noch kein Einsatz</option><% d.regulars.forEach(row=>{ %><option value="d<%= row.driver.id %>" <%= seat==='d'+row.driver.id?'selected':'' %>><%= row.team.name %> · Ersatz für <%= name(row.driver) %></option><% });d.vacancy.forEach(v=>{ %><option value="<%= v.key %>" <%= seat===v.key?'selected':'' %>><%= v.label %></option><% }); %></select></td></tr><% }); %></tbody></table></div></details><button class="button">Aufstellung speichern und weiter</button></fieldset></form></section>
<section class="lmu-workflow-step" id="anwesenheit"><h2>2 · Tatsächliche Anwesenheit</h2><% if(!d.entries.length){ %><p>Zuerst Schritt 1 speichern.</p><% }else{ %><form method="post" action="/admin/lmu-weekends/<%= d.race.id %>/attendance"><input type="hidden" name="version" value="<%= d.version %>"><fieldset <%= locked?'disabled':'' %>><div class="table-wrap"><table><thead><tr><th>Fahrer</th><th>Team / Rolle</th><th>Anwesenheit</th></tr></thead><tbody><% d.entries.forEach(entry=>{const banned=entry.status==='rennsperre'||d.penalty.banned.has(entry.DriverId); %><tr><td><%= name(entry.driver) %><% if(entry.driver?.lmuCar){ %><small><%= entry.driver.lmuCar.manufacturer %> · <%= entry.driver.lmuCar.name %></small><% } %></td><td><%= entry.team?.name||'Ohne Einsatz' %> · <%= entry.roleType==='regular'?'Stamm':'Ersatz' %></td><td><% if(banned){ %><strong>Rennsperre</strong><% }else{ %><select name="attendance[d<%= entry.DriverId %>][status]" required><option value="">Bitte bestätigen</option><% [['anwesend','Anwesend'],['zu_spaet_vorbesprechung','Zu spät zur Vorbesprechung'],['abgemeldet','Abgemeldet'],['unabgemeldet','Unabgemeldet'],['zu_spaet_abgemeldet','Zu spät abgemeldet']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= entry.attendanceStatus===value?'selected':'' %>><%= label %></option><% }); %></select><% } %></td></tr><% }); %></tbody></table></div><p>Strafpunkte und Rennsperren werden in der <a href="/admin/lmu-penalty-ledger?season=<%= season.id %>">LMU-Strafkartei</a> gepflegt.</p><button class="button">Anwesenheit speichern und weiter</button></fieldset></form><% } %></section>
<section class="lmu-workflow-step" id="ergebnisse"><h2>3 · Rennergebnisse</h2><% if(!d.entries.length||d.entries.some(e=>!e.attendanceStatus)){ %><p>Zuerst Aufstellung und Anwesenheit abschließen.</p><% }else{ %><p>Platzierung eintragen; Punkte und FL-/Pole-Bonus werden aus dem Saison-Punktesystem berechnet. Auszeichnungen gelten jeweils für genau einen Fahrer.</p><form method="post" action="/admin/lmu-weekends/<%= d.race.id %>/results"><input type="hidden" name="version" value="<%= d.version %>"><div class="table-wrap"><table><thead><tr><th>Fahrer</th><th>Status</th><th>Platz</th><th>FL</th><th>Pole</th><th>DotD</th><th>Punkte</th></tr></thead><tbody><% d.entries.forEach(entry=>{const result=d.results.find(r=>r.DriverId===entry.DriverId); %><tr><td><%= name(entry.driver) %></td><% if(!entry.includeInResults){ %><td colspan="5"><%= entry.status==='rennsperre'?'S · Rennsperre':'DNS · Nicht gestartet' %></td><% }else{ %><td><select name="results[d<%= entry.DriverId %>][status]" data-result-status><% [['','Im Ziel'],['DNF','DNF'],['DSQ','DSQ']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (result?.status||'')===value?'selected':'' %>><%= label %></option><% }); %></select></td><td><input type="number" min="1" step="1" name="results[d<%= entry.DriverId %>][position]" value="<%= result?.position||'' %>" data-result-position required aria-label="Platz von <%= name(entry.driver) %>"></td><% ['fastestLap','polePosition','driverOfTheDay'].forEach(key=>{ %><td><input type="checkbox" name="results[d<%= entry.DriverId %>][<%= key %>]" <%= result?.[key]?'checked':'' %> aria-label="<%= key %> für <%= name(entry.driver) %>"></td><% }); %><% } %><td><%= result?Number(result.points):'–' %></td></tr><% }); %></tbody></table></div><button class="button">Ergebnisse speichern</button></form><% } %></section>
<details class="lmu-danger"><summary>Schritt zurücksetzen</summary><p>Aufstellung zurücksetzen entfernt auch Anwesenheit und Ergebnisse. Anwesenheit zurücksetzen entfernt auch die Ergebnisse.</p><form method="post" action="/admin/lmu-weekends/<%= d.race.id %>/reset" data-confirm="Ausgewählten Schritt und nachfolgende Ergebnisse zurücksetzen?"><input type="hidden" name="version" value="<%= d.version %>"><select name="step"><option value="3">Nur Ergebnisse</option><option value="2">Anwesenheit und Ergebnisse</option><option value="1">Gesamtes Rennwochenende</option></select><button class="button button-ghost">Zurücksetzen</button></form></details>
<% }else{ %><p class="empty-state">Noch kein LMU-Rennen vorhanden. Bitte zuerst eine Saison mit Kalender erstellen.</p><% } %></div></section><script src="/js/lmu-admin.js" defer></script><%- include('../partials/footer') %>
