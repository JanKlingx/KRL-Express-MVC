<%- include('../partials/header', { title }) %>
<% const displayedFields = config.listFields ? config.listFields.map((name) => config.fields.find((field) => field.name === name)).filter(Boolean) : config.fields.slice(0, 5); %>
<% const calendarDate = (value, withTime = false) => value ? new Intl.DateTimeFormat('de-DE', withTime ? { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' } : { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'Europe/Berlin' }).format(new Date(withTime ? value : `${value}T12:00:00Z`)) : 'Noch offen'; %>
<% const bulkEnabled = entries.length && !config.cardView && config.bulkDelete !== false; %>
<% const bulkIdsShown = new Set(); %>
<section class="admin-shell">
  <div class="container">
    <div class="admin-heading">
      <div>
        <a class="back-link" href="<%= adminBasePath %>">← Dashboard</a>
        <span class="form-kicker"><%= config.group %></span>
        <h1><%= config.title %></h1>
        <p class="admin-intro"><%= config.description %></p>
      </div>
      <a class="button" href="<%= adminBasePath %>/<%= resource %>/new">Neuer Eintrag</a>
    </div>

    <% if (config.nextResource) { %>
      <div class="workflow-hint"><strong>Nächster Schritt:</strong> <a href="<%= adminBasePath %>/<%= config.nextResource %>"><%= config.nextLabel %> →</a></div>
    <% } %>
    <% if (config.nextHref) { %>
      <div class="workflow-hint"><strong>Nächster Schritt:</strong> <a href="<%= config.nextHref %>"><%= config.nextLabel %> →</a></div>
    <% } %>

    <% if (config.filterByLeague) { %>
      <form class="admin-filter" method="get">
        <label><%= config.filterLabel || 'Stammfahrer nach Liga anzeigen' %>
          <select name="league"><option value="">Alle F1-Ligen</option><% leagueOptions.forEach((option) => { %><option value="<%= option.value %>" <%= String(selectedLeague) === option.value ? 'selected' : '' %>><%= option.label %></option><% }) %></select>
        </label>
      </form>
    <% } %>

    <% if (config.rankFilters) { %>
      <form class="admin-filter" method="get">
        <label>Fahrer nach Rang filtern
          <select name="rank"><option value="">Alle Ränge als Kategorien</option><% config.rankFilters.forEach((rank) => { %><option value="<%= rank.value %>" <%= selectedRank === rank.value ? 'selected' : '' %>><%= rank.label %></option><% }) %></select>
        </label>
      </form>
    <% } %>

    <% if (bulkEnabled) { %>
      <form id="bulk-delete-form" method="post" action="<%= adminBasePath %>/<%= resource %>/bulk?_method=DELETE" data-confirm="Die ausgewählten Einträge wirklich löschen? Verknüpfte Zuordnungen können dabei ebenfalls entfernt werden."></form>
      <div class="bulk-actions" data-bulk-actions><label><input type="checkbox" data-bulk-select-all> Alle sichtbaren auswählen</label><span><strong data-bulk-count>0</strong> ausgewählt</span><button class="button button-small bulk-delete-button" type="submit" form="bulk-delete-form" disabled>Auswahl löschen</button></div>
    <% } %>

    <% if (!entries.length) { %>
      <div class="empty-state"><%= selectedRank ? 'Für diesen Rang wurden keine Fahrer gefunden.' : 'Noch keine Einträge vorhanden. Starte mit „Neuer Eintrag“.' %></div>
    <% } else if (config.cardView === 'points-schemes') { %>
      <div class="points-scheme-grid">
        <% entries.forEach((entry) => { const allocations = entry.allocations || []; const mainPoints = allocations.filter((allocation) => allocation.raceType === 'main'); const sprintPoints = allocations.filter((allocation) => allocation.raceType === 'sprint'); %>
          <article class="points-scheme-card">
            <header><div><span><%= entry.discipline.toUpperCase() %> · PUNKTESYSTEM</span><h2><%= entry.name %></h2><small><%= entry.validFrom || 'ohne Startdatum' %> – <%= entry.validUntil || 'unbegrenzt' %></small></div><a href="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>/edit">System bearbeiten</a></header>
            <div class="points-scheme-meta"><span>Schnellste Runde</span><strong><%= entry.fastestLapEnabled ? `${entry.fastestLapPoints} Punkte` : 'deaktiviert' %></strong></div>
            <div class="points-allocation-columns">
              <section><h3>Hauptrennen</h3><% if (!mainPoints.length) { %><p>Noch keine Platzpunkte.</p><% } else { %><ol><% mainPoints.forEach((allocation) => { %><li><span>Platz <%= allocation.position %></span><strong><%= allocation.points %> P</strong><a href="<%= adminBasePath %>/pointAllocations/<%= allocation.id %>/edit" aria-label="Platz <%= allocation.position %> bearbeiten">✎</a><form method="post" action="<%= adminBasePath %>/pointAllocations/<%= allocation.id %>?_method=DELETE" data-confirm="Diesen Punktewert löschen?"><button type="submit" aria-label="Platz <%= allocation.position %> löschen">×</button></form></li><% }) %></ol><% } %></section>
              <% if (entry.discipline === 'f1') { %><section><h3>Sprintrennen</h3><% if (!sprintPoints.length) { %><p>Noch keine Sprintpunkte.</p><% } else { %><ol><% sprintPoints.forEach((allocation) => { %><li><span>Platz <%= allocation.position %></span><strong><%= allocation.points %> P</strong><a href="<%= adminBasePath %>/pointAllocations/<%= allocation.id %>/edit" aria-label="Sprintplatz <%= allocation.position %> bearbeiten">✎</a><form method="post" action="<%= adminBasePath %>/pointAllocations/<%= allocation.id %>?_method=DELETE" data-confirm="Diesen Sprint-Punktewert löschen?"><button type="submit" aria-label="Sprintplatz <%= allocation.position %> löschen">×</button></form></li><% }) %></ol><% } %></section><% } %>
            </div>
            <footer><a class="button button-small" href="<%= adminBasePath %>/pointAllocations/new?scheme=<%= entry.id %>">+ Punkte je Platz</a><form method="post" action="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>?_method=DELETE" data-confirm="Dieses Punktesystem mit allen zugehörigen Werten wirklich löschen?"><button type="submit">System löschen</button></form></footer>
          </article>
        <% }) %>
      </div>
    <% } else if (config.cardView) { %>
      <div class="admin-calendar-grid">
        <% entries.forEach((entry, index) => { %><article class="admin-calendar-card"><header><span class="calendar-round-badge">R<%= entry.sortOrder || index + 1 %></span><div><span><%= config.cardView === 'calendar-f1' ? 'FORMEL 1' : config.title.replace('-Rennkalender', '').toUpperCase() %></span><h2><%= entry.circuit || entry.title %></h2></div><% if (entry.hasSprint) { %><span class="calendar-sprint-badge">SPRINT</span><% } %></header>
          <% if (config.cardView === 'calendar-f1') { %><div class="calendar-schedule"><div><span>Freitagsliga</span><strong><%= calendarDate(entry.fridayDate) %></strong><small><%= entry.fridayTime || 'Startzeit offen' %></small></div><div><span>Sonntagsliga</span><strong><%= calendarDate(entry.sundayDate) %></strong><small><%= entry.sundayTime || 'Startzeit offen' %></small></div></div>
          <% } else { %><div class="calendar-event-date"><span><%= entry.isPublished ? 'Im Frontend sichtbar' : 'Nicht veröffentlicht' %></span><strong><%= calendarDate(entry.startsAt, true) %></strong><small><%= entry.circuit || 'Strecke offen' %><%= entry.durationMinutes ? ` · ${entry.durationMinutes} Minuten` : '' %></small></div><% } %>
          <footer><a href="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>/edit">Bearbeiten</a><form method="post" action="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>?_method=DELETE" data-confirm="Diesen Kalendereintrag wirklich löschen?"><button type="submit">Löschen</button></form></footer>
        </article><% }) %>
      </div>
    <% } else if (typeof rankGroups !== 'undefined' && rankGroups.length) { %>
      <div class="driver-rank-sections">
        <% rankGroups.forEach((group) => { %><section class="driver-rank-group"><header><div><span>RANG</span><h2><%= group.label %></h2></div><strong><%= group.entries.length %> Fahrer</strong></header>
          <div class="table-wrap admin-table"><table><thead><tr><% if (bulkEnabled) { %><th class="bulk-cell">Auswahl</th><% } %><th>Name</th><th>Aliase</th><th>Plattform</th><th>Nationalität</th><th>Aktionen</th></tr></thead><tbody><% group.entries.forEach((entry) => { const nationality = (fieldOptions.nationality || []).find((option) => option.value === String(entry.nationality)); const showBulkItem = bulkEnabled && !bulkIdsShown.has(Number(entry.id)); if (showBulkItem) bulkIdsShown.add(Number(entry.id)); %><tr><% if (bulkEnabled) { %><td class="bulk-cell"><% if (showBulkItem) { %><input type="checkbox" name="ids" value="<%= entry.id %>" form="bulk-delete-form" data-bulk-item aria-label="<%= entry.name %> auswählen"><% } %></td><% } %><td><strong><%= entry.name %></strong></td><td><%= entry.aliasesText || '–' %></td><td><%= entry.platform || '–' %></td><td><%= nationality?.label || entry.nationality || '–' %></td><td class="actions"><a href="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>/edit">Bearbeiten</a><form method="post" action="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>?_method=DELETE" data-confirm="Diesen Fahrer wirklich löschen?"><button type="submit">Löschen</button></form></td></tr><% }) %></tbody></table></div>
        </section><% }) %>
      </div>
    <% } else { %>
      <div class="table-wrap admin-table"><table><thead><tr><% if (bulkEnabled) { %><th class="bulk-cell">Auswahl</th><% } %><th>ID</th><% displayedFields.forEach((field) => { %><th><%= field.label %></th><% }) %><th>Aktionen</th></tr></thead><tbody>
        <% entries.forEach((entry) => { %><tr><% if (bulkEnabled) { %><td class="bulk-cell"><input type="checkbox" name="ids" value="<%= entry.id %>" form="bulk-delete-form" data-bulk-item aria-label="Eintrag #<%= entry.id %> auswählen"></td><% } %><td><span class="id-badge">#<%= entry.id %></span></td><% displayedFields.forEach((field) => { const rawValue = entry[field.name]; const option = (fieldOptions[field.name] || []).find((candidate) => candidate.value === String(rawValue)); %><td><%= option ? option.label : (field.type === 'checkbox' ? (rawValue ? 'Ja' : 'Nein') : (rawValue ?? '–')) %></td><% }) %><td class="actions"><a href="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>/edit">Bearbeiten</a><form method="post" action="<%= adminBasePath %>/<%= resource %>/<%= entry.id %>?_method=DELETE" data-confirm="Diesen Eintrag wirklich löschen?"><button type="submit">Löschen</button></form></td></tr><% }) %>
      </tbody></table></div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
