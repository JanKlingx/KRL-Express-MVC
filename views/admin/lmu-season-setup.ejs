<%- include('../partials/header',{title}) %>
<% const selectedDrivers=[].concat(draft.driverIds||[]).map(Number); const selectedTeams=[].concat(draft.teamIds||[]).map(Number); const stages=['Liga','Saison & Spiel','Kalender','Punktesystem','Fahrer','Teams','Line-up','Abschluss']; %>
<section class="admin-shell season-setup-shell"><div class="container">
<div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">LMU · FIORI-ASSISTENT</span><h1>LMU-SAISON ERSTELLEN</h1><p class="admin-intro">Acht Schritte greifen auf Stammdaten zurück. Die Saison wird erst im letzten Schritt veröffentlicht.</p></div><a class="button button-ghost" href="/admin/lmu-seasons">Saison bearbeiten</a></div>

<nav class="setup-steps setup-steps-eight" aria-label="Schritte der Saisonerstellung"><% stages.forEach((name,index)=>{ %><a href="#lmu-setup-<%= index %>" data-lmu-step-link="<%= index %>"><span><%= index+1 %></span><strong><%= name %></strong></a><% }); %></nav>
<form method="post" action="/admin/lmu-season-setup" class="lmu-season-wizard" data-lmu-wizard data-saved-step="<%= draft.step||1 %>">
<input type="hidden" name="driverSelection" value="explicit">
<section class="setup-panel" data-lmu-step id="lmu-setup-0"><div class="setup-panel-number">01</div><div class="setup-panel-content"><span>SCHRITT 1 VON 8</span><h2>LIGA AUSWÄHLEN</h2><div class="setup-form"><label>LMU-Liga<select name="LeagueId" required><option value="">Bitte auswählen</option><% leagues.forEach(l=>{ %><option value="<%= l.id %>" <%= Number(draft.LeagueId||league?.id)===l.id?'selected':'' %>><%= l.name %></option><% }); %></select></label></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-1"><div class="setup-panel-number">02</div><div class="setup-panel-content"><span>SCHRITT 2 VON 8</span><h2>SAISON UND SPIEL</h2><div class="setup-form">
<label>Saisonname<input name="name" value="<%= draft.name||'' %>" placeholder="z. B. LMU Saison 6" required maxlength="255"></label>
<label>Status<select name="status"><option value="active">Aktuelle Saison</option><option value="historical" <%= draft.status==='historical'?'selected':'' %>>Historische Saison</option></select></label><small>Die bisherige aktuelle Saison wird erst beim abschließenden Erstellen archiviert.</small>
<label>Spiel / Logo<select name="LmuGameId" required><option value="">Bitte auswählen</option><% games.forEach(g=>{ %><option value="<%= g.id %>" <%= Number(draft.LmuGameId)===g.id?'selected':'' %>><%= g.name %></option><% }); %></select></label><a href="/admin/lmu-games" target="_blank" rel="noopener">LMU-Spiele pflegen ↗</a>
<label>Saisonfarbe<input type="color" name="accentColor" value="<%= draft.accentColor||league?.accentColor||'#6ef2f2' %>" required></label></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-2"><div class="setup-panel-number">03</div><div class="setup-panel-content"><span>SCHRITT 3 VON 8</span><h2>RENNKALENDER</h2><div class="setup-form"><label>Zentralen LMU-Kalender auswählen<select name="LmuCalendarId" required data-lmu-calendar-choice><option value="">Bitte auswählen</option><% calendars.forEach(c=>{ %><option value="<%= c.id %>" <%= Number(draft.LmuCalendarId)===c.id?'selected':'' %>><%= c.name %> · <%= c.rounds.length %> Termine</option><% }); %></select></label>
<p>Die Startzeit kommt aus der ausgewählten Liga.</p><p><a href="/admin/lmuTracks" target="_blank" rel="noopener">LMU-Strecken pflegen ↗</a> · <a href="/admin/lmu-calendars" target="_blank" rel="noopener">Zentrale Kalender pflegen ↗</a></p>
<% calendars.forEach(c=>{ %><div data-calendar-preview="<%= c.id %>" class="table-wrap"><h3><%= c.name %></h3><table><thead><tr><th>Runde</th><th>Strecke</th><th>Datum</th></tr></thead><tbody><% let round=0; c.rounds.forEach((r,i)=>{ %><tr><td><%= r.isTestDay?'Testtag':'R'+(++round) %></td><td><%= r.circuit %></td><td><input type="date" name="dates[r<%= r.id||i+1 %>]" value="<%= draft.dates?.['r'+(r.id||i+1)] || (r.startsAt ? new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Berlin',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(r.startsAt)) : '') %>" required aria-label="Datum für <%= r.circuit %>"></td></tr><% }); %></tbody></table></div><% }); %></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-3"><div class="setup-panel-number">04</div><div class="setup-panel-content"><span>SCHRITT 4 VON 8</span><h2>PUNKTESYSTEM</h2><div class="setup-form"><label>LMU-Punktesystem<select name="PointsSchemeId" required><option value="">Bitte auswählen</option><% schemes.forEach(p=>{ %><option value="<%= p.id %>" <%= Number(draft.PointsSchemeId)===p.id?'selected':'' %>><%= p.name %></option><% }); %></select></label><a href="/admin/pointsSchemes" target="_blank" rel="noopener">Punktesysteme pflegen ↗</a><label><input type="checkbox" name="reservePointsForConstructors" <%= !Object.keys(draft).length||draft.reservePointsForConstructors==='on'?'checked':'' %>> Ersatzfahrer-Punkte zählen für ihr eingesetztes Team</label></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-4"><div class="setup-panel-number">05</div><div class="setup-panel-content"><span>SCHRITT 5 VON 8</span><h2>FAHRER AUSWÄHLEN</h2><div class="setup-form"><p>Nur ausgewählte LMU-Fahrer werden Teil dieser Saison und stehen im nächsten Schritt für die Cockpits zur Verfügung.</p><label>Fahrer suchen<input type="search" data-wizard-driver-search placeholder="Name eingeben"></label><div><button type="button" class="button button-small button-ghost" data-driver-all>Alle auswählen</button> <button type="button" class="button button-small button-ghost" data-driver-none>Auswahl leeren</button></div>
<div class="setup-driver-options"><% drivers.forEach(d=>{ %><label data-wizard-driver-name="<%= (d.name+' '+(d.lmuDisplayName||'')).toLowerCase() %>"><input type="checkbox" name="driverIds" value="<%= d.id %>" <%= selectedDrivers.includes(d.id)?'checked':'' %>><span><%= d.lmuDisplayName||d.name %></span></label><% }); %></div><p data-driver-count></p><a href="/admin/drivers/new" target="_blank" rel="noopener">Fahrer in der Fahrerpflege anlegen ↗</a></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-5"><div class="setup-panel-number">06</div><div class="setup-panel-content"><span>SCHRITT 6 VON 8</span><h2>LMU-TEAMS AUSWÄHLEN</h2><div class="setup-form"><div class="lmu-team-options"><% teams.forEach(t=>{ %><label><input type="checkbox" name="teamIds" value="<%= t.id %>" <%= selectedTeams.includes(t.id)?'checked':'' %>><% if(t.logoPath){ %><img src="<%= t.logoPath %>" alt="" width="48" height="36" style="object-fit:contain"><% } %><span><%= t.name %></span></label><% }); %></div><a href="/admin/lmuTeams" target="_blank" rel="noopener">LMU-Teams pflegen ↗</a></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-6"><div class="setup-panel-number">07</div><div class="setup-panel-content"><span>SCHRITT 7 VON 8</span><h2>LINE-UP ZUSAMMENSTELLEN</h2><div class="setup-form"><p>Fahrer aus Schritt 5 auf die drei Plätze der gewählten Teams verteilen. Jeder Fahrer kann genau ein Cockpit belegen. Ohne Cockpit bleibt er Ersatzfahrer.</p><div class="lineup-team-grid"><% teams.forEach(t=>{ %><article class="lineup-team-card" data-cockpit-team="<%= t.id %>" style="--team-color:<%= t.accentColor %>"><h3><%= t.name %></h3><% for(let slot=0;slot<3;slot++){ const chosen=Number(draft.cockpits?.['t'+t.id]?.['s'+slot])||null; %><label>Cockpit <%= slot+1 %><select name="cockpits[t<%= t.id %>][s<%= slot %>]" data-cockpit-driver><option value="">Frei lassen</option><% drivers.forEach(d=>{ %><option value="<%= d.id %>" <%= chosen===d.id?'selected':'' %>><%= d.lmuDisplayName||d.name %></option><% }); %></select></label><% } %></article><% }); %></div><p data-reserve-summary></p></div></div></section>
<section class="setup-panel" data-lmu-step id="lmu-setup-7"><div class="setup-panel-number">08</div><div class="setup-panel-content"><span>SCHRITT 8 VON 8</span><h2>PRÜFEN UND ABSCHLIESSEN</h2><div class="setup-form"><div data-setup-review></div><label><input type="checkbox" name="isPublished" <%= draft.isPublished==='on'?'checked':'' %>> Saison nach dem Erstellen öffentlich anzeigen</label><p>Erst „Saison erstellen“ speichert die neue Saison mit Kalender, ausgewählten Fahrern, Teams und Line-up.</p></div></div></section>
<p data-wizard-status role="status" aria-live="polite"></p><div class="form-actions"><button type="button" class="button button-ghost" data-wizard-back hidden>Zurück</button><button type="button" class="button" data-wizard-next hidden>Speichern und weiter</button><button type="submit" class="button" data-wizard-submit>Saison erstellen</button></div>
</form></div></section><script src="/js/lmu-season-wizard.js" defer></script><%- include('../partials/footer') %>
