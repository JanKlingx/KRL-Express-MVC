<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container"><div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">RENNLEITUNG</span><h1>STRAFKARTEI</h1><p class="admin-intro">Aktive Stammfahrer, Ersatzfahrer und ehemalige Fahrer mit noch gültigen Strafpunkten. Punkte verfallen nach einem Jahr.</p></div><a class="button button-ghost" href="/admin/penaltyRules">Strafpunktesystem</a></div>
<form class="race-selector" method="get"><label>Liga<select name="league" onchange="this.form.submit()"><% leagues.forEach((item) => { %><option value="<%= item.id %>" <%= league?.id === item.id ? 'selected' : '' %>><%= item.name %></option><% }) %></select></label></form>
<% if (rows.some((row) => row.suspended)) { %><div class="flash flash-error">Rennsperre aktiv: Gesperrte Fahrer dürfen nicht als Ersatzfahrer eingesetzt werden.</div><% } %>
<section class="setup-panel"><div class="setup-panel-content"><h2>MANUELLE STRAFE EINTRAGEN</h2><form method="post" action="/admin/penalty-ledger" class="setup-form"><input type="hidden" name="LeagueId" value="<%= league?.id || '' %>"><input type="hidden" name="GrandPrixResultId" value="<%= race?.id || '' %>"><label>Fahrer<select name="DriverId" required><% rows.forEach((row) => { %><option value="<%= row.id %>"><%= row.name %> · <%= row.role %></option><% }) %></select></label><label>Strafpunkte<input type="number" min="1" name="points" required></label><label>Grund<input name="reason" value="Manuelle Strafe" required></label><label>Kommentar<input name="comment"></label><label>Datum<input type="date" name="awardedOn" value="<%= new Date().toISOString().slice(0,10) %>"></label><button class="button">Eintragen</button></form></div></section>
<div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Bereich</th><th>Fahrer</th><th>Gültige Strafpunkte</th><th>Bis Rennsperre</th><th>Status</th></tr></thead><tbody><% rows.forEach((row) => { %><tr class="<%= row.suspended ? 'row-danger' : '' %>"><td><%= row.role %></td><td><strong><%= row.name %></strong><br><small><%= row.penalties.map((p) => `${p.points} · ${p.reason}`).join(', ') || 'Keine' %></small></td><td><%= row.points %></td><td><%= row.remaining %></td><td><%= row.suspended ? 'RENNGESPERRT' : 'Frei' %></td></tr><% }) %></tbody></table></div>
</div></section><%- include('../partials/footer') %>
