<form
  method="post"
  action="/admin/f1-race-lineup/<%= selectedRace.id %>"
  class="f1-lineup-matrix"
  data-f1-lineup-matrix
>
  <input
    type="hidden"
    name="_return"
    value="race-control"
  >


  <div class="f1-lineup-matrix__toolbar">

    <div>
      <span>
        EINSATZMATRIX
      </span>

      <strong>
        Status prüfen, danach Ersatz direkt am Cockpit auswählen
      </strong>

      <small>
        Diese Aufstellung gilt nur für dieses Rennen der aktuellen Saison.
      </small>
    </div>

    <button
      class="button"
      type="submit"
    >
      AUFSTELLUNG SPEICHERN
    </button>

  </div>


  <div
    class="f1-lineup-status-legend"
    aria-label="Statusfarben"
  >

    <% regularStatuses.forEach((status) => { %>

      <span
        class="status-<%= status.value %>"
        data-tone="<%= status.value %>"
      >
        <%= status.label %>
      </span>

    <% }) %>

    <span
      class="status-auf_abruf"
      data-tone="auf_abruf"
    >
      Auf Abruf
    </span>

  </div>


  <!-- ================================================= -->
  <!-- ERSATZFAHRER -->
  <!-- ================================================= -->

  <section
    class="f1-lineup-reserve-pool"
    aria-labelledby="f1-reserve-pool-title"
  >

    <header>

      <div>
        <span>
          1 · ERSATZFAHRERSTATUS
        </span>

        <h3 id="f1-reserve-pool-title">
          ERSATZFAHRER-POOL
        </h3>
      </div>

      <small>
        „Auf Abruf“ wird beim Speichern automatisch vergeben.
      </small>

    </header>


    <div class="f1-lineup-reserve-pool__grid">

      <% reserveRows.forEach((row) => { %>

        <article
          class="f1-lineup-reserve"
          data-reserve-row
          data-reserve-id="<%= row.driver.id %>"
          data-reserve-name="<%= row.driver.name %>"
          data-status="<%= row.status %>"
          data-locked="<%= row.isAttendanceLocked ? 'true' : 'false' %>"
        >

          <div class="f1-lineup-reserve__name">

            <strong>
              <%= row.driver.name %>
            </strong>

            <small>
              <%= row.driver.platform || 'F1 Ersatz' %>
            </small>

          </div>


          <% if (row.isAttendanceLocked) { %>

            <input
              type="hidden"
              name="reserve[d<%= row.driver.id %>][status]"
              value="<%= row.status %>"
              data-reserve-status-input
            >

            <span
              class="f1-lineup-chip"
              data-tone="locked"
            >
              🔒 ANWESENHEIT BESTÄTIGT
            </span>

          <% } else { %>

            <label>

              <span>
                Status
              </span>

              <div class="field-with-edit">

                <select
                  name="reserve[d<%= row.driver.id %>][status]"
                  data-reserve-status-select
                  data-reserve-status-input
                  aria-label="Status <%= row.driver.name %>"
                >

                  <% if (row.status === 'auf_abruf') { %>

                    <option
                      value="auf_abruf"
                      selected
                    >
                      Auf Abruf (System)
                    </option>

                  <% } %>


                  <% reserveStatuses
                    .filter(
                      (status) =>
                        status.value !== 'auf_abruf'
                    )
                    .forEach((status) => {
                  %>

                    <option
                      value="<%= status.value %>"
                      <%= row.status === status.value
                        ? 'selected'
                        : ''
                      %>
                    >
                      <%= status.label %>
                    </option>

                  <% }) %>

                </select>

                <span
                  class="field-edit-pencil"
                  title="Bearbeiten"
                  aria-hidden="true"
                >
              
                </span>

              </div>

            </label>

          <% } %>


          <div
            class="f1-lineup-reserve__assignment"
            data-reserve-assignment
          >

            <% if (row.assignedTo) { %>

              <span>
                EINGETEILT
              </span>

              <strong>
                <%= row.assignedTo.team.name %>
              </strong>

              <small>
                Ersatz für <%= row.assignedTo.driver.name %>
              </small>

            <% } else { %>

              <span>
                FREI
              </span>

              <small>
                Noch keinem Cockpit zugeordnet
              </small>

            <% } %>

          </div>

        </article>

      <% }) %>

    </div>

  </section>


  <!-- ================================================= -->
  <!-- STAMMFAHRER -->
  <!-- ================================================= -->

  <section
    class="f1-lineup-sheet"
    aria-labelledby="f1-lineup-sheet-title"
  >

    <header>

      <div>
        <span>
          2 · STAMMFAHRERSTATUS & ERSATZ
        </span>

        <h3 id="f1-lineup-sheet-title">
          TEAM-AUFSTELLUNG
        </h3>
      </div>

      <small>
        Ersatz erscheint bei „Abgemeldet“, „Zu spät abgemeldet“ oder „Unsicher“.
      </small>

    </header>


    <div
      class="f1-lineup-sheet__head"
      aria-hidden="true"
    >
      <span>TEAM</span>
      <span>FAHRER</span>
      <span>STATUS</span>
      <span>ERSATZ</span>
    </div>


    <% teamCards.forEach((card) => { %>

      <article
        class="f1-lineup-team"
        style="--team-color:<%= card.team.accentColor || '#6ef2f2' %>"
      >

        <div class="f1-lineup-team__identity">

          <% if (card.team.logoPath) { %>

            <img
              src="<%= card.team.logoPath %>"
              alt=""
            >

          <% } %>

          <strong>
            <%= card.team.name %>
          </strong>

        </div>


        <div class="f1-lineup-team__drivers">

          <% card.rows.forEach((row) => {

            const lockedReplacement =
              reserveRows.find(
                (candidate) =>
                  Number(candidate.driver.id) ===
                    Number(row.replacementDriverId) &&
                  candidate.isAttendanceLocked
              );

          %>

            <div
              class="f1-lineup-driver <%= row.isBanned ? 'is-banned' : '' %>"
              data-regular-row
              data-regular-id="<%= row.driver.id %>"
              data-team-name="<%= card.team.name %>"
            >

              <div class="f1-lineup-driver__team-mobile">
                <%= card.team.name %>
              </div>


              <div class="f1-lineup-driver__name">

                <strong>
                  <%= row.driver.name %>
                </strong>

                <small>
                  <%= row.isBanned
                    ? 'Rennsperre · kein Ersatz zulässig'
                    : (row.driver.platform || '')
                  %>
                </small>

              </div>


              <!-- ========================================= -->
              <!-- STATUS -->
              <!-- ========================================= -->

              <div class="f1-lineup-driver__status">

                <% if (row.isBanned) { %>

                  <input
                    type="hidden"
                    name="regular[<%= row.driver.id %>][status]"
                    value="rennsperre"
                  >

                  <span
                    class="f1-lineup-chip"
                    data-tone="rennsperre"
                  >
                    RENNSPERRE
                  </span>

                <% } else { %>

                  <div class="field-with-edit">

                    <select
                      name="regular[<%= row.driver.id %>][status]"
                      data-regular-status
                      data-status="<%= row.status %>"
                      <%= lockedReplacement
                        ? 'disabled'
                        : ''
                      %>
                      aria-label="Status <%= row.driver.name %>"
                    >

                      <% regularStatuses.forEach((status) => { %>

                        <option
                          value="<%= status.value %>"
                          <%= row.status === status.value
                            ? 'selected'
                            : ''
                          %>
                        >
                          <%= status.label %>
                        </option>

                      <% }) %>

                    </select>


                    <% if (!lockedReplacement) { %>

                      <span
                        class="field-edit-pencil"
                        title="Bearbeiten"
                        aria-hidden="true"
                      >
                
                      </span>

                    <% } %>

                  </div>


                  <% if (lockedReplacement) { %>

                    <input
                      type="hidden"
                      name="regular[<%= row.driver.id %>][status]"
                      value="<%= row.status %>"
                    >

                  <% } %>

                <% } %>

              </div>


              <!-- ========================================= -->
              <!-- ERSATZ -->
              <!-- ========================================= -->

              <div
                class="f1-lineup-driver__replacement"
                data-replacement-field
                <%= (
                  row.isBanned ||
                  ![
                    'abgemeldet',
                    'unsicher',
                    'zu_spaet_abgemeldet'
                  ].includes(row.status)
                )
                  ? 'hidden'
                  : ''
                %>
              >

                <div class="field-with-edit">

                  <select
                    name="regular[<%= row.driver.id %>][ReplacementDriverId]"
                    data-replacement-select
                    data-current-replacement="<%= row.replacementDriverId || '' %>"

                    <%= (
                      lockedReplacement ||
                      row.isBanned ||
                      ![
                        'abgemeldet',
                        'unsicher',
                        'zu_spaet_abgemeldet'
                      ].includes(row.status)
                    )
                      ? 'disabled'
                      : ''
                    %>

                    aria-label="Ersatz für <%= row.driver.name %>"
                  >

                    <option value="">
                      Kein Ersatz
                    </option>


                    <% reserveRows
                      .filter(
                        (reserveRow) =>
                          [
                            'anwesend',
                            'unsicher',
                            'auf_abruf'
                          ].includes(reserveRow.status) ||
                          Number(reserveRow.driver.id) ===
                            Number(row.replacementDriverId)
                      )
                      .sort((left, right) => {

                        const rank = (status) =>
                          status === 'auf_abruf'
                            ? 0
                            : status === 'anwesend'
                              ? 1
                              : 2;

                        return (
                          rank(left.status) -
                            rank(right.status) ||
                          left.driver.name.localeCompare(
                            right.driver.name,
                            'de'
                          )
                        );
                      })
                      .forEach((reserveRow) => {

                        const reserveStatusLabel =
                          reserveRow.status === 'anwesend'
                            ? 'ANWESEND'
                            : reserveRow.status === 'auf_abruf'
                              ? 'AUF ABRUF'
                              : 'UNSICHER';

                    %>

                      <option
                        value="<%= reserveRow.driver.id %>"
                        <%= Number(row.replacementDriverId) ===
                            Number(reserveRow.driver.id)
                          ? 'selected'
                          : ''
                        %>
                      >
                        <%= reserveRow.driver.name %>
                        ·
                        <%= reserveStatusLabel %>
                      </option>

                    <% }) %>

                  </select>


                  <% if (
                    !lockedReplacement &&
                    !row.isBanned
                  ) { %>

                    <span
                      class="field-edit-pencil"
                      title="Bearbeiten"
                      aria-hidden="true"
                    >
            
                    </span>

                  <% } %>

                </div>


                <% if (lockedReplacement) { %>

                  <input
                    type="hidden"
                    name="regular[<%= row.driver.id %>][ReplacementDriverId]"
                    value="<%= row.replacementDriverId %>"
                  >

                  <small>
                    🔒 Anwesenheit bestätigt
                  </small>

                <% } %>

              </div>

            </div>

          <% }) %>

        </div>

      </article>

    <% }) %>

  </section>


  <div
    class="f1-lineup-matrix__feedback"
    data-lineup-feedback
    role="status"
  >
    Anwesende Ersatzfahrer ohne Cockpit werden beim Speichern automatisch „Auf Abruf“.
  </div>


  <button
    class="button"
    type="submit"
  >
    AUFSTELLUNG SPEICHERN
  </button>

</form>