<% if (items.length) { %>
  <div class="carousel gp-carousel" data-carousel tabindex="0" aria-label="<%= label %>">
    <div class="carousel-track">
      <% items.forEach((item, index) => {
        const classified = [...(item.entries || [])].sort((left, right) => {
          const leftPosition = Number(left.position) || 999;
          const rightPosition = Number(right.position) || 999;
          return leftPosition - rightPosition || Number(left.sortOrder) - Number(right.sortOrder);
        });
        const podium = classified.filter((entry) => Number(entry.position) >= 1 && Number(entry.position) <= 3);
      %>
        <article class="carousel-slide gp-result-card <%= index === 0 ? 'active' : '' %>" aria-hidden="<%= index !== 0 %>">
          <% if (item.imagePath) { %><img class="gp-poster" src="<%= item.imagePath %>" alt="Rennposter: <%= item.title %>"><% } %>
          <header class="gp-result-header">
            <div>
              <span class="gp-round">RUNDE <%= item.sortOrder || index + 1 %></span>
              <h3><%= item.title %></h3>
              <p><%= item.circuit || 'Strecke folgt' %><%= item.raceDate ? ` · ${item.raceDate}` : '' %></p>
            </div>
            <span class="gp-season"><%= item.season %></span>
          </header>

          <% if (classified.length) { %>
            <% if (podium.length) { %><div class="gp-podium" aria-label="Podium">
              <% podium.forEach((entry) => { const podiumStatus = String(entry.status || '').trim().toUpperCase(); %>
                <article class="podium-place podium-place-<%= entry.position || entry.sortOrder %>">
                  <span class="podium-position">P<%= entry.position %></span>
                  <strong><%= entry.driverName %></strong>
                  <small><%= entry.teamName || 'Privatteam' %></small>
                  <% if (podiumStatus) { %><em class="status-badge status-<%= podiumStatus.toLowerCase() %>"><%= podiumStatus %></em><% } %>
                </article>
              <% }) %>
            </div><% } %>

            <div class="table-wrap gp-classification">
              <table>
                <thead><tr><th>Pos.</th><th>Fahrer</th><th>Team</th><th>Punkte</th></tr></thead>
                <tbody>
                  <% classified.forEach((entry) => { const status = String(entry.status || '').trim().toUpperCase(); const position = Number(entry.position) || null; %>
                    <tr class="<%= position >= 1 && position <= 3 ? `result-position-${position}` : '' %> <%= status ? 'result-has-status' : '' %>">
                      <td><span class="result-place"><% if (position) { %><strong class="position-badge position-<%= position %>">P<%= position %></strong><% } %><% if (status) { %><span class="status-badge status-<%= status.toLowerCase() %>"><%= status %></span><% } %><% if (!position && !status) { %>–<% } %></span></td>
                      <td><%= entry.driverName %><% if (entry.fastestLap) { %><span class="fastest-lap" title="Schnellste Runde"> SR</span><% } %></td>
                      <td><%= entry.teamName || '–' %></td>
                      <td><strong><%= Number(entry.points) %></strong></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="empty-state">Für diesen Grand Prix wurde noch keine Klassifikation eingetragen.</div>
          <% } %>
        </article>
      <% }) %>
    </div>
    <% if (items.length > 1) { %>
      <button class="carousel-control prev" type="button" aria-label="Vorheriges Ergebnis">‹</button>
      <button class="carousel-control next" type="button" aria-label="Nächstes Ergebnis">›</button>
      <div class="carousel-dots" aria-label="Ergebnis auswählen"></div>
    <% } %>
  </div>
<% } else { %>
  <div class="empty-state">Noch keine Grand-Prix-Ergebnisse eingetragen.</div>
<% } %>
