<%- include('partials/header', { title }) %>
<section class="hero">
  <div class="hero-grid-overlay"></div>
  <div class="container hero-content">
    <div class="eyebrow">SIMRACING COMMUNITY · SEIT 2021</div>
    <h1>WILLKOMMEN BEI DER<br><span>KATZES RACING LEAGUE</span></h1>
    <p>Faire Rennen, starke Fahrerfelder und echte Motorsport-Leidenschaft – in mehreren Ligen und auf mehreren Plattformen.</p>
    <div class="hero-actions"><a class="button" href="https://discord.com" target="_blank" rel="noopener">Jetzt beitreten</a><a class="button button-ghost" href="#ligen">Ligen ansehen</a></div>
    <aside class="next-race"><span><%= nextRace?.isTestDay ? 'NÄCHSTER TESTTAG' : 'NÄCHSTES RENNEN' %></span><% if (nextRace) { %><strong><%= nextRace.title %></strong><small><%= nextRace.league.name %> · <%= nextRace.date %> · <%= nextRace.time %> Uhr</small><div class="countdown" data-countdown="<%= nextRace.iso %>">00T : 00H : 00M</div><% } else { %><strong>Termin folgt</strong><small>Im Adminbereich einen F1- oder LMU-Termin veröffentlichen.</small><% } %></aside>
  </div>
</section>

<section class="section container">
  <div class="section-heading"><span>MEHR ALS NUR RENNEN</span><h2>DEINE RACING-COMMUNITY</h2></div>
  <div class="feature-grid">
    <article class="feature-card"><div class="feature-icon">🏁</div><h3>Liga-Betrieb</h3><p>Organisierte Meisterschaften mit Rennleitung und transparenten Wertungen.</p></article>
    <article class="feature-card"><div class="feature-icon">◉</div><h3>Live-Events</h3><p>Spannende Übertragungen, Kommentare und besondere Community-Events.</p></article>
    <article class="feature-card"><div class="feature-icon">⚡</div><h3>Community</h3><p>Ein Ort für faire Fahrer, Teams, Strategen und Motorsport-Fans.</p></article>
  </div>
</section>

<section class="section section-dark" id="ligen">
  <div class="container">
    <div class="section-heading"><span>FÜR JEDEN RENNSTIL</span><h2>UNSERE LIGEN</h2></div>
    <div class="league-grid">
      <% leagues.forEach(league => { const href = league.slug === 'lmu' ? '/lmu' : league.type === 'f1' ? `/f1/${league.slug}` : league.slug === 'wettkampf' ? '/wettkampf-der-ligen' : '/endurance'; %>
        <article class="league-card" style="--accent:<%= league.accentColor %>"><% if (league.logoPath) { %><img class="league-card-logo" src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } %><div class="league-badge"><%= league.type.toUpperCase() %></div><h3><%= league.name %> <% if (isAdmin) { %><a class="admin-inline-action" href="/admin/leagues/<%= league.id %>/edit" aria-label="<%= league.name %> bearbeiten">✎</a><% } %></h3><p><%= league.description %></p><span><%= league.raceDay || 'Infos folgen' %> <%= league.raceTime || '' %></span><a href="<%= href %>">Liga entdecken →</a></article>
      <% }) %>
    </div>
  </div>
</section>

<section class="section stats-section">
  <div class="container stats-grid">
    <% statistics.forEach(stat => { %><article><span><%= stat.icon %></span><strong><%= stat.value %></strong><small><%= stat.label %></small><% if (isAdmin) { %><a class="admin-inline-action" href="/admin/statistics/<%= stat.id %>/edit" aria-label="<%= stat.label %> bearbeiten">✎</a><% } %></article><% }) %>
  </div>
</section>

<section class="section container" id="team">
  <div class="section-heading">
    <span>DIE MENSCHEN HINTER KRL</span>
    <h2>UNSER TEAM</h2>
  </div>

  <% krlTeams.forEach(team => { %>
    <div class="team-group" style="--team-color:<%= team.accentColor %>">
      <h3><%= team.name %> <% if (isAdmin) { %><a class="admin-inline-action" href="/admin/krlTeams/<%= team.id %>/edit" aria-label="<%= team.name %> bearbeiten">✎</a><form class="admin-inline-form" method="post" action="/admin/krlTeams/<%= team.id %>?_method=DELETE" data-confirm="Team wirklich löschen?"><button type="submit" aria-label="<%= team.name %> löschen">×</button></form><% } %></h3>

      <div class="people-grid">
        <% team.assignments.forEach(assignment => { const member = assignment.driver; %>
          <article class="person-card">

            <div class="avatar"><% if (assignment.imagePath) { %><img src="<%= assignment.imagePath %>" alt="<%= member.name %>"><% } else { %><%= member.name.charAt(0) %><% } %></div>

            <strong><%= member.name %></strong>
            <span><%= assignment.roleName %></span><% if (isAdmin) { %><a class="admin-inline-action" href="/admin/krlTeamAssignments/<%= assignment.id %>/edit" aria-label="<%= member.name %> bearbeiten">✎</a><form class="admin-inline-form" method="post" action="/admin/krlTeamAssignments/<%= assignment.id %>?_method=DELETE" data-confirm="Person aus dem Team entfernen?"><button type="submit" aria-label="<%= member.name %> entfernen">×</button></form><% } %>
          </article>
        <% }) %>
      </div>
    </div>
  <% }) %>
</section>
<% if (krlIcons.length) { %><section class="section section-dark icon-preview-section"><div class="container"><div class="section-heading"><span>AUSGEZEICHNET</span><h2>KRL ICONS</h2><a class="download-link" href="/krl-icons">Alle KRL Icons ansehen →</a></div><div class="icon-preview-grid"><% krlIcons.slice(0, 4).forEach((icon, index) => { const appointed = icon.appointedAt ? new Intl.DateTimeFormat('de-DE', { month: 'long', year: 'numeric', timeZone: 'Europe/Berlin' }).format(new Date(`${icon.appointedAt}T12:00:00Z`)) : null; %><article class="icon-preview-card"><span>KRL ICON · <%= String(index + 1).padStart(2, '0') %></span><strong><%= icon.driver.name %></strong><p><%= icon.text %></p><small><%= appointed ? `Ernannt ${appointed}` : 'Ernennung offen' %></small><a href="/krl-icons">Geschichte lesen →</a></article><% }) %></div></div></section><% } %>
<section class="section cta"><div class="container"><span>BEREIT FÜR DIE STARTAUFSTELLUNG?</span><h2>WERDE TEIL DER KRL</h2><p>Besuche unseren Discord und finde die passende Liga für dich.</p><a class="button" href="https://discord.com" target="_blank" rel="noopener">Discord öffnen</a></div></section>
<%- include('partials/footer') %>
