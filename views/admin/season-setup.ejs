<%- include('../partials/header', { title }) %>
<% const setupStructure = typeof structure === 'undefined' ? { allDrivers: [], teams: [], unassignedDrivers: [] } : structure; const setupTracks = typeof tracks === 'undefined' ? [] : tracks; const setupEligibleDrivers = typeof eligibleDrivers === 'undefined' ? [] : eligibleDrivers; const setupFinishReady = typeof finishReady === 'undefined' ? false : finishReady; const selectedDriverIds = new Set((setupStructure.allDrivers || []).map((driver) => Number(driver.id))); const selectedTeamTokens = new Set((setupStructure.teams || []).map((team) => `${team.sourceType}:${team.sourceId}`)); const assignedByTeam = new Map((setupStructure.teams || []).map((team) => [Number(team.id), new Set(team.drivers.map((driver) => Number(driver.id)))])); %>
<section class="admin-shell season-setup-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">FORMEL 1 · FIORI-ASSISTENT</span><h1>F1-SAISON ERSTELLEN</h1><p class="admin-intro">Alle acht Schritte greifen auf Stammdaten zurück. Die Saison wird erst im letzten Schritt veröffentlicht.</p></div><a class="button button-ghost" href="/admin/season-manager">Saison bearbeiten</a></div>
  <nav class="setup-steps setup-steps-eight"><a href="#setup-league" class="is-complete"><span>1</span><strong>Liga</strong></a><a href="#setup-season" class="<%= selectedLeague ? 'is-complete' : '' %>"><span>2</span><strong>Saison</strong></a><a href="#setup-calendar" class="<%= calendar.length ? 'is-complete' : '' %>"><span>3</span><strong>Kalender</strong></a><a href="#setup-points" class="<%= selectedSeason?.PointsSchemeId ? 'is-complete' : '' %>"><span>4</span><strong>Punkte</strong></a><a href="#setup-drivers" class="<%= setupStructure.allDrivers.length ? 'is-complete' : '' %>"><span>5</span><strong>Fahrer</strong></a><a href="#setup-teams" class="<%= setupStructure.teams.length ? 'is-complete' : '' %>"><span>6</span><strong>Teams</strong></a><a href="#setup-lineup" class="<%= setupStructure.teams.some((team) => team.drivers.length) ? 'is-complete' : '' %>"><span>7</span><strong>Line-up</strong></a><a href="#setup-finish" class="<%= setupFinishReady ? 'is-complete' : '' %>"><span>8</span><strong>Abschluss</strong></a></nav>
  <section id="setup-league" class="setup-panel"><div class="setup-panel-number">01</div><div class="setup-panel-content"><span>Freitag, Samstag oder Sonntag</span><h2>LIGA AUSWÄHLEN</h2><form method="get" class="setup-choice-grid"><% leagues.forEach((league) => { %><button class="setup-choice <%= selectedLeague?.id === league.id ? 'is-selected' : '' %>" style="--setup-accent:<%= league.accentColor %>" name="league" value="<%= league.id %>"><% if (league.logoPath) { %><img src="<%= league.logoPath %>" alt=""><% } %><span>FORMEL 1</span><strong><%= league.name %></strong><small><%= league.raceDay %> · <%= league.raceTime %></small></button><% }) %></form></div></section>
  <% if (selectedLeague) { %><section id="setup-season" class="setup-panel"><div class="setup-panel-number">02</div><div class="setup-panel-content"><span>Pflichtangaben</span><h2>SAISON & FARBPROFIL</h2><div class="setup-two-column"><form method="post" action="/admin/season-setup/seasons" class="setup-form"><input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>"><label>Saisonname<input name="name" required></label><label>Status<select name="status" required><option value="active">Aktuell</option><option value="historical">Historisch</option></select></label><label>Farbe<input type="color" name="accentColor" value="<%= selectedLeague.accentColor %>" required></label><button class="button">Saison anlegen</button></form><div class="setup-season-list"><strong>Vorhandene Saisons</strong><% seasons.forEach((season) => { %><a href="/admin/season-setup?league=<%= selectedLeague.id %>&season=<%= season.id %>" class="<%= selectedSeason?.id === season.id ? 'is-selected' : '' %>"><span><%= season.status === 'active' ? 'AKTUELL' : 'HISTORISCH' %></span><strong><%= season.name %></strong><small><%= season.isPublished ? 'Veröffentlicht' : 'Assistent noch offen' %></small></a><% }) %></div></div></div></section><% } %>
  <% if (selectedSeason) { %><section id="setup-calendar" class="setup-panel"><div class="setup-panel-number">03</div><div class="setup-panel-content"><span>Nur aus F1-Streckenstamm</span><h2>RENNKALENDER ERSTELLEN</h2><form id="season-calendar-form" method="post" action="/admin/season-setup/<%= selectedSeason.id %>/calendar" class="setup-form setup-calendar-form"><label>Strecke<select name="F1TrackId" required><option value="">Strecke wählen …</option><% setupTracks.forEach((track) => { %><option value="<%= track.id %>"><%= track.countryRecord?.name || track.country %> · <%= track.name %></option><% }) %></select></label><label>Land<input value="Wird automatisch übernommen" readonly></label><label>Rennen Nr.<input type="number" name="sortOrder" min="1" value="<%= calendar.length + 1 %>" required></label><label>Datum<input type="date" name="date" required></label><label>Startzeit<input type="time" name="time" value="<%= defaultTime %>" readonly></label><label class="checkbox-control"><input type="checkbox" name="isTestDay"><span>Testtag</span></label><label class="checkbox-control"><input type="checkbox" name="hasSprint"><span>Sprint</span></label><button class="button">Rennen hinzufügen</button></form><div class="setup-calendar-list"><% calendar.forEach((event) => { const startsAt = new Date(event.startsAt); %><article class="<%= event.isTestDay ? 'is-test' : '' %>"><span><%= event.isTestDay ? 'TEST' : `R${event.sortOrder}` %></span><% if (event.track?.countryRecord?.flagPath) { %><img class="setup-flag" src="<%= event.track.countryRecord.flagPath %>" alt="Flagge <%= event.track.countryRecord.name %>"><% } %><div><strong><%= event.circuit %></strong><small><%= event.track?.countryRecord?.name || event.track?.country || '' %> · <%= Number.isNaN(startsAt.getTime()) ? 'Datum prüfen' : new Intl.DateTimeFormat('de-DE', { dateStyle: 'medium', timeStyle: 'short' }).format(startsAt) %></small></div></article><% }) %></div><div class="setup-review"><strong>Zusammenfassung vor Schritt 4</strong><span><%= calendar.length %> Termine · <%= calendar.filter((event) => event.isTestDay).length %> Testtage</span><a href="/admin/season-calendar?league=<%= selectedLeague.id %>&season=<%= selectedSeason.id %>">Kalender prüfen/bearbeiten →</a></div></div></section>
  <section id="setup-points" class="setup-panel"><div class="setup-panel-number">04</div><div class="setup-panel-content"><span>Pflichtfeld</span><h2>PUNKTESYSTEM AUSWÄHLEN</h2><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/profile" class="setup-form"><input type="hidden" name="accentColor" value="<%= selectedSeason.accentColor %>"><label>Punktesystem<select name="PointsSchemeId" required><option value="">Punktesystem wählen …</option><% pointsSchemes.forEach((scheme) => { %><option value="<%= scheme.id %>" <%= selectedSeason.PointsSchemeId === scheme.id ? 'selected' : '' %>><%= scheme.name %></option><% }) %></select></label><button class="button">Punktesystem speichern</button></form></div></section>
  <section id="setup-drivers" class="setup-panel"><div class="setup-panel-number">05</div><div class="setup-panel-content"><span>Stammfahrer oder ehemaliger F1-Fahrer</span><h2>FAHRER AUSWÄHLEN</h2><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/drivers"><div class="setup-check-grid"><% setupEligibleDrivers.forEach((driver) => { %><label class="setup-check-card"><input type="checkbox" name="driverIds" value="<%= driver.id %>" <%= selectedDriverIds.has(driver.id) ? 'checked' : '' %>><span><strong><%= driver.name %></strong><small>#<%= driver.id %> · <%= driver.roleFormerF1 ? 'Ehemaliger F1-Fahrer' : 'Stammfahrer' %></small></span></label><% }) %></div><button class="button setup-save-step">Fahrerauswahl speichern</button></form></div></section>
  <section id="setup-teams" class="setup-panel"><div class="setup-panel-number">06</div><div class="setup-panel-content"><span>Maximal 11</span><h2>AKTUELLE ODER HISTORISCHE TEAMS</h2><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/teams"><div class="setup-team-source"><h3>Aktuelle Teams</h3><div class="team-choice-grid"><% f1Teams.forEach((team) => { const token = `current:${team.id}`; %><label class="team-choice-card"><input type="checkbox" name="teamTokens" value="<%= token %>" <%= selectedTeamTokens.has(token) ? 'checked' : '' %>><% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt=""><% } %><strong><%= team.name %></strong></label><% }) %></div></div><div class="setup-team-source"><h3>Historische Teams</h3><div class="team-choice-grid"><% carProfiles.forEach((team) => { const token = `historical:${team.id}`; %><label class="team-choice-card"><input type="checkbox" name="teamTokens" value="<%= token %>" <%= selectedTeamTokens.has(token) ? 'checked' : '' %>><% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt=""><% } %><strong><%= team.name %></strong><small>gehört zu <%= team.baseTeam?.name || '–' %></small></label><% }) %></div></div><button class="button setup-save-step">Teams speichern</button></form></div></section>
  <section id="setup-lineup" class="setup-panel"><div class="setup-panel-number">07</div><div class="setup-panel-content"><span>Nur Fahrer aus Schritt 5</span><h2>LINE-UP ERSTELLEN</h2><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/lineup"><div class="season-lineup-grid"><% setupStructure.teams.forEach((team) => { const selected = assignedByTeam.get(team.id) || new Set(); %><article class="season-lineup-team" style="--team-color:<%= team.accentColor %>"><header><% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt=""><% } %><strong><%= team.name %></strong></header><div><% setupStructure.allDrivers.forEach((driver) => { %><label><input type="checkbox" name="lineup[<%= team.id %>]" value="<%= driver.id %>" <%= selected.has(driver.id) ? 'checked' : '' %>><span><%= driver.name %></span></label><% }) %></div></article><% }) %></div><p class="setup-note">Nicht zugeordnete Fahrer bleiben automatisch als Ersatzfahrer der Saison erhalten.</p><button class="button setup-save-step">Line-up speichern</button></form></div></section>
  <section id="setup-finish" class="setup-panel"><div class="setup-panel-number">08</div><div class="setup-panel-content"><span>Kontrolle vor Veröffentlichung</span><h2>ABSCHLUSS</h2><div class="setup-final-summary"><article><span>Liga</span><strong><%= selectedLeague.name %></strong></article><article><span>Saison</span><strong><%= selectedSeason.name %></strong></article><article><span>Kalender</span><strong><%= calendar.length %> Termine</strong></article><article><span>Fahrer</span><strong><%= setupStructure.allDrivers.length %></strong></article><article><span>Teams</span><strong><%= setupStructure.teams.length %></strong></article><article><span>Ersatzfahrer</span><strong><%= setupStructure.unassignedDrivers.length %></strong></article></div><form method="post" action="/admin/season-setup/<%= selectedSeason.id %>/finish"><button class="button" <%= setupFinishReady ? '' : 'disabled' %>>Saison abschließen & veröffentlichen</button></form><% if (!setupFinishReady) { %><p class="setup-note">Noch nicht vollständig: Kalender, Punktesystem, Fahrer, Teams und mindestens eine Line-up-Zuordnung sind erforderlich.</p><% } %></div></section><% } %>
</div></section>
<%- include('../partials/footer') %>
