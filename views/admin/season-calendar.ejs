<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker">ALLE SAISONS</span><h1>RENNKALENDER BEARBEITEN</h1><p class="admin-intro">Liga und Saison auswählen. Danach Termine direkt ergänzen, ändern oder löschen.</p></div><a class="button button-ghost" href="/admin/season-setup">Neue Saison einrichten</a></div>
  <form class="race-selector" method="get"><label>Liga<select name="league"><% leagues.forEach((league) => { %><option value="<%= league.id %>" <%= selectedLeague?.id === league.id ? 'selected' : '' %>><%= league.name %></option><% }) %></select></label><label>Saison<select name="season"><%- include('../partials/season-options', { seasons, selectedSeason }) %></select></label><noscript><button class="button button-small">Öffnen</button></noscript></form>
  <% if (selectedSeason) { %><section class="setup-panel"><div class="setup-panel-number">+</div><div class="setup-panel-content"><h2>TERMIN HINZUFÜGEN</h2><form method="post" action="/admin/season-calendar/events" class="setup-form setup-calendar-form"><input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>"><input type="hidden" name="SeasonId" value="<%= selectedSeason.id %>"><label>Rennen<input name="title" required></label><label>Strecke<input name="circuit" required></label><label>Datum<input type="date" name="date" required></label><label>Startzeit<input type="time" name="time" value="<%= defaultTime %>" required></label><label>Runde<input type="number" min="1" name="sortOrder" value="<%= events.length + 1 %>"></label><label>Dauer<input type="number" min="1" name="durationMinutes" value="120"></label><label class="checkbox-control"><input type="checkbox" name="isTestDay"><span>Testtag</span></label><% if (discipline === 'f1') { %><label class="checkbox-control"><input type="checkbox" name="hasSprint"><span>Sprint</span></label><% } %><button class="button">Hinzufügen</button></form></div></section>
  <div class="setup-calendar-list season-calendar-editor"><% events.forEach((event, index) => { const startsAt = new Date(event.startsAt); const valid = !Number.isNaN(startsAt.getTime()); %><article class="<%= event.isTestDay ? 'is-test' : '' %>"><form method="post" action="/admin/season-calendar/events/<%= event.id %>?_method=PUT" class="setup-form setup-calendar-form"><span>R<%= event.sortOrder || index + 1 %></span><label>Rennen<input name="title" value="<%= event.title %>" required></label><label>Strecke<input name="circuit" value="<%= event.circuit || '' %>" required></label><label>Datum<input type="date" name="date" value="<%= valid ? startsAt.toISOString().slice(0,10) : '' %>" required></label><label>Zeit<input type="time" name="time" value="<%= valid ? startsAt.toTimeString().slice(0,5) : defaultTime %>" required></label><label>Dauer<input type="number" min="1" name="durationMinutes" value="<%= event.durationMinutes || 120 %>"></label><input type="hidden" name="sortOrder" value="<%= event.sortOrder || index + 1 %>"><label class="checkbox-control"><input type="checkbox" name="isTestDay" <%= event.isTestDay ? 'checked' : '' %>><span>Testtag</span></label><% if (discipline === 'f1') { %><label class="checkbox-control"><input type="checkbox" name="hasSprint" <%= event.hasSprint ? 'checked' : '' %>><span>Sprint</span></label><% } %><button class="button button-small">Speichern</button></form><form method="post" action="/admin/season-calendar/events/<%= event.id %>?_method=DELETE" data-confirm="Termin und Ergebnisse löschen?"><button class="button button-ghost button-small">Löschen</button></form></article><% }) %><% if (!events.length) { %><div class="empty-state">Diese Saison hat noch keine Termine.</div><% } %></div><% } %>
</div></section>
<%- include('../partials/footer') %>
