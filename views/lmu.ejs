<%- include('partials/header', { title }) %>
<section class="league-hero lmu-hero"><div class="container"><% if (league.logoPath) { %><img class="league-hero-logo" src="<%= league.logoPath %>" alt="Logo <%= league.name %>"><% } %><span class="eyebrow">LE MANS ULTIMATE · <%= league.currentSeason %></span><h1>LE MANS<br><span>ULTIMATE</span></h1><p><%= league.description %></p><div class="facts"><span>Renntag <strong><%= league.raceDay %></strong></span><span>Start <strong><%= league.raceTime %></strong></span><span>Format <strong>3 Fahrer pro Team</strong></span></div></div></section>
<section class="season-switcher container"><form method="get"><label for="season-select">Saison auswählen</label><select id="season-select" name="season"><%- include('partials/season-options', { seasons, selectedSeason }) %></select><noscript><button class="button button-small" type="submit">Saison laden</button></noscript></form></section>
<% if (isAdmin) { %><div class="public-edit-bar"><a href="/admin/drivers">✎ Fahrer-Stammdaten</a><a href="/admin/lmuCars">✎ LMU-Autos/Marken</a><a href="/admin/lmuTeams">✎ LMU-Teams</a><a href="/admin/team-rosters/lmu">✎ Cockpits/Fahrer</a><a href="/admin/lmuSeasonCalendar">✎ Rennkalender</a><a href="/admin/season-progress/lmu">✎ Saisonverlauf pro Rennen</a></div><% } %>
<section class="section container"><div class="section-heading"><span>STAMMDATEN</span><h2>LMU-FAHRERFELD</h2></div><div class="driver-grid"><% drivers.forEach((driver) => { %><article class="driver-card"><div class="avatar"><%= driver.name.charAt(0) %></div><h3><%= driver.name %></h3><span><%= driver.team?.name || 'Team offen' %></span><small><%= driver.platform %><% if (driver.aliases.length) { %> · früher <%= driver.aliases.map((alias) => alias.alias).join(', ') %><% } %></small></article><% }) %><% if (!drivers.length) { %><div class="empty-state">Noch keine LMU-Fahrer angelegt.</div><% } %></div></section>
<section class="section container"><div class="section-heading"><span>TEAMWORK AUF DER LANGSTRECKE</span><h2>COCKPITS</h2></div><div class="cockpit-grid"><% cockpits.forEach(cockpit => { const lmuCar = cockpit.team.lmuCar; %><article class="cockpit-card"><div class="cockpit-branding"><% if (cockpit.team.logoPath) { %><img class="cockpit-logo" src="<%= cockpit.team.logoPath %>" alt="Logo <%= cockpit.team.name %>"><% } else { %><div class="roster-logo-fallback"><%= cockpit.team.name.slice(0, 2).toUpperCase() %></div><% } %><% if (lmuCar?.logoPath) { %><img class="cockpit-car-logo" src="<%= lmuCar.logoPath %>" alt="Logo <%= lmuCar.manufacturer %>"><% } %></div><div class="car-number">#<%= cockpit.carNumber || '00' %></div><span><%= lmuCar?.vehicleClass || cockpit.vehicleClass || 'Hypercar' %></span><h3><%= cockpit.team.name %></h3><p><%= lmuCar ? `${lmuCar.manufacturer} ${lmuCar.name}` : (cockpit.team.car || 'Auto noch nicht zugeordnet') %></p><ul><% cockpit.drivers.forEach((driver) => { %><li><%= driver.name %><%= driver.rosterRole === 'Ersatzfahrer' ? ' · Ersatz' : '' %></li><% }) %><% if (cockpit.drivers.length < 3) { %><li>Noch <%= 3 - cockpit.drivers.length %> Fahrerplatz/-plätze offen</li><% } %></ul></article><% }) %></div></section>
<section class="section section-dark"><div class="container"><div class="section-heading"><span>SAISONTERMINE</span><h2>LMU-RENNKALENDER</h2></div><%- include('partials/race-calendar', { calendar, league, emptyMessage: 'Noch keine LMU-Renntermine veröffentlicht.' }) %></div></section>
<section class="section section-dark"><div class="container standings-grid"><div id="lmu-driver-wm"><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>LMU WM-STAND</h2><div class="export-actions"><a class="download-link" href="/lmu/download/wm.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#lmu-driver-wm" data-png-title="<%= league.name %> · Fahrer-WM" data-png-subtitle="<%= selectedSeason?.name || league.currentSeason %>" data-png-filename="lmu-fahrer-wm" data-png-logo="<%= league.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= league.accentColor %>">PNG ↓</button></div></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Fahrer</th><th>Team</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% driverStandings.forEach((row) => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.driver.name %></td><td><%= row.driver.team.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div></div><div id="lmu-team-wm"><div class="section-heading left"><span>AUTOMATISCH BERECHNET</span><h2>TEAM-WM</h2><button class="button button-small" type="button" data-png-export data-png-target="#lmu-team-wm" data-png-title="<%= league.name %> · Team-WM" data-png-subtitle="<%= selectedSeason?.name || league.currentSeason %>" data-png-filename="lmu-team-wm" data-png-logo="<%= league.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= league.accentColor %>">PNG ↓</button></div><div class="table-wrap"><table><thead><tr><th>Pos.</th><th>Team</th><th>Punkte</th><th>Siege</th></tr></thead><tbody><% teamStandings.forEach((row) => { %><tr><td><strong><%= row.position %></strong></td><td><%= row.team.name %></td><td><strong><%= row.points %></strong></td><td><%= row.wins %></td></tr><% }) %></tbody></table></div></div></div></section>
<section class="section container gp-results-section" id="lmu-gp-results"><div class="section-heading"><span>AUTOMATISCH AUS DEM SAISONVERLAUF</span><h2>LMU GP-RESULTS</h2><div class="export-actions"><a class="download-link" href="/lmu/download/results.csv?season=<%= selectedSeason?.id || '' %>" download>CSV ↓</a><button class="button button-small" type="button" data-png-export data-png-target="#lmu-gp-results" data-png-title="<%= league.name %> · GP-Results" data-png-subtitle="<%= selectedSeason?.name || league.currentSeason %>" data-png-filename="lmu-gp-results" data-png-logo="<%= league.logoPath || '/images/krl-placeholder.svg' %>" data-png-accent="<%= league.accentColor %>">PNG ↓</button></div></div><%- include('partials/gp-results', { items: gpResults, label: 'LMU-Ergebnisse' }) %></section>
<%- include('partials/footer') %>
