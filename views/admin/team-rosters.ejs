<%- include('../partials/header', { title }) %>
<section class="admin-shell"><div class="container">
  <div class="admin-heading"><div><a class="back-link" href="/admin">← Dashboard</a><span class="form-kicker"><%= discipline.toUpperCase() %> · Teams</span><h1><%= config.title.toUpperCase() %></h1><p class="admin-intro"><%= config.description %> Weitere Fahrer können jederzeit ergänzt werden.</p></div><a class="button button-ghost" href="/admin/<%= discipline === 'lmu' ? 'lmuTeams' : 'teams' %>"><%= discipline === 'lmu' ? 'LMU-Teams' : 'Formel-1-Teams' %> pflegen</a></div>

  <% if (leagues.length) { %><form class="admin-filter roster-league-filter" method="get"><label>Fahrerfeld der Liga anzeigen<select name="league"><% leagues.forEach((league) => { %><option value="<%= league.id %>" <%= selectedLeague?.id === league.id ? 'selected' : '' %>><%= league.name %></option><% }) %></select></label></form><% } %>

  <% if (selectedLeague && discipline === 'f1') { const assignedTeamIds = new Set(rosters.map((roster) => Number(roster.TeamId || roster.team?.id))); %>
    <section class="team-choice-panel"><header><div><span>TEAMS FÜR DIESE LIGA</span><h2><%= selectedLeague.name %></h2><p>Helle Teams sind bereits zugeordnet. Graue Teams können direkt hinzugefügt werden.</p></div><strong><%= rosters.length %> / <%= teams.length %> aktiv</strong></header>
      <% if (teams.length) { %><div class="team-choice-grid"><% teams.forEach((team, index) => { const isAssigned = assignedTeamIds.has(Number(team.id)); const assignedRoster = isAssigned ? rosters.find((roster) => Number(roster.TeamId || roster.team?.id) === Number(team.id)) : null; %>
        <% if (isAssigned) { %><a class="team-choice-card team-choice-assigned" href="#roster-<%= assignedRoster.id %>"><span class="team-choice-state">✓ In der Liga</span><% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt="Logo <%= team.name %>"><% } else { %><div class="team-choice-logo-fallback"><%= team.name.slice(0, 2).toUpperCase() %></div><% } %><strong><%= team.name %></strong></a>
        <% } else { %><form class="team-choice-card team-choice-available" method="post" action="/admin/team-rosters/<%= discipline %>"><input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>"><input type="hidden" name="TeamId" value="<%= team.id %>"><input type="hidden" name="sortOrder" value="<%= index %>"><span class="team-choice-state">Noch nicht zugeordnet</span><% if (team.logoPath) { %><img src="<%= team.logoPath %>" alt="Logo <%= team.name %>"><% } else { %><div class="team-choice-logo-fallback"><%= team.name.slice(0, 2).toUpperCase() %></div><% } %><strong><%= team.name %></strong><button type="submit">+ Team hinzufügen</button></form><% } %>
      <% }) %></div><% } else { %><div class="empty-state">Lege zuerst zentrale Formel-1-Teams an.</div><% } %>
    </section>
  <% } else if (selectedLeague) { %><form class="roster-create-form" method="post" action="/admin/team-rosters/<%= discipline %>">
      <input type="hidden" name="LeagueId" value="<%= selectedLeague.id %>">
      <div class="roster-selected-league"><span>Ausgewählte Liga</span><strong><%= selectedLeague.name %></strong></div>
      <label>Zentrales Team<select name="TeamId" required><option value="">Team wählen …</option><% teams.forEach((team) => { %><option value="<%= team.id %>"><%= team.name %></option><% }) %></select></label>
      <label>Klasse<input name="vehicleClass" placeholder="Hypercar"></label><label>Startnummer<input name="carNumber" placeholder="00"></label>
      <label>Reihenfolge<input type="number" min="0" name="sortOrder" value="0"></label>
      <button class="button" type="submit">Team zur Liga hinzufügen</button>
    </form>
  <% } else { %><div class="empty-state">Lege zuerst eine passende Liga an.</div><% } %>

  <% if (!rosters.length) { %><div class="empty-state">Noch keine Aufstellung vorhanden. Wähle oben ein zentrales Team und eine Liga aus.</div><% } %>
  <div class="roster-card-grid">
    <% rosters.forEach((roster) => { const requiredDrivers = config.minimum; const assignedDriverIds = new Set(roster.assignments.map((assignment) => Number(assignment.DriverId))); const eligibleDrivers = drivers.filter((driver) => !assignedDriverIds.has(Number(driver.id)) && (discipline === 'lmu' ? (driver.roleLmuRegular || driver.roleLmuReserve) : (roster.league.slug === 'freitag' ? driver.roleF1Friday : driver.roleF1Sunday))); %>
      <article id="roster-<%= roster.id %>" class="roster-card <%= roster.assignments.length < requiredDrivers ? 'roster-incomplete' : '' %>">
        <header><div><span><%= roster.league.name %></span><h2><%= roster.team.name %></h2><% if (discipline === 'lmu') { %><small><%= roster.vehicleClass || 'LMU' %></small><% } %></div><% if (roster.team.logoPath) { %><img src="<%= roster.team.logoPath %>" alt="Logo <%= roster.team.name %>"><% } else { %><div class="roster-logo-fallback"><%= roster.team.name.slice(0, 2).toUpperCase() %></div><% } %></header>
        <% if (discipline === 'lmu' && (roster.carNumber || roster.vehicleClass)) { %><p class="roster-meta"><%= roster.vehicleClass || 'LMU' %><%= roster.carNumber ? ` · #${roster.carNumber}` : '' %></p><% } %>
        <div class="roster-count"><strong><%= roster.assignments.length %></strong> Fahrer · mindestens <%= requiredDrivers %> <%= roster.assignments.length >= requiredDrivers ? '✓' : 'erforderlich' %></div>
        <ol class="roster-driver-list"><% roster.assignments.forEach((assignment) => { %><li><div><strong><%= assignment.driver.name %></strong><small><%= assignment.roleName %> · <%= assignment.driver.platform %></small></div><form method="post" action="/admin/team-rosters/<%= discipline %>/assignments/<%= assignment.id %>?_method=DELETE" data-confirm="Fahrer aus dieser Aufstellung entfernen?"><button type="submit" aria-label="<%= assignment.driver.name %> entfernen">×</button></form></li><% }) %></ol>
        <% if (eligibleDrivers.length) { %><form class="roster-add-driver" method="post" action="/admin/team-rosters/<%= discipline %>/<%= roster.id %>/drivers" data-driver-picker><label for="driver-<%= roster.id %>"><span>FAHRER HINZUFÜGEN</span><small><%= eligibleDrivers.length %> passende Fahrer verfügbar</small></label><div class="roster-driver-search"><span aria-hidden="true">⌕</span><input id="driver-<%= roster.id %>" type="search" list="driver-options-<%= roster.id %>" name="driverSearch" data-driver-search required autocomplete="off" placeholder="Name oder Alias suchen …"></div><input type="hidden" name="DriverId" data-driver-id><datalist id="driver-options-<%= roster.id %>"><% eligibleDrivers.forEach((driver) => { %><option value="<%= driver.name %>" data-driver-id="<%= driver.id %>" label="#<%= driver.id %><%= driver.aliases.length ? ` · Aliase: ${driver.aliases.map((alias) => alias.alias).join(', ')}` : '' %>"></option><% }) %></datalist><button class="button button-small" type="submit">+ Hinzufügen</button></form><% } else { %><div class="roster-search-empty">Alle passenden Fahrer sind bereits zugeordnet.</div><% } %>
        <form class="roster-delete" method="post" action="/admin/team-rosters/<%= discipline %>/<%= roster.id %>?_method=DELETE" data-confirm="Diese Liga-Aufstellung entfernen? Das zentrale Team bleibt bestehen."><button type="submit">Aufstellung entfernen</button></form>
      </article>
    <% }) %>
  </div>
</div></section>
<%- include('../partials/footer') %>
