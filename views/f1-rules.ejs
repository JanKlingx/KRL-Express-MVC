<%- include('partials/header', { title }) %>
<section class="league-hero rules-hero"><div class="container"><span class="eyebrow">FREITAG · SAMSTAG · SONNTAG</span><h1>FORMEL-1-<span>REGELWERK</span></h1><p>Verbindliche Regeln und transparenter Strafenkatalog der KRL Formel-1-Ligen.</p></div></section>
<section class="section container"><div class="rulebook-layout"><nav><strong>INHALT</strong><% sections.forEach((section) => { %><a href="#regel-<%= section.id %>"><%= section.title %></a><% }) %></nav><main><% if (!sections.length) { %><div class="empty-state">Das Regelwerk wird aktuell vorbereitet.</div><% } %><% sections.forEach((section, index) => { %><article id="regel-<%= section.id %>" class="rulebook-section <%= section.sectionType === 'penalty' ? 'penalty' : '' %>"><span><%= section.sectionType === 'penalty' ? 'STRAFENKATALOG' : `REGEL ${String(index + 1).padStart(2,'0')}` %></span><h2><%= section.title %></h2><p><%= section.content %></p><% if (isAdmin) { %><a class="admin-inline-action" href="/admin/f1RuleSections/<%= section.id %>/edit">✎</a><% } %></article><% }) %></main></div></section>
<%- include('partials/footer') %>
