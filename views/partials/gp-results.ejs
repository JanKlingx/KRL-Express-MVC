<%
  const availableTeams =
    typeof teams !== 'undefined' && Array.isArray(teams)
      ? teams
      : [];

  const currentLeague =
    typeof league !== 'undefined'
      ? league
      : null;

  const availableItems =
    Array.isArray(items)
      ? items
      : [];


  const findResultTeam = (entry) => {

    const byName =
      availableTeams.find(
        (team) =>
          String(team.name || '')
            .trim()
            .toLowerCase() ===
          String(entry.teamName || '')
            .trim()
            .toLowerCase()
      );

    if (byName) {
      return byName;
    }

    const byId =
      availableTeams.find(
        (team) =>
          Number(team.id) ===
          Number(entry.TeamId)
      );

    return byId || null;
  };


  const pointLabel = (entry) => {

    if (entry.isReserve) {
      return 'ERSATZ';
    }

    const points =
      Number(entry.points) || 0;

    return `+${points}`;
  };


  const isSprintWeekend = (item) => {

    return availableItems.some(
      (other) => {

        const sameRound =
          Number(other.sortOrder) ===
          Number(item.sortOrder);

        const sameCircuit =
          String(other.circuit || '')
            .trim()
            .toLowerCase() ===
          String(item.circuit || '')
            .trim()
            .toLowerCase();

        return (
          other.raceType === 'sprint' &&
          (
            sameRound ||
            sameCircuit
          )
        );
      }
    );
  };
%>


<% if (availableItems.length) { %>

  <div
    class="carousel gp-carousel gp-broadcast-carousel"
    data-carousel
    tabindex="0"
    aria-label="<%= label %>"
  >

    <div class="carousel-track">

      <% availableItems.forEach((item, index) => {

        const classified =
          [...(item.entries || [])]
            .sort(
              (left, right) => {

                const leftPosition =
                  Number(left.position) || 999;

                const rightPosition =
                  Number(right.position) || 999;

                return (
                  leftPosition -
                    rightPosition ||

                  Number(left.sortOrder) -
                    Number(right.sortOrder)
                );
              }
            );


        const position1 =
          classified.find(
            (entry) =>
              Number(entry.position) === 1
          );

        const position2 =
          classified.find(
            (entry) =>
              Number(entry.position) === 2
          );

        const position3 =
          classified.find(
            (entry) =>
              Number(entry.position) === 3
          );


        /*
         * Optische Reihenfolge:
         * P2 | P1 | P3
         */
        const podium =
          [
            position2,
            position1,
            position3
          ].filter(Boolean);


        /*
         * Alles ab P4.
         */
        const lowerClassification =
          classified.filter(
            (entry) => {

              const position =
                Number(entry.position);

              return (
                !position ||
                position > 3
              );
            }
          );


        /*
         * Desktop:
         * linke Spalte  = erste Hälfte
         * rechte Spalte = zweite Hälfte
         */
        const splitIndex =
          Math.ceil(
            lowerClassification.length / 2
          );

        const lowerLeft =
          lowerClassification.slice(
            0,
            splitIndex
          );

        const lowerRight =
          lowerClassification.slice(
            splitIndex
          );


        const sprintWeekend =
          isSprintWeekend(item);

      %>


        <article
          class="carousel-slide gp-broadcast-card <%= index === 0 ? 'active' : '' %>"
          aria-hidden="<%= index !== 0 %>"
        >


          <!-- ========================================= -->
          <!-- HEADER -->
          <!-- ========================================= -->

          <header class="gp-broadcast-header">

            <div class="gp-broadcast-league">

              <% if (currentLeague?.logoPath) { %>

                <img
                  src="<%= currentLeague.logoPath %>"
                  alt="<%= currentLeague.name %>"
                >

              <% } %>

            </div>


            <div class="gp-broadcast-title">

              <% if (sprintWeekend) { %>

                <span>
                  <%= item.raceType === 'sprint'
                    ? 'SPRINTRENNEN'
                    : 'HAUPTRENNEN'
                  %>
                </span>

              <% } else { %>

                <span>
                  GRAND PRIX
                </span>

              <% } %>


              <h3>
                <%= item.displayTitle || item.title %>
              </h3>


              <% if (item.displayCircuit) { %>

                <small>
                  <%= item.displayCircuit %>
                </small>

              <% } %>

            </div>


            <div class="gp-broadcast-track">

              <% if (item.trackLogoPath) { %>

                <img
                  src="<%= item.trackLogoPath %>"
                  alt="<%= item.countryName || item.displayCircuit || '' %>"
                >

              <% } else { %>

                <span class="gp-track-fallback">
                  <%= item.countryName || 'GP' %>
                </span>

              <% } %>

            </div>

          </header>


          <!-- ========================================= -->
          <!-- META -->
          <!-- ========================================= -->

          <div class="gp-broadcast-meta">

            <span>
              RUNDE
              <strong>
                <%= item.sortOrder || index + 1 %>
              </strong>
            </span>


            <% if (item.raceDate) { %>

              <span>
                <%= item.raceDate %>
              </span>

            <% } %>


            <span>
              <%= item.season %>
            </span>

          </div>


          <% if (classified.length) { %>


            <!-- ======================================= -->
            <!-- PODIUM -->
            <!-- ======================================= -->

            <% if (podium.length) { %>

              <div
                class="gp-broadcast-podium"
                aria-label="Podium"
              >

                <% podium.forEach((entry) => {

                  const team =
                    findResultTeam(entry);

                  const position =
                    Number(entry.position);

                  const status =
                    String(entry.status || '')
                      .trim()
                      .toUpperCase();

                %>


                  <article
                    class="
                      gp-broadcast-podium-card
                      gp-broadcast-podium-<%= position %>
                    "
                    style="
                      --gp-team-color:<%= team?.accentColor || '#6ef2f2' %>;
                    "
                  >


                    <span
                      class="gp-broadcast-podium-position"
                    >
                      <%= position %>
                    </span>


                    <div
                      class="gp-broadcast-podium-team"
                    >

                      <% if (team?.logoPath) { %>

                        <img
                          src="<%= team.logoPath %>"
                          alt="<%= entry.teamName || team.name %>"
                          title="<%= entry.teamName || team.name %>"
                        >

                      <% } else { %>

                        <strong>
                          <%= entry.teamName || 'TEAM' %>
                        </strong>

                      <% } %>

                    </div>


                    <div
                      class="gp-broadcast-podium-info"
                    >

                      <strong
                        class="gp-broadcast-driver"
                      >
                        <%= entry.driverName %>
                      </strong>


                      <span
                        class="
                          gp-broadcast-result-label
                          <%= entry.isReserve
                            ? 'is-reserve'
                            : 'is-points'
                          %>
                        "
                      >

                        <%= pointLabel(entry) %>

                        <% if (!entry.isReserve) { %>
                          PKT
                        <% } %>

                      </span>

                    </div>


                    <% if (entry.fastestLap) { %>

                      <span
                        class="gp-broadcast-fastest"
                        title="Schnellste Runde"
                      >
                        SR
                      </span>

                    <% } %>


                    <% if (
                      status &&
                      status !== 'GEWERTET'
                    ) { %>

                      <span
                        class="gp-broadcast-status"
                      >
                        <%= status %>
                      </span>

                    <% } %>

                  </article>

                <% }) %>

              </div>

            <% } %>


            <!-- ======================================= -->
            <!-- P4 BIS ENDE · ZWEI SPALTEN -->
            <!-- ======================================= -->

            <div class="gp-broadcast-ranking">


              <!-- LINKE SPALTE -->

              <div class="gp-broadcast-ranking-column">

                <% lowerLeft.forEach((entry) => {

                  const position =
                    Number(entry.position) ||
                    null;

                  const team =
                    findResultTeam(entry);

                  const status =
                    String(entry.status || '')
                      .trim()
                      .toUpperCase();

                  const statusClass =
                    status
                      .toLowerCase()
                      .replace(
                        /[^a-z0-9_-]+/g,
                        '-'
                      );

                %>

                  <article
                    class="
                      gp-broadcast-row
                      <%= position ? `gp-position-${position}` : '' %>
                      <%= statusClass ? `status-${statusClass}` : '' %>
                    "
                    style="
                      --gp-team-color:<%= team?.accentColor || '#6ef2f2' %>;
                    "
                  >


                    <div
                      class="gp-broadcast-row-position"
                    >

                      <strong>
                        <%= position || '–' %>
                      </strong>

                    </div>


                    <div
                      class="gp-broadcast-row-team"
                    >

                      <% if (team?.logoPath) { %>

                        <img
                          src="<%= team.logoPath %>"
                          alt="<%= entry.teamName || team.name %>"
                          title="<%= entry.teamName || team.name %>"
                        >

                      <% } else { %>

                        <span>
                          <%= entry.teamName || '–' %>
                        </span>

                      <% } %>

                    </div>


                    <div
                      class="gp-broadcast-row-driver"
                    >

                      <strong>
                        <%= entry.driverName %>
                      </strong>


                      <% if (
                        status &&
                        status !== 'GEWERTET'
                      ) { %>

                        <small
                          class="status-<%= statusClass %>"
                        >
                          <%= status %>
                        </small>

                      <% } %>


                      <% if (entry.fastestLap) { %>

                        <span
                          class="gp-broadcast-row-sr"
                          title="Schnellste Runde"
                        >
                          SR
                        </span>

                      <% } %>

                    </div>


                    <div
                      class="
                        gp-broadcast-row-result
                        <%= entry.isReserve
                          ? 'is-reserve'
                          : ''
                        %>
                      "
                    >

                      <%= pointLabel(entry) %>

                      <% if (!entry.isReserve) { %>
                        <small>PKT</small>
                      <% } %>

                    </div>

                  </article>

                <% }) %>

              </div>


              <!-- RECHTE SPALTE -->

              <div class="gp-broadcast-ranking-column">

                <% lowerRight.forEach((entry) => {

                  const position =
                    Number(entry.position) ||
                    null;

                  const team =
                    findResultTeam(entry);

                  const status =
                    String(entry.status || '')
                      .trim()
                      .toUpperCase();

                  const statusClass =
                    status
                      .toLowerCase()
                      .replace(
                        /[^a-z0-9_-]+/g,
                        '-'
                      );

                %>

                  <article
                    class="
                      gp-broadcast-row
                      <%= position ? `gp-position-${position}` : '' %>
                      <%= statusClass ? `status-${statusClass}` : '' %>
                    "
                    style="
                      --gp-team-color:<%= team?.accentColor || '#6ef2f2' %>;
                    "
                  >


                    <div
                      class="gp-broadcast-row-position"
                    >

                      <strong>
                        <%= position || '–' %>
                      </strong>

                    </div>


                    <div
                      class="gp-broadcast-row-team"
                    >

                      <% if (team?.logoPath) { %>

                        <img
                          src="<%= team.logoPath %>"
                          alt="<%= entry.teamName || team.name %>"
                          title="<%= entry.teamName || team.name %>"
                        >

                      <% } else { %>

                        <span>
                          <%= entry.teamName || '–' %>
                        </span>

                      <% } %>

                    </div>


                    <div
                      class="gp-broadcast-row-driver"
                    >

                      <strong>
                        <%= entry.driverName %>
                      </strong>


                      <% if (
                        status &&
                        status !== 'GEWERTET'
                      ) { %>

                        <small
                          class="status-<%= statusClass %>"
                        >
                          <%= status %>
                        </small>

                      <% } %>


                      <% if (entry.fastestLap) { %>

                        <span
                          class="gp-broadcast-row-sr"
                          title="Schnellste Runde"
                        >
                          SR
                        </span>

                      <% } %>

                    </div>


                    <div
                      class="
                        gp-broadcast-row-result
                        <%= entry.isReserve
                          ? 'is-reserve'
                          : ''
                        %>
                      "
                    >

                      <%= pointLabel(entry) %>

                      <% if (!entry.isReserve) { %>
                        <small>PKT</small>
                      <% } %>

                    </div>

                  </article>

                <% }) %>

              </div>

            </div>


          <% } else { %>

            <div class="empty-state">
              Für diesen Grand Prix wurde noch keine Klassifikation eingetragen.
            </div>

          <% } %>

        </article>

      <% }) %>

    </div>


    <!-- =============================================== -->
    <!-- CAROUSEL -->
    <!-- =============================================== -->

    <% if (availableItems.length > 1) { %>

      <button
        class="carousel-control prev"
        type="button"
        aria-label="Vorheriges Ergebnis"
      >
        ‹
      </button>


      <button
        class="carousel-control next"
        type="button"
        aria-label="Nächstes Ergebnis"
      >
        ›
      </button>


      <div
        class="carousel-dots"
        aria-label="Ergebnis auswählen"
      ></div>

    <% } %>

  </div>


<% } else { %>

  <div class="empty-state">
    Noch keine Grand-Prix-Ergebnisse eingetragen.
  </div>

<% } %>