<% const posts = typeof newsPosts === 'undefined' ? [] : newsPosts;
const canEdit = typeof communityEditing !== 'undefined' && communityEditing;
const settings = typeof communitySettings === 'undefined' ? {} : communitySettings;
const draft = typeof newsDraft === 'undefined' ? null : newsDraft; %>
<section class="section container" id="news"><div class="section-heading"><span>AUS DEM PADDOCK</span><h2>KRL NEWS</h2></div>
<% if(canEdit) { %><details class="community-editor" <%= draft && !draft.id ? 'open' : '' %>><summary>+ News hinzufügen</summary><%- include('news-form',{post:draft && !draft.id ? draft : {}}) %></details><% } %>
<div class="news-grid"><% posts.forEach((post,index)=>{ %><article class="news-card <%= index===0?'news-featured':'' %>"><span class="eyebrow"><%= post.isPublished?'KRL UPDATE':'ENTWURF · NUR ADMIN' %></span><h3><%= post.title %></h3><% if(post.publishedAt){ %><time datetime="<%= new Date(post.publishedAt).toISOString() %>"><%= new Date(post.publishedAt).toLocaleDateString('de-DE') %></time><% } %><div class="news-body rich-content" id="news-body-<%= post.id %>" data-news-body><% if(typeof renderRichContent==='function'){ %><%- renderRichContent(post.body) %><% }else{ %><p><%= post.body %></p><% } %></div><% if(post.body.length>260){ %><button type="button" class="button button-ghost button-small" data-news-toggle="news-body-<%= post.id %>" aria-expanded="false" hidden>Alles lesen</button><% } %>
<% if(canEdit){ %><details class="community-editor" <%= String(draft?.id)===String(post.id)?'open':'' %>><summary>✎ News bearbeiten</summary><%- include('news-form',{post:String(draft?.id)===String(post.id)?draft:post}) %><form method="post" action="/admin/news/<%= post.id %>/delete" data-confirm="Diese News endgültig löschen?"><button class="button button-ghost button-small">News löschen</button></form></details><% } %></article><% }); %>
<% if(!posts.length){ %><p class="empty-state">Hier findest du bald Neuigkeiten aus der KRL. Entdecke bis dahin unsere Ligen und Social-Media-Kanäle.</p><% } %></div></section>
<section class="section container" id="social"><div class="section-heading"><span>AUCH ZWISCHEN DEN RENNEN</span><h2>BLEIB MITTENDRIN</h2></div>
<div class="social-links"><% [['Twitch','Live dabei','https://www.twitch.tv/katzesracingleague'],['Instagram','Momente aus der Liga','https://www.instagram.com/katzesracingleague/'],['TikTok','Clips & Highlights','https://www.tiktok.com/@katzesracingleaguef1liga'],['YouTube','Rennen noch einmal erleben','https://www.youtube.com/@KatzesRacingLeague/featured'],['Teamshop','Zeig deine Liga','https://www.xoose.de/produkt-kategorie/katzes-racing-league/']].forEach(([label,subtitle,url])=>{ %><a href="<%= url %>" target="_blank" rel="noopener"><strong><%= label %> ↗</strong><span><%= subtitle %></span></a><% }); %></div>
<div class="social-feed-grid"><article class="social-feed"><h3>Neue Clips auf TikTok</h3><p>Die aktuellen Videos direkt aus unserem Profil.</p><div data-tiktok-feed><button type="button" class="button" data-load-tiktok>TikTok-Clips laden</button><small>Beim Laden wird eine Verbindung zu TikTok hergestellt.</small></div><a href="https://www.tiktok.com/@katzesracingleaguef1liga" target="_blank" rel="noopener">Alle Clips auf TikTok ↗</a></article>
<% if(settings.instagramPost){ %><article class="social-feed"><h3>Auf Instagram</h3><button type="button" class="button" data-load-frame="<%= settings.instagramPost.replace(/\/$/,'') %>/embed/" data-frame-title="Instagram-Beitrag der KRL">Instagram-Beitrag laden</button><a href="<%= settings.instagramPost %>" target="_blank" rel="noopener">Beitrag öffnen ↗</a></article><% } %>
<% if(settings.discordServerId){ %><article class="social-feed"><h3>Unser Discord</h3><iframe src="https://discord.com/widget?id=<%= settings.discordServerId %>&theme=dark" title="KRL Discord" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe></article><% } %></div>
<% if(canEdit){ %><details class="community-editor"><summary>✎ Social Media bearbeiten</summary><form method="post" action="/admin/community-settings" class="news-form"><label>Instagram-Beitrag hervorheben<input type="url" name="instagramPost" value="<%= settings.instagramPost || '' %>" placeholder="https://www.instagram.com/p/…/"></label><p>Der TikTok-Profilfeed aktualisiert sich automatisch. Den Instagram-Beitragslink kannst du hier ersetzen.</p><label>Discord-Server-ID<input name="discordServerId" inputmode="numeric" value="<%= settings.discordServerId || '' %>"></label><small>Im Discord-Server muss das Server-Widget aktiviert sein.</small><button class="button button-small">Speichern</button></form></details><% } %>
</section>
