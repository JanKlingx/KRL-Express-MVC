<%- include('../partials/header', { title }) %>

<%
  const selectedRounds = Array.isArray(selectedCalendar?.rounds) ? selectedCalendar.rounds : [];
  const officialRounds = selectedRounds.filter((round) => !round.isTestDay);
  const nextOfficialRound = officialRounds.reduce(
    (highest, round) => Math.max(highest, Number(round.roundNumber || 0)),
    0
  ) + 1;
%>

<style>
  .f1-calendar-layout {
    display: grid;
    grid-template-columns: minmax(270px, 330px) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .f1-calendar-sidebar,
  .f1-calendar-workspace {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .f1-calendar-card {
    border: 1px solid rgba(255,255,255,.12);
    background: linear-gradient(145deg, rgba(18,28,32,.96), rgba(8,13,16,.98));
    box-shadow: 0 18px 45px rgba(0,0,0,.18);
  }

  .f1-calendar-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    border-bottom: 1px solid rgba(255,255,255,.1);
  }

  .f1-calendar-card__header span,
  .f1-calendar-field > span {
    color: var(--cyan);
    font-size: .68rem;
    font-weight: 900;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .f1-calendar-card__header h2,
  .f1-calendar-card__header h3 {
    margin: .25rem 0 0;
  }

  .f1-calendar-card__body { padding: 1.25rem; }

  .f1-calendar-list {
    display: grid;
    gap: .6rem;
  }

  .f1-calendar-list a {
    display: grid;
    gap: .3rem;
    padding: .85rem .95rem;
    border: 1px solid rgba(255,255,255,.12);
    color: inherit;
    text-decoration: none;
    background: rgba(255,255,255,.025);
  }

  .f1-calendar-list a:hover,
  .f1-calendar-list a.is-selected {
    border-color: var(--cyan);
    background: rgba(110,242,242,.075);
  }

  .f1-calendar-list small,
  .f1-calendar-help {
    color: var(--muted);
  }

  .f1-calendar-form,
  .f1-calendar-meta-form,
  .f1-calendar-round-form {
    display: grid;
    gap: 1rem;
  }

  .f1-calendar-field {
    display: grid;
    gap: .4rem;
    margin: 0;
  }

  .f1-calendar-field input,
  .f1-calendar-field select {
    width: 100%;
    min-width: 0;
  }

  .f1-calendar-meta-form {
    grid-template-columns: minmax(220px, 1fr) minmax(120px, .35fr) auto auto;
    align-items: end;
  }

  .f1-calendar-round-form {
    grid-template-columns: minmax(100px, .35fr) minmax(280px, 1.4fr) auto auto auto;
    align-items: end;
  }

  .f1-calendar-options {
    display: flex;
    gap: .75rem;
    align-items: center;
    min-height: 44px;
  }

  .f1-calendar-options .checkbox-control { margin: 0; }

  .f1-calendar-transaction-note {
    display: flex;
    gap: .75rem;
    align-items: flex-start;
    margin-top: 1rem;
    padding: .8rem .9rem;
    border-left: 3px solid var(--cyan);
    background: rgba(110,242,242,.05);
    color: var(--muted);
    font-size: .8rem;
  }

  .f1-calendar-transaction-note strong { color: #fff; }

  .f1-calendar-table-wrap { overflow-x: auto; }

  .f1-calendar-table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
  }

  .f1-calendar-table th,
  .f1-calendar-table td {
    padding: .75rem .65rem;
    border-bottom: 1px solid rgba(255,255,255,.1);
    vertical-align: middle;
  }

  .f1-calendar-table th {
    color: var(--cyan);
    font-size: .66rem;
    letter-spacing: .09em;
    text-align: left;
    text-transform: uppercase;
  }

  .f1-calendar-table tr.is-test {
    background: rgba(233,30,99,.055);
    box-shadow: inset 3px 0 #e91e63;
  }

  .f1-calendar-table img {
    width: 28px;
    height: 18px;
    margin-right: .5rem;
    border-radius: 2px;
    object-fit: cover;
    vertical-align: middle;
  }

  .f1-calendar-table .round-track { min-width: 280px; }
  .f1-calendar-round-field { width: 110px; }
  .f1-calendar-round-field input { width: 100%; }

  .f1-calendar-test-label {
    display: grid;
    gap: .15rem;
    color: #ff80ac;
  }

  .f1-calendar-test-label small { color: var(--muted); }

  .f1-calendar-row-actions {
    display: flex;
    gap: .45rem;
    white-space: nowrap;
  }

  .f1-calendar-drag {
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: grab;
    font-size: 1.15rem;
  }

  .f1-calendar-table tr.is-dragging { opacity: .45; }

  .f1-calendar-reorder {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding: .85rem;
    border: 1px dashed rgba(255,255,255,.2);
    background: rgba(255,255,255,.02);
  }

  @media (max-width: 1100px) {
    .f1-calendar-layout { grid-template-columns: 1fr; }
    .f1-calendar-sidebar { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .f1-calendar-meta-form,
    .f1-calendar-round-form { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .f1-calendar-sidebar { grid-template-columns: 1fr; }
    .f1-calendar-meta-form,
    .f1-calendar-round-form { grid-template-columns: 1fr; }
    .f1-calendar-reorder { align-items: stretch; flex-direction: column; }
  }
  .f1-calendar-layout { display: block; }
  .f1-calendar-workspace [hidden] { display: none !important; }
</style>

<section class="admin-shell">
  <div class="container">
    <div class="admin-heading">
      <div>
        <a class="back-link" href="/admin">← Dashboard</a>
        <span class="form-kicker">FORMEL 1 · STAMMDATEN</span>
        <h1>ZENTRALE F1-RENNKALENDER</h1>
        <p class="admin-intro">Hier wird nur die gemeinsame Reihenfolge aus Strecke, Sprint und Testtag gepflegt. Datum und feste Startzeit folgen später im Saison-Assistenten.</p>
      </div>
      <a class="button button-ghost" href="/admin/season-setup">Saison-Assistent</a>
    </div>

    <div class="f1-calendar-layout">
      <% if (!selectedCalendar) { %>
        <p><a class="button button-ghost" href="/admin/f1-calendars">Kalender bearbeiten</a> <a class="button" href="/admin/f1-calendars?mode=create">+ Kalender erstellen</a></p>
        <% if (creating) { %>

        <section class="f1-calendar-card">
          <header class="f1-calendar-card__header"><div><span>Schritt 1 von 2</span><h2>Kalender benennen</h2></div></header>
          <div class="f1-calendar-card__body">
            <form method="post" action="/admin/f1-calendars" class="f1-calendar-form">
              <label class="f1-calendar-field"><span>Name</span><input name="name" maxlength="255" value="<%= draftName %>" placeholder="z. B. Saison 18 Rennkalender" required></label>
              <label class="checkbox-control"><input type="checkbox" name="isActive" checked><span>Direkt zur Saisonwahl freigeben</span></label>
              <button class="button" type="submit">Weiter zur Kalenderstruktur →</button>
            </form>
          </div>
        </section>
<% } else { %>        <section class="f1-calendar-card">
          <header class="f1-calendar-card__header"><div><span>Schritt 1 von 2</span><h2>Kalender auswählen</h2></div></header>
          <div class="f1-calendar-card__body">
            <div class="f1-calendar-list">
              <% calendars.forEach((calendar) => { %>
                <a href="/admin/f1-calendars?calendar=<%= calendar.id %>" class="<%= selectedCalendar?.id === calendar.id ? 'is-selected' : '' %>">
                  <strong><%= calendar.name %></strong>
                  <small><%= (calendar.rounds || []).filter((round) => !round.isTestDay).length %> Rennen<%= (calendar.rounds || []).some((round) => round.isTestDay) ? ' · mit Testtag' : '' %> · <%= calendar.isActive ? 'aktiv' : 'inaktiv' %></small>
                </a>
              <% }) %>
              <% if (!calendars.length) { %><div class="empty-state">Noch kein Kalender vorhanden.</div><% } %>
            </div>
          </div>
        </section><% } %>
      <% } %>
      <main class="f1-calendar-workspace">
        <% if (selectedCalendar) { const showStructure = typeof structureOpen === 'undefined' || structureOpen; %>
          <a class="back-link" href="/admin/f1-calendars">← Kalenderauswahl</a>
          <section class="f1-calendar-card">
            <header class="f1-calendar-card__header"><div><span><%= showStructure ? 'Gewählter Kalender' : 'Schritt 1 von 2 · Name' %></span><h2><%= selectedCalendar.name %></h2></div></header>
            <div class="f1-calendar-card__body">
              <form method="post" action="/admin/f1-calendars/<%= selectedCalendar.id %>" class="f1-calendar-meta-form">
                <label class="f1-calendar-field"><span>Name</span><input name="name" value="<%= selectedCalendar.name %>" maxlength="255" required></label>
                <label class="checkbox-control"><input type="checkbox" name="isActive" <%= selectedCalendar.isActive ? 'checked' : '' %>><span>Zur Saisonwahl freigeben</span></label>
                <button class="button button-small" type="submit"><%= showStructure ? 'Name speichern' : 'Weiter zur Kalenderstruktur →' %></button>
              </form>
              <form method="post" action="/admin/f1-calendars/<%= selectedCalendar.id %>/delete" data-confirm="Diesen unbenutzten Kalender löschen?"><button class="button button-ghost button-small">Kalender löschen</button></form>
            </div>
          </section>
          <% if (showStructure) { %>
          <section class="f1-calendar-card">
            <header class="f1-calendar-card__header"><div><span>Schritt 2 von 2</span><h2>Kalenderstruktur</h2></div></header>
            <div class="f1-calendar-card__body">
              <p>Mit ↑ und ↓ verschieben oder am Griff ziehen. Die Rennnummern werden automatisch vergeben; Testtage zählen nicht mit.</p>
              <form id="calendar-structure" method="post" action="/admin/f1-calendars/<%= selectedCalendar.id %>/structure" data-calendar-structure>
                <div class="f1-calendar-table-wrap"><table class="f1-calendar-table">
                  <thead><tr><th>Verschieben</th><th>Rennen</th><th>Land / Strecke</th><th>Sprint</th><th>Testtag</th><th></th></tr></thead>
                  <tbody data-round-list>
                    <% let raceNumber = 0; selectedRounds.forEach((round) => { if (!round.isTestDay) raceNumber += 1; %>
                      <tr data-round-row data-round-id="<%= round.id %>" class="<%= round.isTestDay ? 'is-test' : '' %>">
                        <td><div class="f1-calendar-row-actions"><button class="f1-calendar-drag" type="button" draggable="true" data-drag-handle aria-label="Kalendereintrag ziehen">↕</button><button type="button" data-move="up" aria-label="Nach oben">↑</button><button type="button" data-move="down" aria-label="Nach unten">↓</button></div></td>
                        <td><input type="hidden" name="roundIds" value="<%= round.id %>"><strong data-round-number-field <%= round.isTestDay ? 'hidden' : '' %>><%= round.isTestDay ? '' : `R${raceNumber}` %></strong><strong data-test-label title="keine Rennnummer" <%= round.isTestDay ? '' : 'hidden' %>>TESTTAG</strong></td>
                        <td><% if (round.track?.countryRecord?.flagPath) { %><img src="<%= round.track.countryRecord.flagPath %>" alt=""><% } %><select name="rounds[<%= round.id %>][F1TrackId]" required aria-label="Strecke"><% tracks.forEach((track) => { %><option value="<%= track.id %>" <%= Number(round.F1TrackId) === Number(track.id) ? 'selected' : '' %>><%= track.countryRecord?.name || track.country %> · <%= track.name %></option><% }) %></select></td>
                        <td><input type="checkbox" name="rounds[<%= round.id %>][hasSprint]" data-sprint-toggle aria-label="Sprint" <%= round.hasSprint ? 'checked' : '' %> <%= round.isTestDay ? 'disabled' : '' %>></td>
                        <td><input type="checkbox" name="rounds[<%= round.id %>][isTestDay]" data-test-toggle aria-label="Testtag" <%= round.isTestDay ? 'checked' : '' %>></td>
                        <td><button class="button button-ghost button-small" type="submit" form="delete-round-<%= round.id %>">Löschen</button></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table></div>
                <% if (selectedRounds.length) { %><p><button class="button" type="submit">Kalenderstruktur speichern</button> <span data-order-status role="status"></span></p><% } else { %><p>Füge das erste Rennen oder einen Testtag hinzu.</p><% } %>
              </form>
              <% selectedRounds.forEach((round) => { %><form id="delete-round-<%= round.id %>" method="post" action="/admin/f1-calendars/<%= selectedCalendar.id %>/rounds/<%= round.id %>/delete" data-confirm="Diesen unbenutzten Kalendereintrag löschen? Ungespeicherte Strukturänderungen gehen verloren."></form><% }) %>
            </div>
          </section>
          <section class="f1-calendar-card">
            <header class="f1-calendar-card__header"><h2>+ Rennen oder Testtag hinzufügen</h2></header>
            <div class="f1-calendar-card__body">
              <form method="post" action="/admin/f1-calendars/<%= selectedCalendar.id %>/rounds" class="f1-calendar-round-form" data-calendar-entry-form>
                <label class="f1-calendar-field"><span>Strecke</span><select name="F1TrackId" required><option value="">Strecke wählen …</option><% tracks.forEach((track) => { %><option value="<%= track.id %>"><%= track.countryRecord?.name || track.country %> · <%= track.name %></option><% }) %></select></label>
                <label class="checkbox-control"><input type="checkbox" name="hasSprint" data-sprint-toggle><span>Sprint</span></label>
                <label class="checkbox-control"><input type="checkbox" name="isTestDay" data-test-toggle><span>Testtag</span></label>
                <button class="button" type="submit">Hinzufügen</button>
              </form>
            </div>
          </section>
          <% } %>
        <% } %>
      </main>
    </div>
  </div>
</section>

<script src="/js/calendar-structure.js" defer></script>

<%- include('../partials/footer') %>
